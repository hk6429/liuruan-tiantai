using System;
using System.Collections.Generic;
using System.Collections;
using UnityEngine;

namespace Liuruan
{
    [DefaultExecutionOrder(-100)]
    public sealed class GameFlow : MonoBehaviour
    {
        const string SaveKey = "liuruan_r1_progress";
        [SerializeField] TextAsset clueJson;
        [SerializeField] Material returnMaterial;
        public Material returnSky;
        public SeasonSwap seasons;
        public EpilogueDirector epilogue;
        public bool SeasonPlaying => seasons && seasons.IsPlaying;
        public MinimapCam minimap;
        public ClimbZone climb;
        public DriftCollection driftCollection;
        [Serializable] public sealed class Progress
        {
            public int act = 1, bark, drift, villageStep;
            public bool climbed, inferred, ended, halfYearComplete;
            public float playSeconds;
            public Vector3 position = new Vector3(0, 0.1f, -105);
        }
        public Progress State { get; private set; }
        public int Act { get { return State.act; } }
        public int BarkCount { get { int n = 0; for (int i = 0; i < 5; i++) if ((State.bark & (1 << i)) != 0) n++; return n; } }
        public bool Reading { get; private set; }
        public bool CanReturn { get { return Act == 4 && State.villageStep == 3 && !Reading && State.halfYearComplete && !SeasonPlaying; } }
        public HungerSystem Hunger { get; private set; }
        public CompanionFollow Companion { get; private set; }
        public PlayerController Player { get; private set; }
        public ClueData CurrentCard { get; private set; }
        readonly Dictionary<string, Interactable> points = new Dictionary<string, Interactable>();
        ClueData[] clues = new ClueData[0];
        public string Objective
        {
            get
            {
                if (Act == 1) return "一・迷山　剝取穀皮 " + BarkCount + "／5";
                if (Act == 2) return State.climbed ? "二・攀桃　摘取桃子" : "二・攀桃　前往崖下攀援處";
                if (Act == 3) return State.inferred ? "三・流杯　向北涉水" : "三・流杯　拾取三件漂流物";
                if (Act == 4) return new[] { "四・仙村　前往二女子處", "四・仙村　前往銅瓦屋", "四・仙村　閱讀告示板", "四・仙村　選擇求歸" }[State.villageStep];
                return State.ended ? "五・歸鄉　旅程結束" : "五・歸鄉　回到村口";
            }
        }
        void Awake()
        {
            ScrollUI.DeferHelp = true;
            State = new Progress();
            try { if (PlayerPrefs.HasKey(SaveKey)) State = JsonUtility.FromJson<Progress>(PlayerPrefs.GetString(SaveKey)) ?? new Progress(); }
            catch (ArgumentException) { State = new Progress(); }
            State.act = Mathf.Clamp(State.act, 1, 5);
            if (float.IsNaN(State.playSeconds) || float.IsInfinity(State.playSeconds) || State.playSeconds < 0) State.playSeconds = 0;
            State.bark &= 31; State.drift &= 7; State.villageStep = Mathf.Clamp(State.villageStep, 0, 3);
            Player = FindFirstObjectByType<PlayerController>();
            Hunger = Player.GetComponent<HungerSystem>();
            Companion = FindFirstObjectByType<CompanionFollow>();
            if (clueJson)
            {
                try { var list = JsonUtility.FromJson<ClueList>(clueJson.text); if (list != null) clues = list.clues ?? clues; }
                catch (ArgumentException e) { Debug.LogWarning("[GameFlow] 題庫格式無法讀取：" + e.Message); }
            }
            foreach (Transform t in GameObject.Find("ActPoints").transform)
            {
                var it = t.GetComponent<Interactable>();
                if (!it) continue;
                string key = t.name;
                points.Add(key, it);
                it.onInteract.AddListener(() => InteractPoint(key));
            }
        }
        void OnEnable()
        {
            if (seasons) seasons.OnBirdsSing += BirdsSing;
            if (climb) climb.OnTopOut += Climbed;
            if (driftCollection) { driftCollection.OnCollected += Collected; driftCollection.OnAllCollected += Infer; }
        }
        void OnDisable()
        {
            if (seasons) seasons.OnBirdsSing -= BirdsSing;
            if (climb) climb.OnTopOut -= Climbed;
            if (driftCollection) { driftCollection.OnCollected -= Collected; driftCollection.OnAllCollected -= Infer; }
        }
        void BirdsSing()
        {
            State.halfYearComplete = true;
            Debug.Log("[SeasonSwap] 百鳥啼鳴（音效待補）");
            GetComponent<HudUI>().ShowBirds(); Save(); SyncPoints();
        }
        void BeginHalfYear()
        {
            if (State.halfYearComplete || !seasons) return;
            Toast("遂停半年"); seasons.PlayHalfYear();
        }
        public EpilogueModel EndingModel()
        {
            var results = new List<ReadingResult>();
            foreach (var clue in clues) if (!clue.isEnding) results.Add(new ReadingResult(clue.id, QuizStats.FirstTryCorrect(clue.id)));
            int drift = 0; for (int i = 0; i < 3; i++) if ((State.drift & (1 << i)) != 0) drift++;
            return epilogue && epilogue.Present(BarkCount, drift, results.ToArray(), State.playSeconds) ? epilogue.Model : null;
        }
        void Climbed() { State.climbed = true; Save(); SyncPoints(); }
        bool restoringDrift;
        void Collected(int id) { if (restoringDrift) return; State.drift |= 1 << (id - 1); Save(); SyncPoints(); }
        void Infer() { if (!restoringDrift && !Reading && Act == 3 && !State.inferred) ReadAct(3, () => { State.inferred = true; Save(); SyncPoints(); }); }
        void Start()
        {
            restoringDrift = true;
            if (driftCollection) for (int id = 1; id <= 3; id++)
                if ((State.drift & (1 << (id - 1))) != 0) driftCollection.Core.Collect(id);
            restoringDrift = false;
            MovePlayer(State.position);
            if (Act >= 3) Hunger.FillAll();
            Hunger.OnToast += Toast;
            SyncPoints();
            if (Act == 5) ApplyReturn();
            if (Act == 4 && State.villageStep == 3) BeginHalfYear();
            if (Act == 3 && State.drift == 7 && !State.inferred) Infer();
            if (State.ended) GetComponent<HudUI>().ShowEnding();
        }
        void OnDestroy() { if (Hunger) Hunger.OnToast -= Toast; }
        void Update()
        {
            if (climb && climb.IsLocked && TouchInput.Enabled) climb.SetMoveInput(TouchInput.Move);
            bool busy = Reading || (ScrollUI.I && ScrollUI.I.IsBusy) || State.ended || SeasonPlaying;
            if (!busy) State.playSeconds += Time.deltaTime;
            if (busy) Hunger.Pause(); else Hunger.Resume();
            if (!busy)
            {
                if (Input.GetKeyDown(KeyCode.F)) UseSkill(0);
                if (Input.GetKeyDown(KeyCode.R)) UseSkill(1);
                if (Input.GetKeyDown(KeyCode.G)) UseSkill(2);
            }
#if UNITY_EDITOR || DEVELOPMENT_BUILD
            if (Input.GetKeyDown(KeyCode.F9) && !busy) DebugNextAct();
#endif
        }
        void LateUpdate()
        {
            if (!climb || !climb.IsLocked || !Player.cam) return;
            Player.cam.position = Player.transform.position + new Vector3(6, 2.5f, -4);
            Player.cam.LookAt(Player.transform.position + Vector3.up);
        }
        public void UseSkill(int skill)
        {
            if (Reading || SeasonPlaying || State.ended || (ScrollUI.I && ScrollUI.I.IsBusy)) return;
            if (skill == 2) { if (Companion.Call()) Toast("已呼喚阮肇"); return; }
            var near = Interactable.Nearest(Player.transform.position);
            if (near && (skill == 0 ? near.name.StartsWith("Act1_Bark_") : near.name.StartsWith("Act3_Drift_"))) near.Interact();
            else Toast(skill == 0 ? "請靠近可剝皮的楮樹" : "請靠近溪中漂流物");
        }
        public void InteractPoint(string key)
        {
            Interactable point;
            if (Reading || SeasonPlaying || State.ended || !points.TryGetValue(key, out point) || !point.enabled) return;
            if (Act == 1 && key.StartsWith("Act1_Bark_"))
            {
                State.bark |= 1 << (key[key.Length - 1] - '1');
                if (State.bark == 31) { State.act = 2; ReadAct(1, null); }
            }
            else if (Act == 2 && key == "Act2_ClimbBase")
            {
                if (climb) climb.TryInteract();
            }
            else if (Act == 2 && key == "Act2_PeachTree")
            {
                if (Player.animator) Player.animator.SetTrigger("PickFruit");
                Hunger.FillAll();
                Reading = true;
                StartCoroutine(FinishPicking());
            }
            else if (Act == 3 && key.StartsWith("Act3_Drift_"))
            {
                var pickup = point.GetComponent<DriftPickup>();
                if (pickup) pickup.TryInteract();
            }
            else if (Act == 3 && key == "Act3_Wade") { State.act = 4; MovePlayer(new Vector3(0, 0.2f, 63)); }
            else if (Act == 4)
            {
                State.villageStep = Mathf.Min(3, State.villageStep + 1);
                if (key == "Act4_Board") ReadAct(4, BeginHalfYear);
            }
            else if (Act == 5 && key == "Act5_Return")
            {
                ApplyReturn();
                ReadAct(5, () => { State.ended = true; Save(); SyncPoints(); GetComponent<HudUI>().ShowEnding(); });
            }
            Save(); SyncPoints();
        }
        IEnumerator FinishPicking()
        {
            float duration = 1;
            if (Player.animator) foreach (var clip in Player.animator.runtimeAnimatorController.animationClips)
                if (clip.name == "pickfruit") duration = clip.length + .15f;
            yield return new WaitForSeconds(duration);
            State.act = 3; MovePlayer(new Vector3(-7, .2f, -16)); ReadAct(2, null); Save(); SyncPoints();
        }
        public void ReturnHome()
        {
            if (!CanReturn || (ScrollUI.I && ScrollUI.I.IsBusy)) return;
            State.act = 5; ApplyReturn(); MovePlayer(new Vector3(0, 0.2f, -104)); Save(); SyncPoints();
        }
        void ReadAct(int act, Action done)
        {
            var cards = new List<ClueData>();
            foreach (var c in clues) if (c != null && !c.isEnding && c.act == act) cards.Add(c);
            if (cards.Count == 0) cards.Add(new ClueData { id = -act, act = act, title = "〔act" + act + "-原文〕", original = "〔act" + act + "-原文〕" });
            Reading = true; Hunger.Pause();
            ReadCard(cards, 0, done);
        }
        void ReadCard(List<ClueData> cards, int i, Action done)
        {
            if (i == cards.Count) { Reading = false; CurrentCard = null; if (done != null) done(); return; }
            CurrentCard = cards[i];
            ScrollUI.I.ShowClue(CurrentCard, () => ReadCard(cards, i + 1, done));
        }
        void SyncPoints()
        {
            if (minimap) minimap.SetAct(Act);
            Transform target = null;
            foreach (var pair in points)
            {
                string k = pair.Key;
                bool enabled = false;
                if (!State.ended)
                {
                    if (Act == 1 && k.StartsWith("Act1_Bark_")) enabled = (State.bark & (1 << (k[k.Length - 1] - '1'))) == 0;
                    if (Act == 2) enabled = k == (State.climbed ? "Act2_PeachTree" : "Act2_ClimbBase");
                    if (Act == 3 && k.StartsWith("Act3_Drift_")) enabled = !State.inferred && (State.drift & (1 << (k[k.Length - 1] - '1'))) == 0;
                    if (Act == 3 && k == "Act3_Wade") enabled = State.inferred;
                    if (Act == 4 && State.villageStep < 3) enabled = k == new[] { "Act4_Women", "Act4_House", "Act4_Board" }[State.villageStep];
                    if (Act == 4 && State.villageStep == 3) enabled = k == "Act4_Board";
                    if (Act == 5) enabled = k == "Act5_Return";
                }
                var prop = pair.Value.transform.Find("R2Prop");
                if (prop && k.StartsWith("Act4_")) prop.gameObject.SetActive(Act < 5);
                pair.Value.enabled = enabled;
                if (enabled && !target) target = pair.Value.transform;
                var visual = pair.Value.transform.Find("R1Marker");
                if (visual) visual.gameObject.SetActive(enabled);
            }
            if (minimap) minimap.SetTarget(target);
        }
        public void MovePlayer(Vector3 position)
        {
            var cc = Player.GetComponent<CharacterController>();
            cc.enabled = false; Player.transform.position = position; cc.enabled = true;
        }
        void Save() { State.position = Player.transform.position; PlayerPrefs.SetString(SaveKey, JsonUtility.ToJson(State)); PlayerPrefs.Save(); }
        void ApplyReturn()
        {
            if (seasons) seasons.SwapToHome();
        }
        void Toast(string text) { if (ScrollUI.I) ScrollUI.I.Toast(text); }
#if UNITY_EDITOR || DEVELOPMENT_BUILD
        public void DebugNextAct()
        {
            State.act = Mathf.Min(5, Act + 1);
            if (Act == 2) MovePlayer(new Vector3(-11, 0.2f, -31));
            if (Act == 3) MovePlayer(new Vector3(-5, 0.2f, -13));
            if (Act == 4) MovePlayer(new Vector3(0, 0.2f, 63));
            if (Act == 5) { ApplyReturn(); MovePlayer(new Vector3(0, 0.2f, -104)); }
            Save(); SyncPoints();
        }
#endif
    }
}
using UnityEngine;
using UnityEngine.UI;
using TMPro;

namespace Liuruan
{
    public sealed class HudUI : MonoBehaviour
    {
        public TMP_FontAsset font;
        public Sprite peachFull, peachHalf, peachEmpty, barkIcon, skillBark, skillWater, skillCall, portraitImage, portraitFrame;
        GameFlow flow;
        GameObject root, ending;
        Image[] peaches = new Image[5];
        Image cooldown;
        TMP_Text bark, objective, prompt;
        Button returnButton;
        Sprite circle;
        TMP_Text endingText, birds;
        EpilogueModel endingModel;
        int endingPage;
        readonly System.Collections.Generic.List<Button> endingOptions = new System.Collections.Generic.List<Button>();
        public void ShowBirds() { birdsUntil = Time.unscaledTime + 5; }
        float birdsUntil;
        void Start()
        {
            flow = GetComponent<GameFlow>();
            ScrollUI.I.JourneyHud = true;
            circle = Shape(0);
            var canvas = new GameObject("JourneyHUD", typeof(RectTransform), typeof(Canvas), typeof(CanvasScaler), typeof(GraphicRaycaster));
            canvas.transform.SetParent(transform, false);
            canvas.GetComponent<Canvas>().renderMode = RenderMode.ScreenSpaceOverlay;
            canvas.GetComponent<Canvas>().sortingOrder = 1;
            var scaler = canvas.GetComponent<CanvasScaler>();
            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
            scaler.referenceResolution = new Vector2(1280, 720); scaler.matchWidthOrHeight = 0.5f;
            root = canvas;
            for (int i = 0; i < 5; i++)
            {
                peaches[i] = Icon("Peach" + i, new Vector2(0, 1), new Vector2(38 + i * 38, -38), new Vector2(31, 35), peachFull, Color.white);
            }
            Icon("BarkIcon", new Vector2(0, 1), new Vector2(33, -78), new Vector2(30, 30), barkIcon, Color.white);
            bark = Label("Bark", new Vector2(0, 1), new Vector2(140, -78), new Vector2(180, 36), 25);
            objective = Label("Objective", new Vector2(0.5f, 1), new Vector2(0, -30), new Vector2(470, 42), 21);
            string[] names = { "剝皮", "取水", "呼喚" };
            string[] keys = { "F", "R", "G" };
            for (int i = 0; i < 3; i++)
            {
                int index = i;
                var image = Icon("Skill" + keys[i], new Vector2(1, 1), new Vector2(-218 + i * 82, -63), new Vector2(76, 76), new[] { skillBark, skillWater, skillCall }[i], Color.white);
                var button = image.gameObject.AddComponent<Button>();
                button.onClick.AddListener(() => flow.UseSkill(index));
                ChildLabel(image.transform, names[i] + "\n" + keys[i], 19);
            }
            var portrait = Icon("CompanionPortraitFrame", new Vector2(0, 0), new Vector2(75, 78), new Vector2(108, 108), portraitFrame, Color.white);
            cooldown = Icon("CallCooldown", new Vector2(0, 0), new Vector2(75, 78), new Vector2(108, 108), circle, new Color(0.96f, 0.72f, 0.3f));
            cooldown.type = Image.Type.Filled; cooldown.fillMethod = Image.FillMethod.Radial360; cooldown.fillClockwise = true;
            Icon("CompanionPortrait", new Vector2(0, 0), new Vector2(75, 78), new Vector2(88, 88), portraitImage, Color.white);
            portrait.transform.SetAsLastSibling();
            var map = Icon("MinimapFrame", new Vector2(1, 0), new Vector2(-104, 104), new Vector2(184, 184), null, Color.clear);
            if (flow.minimap) flow.minimap.HudFrame = (RectTransform)map.transform;
            prompt = Label("InteractPrompt", new Vector2(0.5f, 0), new Vector2(0, 84), new Vector2(450, 42), 26);
            returnButton = ActionButton("ReturnHome", "求歸", new Vector2(0.5f, 0), new Vector2(0, 145), new Vector2(160, 52));
            returnButton.onClick.AddListener(flow.ReturnHome);
            birds = Label("Birds", new Vector2(.5f, 1), new Vector2(0, -80), new Vector2(250, 36), 21);
            birds.text = "百鳥啼鳴";
            ending = new GameObject("JourneyEnding", typeof(RectTransform), typeof(Image));
            ending.transform.SetParent(root.transform, false);
            var er = (RectTransform)ending.transform; er.anchorMin = new Vector2(0.05f, 0.05f); er.anchorMax = new Vector2(0.95f, 0.95f); er.offsetMin = er.offsetMax = Vector2.zero;
            ending.GetComponent<Image>().color = new Color(0.13f, 0.18f, 0.22f, 0.98f);
            endingText = ChildLabel(ending.transform, "", 25);
            var textRect = (RectTransform)endingText.transform;
            textRect.offsetMin = new Vector2(35, 100); textRect.offsetMax = new Vector2(-35, -30);
            endingText.alignment = TextAlignmentOptions.TopLeft;
            EndingButton("EndingPrev", "上一頁", new Vector2(-130, 40), () => TurnEnding(-1));
            EndingButton("EndingNext", "下一頁", new Vector2(130, 40), () => TurnEnding(1));
            for (int i = 0; i < 3; i++)
            {
                int answer = i;
                var button = EndingButton("EndingOption" + i, "", new Vector2(0, 340 - i * 90), () => AnswerEnding(answer));
                ((RectTransform)button.transform).sizeDelta = new Vector2(950, 75);
                endingOptions.Add(button);
            }
            ending.SetActive(flow.State.ended);
            flow.Hunger.OnChanged += DrawHunger; DrawHunger(flow.Hunger.Value);
            if (flow.State.ended) ShowEnding();
        }
        void OnDestroy()
        {
            if (flow && flow.Hunger) flow.Hunger.OnChanged -= DrawHunger;
            foreach (var sprite in new[] { circle }) if (sprite) { Destroy(sprite.texture); Destroy(sprite); }
        }
        void DrawHunger(float value)
        {
            for (int i = 0; i < 5; i++)
            {
                float fill = Mathf.Clamp01(value - i);
                peaches[i].sprite = fill >= 1 ? peachFull : fill > 0 ? peachHalf : peachEmpty;
                peaches[i].color = Color.white;
            }
        }
        void LateUpdate()
        {
            if (!root) return;
            bool busy = flow.Reading || (ScrollUI.I && ScrollUI.I.IsBusy);
            for (int i = 0; i < root.transform.childCount; i++)
            {
                var child = root.transform.GetChild(i).gameObject;
                if (child != ending) child.SetActive(!busy && !flow.State.ended);
            }
            bark.text = "穀皮 ×" + flow.BarkCount;
            objective.text = flow.Objective;
            cooldown.fillAmount = flow.Companion.CooldownRatio;
            var near = Interactable.Nearest(flow.Player.transform.position);
            prompt.text = near ? (TouchInput.Enabled ? "互動　" : "[E] ") + near.prompt : "";
            returnButton.gameObject.SetActive(flow.CanReturn && !busy);
            birds.gameObject.SetActive(!flow.State.ended && Time.unscaledTime < birdsUntil);
            if (TouchInput.Enabled)
            {
                var p = (RectTransform)cooldown.transform; p.anchoredPosition = new Vector2(75, 250);
                root.transform.Find("CompanionPortrait").GetComponent<RectTransform>().anchoredPosition = p.anchoredPosition;
                root.transform.Find("CompanionPortraitFrame").GetComponent<RectTransform>().anchoredPosition = p.anchoredPosition;
            }
        }
        public void ShowEnding()
        {
            if (!ending) return;
            endingModel = flow.EndingModel();
            if (endingModel == null) return;
            endingPage = 0; DrawEnding(); ending.SetActive(true);
            if (ScrollUI.I) ScrollUI.I.ExternalUI = true;
        }
        Button EndingButton(string name, string text, Vector2 position, UnityEngine.Events.UnityAction action)
        {
            var button = ActionButton(name, text, new Vector2(.5f, 0), position, new Vector2(210, 50));
            button.transform.SetParent(ending.transform, false); button.onClick.AddListener(action); return button;
        }
        void TurnEnding(int delta)
        { endingPage = Mathf.Clamp(endingPage + delta, 0, endingModel.Paragraphs.Count + endingModel.Comparison.Count + 1); DrawEnding(); }
        void DrawEnding()
        {
            int paragraphs = endingModel.Paragraphs.Count;
            foreach (var button in endingOptions) button.gameObject.SetActive(endingPage == paragraphs);
            if (endingPage < paragraphs) endingText.text = "全文　" + (endingPage + 1) + "／" + paragraphs + "\n\n" + endingModel.Paragraphs[endingPage];
            else if (endingPage == paragraphs)
            {
                endingText.text = endingModel.Question.Prompt;
                for (int i = 0; i < endingOptions.Count; i++) endingOptions[i].GetComponentInChildren<TMP_Text>().text = endingModel.Question.Options[i];
            }
            else if (endingPage <= paragraphs + endingModel.Comparison.Count)
            {
                var row = endingModel.Comparison[endingPage - paragraphs - 1];
                endingText.text = "與〈桃花源記〉比較　" + (endingPage - paragraphs) + "／" + endingModel.Comparison.Count + "\n\n" + row.Aspect + "\n\n〈劉晨阮肇入天台〉\n" + row.Liuruan + "\n\n〈桃花源記〉\n" + row.Taohua;
            }
            else
            {
                var score = endingModel.Score;
                endingText.text = "成績卡\n\n穀皮 " + score.BarkCount + "／5\n漂流物 " + score.DriftCount + "／3\n閱讀首答 " + score.ReadingCorrect + "／" + score.ReadingTotal + "（" + (score.ReadingAccuracy * 100).ToString("F0") + "%）\n有效遊玩 " + score.TotalSeconds.ToString("F0") + " 秒";
            }
        }
        void AnswerEnding(int answer)
        {
            bool correct = answer == endingModel.Question.AnswerIndex;
            QuizStats.Record(QuizStats.InferId, correct);
            endingText.text = endingModel.Question.Prompt + "\n" + (correct ? "答對了。" : "再想一想。") + "\n" + endingModel.Question.Explanation;
        }
        Image Icon(string name, Vector2 anchor, Vector2 pos, Vector2 size, Sprite sprite, Color color)
        {
            var go = new GameObject(name, typeof(RectTransform), typeof(Image));
            go.transform.SetParent(root.transform, false);
            var r = (RectTransform)go.transform; r.anchorMin = r.anchorMax = anchor; r.anchoredPosition = pos; r.sizeDelta = size;
            var img = go.GetComponent<Image>(); img.sprite = sprite; img.color = color; img.raycastTarget = name.StartsWith("Skill"); return img;
        }
        TMP_Text Label(string name, Vector2 anchor, Vector2 pos, Vector2 size, int fontSize)
        {
            var img = Icon(name, anchor, pos, size, null, new Color(0.08f, 0.13f, 0.11f, 0.8f));
            return ChildLabel(img.transform, "", fontSize);
        }
        TMP_Text ChildLabel(Transform parent, string text, int size)
        {
            var go = new GameObject("Label", typeof(RectTransform), typeof(TextMeshProUGUI)); go.transform.SetParent(parent, false);
            var r = (RectTransform)go.transform; r.anchorMin = Vector2.zero; r.anchorMax = Vector2.one; r.offsetMin = new Vector2(4, 4); r.offsetMax = new Vector2(-4, -4);
            var label = go.GetComponent<TextMeshProUGUI>(); label.font = font; label.text = text; label.fontSize = size;
            label.alignment = TextAlignmentOptions.Center; label.raycastTarget = false; return label;
        }
        Button ActionButton(string name, string text, Vector2 anchor, Vector2 pos, Vector2 size)
        {
            var image = Icon(name, anchor, pos, size, null, new Color(0.35f, 0.4f, 0.24f)); image.raycastTarget = true;
            var button = image.gameObject.AddComponent<Button>(); ChildLabel(image.transform, text, 25); return button;
        }
        static Sprite Shape(int shape)
        {
            var tex = new Texture2D(64, 64, TextureFormat.RGBA32, false);
            var pixels = new Color[4096];
            for (int y = 0; y < 64; y++) for (int x = 0; x < 64; x++)
            {
                float a = (x - 31.5f) / 30f, b = (y - 31.5f) / 30f;
                float q = a * a + b * b - 0.75f;
                bool inside = shape == 0 ? a * a + b * b <= 1 : shape == 2 ? Mathf.Abs(a) + Mathf.Abs(b) <= 1 : q * q * q - a * a * b * b * b <= 0;
                pixels[y * 64 + x] = inside ? Color.white : Color.clear;
            }
            tex.SetPixels(pixels); tex.Apply(); return Sprite.Create(tex, new Rect(0, 0, 64, 64), new Vector2(0.5f, 0.5f));
        }
    }
}
using System;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace Liuruan
{
    /// clues.json 的閱讀、問答與進度資料。
    /// JsonUtility 缺欄位時給預設值（字串 null、陣列 null），一律用下面的唯讀屬性判斷。
    [Serializable]
    public class ClueData
    {
        public int id;
        public int act;
        public string title;
        public string original;
        public string plain;
        public string question;
        public string[] options;
        public int answer;
        public string feedback;
        public string[] wrongHints;

        public bool isEnding;     // 選填：結局卷軸（沒有任何一筆標記時，退回「最大 id＝結局」）
        public int[] requires;    // 選填：這些線索收齊前鎖住（標記灰色、靠近時提示「先去看看〇〇」）

        /// 題目及答案索引完整時才出題。
        public bool HasQuiz => !string.IsNullOrEmpty(question) && options != null && options.Length > 0
                               && answer >= 0 && answer < options.Length;

    }

    /// 頂層 "evidenceCards" 的一張：結局推論題前顯示（只顯示已收集線索的卡）
    [Serializable]
    public class EvidenceCard
    {
        public int clueId;
        public string label;
        public string quote;
    }

    /// 頂層 "reflection"：不計分的反思題
    [Serializable]
    public class Reflection
    {
        public string question;
        public string[] prompts;
    }

    [Serializable]
    class ClueList
    {
        public ClueData[] clues;
        public ClueData infer;      // 選填：結局後的推論題；沒填就不出（結局線索本身可當推論題）
        public string endingText;   // 選填：作者／人物揭曉文字；沒填用 Txt.EndingReveal
        public EvidenceCard[] evidenceCards; // 選填
        public Reflection reflection;        // 選填
    }

    /// 線索資料（clues.json）＋進度（PlayerPrefs）。
    /// 有 requires 的線索要等列出的線索都收齊才開。
    public class ClueManager : MonoBehaviour
    {
        const string SaveKey = "liuruan_collected";

        public static ClueManager I { get; private set; }
        /// 結局線索 id（資料中最大 id）；QuizStats 以它推算推論題 id
        public static int EndingId { get; private set; }
        public static bool IsEnding(int id) => id == EndingId;

        [SerializeField] TextAsset clueJson;
        [SerializeField] ScrollUI ui;
        [SerializeField] Material markerMat; // 線索標記用（URP Unlit）
        public Material MarkerMat => markerMat; // R17 任務關卡標記共用

        ClueData[] clues = new ClueData[0];
        ClueData inferData;
        string endingText;
        EvidenceCard[] evidenceCards = new EvidenceCard[0];
        Reflection reflection;
        readonly HashSet<int> collected = new HashSet<int>();
        // id → 線索。ClueMarker 每幀呼叫 IsLocked → Find；舊版 Array.Find 帶捕獲 lambda，每次呼叫都配置記憶體（審查 #17）
        readonly Dictionary<int, ClueData> byId = new Dictionary<int, ClueData>();

        public IReadOnlyList<ClueData> Clues => clues;
        public bool IsCollected(int id) => collected.Contains(id);
        public bool FirstScrollPending => clues.Length > 0 && !collected.Contains(clues[0].id);
        public ClueData Find(int id) => byId.TryGetValue(id, out var c) ? c : null;
        public ClueData InferData => inferData;
        public string EndingText => string.IsNullOrEmpty(endingText) ? Txt.EndingReveal : endingText;
        /// 反思題（沒填 question 時為 null）
        public Reflection ReflectionData => reflection;

        /// 已收集線索的證據卡（依 clueId 排序）
        public List<EvidenceCard> CollectedEvidence()
        {
            var list = new List<EvidenceCard>();
            foreach (var e in evidenceCards)
                if (e != null && collected.Contains(e.clueId) && (!string.IsNullOrEmpty(e.label) || !string.IsNullOrEmpty(e.quote)))
                    list.Add(e);
            list.Sort((a, b) => a.clueId.CompareTo(b.clueId));
            return list;
        }

        // 以下計數每幀被 HUD／ClueMarker 呼叫：用迴圈，不用捕獲 this 的 lambda 或方法群組（每次都會配置委派）
        /// 結局以外的線索數（HUD「線索冊 x／N」）
        public int ScrollCount { get { int n = 0; foreach (var c in clues) if (c.id != EndingId) n++; return n; } }
        public int ScrollsCollected { get { int n = 0; foreach (var c in clues) if (c.id != EndingId && collected.Contains(c.id)) n++; return n; } }
        public bool EndingUnlocked => ScrollsCollected == ScrollCount;


        /// ClueMarker 每幀呼叫：只回布林、不產生字串
        public bool IsLocked(int id)
        {
            if (id == EndingId) return !EndingUnlocked;
            var c = Find(id);
            return c != null && (MissingRequirement(c) != null);
        }

        /// requires 裡第一張還沒收集的線索；都收齊回傳 null。
        /// 會造成永久鎖死的條件一律略過（check.py 也會擋，這裡是 C# 端防呆，審查 #16）：
        public ClueData MissingRequirement(ClueData c)
        {
            if (c == null || c.requires == null) return null;
            foreach (int r in c.requires)
            {
                if (r == c.id || r == EndingId || collected.Contains(r)) continue;
                var rc = Find(r);
                if (rc == null) continue;
                return rc;
            }
            return null;
        }

        /// 鎖住時的提示；沒鎖回傳 null
        string LockedMessage(int id)
        {
            if (id == EndingId) return EndingUnlocked ? null : Txt.EndingLocked(ScrollsCollected, ScrollCount);
            var c = Find(id);
            if (c == null) return null;
            var miss = MissingRequirement(c);
            return miss != null ? Txt.RequiresLocked(miss.title) : null;
        }

        /// 算進成績的題目：一般選擇題、配對關（以配對後選擇題首答計）、
        /// 有選擇題的小遊戲（小遊戲後由 ScrollUI 出題）、推論題（有 infer 區塊時）。
        public bool IsScored(int id)
        {
            if (id == QuizStats.InferId) return inferData != null;
            var c = Find(id);
            return c != null && c.HasQuiz;
        }

        public string LabelOf(ClueData c)
        {
            if (c.id == EndingId) return Txt.EndingTag;
            int n = 0;
            foreach (var x in clues) if (x.id != EndingId && x.id < c.id) n++;
            return Txt.RollPrefix + (n < Txt.Numerals.Length ? Txt.Numerals[n].ToString() : (n + 1).ToString());
        }


        void Awake()
        {
            I = this;
            if (clueJson == null) Debug.LogError("[ClueManager] 沒有指定 clues.json");
            else
            {
                var list = JsonUtility.FromJson<ClueList>(clueJson.text);
                if (list != null)
                {
                    clues = list.clues ?? new ClueData[0];
                    inferData = list.infer != null && !string.IsNullOrEmpty(list.infer.question) ? list.infer : null;
                    endingText = list.endingText;
                    if (list.evidenceCards != null) evidenceCards = list.evidenceCards;
                    reflection = list.reflection != null && !string.IsNullOrEmpty(list.reflection.question) ? list.reflection : null;
                }
            }
            Array.Sort(clues, (a, b) => a.id.CompareTo(b.id));
            byId.Clear();
            foreach (var c in clues) if (c != null && !byId.ContainsKey(c.id)) byId[c.id] = c;
            var flagged = Array.Find(clues, c => c.isEnding);
            EndingId = flagged != null ? flagged.id : clues.Length > 0 ? clues[clues.Length - 1].id : 0;
            foreach (var s in PlayerPrefs.GetString(SaveKey, "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                if (int.TryParse(s, out int v)) collected.Add(v);
        }

        void Start()
        {
            foreach (var it in Interactable.All)
                if (it.clueId >= 0) ClueMarker.Create(it, markerMat);
            // 不自動跳題：先讓玩家自由走動，用一句話指出第一步
            if (collected.Count == 0 && !ScrollUI.DeferHelp) Invoke(nameof(StartOpening), 1f);
        }

        void StartOpening() { if (ui) ui.Toast(Txt.Opening); }
        /// R17：選經典模式後才放開場提示
        public void ShowOpening() { if (collected.Count == 0) Invoke(nameof(StartOpening), 0.5f); }

        public void TriggerClue(int id)
        {
            var locked = LockedMessage(id);
            if (locked != null) { ui.Toast(locked); return; }
            var clue = Find(id);
            if (clue == null) { Debug.LogWarning($"[ClueManager] clues.json 沒有 id={id}"); return; }
            if (IsCollected(id))
                ui.ShowClue(clue, () => { }, true); // 已收集：直接重讀，不重播演出
            else if (id == EndingId) ui.StartEnding(clue, () => Collect(id));
            else ui.ShowClue(clue, () => Collect(id));
        }

        void Collect(int id)
        {
            if (!collected.Add(id)) return;
            PlayerPrefs.SetString(SaveKey, string.Join(",", collected));
            PlayerPrefs.Save();
            if (id == EndingId) return;
            string msg = EndingUnlocked ? Txt.EndingReady : null;
            if (clues.Length > 0 && id == clues[0].id) msg = Txt.FirstScrollComplete;
            StartCoroutine(NextStopToast(msg));
        }

        System.Collections.IEnumerator NextStopToast(string msg)
        {
            yield return null;
            for (float t = 0; t < 30f && ScrollUI.I && ScrollUI.I.IsBusy; t += Time.unscaledDeltaTime) yield return null;
            string text = msg;
            if (string.IsNullOrEmpty(text)) yield break;
            ui.Toast(text);
        }

        public void ResetProgress()
        {
            PlayerPrefs.DeleteKey(SaveKey);
            QuizStats.Clear();
            PlayerPrefs.DeleteKey(ScrollUI.HelpSeenKey); // 共用電腦：下一位學生重新開始也看得到操作說明
            PlayerPrefs.Save();
            SceneManager.LoadScene(SceneManager.GetActiveScene().name);
        }
    }
}
