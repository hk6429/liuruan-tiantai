            var map = Icon("MinimapFrame", new Vector2(1, 0), new Vector2(-104, 104), new Vector2(184, 184), null, Color.clear);
            if (flow.minimap) flow.minimap.HudFrame = (RectTransform)map.transform;
            prompt = Label("InteractPrompt", new Vector2(0.5f, 0), new Vector2(0, 84), new Vector2(450, 42), 26);
            returnButton = ActionButton("ReturnHome", "求歸", new Vector2(0.5f, 0), new Vector2(0, 145), new Vector2(160, 52));
            returnButton.onClick.AddListener(flow.ReturnHome);
            birds = Label("Birds", new Vector2(.5f, 1), new Vector2(0, -80), new Vector2(250, 36), 21);
            birds.text = "百鳥啼鳴";
            ending = new GameObject("JourneyEnding", typeof(RectTransform), typeof(Image));
            ending.transform.SetParent(root.transform, false);
            var er = (RectTransform)ending.transform; er.anchorMin = new Vector2(0.05f, 0.05f); er.anchorMax = new Vector2(0.95f, 0.95f); er.offsetMin = er.offsetMax = Vector2.zero;
            ending.GetComponent<Image>().color = new Color(0.13f, 0.18f, 0.22f, 0.98f);
            endingText = ChildLabel(ending.transform, "", 25);
            var textRect = (RectTransform)endingText.transform;
            textRect.offsetMin = new Vector2(35, 100); textRect.offsetMax = new Vector2(-35, -30);
            endingText.alignment = TextAlignmentOptions.TopLeft;
            EndingButton("EndingPrev", "上一頁", new Vector2(-130, 40), () => TurnEnding(-1));
            EndingButton("EndingNext", "下一頁", new Vector2(130, 40), () => TurnEnding(1));
            for (int i = 0; i < 3; i++)
            {
                int answer = i;
                var button = EndingButton("EndingOption" + i, "", new Vector2(0, 340 - i * 90), () => AnswerEnding(answer));
                ((RectTransform)button.transform).sizeDelta = new Vector2(950, 75);
                endingOptions.Add(button);
            }
            ending.SetActive(flow.State.ended);
            flow.Hunger.OnChanged += DrawHunger; DrawHunger(flow.Hunger.Value);
            if (flow.State.ended) ShowEnding();
        }
        void OnDestroy()
        {
            if (flow && flow.Hunger) flow.Hunger.OnChanged -= DrawHunger;
            foreach (var sprite in new[] { circle }) if (sprite) { Destroy(sprite.texture); Destroy(sprite); }
        }
        void DrawHunger(float value)
        {
            for (int i = 0; i < 5; i++)
            {
                float fill = Mathf.Clamp01(value - i);
                peaches[i].sprite = fill >= 1 ? peachFull : fill > 0 ? peachHalf : peachEmpty;
                peaches[i].color = Color.white;
            }
        }
        void LateUpdate()
        {
            if (!root) return;
            bool busy = flow.Reading || (ScrollUI.I && ScrollUI.I.IsBusy);
            for (int i = 0; i < root.transform.childCount; i++)
            {
                var child = root.transform.GetChild(i).gameObject;
                if (child != ending) child.SetActive(!busy && !flow.State.ended);
            }
            bark.text = "穀皮 ×" + flow.BarkCount;
            objective.text = flow.Objective;
            cooldown.fillAmount = flow.Companion.CooldownRatio;
            var near = Interactable.Nearest(flow.Player.transform.position);
            prompt.text = near ? (TouchInput.Enabled ? "互動　" : "[E] ") + near.prompt : "";
            returnButton.gameObject.SetActive(flow.CanReturn && !busy);
            birds.gameObject.SetActive(!flow.State.ended && Time.unscaledTime < birdsUntil);
            if (TouchInput.Enabled)
            {
                var p = (RectTransform)cooldown.transform; p.anchoredPosition = new Vector2(75, 250);
                root.transform.Find("CompanionPortrait").GetComponent<RectTransform>().anchoredPosition = p.anchoredPosition;
                root.transform.Find("CompanionPortraitFrame").GetComponent<RectTransform>().anchoredPosition = p.anchoredPosition;
            }
        }
        public void ShowEnding()
        {
            if (!ending) return;
            endingModel = flow.EndingModel();
            if (endingModel == null) return;
            endingPage = 0; DrawEnding(); ending.SetActive(true);
            if (ScrollUI.I) ScrollUI.I.ExternalUI = true;
        }
        Button EndingButton(string name, string text, Vector2 position, UnityEngine.Events.UnityAction action)
        {
            var button = ActionButton(name, text, new Vector2(.5f, 0), position, new Vector2(210, 50));
            button.transform.SetParent(ending.transform, false); button.onClick.AddListener(action); return button;
        }
        void TurnEnding(int delta)
        { endingPage = Mathf.Clamp(endingPage + delta, 0, endingModel.Paragraphs.Count + endingModel.Comparison.Count + 1); DrawEnding(); }
        void DrawEnding()
        {
            int paragraphs = endingModel.Paragraphs.Count;
            foreach (var button in endingOptions) button.gameObject.SetActive(endingPage == paragraphs);
            if (endingPage < paragraphs) endingText.text = "全文　" + (endingPage + 1) + "／" + paragraphs + "\n\n" + endingModel.Paragraphs[endingPage];
            else if (endingPage == paragraphs)
            {
                endingText.text = endingModel.Question.Prompt;
                for (int i = 0; i < endingOptions.Count; i++) endingOptions[i].GetComponentInChildren<TMP_Text>().text = endingModel.Question.Options[i];
            }
            else if (endingPage <= paragraphs + endingModel.Comparison.Count)
            {
                var row = endingModel.Comparison[endingPage - paragraphs - 1];
                endingText.text = "與〈桃花源記〉比較　" + (endingPage - paragraphs) + "／" + endingModel.Comparison.Count + "\n\n" + row.Aspect + "\n\n〈劉晨阮肇入天台〉\n" + row.Liuruan + "\n\n〈桃花源記〉\n" + row.Taohua;
            }
            else
            {
                var score = endingModel.Score;
                endingText.text = "成績卡\n\n穀皮 " + score.BarkCount + "／5\n漂流物 " + score.DriftCount + "／3\n閱讀首答 " + score.ReadingCorrect + "／" + score.ReadingTotal + "（" + (score.ReadingAccuracy * 100).ToString("F0") + "%）\n有效遊玩 " + score.TotalSeconds.ToString("F0") + " 秒";
            }
        }
        void AnswerEnding(int answer)
        {
            bool correct = answer == endingModel.Question.AnswerIndex;
            QuizStats.Record(QuizStats.InferId, correct);
            endingText.text = endingModel.Question.Prompt + "\n" + (correct ? "答對了。" : "再想一想。") + "\n" + endingModel.Question.Explanation;
        }
        Image Icon(string name, Vector2 anchor, Vector2 pos, Vector2 size, Sprite sprite, Color color)
        {
            var go = new GameObject(name, typeof(RectTransform), typeof(Image));
            go.transform.SetParent(root.transform, false);
            var r = (RectTransform)go.transform; r.anchorMin = r.anchorMax = anchor; r.anchoredPosition = pos; r.sizeDelta = size;
            var img = go.GetComponent<Image>(); img.sprite = sprite; img.color = color; img.raycastTarget = name.StartsWith("Skill"); return img;
        }
        TMP_Text Label(string name, Vector2 anchor, Vector2 pos, Vector2 size, int fontSize)
        {
            var img = Icon(name, anchor, pos, size, null, new Color(0.08f, 0.13f, 0.11f, 0.8f));
            return ChildLabel(img.transform, "", fontSize);
        }
        TMP_Text ChildLabel(Transform parent, string text, int size)
        {
            var go = new GameObject("Label", typeof(RectTransform), typeof(TextMeshProUGUI)); go.transform.SetParent(parent, false);
            var r = (RectTransform)go.transform; r.anchorMin = Vector2.zero; r.anchorMax = Vector2.one; r.offsetMin = new Vector2(4, 4); r.offsetMax = new Vector2(-4, -4);
            var label = go.GetComponent<TextMeshProUGUI>(); label.font = font; label.text = text; label.fontSize = size;
            label.alignment = TextAlignmentOptions.Center; label.raycastTarget = false; return label;
        }
        Button ActionButton(string name, string text, Vector2 anchor, Vector2 pos, Vector2 size)
        {
            var image = Icon(name, anchor, pos, size, null, new Color(0.35f, 0.4f, 0.24f)); image.raycastTarget = true;
            var button = image.gameObject.AddComponent<Button>(); ChildLabel(image.transform, text, 25); return button;
        }
        static Sprite Shape(int shape)
        {
            var tex = new Texture2D(64, 64, TextureFormat.RGBA32, false);
            var pixels = new Color[4096];
            for (int y = 0; y < 64; y++) for (int x = 0; x < 64; x++)
            {
                float a = (x - 31.5f) / 30f, b = (y - 31.5f) / 30f;
                float q = a * a + b * b - 0.75f;
                bool inside = shape == 0 ? a * a + b * b <= 1 : shape == 2 ? Mathf.Abs(a) + Mathf.Abs(b) <= 1 : q * q * q - a * a * b * b * b <= 0;
                pixels[y * 64 + x] = inside ? Color.white : Color.clear;
            }
            tex.SetPixels(pixels); tex.Apply(); return Sprite.Create(tex, new Rect(0, 0, 64, 64), new Vector2(0.5f, 0.5f));
        }
    }
}
# C 線 R3：故事卡、任務、提示、對話、逐句白話、注釋、題目

先讀 AGENTS.md（**R3 起可加簡短白話提示對話**，規則在鐵律）、docs/r3-diagnosis.md（四專家診斷）、docs/plan.md、sources/liuruan_tw.txt、sources/variants.md、docs/content/acts.md、glossary.md、compare_taohuayuan.md、Assets/_Project/Data/*.json（只讀）。只能寫 docs/content/r3/ 與 tools/check_r3.py。不開 Unity。交件報告 docs/content/r3/C-R3.md。

原則：
- 原文引用一律逐字照 liuruan_tw.txt（type="original"）。
- 白話（type="plain"）每句 ≤20 字，給沒讀過故事的國中生，不得新增原文沒有的情節；留宿段照 AGENTS.md 略過，只用「遂停半年」。
- 地名器物照原文：筒瓦屋（不是銅）、度山出一大溪（不是涉水）、百鳥鳴呼（不是啼鳴）。「洞中方七日，世上已千年」不是本篇原文，出現時要標明「後人俗語」。
- 遊戲裡**沒有告示板**了（R3b 會移除），第四幕改由二女與屋內事件推進。

## 要交的檔案（JSON 用 UTF-8，格式照寫，S 線會照這個讀）
1. `story_card.json`：開場故事卡 3–4 張（每張 ≤45 字，含人物、時代「漢明帝永平五年」、剡縣、入天台山取穀皮、迷路十三日糧盡；最後一張「你是劉晨，阮肇在你身旁」＋目標）。格式 `{"cards":[{"text":"…","orig":"可選，原文句"}]}`。
2. `objectives.json`：五幕每一步 `{goal, why, where, count}`（格式見 briefs/S-R3.md 第 3 點）。第四幕步驟改成：見溪邊二女 → 跟二女回家 → 屋內款待 → 群女來賀 → （遂停半年）→ 聽見百鳥鳴呼 → 求歸。第五幕：回到村口 → 找人問 → 見七世孫。
3. `hints.json`：每幕每步 30/60/90 秒三級提示，desktop 與 touch 各一版（touch 用「搖桿」「互動鈕」）。`{"acts":[{"act":1,"steps":[{"id":"bark","l1":{"desktop":"…","touch":"…"},"l2":{…},"l3":{…}}]}]}`。l3 是阮肇說的話（例如「跟我來，這邊！」）。
4. `dialogue.json`（格式見 S-R3 第 2 點）：
   - 每幕開頭 1–2 句劉阮白話對話（帶出目標）。
   - 第三幕撿到漂流物時的原文半句＋推論（「此知去人徑不遠」逐字）。
   - 第四幕：二女原文台詞全部（呼姓、「劉、阮二郎捉向所失流杯來」、「來何晚耶」、款待「敕云」、群女「賀汝婿來」、求歸時女子的原文回應），劉阮的白話反應（例如「她們怎麼認得我們？」對應「晨、肇既不識之」）、奏樂送行。
   - 第五幕：七世孫——原文是「問得七世孫，傳聞上世入山，迷不得歸」，七世孫台詞用白話轉述並附原文。
   每個 scene 給 trigger（例如 `act_start:1`、`interact:Act4_Women`、`interact:Act4_House`、`after:half_year`、`interact:Act5_Grandson`）。
5. `narration.json`（取代現行版）：每幕開頭先顯示**原文關鍵句**再接白話一句。格式 `{"acts":[{"act":1,"lines":[{"text":"…","type":"original"},{"text":"…","type":"plain"}]}]}`。
6. `sentences.json`：全文 7 段逐句切開，每句 orig＋plain＋terms（格式見 S-R3 第 6 點）。
7. `glossary_cards.json`：把 glossary.md 40 條轉成 `{term, reading, meaning}`；「要」讀ㄧㄠ；sentences 用到的 terms 都要在這裡。
8. `questions_r3.json`：補 4 題理解型三選一（一詞多義「去」、二女呼名暗示什麼、「忻怖交並」喜什麼怕什麼、「瓊實」前後呼應），格式沿用 clues.json 題目欄位；並寫明 clues.json:127 與 EpilogueCore 推論題重複，建議保留哪一題。
9. `epilogue_guide.json`：結局導讀 3–4 頁（半年 vs 七世、為什麼是七世孫、與〈桃花源記〉一句比較、俗語標註），每頁 ≤60 字。
10. `tools/check_r3.py`：檢查所有 type=original 的字串都在 liuruan_tw.txt 逐字找到（或在 variants.md）、plain ≤20 字（故事卡／導讀依各自上限）、禁用字（銅瓦、涉水、啼鳴、告示板）不出現、sentences 的 terms 都在 glossary_cards。實跑輸出貼報告。
using System;

namespace Liuruan
{
    public readonly struct WorldPosition
    {
        public readonly float X, Y, Z;
        public WorldPosition(float x, float y, float z)
        {
            HungerCore.RequireFinite(x, nameof(x));
            HungerCore.RequireFinite(y, nameof(y));
            HungerCore.RequireFinite(z, nameof(z));
            X = x; Y = y; Z = z;
        }
        public static double Distance(WorldPosition a, WorldPosition b)
        {
            double x = (double)a.X - b.X, y = (double)a.Y - b.Y, z = (double)a.Z - b.Z;
            return Math.Sqrt(x * x + y * y + z * z);
        }
    }

    public enum CompanionState { Follow, Idle, Catchup, Teleport }

    public sealed class CompanionCore
    {
        public const float CallCooldownSeconds = 8f;
        public CompanionState State { get; private set; } = CompanionState.Idle;
        public WorldPosition Destination { get; private set; }
        public float CooldownRatio => (float)(cooldown / CallCooldownSeconds);
        private double cooldown;
        private double stuckSeconds;
        private WorldPosition progressAnchor;
        private bool trackingProgress;
        private bool called;

        public bool Call()
        {
            if (cooldown > 0) return false;
            cooldown = CallCooldownSeconds;
            called = true;
            return true;
        }

        public CompanionState Tick(float deltaSeconds, WorldPosition player,
            WorldPosition companion, WorldPosition playerForward)
        {
            HungerCore.RequireFinite(deltaSeconds, nameof(deltaSeconds));
            if (deltaSeconds < 0) throw new ArgumentOutOfRangeException(nameof(deltaSeconds));
            cooldown = Math.Max(0, cooldown - deltaSeconds);
            double distance = WorldPosition.Distance(player, companion);
            Destination = player;
            if (distance < 2.5)
            {
                State = CompanionState.Idle;
                called = false;
                ResetProgress();
                return State;
            }

            if (!trackingProgress || WorldPosition.Distance(progressAnchor, companion) >= 0.05)
            {
                progressAnchor = companion;
                stuckSeconds = 0;
                trackingProgress = true;
            }
            else stuckSeconds += deltaSeconds;

            if (distance > 30 || stuckSeconds >= 3)
            {
                // 只取水平朝向，避免玩家上下坡時把夥伴放進地底。
                double length = Math.Sqrt((double)playerForward.X * playerForward.X +
                    (double)playerForward.Z * playerForward.Z);
                float x = length > 0 ? (float)(playerForward.X / length) : 0f;
                float z = length > 0 ? (float)(playerForward.Z / length) : 1f;
                Destination = new WorldPosition(player.X - 2 * x, player.Y, player.Z - 2 * z);
                State = CompanionState.Teleport;
                called = false;
                ResetProgress();
            }
            else State = distance > 12 || called ? CompanionState.Catchup : CompanionState.Follow;
            return State;
        }

        private void ResetProgress()
        {
            trackingProgress = false;
            stuckSeconds = 0;
        }
    }
}
using System;
using System.IO;
using NUnit.Framework;

namespace Liuruan.Tests
{
    public sealed class SeasonCoreTests
    {
        [TestCase(0f, Season.Spring, Season.Summer)]
        [TestCase(.25f, Season.Summer, Season.Autumn)]
        [TestCase(.5f, Season.Autumn, Season.Winter)]
        [TestCase(.75f, Season.Winter, Season.Spring)]
        [TestCase(1f, Season.Spring, Season.Summer)]
        public void ExactBoundaries(float progress, Season current, Season next)
        {
            var b = SeasonCore.Sample(progress);
            Check.Equal(current, b.Current); Check.Equal(next, b.Next); Check.Near(0, b.Weight);
        }
        private static double Mix(float progress)
        {
            var b = SeasonCore.Sample(progress);
            double[] palette = { .2, .8, .4, .1 };
            return palette[(int)b.Current] * (1 - b.Weight) + palette[(int)b.Next] * b.Weight;
        }
        [Test] public void WeightsAndBlendedValuesAreContinuousAcrossEveryBoundary()
        {
            foreach (float boundary in new[] { .25f, .5f, .75f, 1f })
            {
                Check.Near(Mix(boundary), Mix(boundary - .000001f));
                if (boundary < 1) Check.Near(Mix(boundary), Mix(boundary + .000001f));
            }
            for (int i = 0; i < 1000; i++)
            {
                var b = SeasonCore.Sample(i / 1000f);
                Check.Equal(true, b.Weight >= 0 && b.Weight <= 1);
            }
            Check.Near(.5, SeasonCore.Sample(.125f).Weight);
            Check.Equal(Season.Spring, SeasonCore.Sample(-1).Current);
            Check.Equal(Season.Spring, SeasonCore.Sample(2).Current);
        }
        [Test] public void SixSecondsEndsInSpringAndBirdsOnlyOnceEvenWithReentry()
        {
            var c = new SeasonCore(); int birds = 0;
            c.OnBirdsSing += () => { birds++; Check.Equal(false, c.PlayHalfYear()); c.Tick(100); };
            c.Tick(10); Check.Near(0, c.Progress);
            Check.Equal(true, c.PlayHalfYear()); c.Tick(3);
            Check.Equal(false, c.PlayHalfYear()); Check.Near(.5, c.Progress);
            c.Tick(2.99f); Check.Equal(0, birds); c.Tick(.02f);
            Check.Equal(1, birds); Check.Equal(false, c.IsPlaying);
            Check.Equal(Season.Spring, c.Blend.Current); Check.Near(1, c.Progress);
            c.Tick(float.MaxValue); Check.Equal(false, c.PlayHalfYear()); Check.Equal(1, birds);
        }
        [Test] public void ExactDurationAndRepeatedHomeCallsAreIdempotent()
        {
            var c = new SeasonCore(); int birds = 0; c.OnBirdsSing += () => birds++;
            c.PlayHalfYear(); c.Tick(6); Check.Equal(1, birds);
            Check.Equal(true, c.SwapToHome()); Check.Equal(false, c.SwapToHome());
            Check.Equal(false, c.PlayHalfYear()); c.Tick(6); Check.Equal(1, birds);
        }
        [Test] public void EarlyReturnCancelsSeasonWithoutLateBirds()
        {
            var c = new SeasonCore(); int birds = 0; c.OnBirdsSing += () => birds++;
            c.PlayHalfYear(); c.Tick(1); c.SwapToHome(); c.Tick(6);
            Check.Equal(true, c.IsHome); Check.Equal(false, c.IsPlaying); Check.Equal(0, birds);
            Check.Equal(false, c.PlayHalfYear());
            var home = new SeasonCore(); home.SwapToHome(); Check.Equal(false, home.PlayHalfYear());
        }
        [Test] public void RejectsInvalidInputs()
        {
            Check.Throws(() => new SeasonCore().Tick(-1));
            foreach (float value in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity })
            { Check.Throws(() => SeasonCore.Sample(value)); Check.Throws(() => new SeasonCore().Tick(value)); }
        }
    }

    public sealed class EpilogueCoreTests
    {
        private static string Root
        {
            get
            {
#if UNITY_5_3_OR_NEWER
                return Path.GetDirectoryName(UnityEngine.Application.dataPath);
#else
                return Environment.GetEnvironmentVariable("LIURUAN_PROJECT_ROOT") ?? Directory.GetCurrentDirectory();
#endif
            }
        }
        private static T Read<T>(string path)
        {
            string json = File.ReadAllText(Path.Combine(Root, path));
#if UNITY_5_3_OR_NEWER
            return UnityEngine.JsonUtility.FromJson<T>(json);
#else
            return System.Text.Json.JsonSerializer.Deserialize<T>(json, new System.Text.Json.JsonSerializerOptions { IncludeFields = true });
#endif
        }
        private static EpilogueClueDocument Clues() => Read<EpilogueClueDocument>("Assets/_Project/Data/clues.json");
        private static EpilogueCompareDocument Compare() => Read<EpilogueCompareDocument>("Assets/_Project/Data/compare.json");
        private static EpilogueModel Build(ReadingResult[] readings = null) => EpilogueCore.Build(Clues(), Compare(), 5, 3, readings ?? new ReadingResult[0], 900);
        private static void Reject(Action action)
        {
            try { action(); } catch (ArgumentException) { return; }
            throw new Exception("Expected ArgumentException");
        }
        [Test] public void RealJsonRowsMatchEveryFieldAndModelCopiesData()
        {
            var clues = Clues(); var compare = Compare();
            var model = EpilogueCore.Build(clues, compare, 0, 0, new ReadingResult[0], 0);
            Check.Equal(compare.rows.Length, model.Comparison.Count);
            for (int i = 0; i < compare.rows.Length; i++)
            {
                Check.Equal(compare.rows[i].aspect, model.Comparison[i].Aspect);
                Check.Equal(compare.rows[i].liuruan, model.Comparison[i].Liuruan);
                Check.Equal(compare.rows[i].taohua, model.Comparison[i].Taohua);
            }
            string first = model.Comparison[0].Aspect;
            compare.rows[0].aspect = "changed"; Check.Equal(first, model.Comparison[0].Aspect);
        }
        [Test] public void EndingParagraphsAreFullSourceVerbatimAndRetainOmission()
        {
            var model = Build();
            string source = File.ReadAllText(Path.Combine(Root, "sources/liuruan_tw.txt")).TrimEnd('\r', '\n').Replace("\r\n", "\n");
            Check.Equal(source, string.Join("\n", model.Paragraphs));
            Check.Equal(7, model.Paragraphs.Count);
            Check.Equal(true, model.Paragraphs[5].StartsWith("……遂停半年。"));
            Check.Equal(false, source.Contains("各就一帳宿"));
        }
        [Test] public void ThreeEvidenceOptionsAndAnswerIndexMatchSourceAndActs()
        {
            var q = Build().Question;
            Check.Equal("為什麼找到的是七世孫？", q.Prompt); Check.Equal(3, q.Options.Count); Check.Equal(1, q.AnswerIndex);
            Check.Equal("「遂停半年」與「問得七世孫」", q.Options[q.AnswerIndex]);
            string source = File.ReadAllText(Path.Combine(Root, "sources/liuruan_tw.txt"));
            foreach (string option in q.Options)
            foreach (string quote in option.Split(new[] { '「', '」' }, StringSplitOptions.RemoveEmptyEntries))
                if (quote != "與") Check.Equal(true, source.Contains(quote));
            string acts = File.ReadAllText(Path.Combine(Root, "docs/content/acts.md"));
            Check.Equal(true, acts.Contains("以異境與人間時間落差為合理推論，不假稱原文明說固定換算率。"));
            Check.Equal(true, q.Explanation.Contains("以異境與人間時間落差為合理推論，不假稱原文明說固定換算率。"));
        }
        [Test] public void ScoresUseAllNonEndingCardsAndFirstTryOnly()
        {
            var model = Build(new[] { new ReadingResult(0, true), new ReadingResult(1, false), new ReadingResult(3, true) });
            Check.Equal(5, model.Score.BarkCount); Check.Equal(3, model.Score.DriftCount);
            Check.Equal(2, model.Score.ReadingCorrect); Check.Equal(6, model.Score.ReadingTotal);
            Check.Near(2d / 6, model.Score.ReadingAccuracy); Check.Near(900, model.Score.TotalSeconds);
            Check.Near(0, Build().Score.ReadingAccuracy);
            Check.Near(0, new EndingScore(0, 0, 0, 0, 0).ReadingAccuracy);
            var all = new System.Collections.Generic.List<ReadingResult>();
            foreach (var clue in Clues().clues) if (!clue.isEnding) all.Add(new ReadingResult(clue.id, true));
            Check.Near(1, Build(all.ToArray()).Score.ReadingAccuracy);
        }
        [Test] public void RejectsDuplicateUnknownAndEndingScoreIds()
        {
            Reject(() => Build(new[] { new ReadingResult(0, true), new ReadingResult(0, true) }));
            Reject(() => Build(new[] { new ReadingResult(999, true) }));
            Reject(() => Build(new[] { new ReadingResult(6, true) }));
        }
        [Test] public void RejectsMissingAmbiguousOrBrokenData()
        {
            Reject(() => EpilogueCore.Build(null, Compare(), 0, 0, new ReadingResult[0], 0));
            Reject(() => EpilogueCore.Build(Clues(), null, 0, 0, new ReadingResult[0], 0));
            var c = Clues(); c.clues[6].isEnding = false;
            Reject(() => EpilogueCore.Build(c, Compare(), 0, 0, new ReadingResult[0], 0));
            c.clues[6].isEnding = true; c.clues[0].isEnding = true;
            Reject(() => EpilogueCore.Build(c, Compare(), 0, 0, new ReadingResult[0], 0));
            var compare = Compare(); compare.rows[0].aspect = " ";
            Reject(() => EpilogueCore.Build(Clues(), compare, 0, 0, new ReadingResult[0], 0));
            c = Clues(); c.clues[0].id = c.clues[1].id;
            Reject(() => EpilogueCore.Build(c, Compare(), 0, 0, new ReadingResult[0], 0));
        }
        [Test] public void RejectsInvalidScoreInputs()
        {
            Check.Throws(() => new EndingScore(-1, 0, 0, 0, 0)); Check.Throws(() => new EndingScore(6, 0, 0, 0, 0));
            Check.Throws(() => new EndingScore(0, 4, 0, 0, 0)); Check.Throws(() => new EndingScore(0, -1, 0, 0, 0));
            Check.Throws(() => new EndingScore(0, 0, 2, 1, 0)); Check.Throws(() => new EndingScore(0, 0, 0, 0, -1));
            foreach (float value in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity })
                Check.Throws(() => new EndingScore(0, 0, 0, 0, value));
        }
    }

    public sealed class CharacterBobCoreTests
    {
        [Test] public void IdleHasNoBounceSwayOrLeanAndBreathStaysWithinOnePointFivePercent()
        {
            var c = new CharacterBobCore(); bool breathing = false;
            c.Tick(.2f, 4);
            for (int i = 0; i < 1000; i++)
            {
                var p = c.Tick(.01f, 0);
                Check.Near(0, p.Height); Check.Near(0, p.RollDegrees); Check.Near(0, p.LeanDegrees);
                Check.Equal(true, p.Scale >= .985f && p.Scale <= 1.015f);
                breathing |= Math.Abs(p.Scale - 1) > .01;
            }
            Check.Equal(true, breathing);
        }
        [Test] public void FrequencyIsMonotonicAndCapsAtMaxSpeed()
        {
            var c = new CharacterBobCore(); Check.Near(0, c.Frequency(0));
            float previous = 0;
            for (int i = 1; i <= 80; i++)
            { float next = c.Frequency(i / 10f); Check.Equal(true, next > previous); previous = next; }
            Check.Near(c.Frequency(8), c.Frequency(float.MaxValue));
        }
        [Test] public void MovementUsesConfigAndZeroTimeDoesNotAdvancePose()
        {
            var c = new CharacterBobCore(4, 1, 0, .1f, 5, 10);
            var pose = c.Tick(.25f, 4);
            Check.Near(.1, pose.Height); Check.Near(5, pose.RollDegrees); Check.Near(10, pose.LeanDegrees); Check.Near(1, pose.Scale);
            var still = c.Tick(0, 4); Check.Near(pose.Height, still.Height); Check.Near(pose.RollDegrees, still.RollDegrees);
        }
        [Test] public void FiniteForHugeInputsAndLongRunningPhase()
        {
            var c = new CharacterBobCore();
            foreach (float speed in new[] { 0, .001f, 1, 8, float.MaxValue })
            foreach (float dt in new[] { 0, .016f, 1000, float.MaxValue })
            {
                var p = c.Tick(dt, speed);
                foreach (float value in new[] { p.Height, p.RollDegrees, p.LeanDegrees, p.Scale })
                    Check.Equal(true, !float.IsNaN(value) && !float.IsInfinity(value));
            }
        }
        [Test] public void RejectsInvalidSpeedTimeAndSettings()
        {
            var c = new CharacterBobCore();
            Check.Throws(() => c.Tick(-1, 0)); Check.Throws(() => c.Tick(0, -1));
            Check.Throws(() => new CharacterBobCore(0)); Check.Throws(() => new CharacterBobCore(breath: .02f));
            Check.Throws(() => new CharacterBobCore(bounce: -1));
            foreach (float value in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity })
            {
                Check.Throws(() => c.Tick(value, 0)); Check.Throws(() => c.Tick(0, value));
                Check.Throws(() => c.Frequency(value)); Check.Throws(() => new CharacterBobCore(maxSpeed: value));
            }
        }
    }
}

