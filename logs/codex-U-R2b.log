using UnityEngine;
using UnityEngine.AI;

namespace Liuruan
{
    public sealed class CompanionFollow : MonoBehaviour
    {
        [SerializeField] private Transform player;
        [SerializeField, Min(0f)] private float followSpeed = 3f;
        [SerializeField, Min(1f)] private float catchupMultiplier = 1.6f;
        private NavMeshAgent agent;
        private readonly CompanionCore core = new CompanionCore();
        private Vector3 previousPosition;
        public float Speed { get; private set; }
        public float CooldownRatio => core.CooldownRatio;
        public CompanionState State => core.State;
        public bool Call() => core.Call();
        private bool AgentReady => agent != null && agent.enabled && agent.isOnNavMesh;
        private void Awake() => agent = GetComponent<NavMeshAgent>();
        private void OnEnable() { previousPosition = transform.position; Speed = 0f; }

        private void Update()
        {
            float dt = Time.deltaTime;
            Speed = dt > 0f ? Vector3.Distance(transform.position, previousPosition) / dt : 0f;
            previousPosition = transform.position;
            if (player == null)
            {
                if (AgentReady) agent.ResetPath();
                Speed = 0f;
                return;
            }
            CompanionState state = core.Tick(dt, ToCore(player.position),
                ToCore(transform.position), ToCore(player.forward));
            Vector3 target = ToUnity(core.Destination);
            if (state == CompanionState.Teleport)
            {
                // shortcut: 僅搜尋目標附近 2m 的 NavMesh；複雜多層地形由 U 線提供安全落點。
                bool ready = AgentReady;
                if (NavMesh.SamplePosition(target, out NavMeshHit hit, 2f, NavMesh.AllAreas))
                    target = hit.position;
                if (ready) agent.ResetPath();
                if (!ready || !agent.Warp(target)) transform.position = target;
                previousPosition = transform.position;
                Speed = 0f;
                return;
            }
            float speed = state == CompanionState.Catchup ? followSpeed * catchupMultiplier : followSpeed;
            if (AgentReady)
            {
                agent.stoppingDistance = 2.4f;
                agent.speed = speed;
                agent.isStopped = state == CompanionState.Idle;
                if (state != CompanionState.Idle) agent.SetDestination(target);
            }
            else if (state != CompanionState.Idle)
            {
                float remaining = Mathf.Max(0f, Vector3.Distance(transform.position, target) - 2.4f);
                transform.position = Vector3.MoveTowards(transform.position, target, Mathf.Min(speed * dt, remaining));
            }
        }

        private void OnDisable()
        {
            if (AgentReady) agent.ResetPath();
            Speed = 0f;
        }
        private static WorldPosition ToCore(Vector3 p) => new WorldPosition(p.x, p.y, p.z);
        private static Vector3 ToUnity(WorldPosition p) => new Vector3(p.X, p.Y, p.Z);
    }
}
using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;

namespace Liuruan
{
    [Serializable] public sealed class EpilogueClueDocument { public EpilogueClue[] clues = null; }
    [Serializable] public sealed class EpilogueClue
    {
        public int id = 0;
        public bool isEnding = false;
        public string original = null;
    }
    [Serializable] public sealed class EpilogueCompareDocument { public EpilogueCompareRow[] rows = null; }
    [Serializable] public sealed class EpilogueCompareRow
    { public string aspect = null, liuruan = null, taohua = null; }

    public readonly struct ReadingResult
    {
        public int Id { get; }
        public bool FirstTryCorrect { get; }
        public ReadingResult(int id, bool firstTryCorrect) { Id = id; FirstTryCorrect = firstTryCorrect; }
    }
    public sealed class EndingQuestion
    {
        public string Prompt => "為什麼找到的是七世孫？";
        public ReadOnlyCollection<string> Options { get; } = Array.AsReadOnly(new[] {
            "「攀葛乃得至」與「而饑止體充」",
            "「遂停半年」與「問得七世孫」",
            "「見蕪菁葉從山腹流出」與「此處去人徑不遠」" });
        public int AnswerIndex => 1;
        public string Explanation => "「遂停半年」與「問得七世孫」；以異境與人間時間落差為合理推論，不假稱原文明說固定換算率。";
    }
    public readonly struct ComparisonRow
    {
        public string Aspect { get; }
        public string Liuruan { get; }
        public string Taohua { get; }
        public ComparisonRow(EpilogueCompareRow row)
        { Aspect = row.aspect; Liuruan = row.liuruan; Taohua = row.taohua; }
    }
    public readonly struct EndingScore
    {
        public int BarkCount { get; }
        public int DriftCount { get; }
        public int ReadingCorrect { get; }
        public int ReadingTotal { get; }
        public float ReadingAccuracy => ReadingTotal == 0 ? 0 : (float)ReadingCorrect / ReadingTotal;
        public float TotalSeconds { get; }
        public EndingScore(int bark, int drift, int correct, int total, float seconds)
        {
            HungerCore.RequireFinite(seconds, nameof(seconds));
            if (bark < 0 || bark > 5 || drift < 0 || drift > 3 || total < 0 || correct < 0 || correct > total || seconds < 0)
                throw new ArgumentOutOfRangeException(nameof(bark));
            BarkCount = bark; DriftCount = drift; ReadingCorrect = correct; ReadingTotal = total; TotalSeconds = seconds;
        }
    }
    public sealed class EpilogueModel
    {
        public ReadOnlyCollection<string> Paragraphs { get; }
        public EndingQuestion Question { get; } = new EndingQuestion();
        public ReadOnlyCollection<ComparisonRow> Comparison { get; }
        public EndingScore Score { get; }
        internal EpilogueModel(string[] paragraphs, ComparisonRow[] comparison, EndingScore score)
        { Paragraphs = Array.AsReadOnly(paragraphs); Comparison = Array.AsReadOnly(comparison); Score = score; }
    }
    public static class EpilogueCore
    {
        public static EpilogueModel Build(EpilogueClueDocument clues, EpilogueCompareDocument compare,
            int bark, int drift, ReadingResult[] readings, float totalSeconds)
        {
            if (clues?.clues == null || compare?.rows == null || readings == null)
                throw new ArgumentException("結局需要 clues、compare 與閱讀成績。");
            EpilogueClue ending = null;
            var ids = new HashSet<int>();
            var readingIds = new HashSet<int>();
            foreach (var clue in clues.clues)
            {
                if (clue == null || clue.id < 0 || !ids.Add(clue.id)) throw new ArgumentException("線索 id 無效或重複。");
                if (clue.isEnding)
                {
                    if (ending != null) throw new ArgumentException("結局全文必須恰有一筆。");
                    ending = clue;
                }
                else readingIds.Add(clue.id);
            }
            if (ending == null || string.IsNullOrWhiteSpace(ending.original)) throw new ArgumentException("缺少結局全文。");
            var paragraphs = ending.original.Replace("\r\n", "\n").Replace('\r', '\n')
                .Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries);
            int correct = 0;
            var seen = new HashSet<int>();
            foreach (var result in readings)
            {
                if (!readingIds.Contains(result.Id) || !seen.Add(result.Id)) throw new ArgumentException("閱讀成績 id 無效或重複。");
                if (result.FirstTryCorrect) correct++;
            }
            var rows = new ComparisonRow[compare.rows.Length];
            for (int i = 0; i < rows.Length; i++)
            {
                var row = compare.rows[i];
                if (row == null || string.IsNullOrWhiteSpace(row.aspect) || string.IsNullOrWhiteSpace(row.liuruan) || string.IsNullOrWhiteSpace(row.taohua))
                    throw new ArgumentException("比較表欄位不可空白。");
                rows[i] = new ComparisonRow(row);
            }
            return new EpilogueModel(paragraphs, rows, new EndingScore(bark, drift, correct, readingIds.Count, totalSeconds));
        }
    }
}
using System;
using System.IO;
using UnityEditor;
using UnityEditor.Build.Reporting;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace Liuruan
{
    /// WebGL 分包（仿 oz-journey ZoneBundles）：Main.unity 打成 LZMA scene bundle「main」，切成 ≤20 MiB 的
    /// StreamingAssets/scene/main.0、.1…＋parts.json；主包只放 Boot.unity（BootLoader 下載拼回後載入 Main）。
    /// EditorBuildSettings 不動：Editor 直接開 Main.unity 按 Play 照舊。
    /// 一鍵：-executeMethod Liuruan.SceneBundles.BuildAll
    public static class SceneBundles
    {
        const string MainScenePath = "Assets/_Project/Scenes/Main.unity";
        const string BootScenePath = "Assets/_Project/Scenes/Boot.unity";
        const string OutDir = "Build/SceneBundles";      // 增量建置快取；SceneBundles.manifest 給程式碼裁剪用
        const string PlayerDir = "Build/WebGL";
        const string ServeDir = PlayerDir + "/StreamingAssets/" + BootLoader.Dir;
        const string DoneFlag = PlayerDir + "/.bundle-done"; // 全部成功才寫；外部用它判斷建置結束
        const long MaxFile = 25L * 1024 * 1024;          // Cloudflare Pages 單檔上限

        [MenuItem("Tools/Liuruan/Build/Scene Bundle Only")]
        public static void BuildBundleOnlyMenu()
        {
            bool ok = BuildBundle() && (!Directory.Exists(PlayerDir) || CopyToPlayer());
            if (Application.isBatchMode) EditorApplication.Exit(ok ? 0 : 1);
        }

        /// 建 bundle → 建 WebGL（只含 Boot）→ bundle 切塊放進 Build/WebGL/StreamingAssets/scene → 寫 .bundle-done
        [MenuItem("Tools/Liuruan/Build/WebGL + Scene Bundle")]
        public static void BuildAll()
        {
            if (File.Exists(DoneFlag)) File.Delete(DoneFlag);
            bool ok = EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo() && EnsureBootScene() && BuildBundle();
            if (ok)
            {
                // PlayerSettings（Brotli、檔名雜湊、模板、記憶體）沿用 ProjectSettings 現有 WebGL 設定
                var report = BuildPipeline.BuildPlayer(new BuildPlayerOptions
                {
                    scenes = new[] { BootScenePath },
                    locationPathName = PlayerDir,
                    target = BuildTarget.WebGL,
                    targetGroup = BuildTargetGroup.WebGL,
                    options = EditorUserBuildSettings.development ? BuildOptions.Development : BuildOptions.None,
                    assetBundleManifestPath = $"{OutDir}/{Path.GetFileName(OutDir)}.manifest", // 只在 bundle 用到的型別／引擎模組不被裁掉
                });
                ok = report.summary.result == BuildResult.Succeeded;
                Debug.Log($"[SceneBundles] WebGL {report.summary.result}");
                if (ok) ok = CopyToPlayer(); // BuildPlayer 之後才複製，避免被 StreamingAssets 覆蓋
            }
            if (ok) File.WriteAllText(DoneFlag, DateTime.Now.ToString("o") + "\n");
            else Debug.LogError("[SceneBundles] 建置失敗，未寫 .bundle-done");
            if (Application.isBatchMode) EditorApplication.Exit(ok ? 0 : 1);
        }

        static bool BuildBundle()
        {
            // bundle 讀磁碟上的場景：Main 有未存修改時先問（batch mode 直接回 true）
            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return false;
            Directory.CreateDirectory(OutDir);
            // 預設 LZMA：檔案最小（CF 以存放大小算 25 MiB；octet-stream 不一定會再壓）
            var manifest = BuildPipeline.BuildAssetBundles(OutDir, new[]
            {
                new AssetBundleBuild { assetBundleName = BootLoader.BundleName, assetNames = new[] { MainScenePath } },
            }, BuildAssetBundleOptions.None, BuildTarget.WebGL);
            if (!manifest) { Debug.LogError("[SceneBundles] bundle 建置失敗"); return false; }
            long size = new FileInfo(Path.Combine(OutDir, BootLoader.BundleName)).Length;
            Debug.Log($"[SceneBundles] {BootLoader.BundleName} {size / 1048576f:F2} MiB");
            return true;
        }

        /// 切成 ≤20 MiB 的 main.0、.1…，寫 parts.json；任何一塊超過 25 MiB 就失敗
        static bool CopyToPlayer()
        {
            if (Directory.Exists(ServeDir)) Directory.Delete(ServeDir, true);
            Directory.CreateDirectory(ServeDir);
            var data = File.ReadAllBytes(Path.Combine(OutDir, BootLoader.BundleName));
            if (data.LongLength == 0 || data.LongLength > int.MaxValue) { Debug.LogError("[SceneBundles] bundle 大小無效"); return false; }
            int n = (int)((data.LongLength + BootLoader.PartSize - 1) / BootLoader.PartSize);
            for (int i = 0; i < n; i++)
            {
                int len = (int)Math.Min(BootLoader.PartSize, data.LongLength - (long)i * BootLoader.PartSize);
                if (len > MaxFile) { Debug.LogError($"[SceneBundles] {BootLoader.BundleName}.{i} 超過 25 MiB"); return false; }
                using (var fs = File.Create(Path.Combine(ServeDir, $"{BootLoader.BundleName}.{i}")))
                    fs.Write(data, i * BootLoader.PartSize, len);
            }
            var parts = new BootLoader.Parts { name = BootLoader.BundleName, parts = n, bytes = data.LongLength };
            File.WriteAllText(Path.Combine(ServeDir, BootLoader.IndexFile), JsonUtility.ToJson(parts, true));
            Debug.Log($"[SceneBundles] 已切 {n} 塊到 {ServeDir}");
            return true;
        }

        /// Boot.unity 不存在就建：黑底相機＋BootLoader（附加開啟後存檔關閉，不動目前場景）
        static bool EnsureBootScene()
        {
            if (File.Exists(BootScenePath)) return true;
            var active = SceneManager.GetActiveScene();
            bool additive = active.IsValid() && !string.IsNullOrEmpty(active.path); // 未命名場景不能附加開新場景（batch mode 常見）
            var boot = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, additive ? NewSceneMode.Additive : NewSceneMode.Single);
            SceneManager.SetActiveScene(boot); // 新物件建在 Boot，不弄髒 Main
            var cam = new GameObject("Camera").AddComponent<Camera>();
            cam.clearFlags = CameraClearFlags.SolidColor;
            cam.backgroundColor = new Color(0.12f, 0.09f, 0.07f);
            new GameObject("BootLoader", typeof(BootLoader));
            bool ok = EditorSceneManager.SaveScene(boot, BootScenePath);
            if (additive)
            {
                SceneManager.SetActiveScene(active);
                EditorSceneManager.CloseScene(boot, true);
            }
            if (!ok) Debug.LogError("[SceneBundles] Boot.unity 建立失敗");
            else AssetDatabase.ImportAsset(BootScenePath);
            return ok;
        }
    }
}

