using System;
using System.Collections.Generic;
using UnityEngine;

namespace Liuruan
{
    [DefaultExecutionOrder(-100)]
    public sealed class GameFlow : MonoBehaviour
    {
        const string SaveKey = "liuruan_r1_progress";
        [SerializeField] TextAsset clueJson;
        [SerializeField] Material returnMaterial;
        public Material returnSky;
        public MinimapCam minimap;
        public ClimbZone climb;
        public DriftCollection driftCollection;
        [Serializable] public sealed class Progress
        {
            public int act = 1, bark, drift, villageStep;
            public bool climbed, inferred, ended;
            public Vector3 position = new Vector3(0, 0.1f, -105);
        }
        public Progress State { get; private set; }
        public int Act { get { return State.act; } }
        public int BarkCount { get { int n = 0; for (int i = 0; i < 5; i++) if ((State.bark & (1 << i)) != 0) n++; return n; } }
        public bool Reading { get; private set; }
        public bool CanReturn { get { return Act == 4 && State.villageStep == 3 && !Reading; } }
        public HungerSystem Hunger { get; private set; }
        public CompanionFollow Companion { get; private set; }
        public PlayerController Player { get; private set; }
        public ClueData CurrentCard { get; private set; }
        readonly Dictionary<string, Interactable> points = new Dictionary<string, Interactable>();
        ClueData[] clues = new ClueData[0];
        public string Objective
        {
            get
            {
                if (Act == 1) return "一・迷山　剝取穀皮 " + BarkCount + "／5";
                if (Act == 2) return State.climbed ? "二・攀桃　摘取桃子" : "二・攀桃　前往崖下攀援處";
                if (Act == 3) return State.inferred ? "三・流杯　向北涉水" : "三・流杯　拾取三件漂流物";
                if (Act == 4) return new[] { "四・仙村　前往二女子處", "四・仙村　前往銅瓦屋", "四・仙村　閱讀告示板", "四・仙村　選擇求歸" }[State.villageStep];
                return State.ended ? "五・歸鄉　旅程結束" : "五・歸鄉　回到村口";
            }
        }
        void Awake()
        {
            ScrollUI.DeferHelp = true;
            State = new Progress();
            try { if (PlayerPrefs.HasKey(SaveKey)) State = JsonUtility.FromJson<Progress>(PlayerPrefs.GetString(SaveKey)) ?? new Progress(); }
            catch (ArgumentException) { State = new Progress(); }
            State.act = Mathf.Clamp(State.act, 1, 5);
            State.bark &= 31; State.drift &= 7; State.villageStep = Mathf.Clamp(State.villageStep, 0, 3);
            Player = FindFirstObjectByType<PlayerController>();
            Hunger = Player.GetComponent<HungerSystem>();
            Companion = FindFirstObjectByType<CompanionFollow>();
            if (clueJson)
            {
                try { var list = JsonUtility.FromJson<ClueList>(clueJson.text); if (list != null) clues = list.clues ?? clues; }
                catch (ArgumentException e) { Debug.LogWarning("[GameFlow] 題庫格式無法讀取：" + e.Message); }
            }
            foreach (Transform t in GameObject.Find("ActPoints").transform)
            {
                var it = t.GetComponent<Interactable>();
                if (!it) continue;
                string key = t.name;
                points.Add(key, it);
                it.onInteract.AddListener(() => InteractPoint(key));
            }
        }
        void OnEnable()
        {
            if (climb) climb.OnTopOut += Climbed;
            if (driftCollection) { driftCollection.OnCollected += Collected; driftCollection.OnAllCollected += Infer; }
        }
        void OnDisable()
        {
            if (climb) climb.OnTopOut -= Climbed;
            if (driftCollection) { driftCollection.OnCollected -= Collected; driftCollection.OnAllCollected -= Infer; }
        }
        void Climbed() { State.climbed = true; Save(); SyncPoints(); }
        bool restoringDrift;
        void Collected(int id) { if (restoringDrift) return; State.drift |= 1 << (id - 1); Save(); SyncPoints(); }
        void Infer() { if (!restoringDrift && !Reading && Act == 3 && !State.inferred) ReadAct(3, () => { State.inferred = true; Save(); SyncPoints(); }); }
        void Start()
        {
            restoringDrift = true;
            if (driftCollection) for (int id = 1; id <= 3; id++)
                if ((State.drift & (1 << (id - 1))) != 0) driftCollection.Core.Collect(id);
            restoringDrift = false;
            MovePlayer(State.position);
            if (Act >= 3) Hunger.FillAll();
            Hunger.OnToast += Toast;
            SyncPoints();
            if (Act == 5) ApplyReturn();
            if (Act == 3 && State.drift == 7 && !State.inferred) Infer();
            if (State.ended) GetComponent<HudUI>().ShowEnding();
        }
        void OnDestroy() { if (Hunger) Hunger.OnToast -= Toast; }
        void Update()
        {
            if (climb && climb.IsLocked && TouchInput.Enabled) climb.SetMoveInput(TouchInput.Move);
            bool busy = Reading || (ScrollUI.I && ScrollUI.I.IsBusy) || State.ended;
            if (busy) Hunger.Pause(); else Hunger.Resume();
            if (!busy)
            {
                if (Input.GetKeyDown(KeyCode.F)) UseSkill(0);
                if (Input.GetKeyDown(KeyCode.R)) UseSkill(1);
                if (Input.GetKeyDown(KeyCode.G)) UseSkill(2);
            }
#if UNITY_EDITOR || DEVELOPMENT_BUILD
            if (Input.GetKeyDown(KeyCode.F9) && !busy) DebugNextAct();
#endif
        }
        void LateUpdate()
        {
            if (!climb || !climb.IsLocked || !Player.cam) return;
            Player.cam.position = Player.transform.position + new Vector3(6, 2.5f, -4);
            Player.cam.LookAt(Player.transform.position + Vector3.up);
        }
        public void UseSkill(int skill)
        {
            if (Reading || State.ended || (ScrollUI.I && ScrollUI.I.IsBusy)) return;
            if (skill == 2) { if (Companion.Call()) Toast("已呼喚阮肇"); return; }
            var near = Interactable.Nearest(Player.transform.position);
            if (near && (skill == 0 ? near.name.StartsWith("Act1_Bark_") : near.name.StartsWith("Act3_Drift_"))) near.Interact();
            else Toast(skill == 0 ? "請靠近可剝皮的楮樹" : "請靠近溪中漂流物");
        }
        public void InteractPoint(string key)
        {
            Interactable point;
            if (Reading || State.ended || !points.TryGetValue(key, out point) || !point.enabled) return;
            if (Act == 1 && key.StartsWith("Act1_Bark_"))
            {
                State.bark |= 1 << (key[key.Length - 1] - '1');
                if (State.bark == 31) { State.act = 2; ReadAct(1, null); }
            }
            else if (Act == 2 && key == "Act2_ClimbBase")
            {
                if (climb) climb.TryInteract();
            }
            else if (Act == 2 && key == "Act2_PeachTree")
            {
                Hunger.FillAll(); State.act = 3;
                MovePlayer(new Vector3(-7, 0.2f, -16)); ReadAct(2, null);
            }
            else if (Act == 3 && key.StartsWith("Act3_Drift_"))
            {
                var pickup = point.GetComponent<DriftPickup>();
                if (pickup) pickup.TryInteract();
            }
            else if (Act == 3 && key == "Act3_Wade") { State.act = 4; MovePlayer(new Vector3(0, 0.2f, 63)); }
            else if (Act == 4)
            {
                State.villageStep = Mathf.Min(3, State.villageStep + 1);
                if (key == "Act4_Board") ReadAct(4, null);
            }
            else if (Act == 5 && key == "Act5_Return")
            {
                ApplyReturn();
                ReadAct(5, () => { State.ended = true; Save(); SyncPoints(); GetComponent<HudUI>().ShowEnding(); });
            }
            Save(); SyncPoints();
        }
        public void ReturnHome()
        {
            if (!CanReturn || (ScrollUI.I && ScrollUI.I.IsBusy)) return;
            State.act = 5; ApplyReturn(); MovePlayer(new Vector3(0, 0.2f, -104)); Save(); SyncPoints();
        }
        void ReadAct(int act, Action done)
        {
            var cards = new List<ClueData>();
            foreach (var c in clues) if (c != null && c.act == act) cards.Add(c);
            if (cards.Count == 0) cards.Add(new ClueData { id = -act, act = act, title = "〔act" + act + "-原文〕", original = "〔act" + act + "-原文〕" });
            Reading = true; Hunger.Pause();
            ReadCard(cards, 0, done);
        }
        void ReadCard(List<ClueData> cards, int i, Action done)
        {
            if (i == cards.Count) { Reading = false; CurrentCard = null; if (done != null) done(); return; }
            CurrentCard = cards[i];
            ScrollUI.I.ShowClue(CurrentCard, () => ReadCard(cards, i + 1, done));
        }
        void SyncPoints()
        {
            if (minimap) minimap.SetAct(Act);
            Transform target = null;
            foreach (var pair in points)
            {
                string k = pair.Key;
                bool enabled = false;
                if (!State.ended)
                {
                    if (Act == 1 && k.StartsWith("Act1_Bark_")) enabled = (State.bark & (1 << (k[k.Length - 1] - '1'))) == 0;
                    if (Act == 2) enabled = k == (State.climbed ? "Act2_PeachTree" : "Act2_ClimbBase");
                    if (Act == 3 && k.StartsWith("Act3_Drift_")) enabled = !State.inferred && (State.drift & (1 << (k[k.Length - 1] - '1'))) == 0;
                    if (Act == 3 && k == "Act3_Wade") enabled = State.inferred;
                    if (Act == 4 && State.villageStep < 3) enabled = k == new[] { "Act4_Women", "Act4_House", "Act4_Board" }[State.villageStep];
                    if (Act == 4 && State.villageStep == 3) enabled = k == "Act4_Board";
                    if (Act == 5) enabled = k == "Act5_Return";
                }
                pair.Value.enabled = enabled;
                if (enabled && !target) target = pair.Value.transform;
                var visual = pair.Value.transform.Find("R1Marker");
                if (visual) visual.gameObject.SetActive(enabled);
            }
            if (minimap) minimap.SetTarget(target);
        }
        public void MovePlayer(Vector3 position)
        {
            var cc = Player.GetComponent<CharacterController>();
            cc.enabled = false; Player.transform.position = position; cc.enabled = true;
        }
        void Save() { State.position = Player.transform.position; PlayerPrefs.SetString(SaveKey, JsonUtility.ToJson(State)); PlayerPrefs.Save(); }
        void ApplyReturn()
        {
            if (returnSky) RenderSettings.skybox = returnSky;
            foreach (string zone in new[] { "Village", "Forest" })
            {
                var root = GameObject.Find(zone);
                if (!root) continue;
                foreach (var r in root.GetComponentsInChildren<Renderer>(true))
                    if (r.name.Contains("Wall") || r.name.Contains("Roof") || r.name.Contains("Gate")) r.sharedMaterial = returnMaterial;
                int houses = 0;
                foreach (Transform t in root.transform) if (t.name.StartsWith("House_")) t.gameObject.SetActive(houses++ % 2 == 0);
            }
            if (RenderSettings.sun) RenderSettings.sun.color = new Color(0.62f, 0.7f, 0.82f);
        }
        void Toast(string text) { if (ScrollUI.I) ScrollUI.I.Toast(text); }
#if UNITY_EDITOR || DEVELOPMENT_BUILD
        public void DebugNextAct()
        {
            State.act = Mathf.Min(5, Act + 1);
            if (Act == 2) MovePlayer(new Vector3(-11, 0.2f, -31));
            if (Act == 3) MovePlayer(new Vector3(-5, 0.2f, -13));
            if (Act == 4) MovePlayer(new Vector3(0, 0.2f, 63));
            if (Act == 5) { ApplyReturn(); MovePlayer(new Vector3(0, 0.2f, -104)); }
            Save(); SyncPoints();
        }
#endif
    }
}
using UnityEngine;

namespace Liuruan
{
    /// 第三人稱控制：WASD／方向鍵移動、按住滑鼠右鍵轉視角、E 互動。相機為簡單跟隨相機。
    [RequireComponent(typeof(CharacterController))]
    public class PlayerController : MonoBehaviour
    {
        public float moveSpeed = 4f;
        public float turnSpeed = 720f;
        public float gravity = -20f;

        public Transform cam;
        public float camDistance = 6f;
        public float camHeight = 1.5f;
        public float mouseSensitivity = 3f;
        public LayerMask camCollision = ~0;

        public Animator animator; // 參數 Speed (float)

        /// 演出時由 CluePerformance 指定的固定鏡頭；null 時恢復跟隨
        public static Transform CamShot;

        CharacterController cc;
        HungerSystem hunger;
        float yaw, pitch = 20f, vy;
        float interactHintAfter;
        static readonly int SpeedHash = Animator.StringToHash("Speed");

        void Awake()
        {
            cc = GetComponent<CharacterController>();
            hunger = GetComponent<HungerSystem>();
            if (cam == null && Camera.main != null) cam = Camera.main.transform;
            yaw = transform.eulerAngles.y;
            RestoreFoliage();
            foliage = null; // 關掉 Domain Reload 時靜態清單會殘留上一局
        }

        public void FaceDirection(Vector3 direction)
        {
            direction.y = 0;
            if (direction.sqrMagnitude < 0.01f) return;
            transform.rotation = Quaternion.LookRotation(direction);
            yaw = transform.eulerAngles.y;
        }

        void Update()
        {
            // hotfix1：HTML 輸入框開著時不吃鍵盤（WASD、E 是在打字）
            bool busy = (ScrollUI.I != null && ScrollUI.I.IsBusy);
            Vector3 move = Vector3.zero;

            if (!busy)
            {
                if (Input.GetMouseButton(1))
                {
                    yaw += Input.GetAxis("Mouse X") * mouseSensitivity;
                    pitch = Mathf.Clamp(pitch - Input.GetAxis("Mouse Y") * mouseSensitivity, -10f, 60f);
                }
                Vector2 look = TouchInput.ConsumeLook() * 0.15f;
                yaw += look.x;
                pitch = Mathf.Clamp(pitch - look.y, -10f, 60f);
                Vector3 input = new Vector3(Input.GetAxisRaw("Horizontal"), 0, Input.GetAxisRaw("Vertical"));
                input += new Vector3(TouchInput.Move.x, 0, TouchInput.Move.y);
                move = Quaternion.Euler(0, yaw, 0) * Vector3.ClampMagnitude(input, 1f);

                var near = Interactable.Nearest(transform.position);
                ScrollUI.I?.SetPrompt(near ? near.CurrentPrompt : null);
                bool interactPressed = Input.GetKeyDown(KeyCode.E) | TouchInput.ConsumeDown();
                if (interactPressed)
                {
                    if (near) near.Interact();
                    else if (Time.unscaledTime >= interactHintAfter)
                    {
                        interactHintAfter = Time.unscaledTime + 2.5f;
                        ScrollUI.I?.Toast(Txt.InteractTooFar);
                    }
                }
            }
            else TouchInput.ConsumeLook();

            if (!enabled || !cc.enabled) return; // 互動可能在本幀掛上藤蔓並鎖定控制。
            if (move.sqrMagnitude > 0.01f)
                transform.rotation = Quaternion.RotateTowards(transform.rotation, Quaternion.LookRotation(move), turnSpeed * Time.deltaTime);

            vy = cc.isGrounded ? -1f : vy + gravity * Time.deltaTime;
            Vector3 before = transform.position;
            float speed = moveSpeed * (hunger ? hunger.SpeedMultiplier : 1f);
            MoveDisplacement(cc, (move * speed + Vector3.up * vy) * Time.deltaTime);
            GroundFeet();

            // 讀實際水平速度（撞牆就停步；鍵盤、觸控搖桿都走 move → cc.Move，一樣有效）
            if (animator)
            {
                var v = (transform.position - before) / Mathf.Max(Time.deltaTime, 0.0001f); v.y = 0f;
                animator.SetFloat(SpeedHash, v.magnitude, 0.08f, Time.deltaTime);
            }
        }

        public static CollisionFlags MoveDisplacement(CharacterController controller, Vector3 delta)
        {
            // 每次不跨過單級踏面，低幀率也能逐階抬腳；限制落下時的迴圈成本。
            int count = Mathf.Clamp(Mathf.CeilToInt(delta.magnitude / 0.12f), 1, 32);
            var flags = CollisionFlags.None;
            for (int i = 0; i < count; i++) flags |= controller.Move(delta / count);
            return flags;
        }

        // hotfix1：腳貼地。膠囊圓底踩在台階邊緣時，模型腳底會陷進上一階（最多一階高）或浮在下一階；
        // 改用腳尖、腳中、腳跟三條射線量到的最高走路面當腳底，模型只上下微調（±0.1～0.3m），碰撞體不動。
        Transform foot; float footBase, footOff;
        void GroundFeet()
        {
            if (!foot)
            {
                if (!animator || !animator.transform.parent) return;
                foot = animator.transform.parent; footBase = foot.localPosition.y;
            }
            float bottom = transform.position.y + cc.center.y - cc.height * 0.5f;
            float best = float.NegativeInfinity;
            var fw = transform.forward;
            for (int i = -1; i <= 1; i++)
            {
                var p = transform.position + fw * (0.14f * i);
                if (Physics.Raycast(new Vector3(p.x, bottom + 0.4f, p.z), Vector3.down, out var h, 0.65f, CamOcclusion.WalkMask & ~(1 << 2), QueryTriggerInteraction.Ignore)
                    && h.normal.y > 0.6f && h.point.y > best) best = h.point.y;
            }
            float want = cc.isGrounded && best > float.NegativeInfinity ? Mathf.Clamp(best - bottom, -0.1f, 0.3f) : 0f;
            footOff = Mathf.MoveTowards(footOff, want, 1.5f * Time.deltaTime);
            var lp = foot.localPosition;
            float s = foot.parent ? foot.parent.lossyScale.y : 1f;
            lp.y = footBase + footOff / (s > 0.001f ? s : 1f);
            foot.localPosition = lp;
        }

        void LateUpdate()
        {
            if (!cam) return;
            if (CamShot) { cam.SetPositionAndRotation(CamShot.position, CamShot.rotation); RestoreFoliage(); HideSelf(false); return; }
            Vector3 pivot = transform.position + Vector3.up * camHeight;
            // 低矮屋簷下（亭子內抬高視角）鏡頭會被樑擋到貼著後腦：暫時把俯角放低，挑退得最遠的角度（不改玩家設定的 pitch）
            Quaternion rot = Quaternion.Euler(pitch, yaw, 0);
            float want = CamClearDistance(pivot, rot * Vector3.back, camDistance, transform);
            if (want < 1.2f)
                for (float p = pitch - 10f; p >= -10f; p -= 10f)
                {
                    var r2 = Quaternion.Euler(p, yaw, 0);
                    float w2 = CamClearDistance(pivot, r2 * Vector3.back, camDistance, transform);
                    if (w2 > want + 0.5f) { rot = r2; want = w2; }
                    if (want >= 2f) break;
                }
            // 撞到就立刻拉近；離開障礙時慢慢退回，不會一抽一抽
            camDist = want < camDist ? want : Mathf.MoveTowards(camDist, want, 4f * Time.deltaTime);
            cam.SetPositionAndRotation(pivot + rot * Vector3.back * camDist, rot);
            UpdateFoliage(cam.position, transform.position);
            // 背貼牆時鏡頭只剩 0.35～0.8 m，後腦會佔掉半個畫面：人物改成只投影子（不動模型本身）
            HideSelf(camDist < 0.8f);
        }

        Renderer[] selfRenderers;
        UnityEngine.Rendering.ShadowCastingMode[] selfModes;
        bool selfHidden;
        void HideSelf(bool hide)
        {
            if (hide == selfHidden) return;
            selfHidden = hide;
            if (selfRenderers == null)
            {
                selfRenderers = GetComponentsInChildren<Renderer>(true);
                selfModes = new UnityEngine.Rendering.ShadowCastingMode[selfRenderers.Length];
                for (int i = 0; i < selfRenderers.Length; i++) selfModes[i] = selfRenderers[i].shadowCastingMode;
            }
            for (int i = 0; i < selfRenderers.Length; i++)
                if (selfRenderers[i]) selfRenderers[i].shadowCastingMode = hide ? UnityEngine.Rendering.ShadowCastingMode.ShadowsOnly : selfModes[i];
        }

        float camDist = 5f;
        const float CamRadius = 0.22f, CamMin = 0.35f;

        /// R17-U：鏡頭可退多遠。SphereCastAll 取最近的非玩家碰撞（含 CamOcclusion 鏡頭層），
        /// 再檢查鏡頭點本身有沒有埋在物件裡（SphereCast 起點就重疊時會漏掉），有就一路往前拉近。
        public static float CamClearDistance(Vector3 pivot, Vector3 dir, float maxDist, Transform self)
        {
            float best = maxDist;
            foreach (var h in Physics.SphereCastAll(pivot, CamRadius, dir, maxDist, ~0, QueryTriggerInteraction.Ignore))
            {
                if (h.distance <= 0f || IsSelf(h.collider, self)) continue;
                if (h.distance < best) best = h.distance;
            }
            best = Mathf.Max(CamMin, best - 0.05f);
            for (int i = 0; i < 12 && best > CamMin; i++)
            {
                if (!Blocked(pivot + dir * best, self)) break;
                best = Mathf.Max(CamMin, best - 0.4f);
            }
            return best;
        }

        static readonly Collider[] overlap = new Collider[8];
        static bool Blocked(Vector3 p, Transform self)
        {
            int n = Physics.OverlapSphereNonAlloc(p, CamRadius * 0.8f, overlap, ~0, QueryTriggerInteraction.Ignore);
            for (int i = 0; i < n; i++) if (!IsSelf(overlap[i], self)) return true;
            return false;
        }

        static bool IsSelf(Collider c, Transform self) =>
            (self && c.transform.IsChildOf(self)) || c.GetComponentInParent<PlayerController>() || c is CharacterController;

        // 樹冠沒有碰撞體：沿用暫時只投影，兼看鏡頭所在處與鏡頭到角色的視線。
        static readonly string[] FoliageKeys = { "maple", "willow", "pine", "wutong", "bamboo", "banana", "tree" };
        static System.Collections.Generic.List<Renderer> foliage;
        static readonly System.Collections.Generic.Dictionary<Renderer, UnityEngine.Rendering.ShadowCastingMode> hidden = new System.Collections.Generic.Dictionary<Renderer, UnityEngine.Rendering.ShadowCastingMode>();
        static readonly System.Collections.Generic.List<Renderer> toShow = new System.Collections.Generic.List<Renderer>();

        void OnDisable() { RestoreFoliage(); HideSelf(false); }

        static void RestoreFoliage()
        {
            foreach (var item in hidden) if (item.Key) item.Key.shadowCastingMode = item.Value;
            hidden.Clear();
        }

        static void UpdateFoliage(Vector3 camPos, Vector3 feet)
        {
            if (foliage == null)
            {
                foliage = new System.Collections.Generic.List<Renderer>();
                foreach (var r in FindObjectsByType<MeshRenderer>(FindObjectsSortMode.None))
                {
                    if (r.bounds.size.y < 1f) continue;
                    bool tree = false;
                    for (var t = r.transform; t && !tree; t = t.parent)
                    {
                        string n = t.name.ToLowerInvariant();
                        foreach (var k in FoliageKeys) if (n.Contains(k)) { tree = true; break; }
                    }
                    if (tree) foliage.Add(r);
                }
            }
            toShow.Clear();
            foreach (var item in hidden)
                if (!item.Key || !ObscuresPlayer(item.Key.bounds, camPos, feet)) toShow.Add(item.Key);
            foreach (var r in toShow)
            {
                var mode = hidden[r]; hidden.Remove(r);
                if (r) r.shadowCastingMode = mode;
            }
            foreach (var r in foliage)
                if (r && r.enabled && !hidden.ContainsKey(r) && ObscuresPlayer(r.bounds, camPos, feet)
                    && r.shadowCastingMode != UnityEngine.Rendering.ShadowCastingMode.ShadowsOnly)
                {
                    hidden.Add(r, r.shadowCastingMode);
                    r.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.ShadowsOnly;
                }
        }

        static bool ObscuresPlayer(Bounds b, Vector3 camera, Vector3 feet)
        {
            // shortcut: 用樹的包圍盒保護角色輪廓；若鬆散樹冠隱藏過多，再改成網格判定。
            return CamOcclusion.BlocksView(b, camera, feet + Vector3.up * 0.3f)
                || CamOcclusion.BlocksView(b, camera, feet + Vector3.up * 1f)
                || CamOcclusion.BlocksView(b, camera, feet + Vector3.up * 1.7f);
        }
    }
}
using UnityEngine;
using UnityEngine.AI;

namespace Liuruan
{
    public sealed class CompanionFollow : MonoBehaviour
    {
        [SerializeField] private Transform player;
        [SerializeField, Min(0f)] private float followSpeed = 3f;
        [SerializeField, Min(1f)] private float catchupMultiplier = 1.6f;
        private NavMeshAgent agent;
        private readonly CompanionCore core = new CompanionCore();
        private Vector3 previousPosition;
        public float Speed { get; private set; }
        public float CooldownRatio => core.CooldownRatio;
        public CompanionState State => core.State;
        public bool Call() => core.Call();
        private bool AgentReady => agent != null && agent.enabled && agent.isOnNavMesh;
        private void Awake() => agent = GetComponent<NavMeshAgent>();
        private void OnEnable() { previousPosition = transform.position; Speed = 0f; }

        private void Update()
        {
            float dt = Time.deltaTime;
            Speed = dt > 0f ? Vector3.Distance(transform.position, previousPosition) / dt : 0f;
            previousPosition = transform.position;
            if (player == null)
            {
                if (AgentReady) agent.ResetPath();
                Speed = 0f;
                return;
            }
            CompanionState state = core.Tick(dt, ToCore(player.position),
                ToCore(transform.position), ToCore(player.forward));
            Vector3 target = ToUnity(core.Destination);
            if (state == CompanionState.Teleport)
            {
                // shortcut: 僅搜尋目標附近 2m 的 NavMesh；複雜多層地形由 U 線提供安全落點。
                bool ready = AgentReady;
                if (NavMesh.SamplePosition(target, out NavMeshHit hit, 2f, NavMesh.AllAreas))
                    target = hit.position;
                if (ready) agent.ResetPath();
                if (!ready || !agent.Warp(target)) transform.position = target;
                previousPosition = transform.position;
                Speed = 0f;
                return;
            }
            float speed = state == CompanionState.Catchup ? followSpeed * catchupMultiplier : followSpeed;
            if (AgentReady)
            {
                agent.stoppingDistance = 2.4f;
                agent.speed = speed;
                agent.isStopped = state == CompanionState.Idle;
                if (state != CompanionState.Idle) agent.SetDestination(target);
            }
            else if (state != CompanionState.Idle)
            {
                float remaining = Mathf.Max(0f, Vector3.Distance(transform.position, target) - 2.4f);
                transform.position = Vector3.MoveTowards(transform.position, target, Mathf.Min(speed * dt, remaining));
            }
        }

        private void OnDisable()
        {
            if (AgentReady) agent.ResetPath();
            Speed = 0f;
        }
        private static WorldPosition ToCore(Vector3 p) => new WorldPosition(p.x, p.y, p.z);
        private static Vector3 ToUnity(WorldPosition p) => new Vector3(p.X, p.Y, p.Z);
    }
}

