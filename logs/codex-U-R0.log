using System;
using System.Collections;
using System.Text;
using UnityEngine;
using UnityEngine.Networking;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// Boot 場景唯一的元件。WebGL 版 Main 場景不在主包：從 StreamingAssets/scene/ 依 parts.json 依序下載各塊、
    /// 拼回完整 bundle 再 LoadFromMemoryAsync，最後載入 Main（Editor/SceneBundles.cs 產生這些檔）。
    /// Editor 直接 LoadScene("Main")（Main 仍在 Build Settings）。畫面文字只用英文／數字，避免 TMP 中文缺字。
    public class BootLoader : MonoBehaviour
    {
        public const string MainScene = "Main", BundleName = "main", Dir = "scene", IndexFile = "parts.json";
        public const int PartSize = 20 * 1024 * 1024; // 每塊 20 MiB，低於 Cloudflare Pages 單檔 25 MiB

        /// parts.json：{ "name": "main", "parts": 2, "bytes": 31457280 }
        [Serializable] public class Parts { public string name; public int parts; public long bytes; }

#pragma warning disable CS0169, CS0649 // 下面三個欄位只在 WebGL 分支寫入；Editor 編譯時別洗警告
        static AssetBundle bundle; // 刻意不卸載：「重新開始」用 LoadScene("Main") 重載時還要用
        long doneBytes, totalBytes;
#pragma warning restore CS0169, CS0649

        string status = "Loading...";
        bool failed;
        UnityWebRequest current;
        GUIStyle label, button;

        void Start() => StartCoroutine(Run());

        IEnumerator Run()
        {
            failed = false;
            status = "Loading...";
#if UNITY_WEBGL && !UNITY_EDITOR
            if (!bundle)
            {
                string dir = $"{Application.streamingAssetsPath}/{Dir}/", v = $"?v={Application.buildGUID}"; // ?v= 讓新版不吃到 CDN 舊檔
                byte[] json = null;
                yield return Download(dir + IndexFile + v, d => json = d);
                if (json == null) { Fail("Network error (E1). Please check your connection and retry."); yield break; }
                Parts p = null;
                try { p = JsonUtility.FromJson<Parts>(Encoding.UTF8.GetString(json)); }
                catch (Exception e) { Debug.LogError($"[Boot] parts.json parse failed (got index.html?): {e.Message}"); }
                if (p == null || p.name != BundleName || p.bytes <= 0 || p.bytes > int.MaxValue
                    || p.parts != (p.bytes + PartSize - 1) / PartSize)
                { Fail("Data error (E2). Please reload the page."); yield break; }

                var all = new byte[p.bytes];
                totalBytes = p.bytes;
                doneBytes = 0;
                for (int i = 0; i < p.parts; i++)
                {
                    byte[] part = null;
                    yield return Download($"{dir}{p.name}.{i}{v}", d => part = d);
                    if (part == null) { Fail($"Network error (E3, part {i + 1}/{p.parts}). Please retry."); yield break; }
                    if (doneBytes + part.Length > all.Length) { Fail($"Data error (E4, part {i + 1}). Please reload the page."); yield break; }
                    Buffer.BlockCopy(part, 0, all, (int)doneBytes, part.Length);
                    doneBytes += part.Length;
                }
                if (doneBytes != all.Length) { Fail($"Data error (E4, {doneBytes}/{all.Length}). Please reload the page."); yield break; }

                status = "Unpacking...";
                var load = AssetBundle.LoadFromMemoryAsync(all);
                all = null; // 引擎已有自己的副本，放掉讓 GC 回收
                yield return load;
                bundle = load.assetBundle;
                if (!bundle) { Fail("Load error (E5). Please reload the page."); yield break; }
            }
#endif
            status = "Starting...";
            var op = SceneManager.LoadSceneAsync(MainScene);
            if (op == null) { Fail("Load error (E6). Please reload the page."); yield break; } // Editor：Main 不在 Build Settings
            yield return op;
        }

        void Fail(string message)
        {
            Debug.LogError("[Boot] " + message);
            status = message;
            failed = true;
            current = null;
        }

        /// 網路不穩重試 3 次；全失敗不呼叫 done（呼叫端以 null 判斷）
        IEnumerator Download(string url, Action<byte[]> done)
        {
            for (int tries = 1; tries <= 3; tries++)
                using (var req = UnityWebRequest.Get(url))
                {
                    current = req;
                    yield return req.SendWebRequest();
                    current = null;
                    if (req.result == UnityWebRequest.Result.Success) { done(req.downloadHandler.data); yield break; }
                    Debug.LogWarning($"[Boot] download failed (try {tries}) {url}: {req.error}");
                    if (tries < 3) yield return new WaitForSecondsRealtime(tries);
                }
        }

        void OnGUI()
        {
            int size = Mathf.Max(16, Screen.height / 28);
            if (label == null)
            {
                label = new GUIStyle(GUI.skin.label) { alignment = TextAnchor.MiddleCenter, wordWrap = true };
                label.normal.textColor = new Color(0.96f, 0.9f, 0.78f);
                button = new GUIStyle(GUI.skin.button);
            }
            label.fontSize = button.fontSize = size;

            string text = status;
            if (!failed && totalBytes > 0 && status == "Loading...")
            {
                long got = doneBytes + (current != null ? (long)current.downloadedBytes : 0);
                text = $"Loading {Mathf.Clamp(100f * got / totalBytes, 0f, 100f):0}%  ({got / 1048576f:0.0} / {totalBytes / 1048576f:0.0} MB)";
            }
            float w = Mathf.Min(Screen.width - 32, size * 30);
            GUI.Label(new Rect((Screen.width - w) / 2, Screen.height / 2 - size * 2, w, size * 3), text, label);
            if (failed && GUI.Button(new Rect((Screen.width - size * 6) / 2, Screen.height / 2 + size * 1.5f, size * 6, size * 2), "Retry", button))
                StartCoroutine(Run());
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// 作答紀錄（PlayerPrefs）：每題答對前的作答次數、是否已答對、答對前是否看過白話。
    /// 題號 = 線索 id；結局推論題 = 固定 InferId（100，不與線索 id 撞號）。首答正確 = 已答對且只答了 1 次。
    /// 小遊戲不計分，見 ClueManager.IsScored。
    public static class QuizStats
    {
        /// 推論題固定題號；線索 id 必須小於它（check.py 另驗）
        public const int InferId = 100;
        /// 線索題號上限（不含推論題），依 ClueManager 實際最大 id
        static int MaxClueId => ClueManager.I != null && ClueManager.I.Clues.Count > 0 ? ClueManager.I.Clues[ClueManager.I.Clues.Count - 1].id : ClueManager.EndingId;
        static System.Collections.Generic.IEnumerable<int> Ids()
        {
            for (int i = 0; i <= MaxClueId; i++) yield return i;
            yield return InferId;
        }
        const int ClearMax = 64; // 重新開始時一律清到這裡，不依賴 ClueManager 是否在場

        static string TriesKey(int id) => $"liulaolao_q{id}_tries";
        static string SolvedKey(int id) => $"liulaolao_q{id}_solved";
        static string PlainKey(int id) => $"liulaolao_q{id}_plain";

        public static bool Solved(int id) => PlayerPrefs.GetInt(SolvedKey(id), 0) == 1;
        public static int Tries(int id) => PlayerPrefs.GetInt(TriesKey(id), 0);
        public static bool SawPlain(int id) => PlayerPrefs.GetInt(PlainKey(id), 0) == 1;
        public static bool FirstTryCorrect(int id) => Solved(id) && Tries(id) == 1;

        static bool Scored(int id) => ClueManager.I == null || ClueManager.I.IsScored(id);

        /// 只記「第一次答對之前」的作答，重看已答對的卷軸不改成績。
        public static void Record(int id, bool correct)
        {
            if (Solved(id)) return;
            PlayerPrefs.SetInt(TriesKey(id), Tries(id) + 1);
            if (correct) PlayerPrefs.SetInt(SolvedKey(id), 1);
            PlayerPrefs.Save();
        }

        public static void MarkPlain(int id)
        {
            if (Solved(id) || SawPlain(id)) return;
            PlayerPrefs.SetInt(PlainKey(id), 1);
            PlayerPrefs.Save();
        }

        public static int ScoredCount()
        {
            int n = 0;
            foreach (int i in Ids()) if (Scored(i)) n++;
            return n;
        }

        public static int FirstTryCount()
        {
            int n = 0;
            foreach (int i in Ids()) if (Scored(i) && FirstTryCorrect(i)) n++;
            return n;
        }

        /// 有白話的計分題中，沒看白話就答對的題數
        public static int NoPlainCount()
        {
            int n = 0;
            for (int i = 0; i <= MaxClueId; i++) if (Scored(i) && Solved(i) && !SawPlain(i)) n++;
            return n;
        }

        /// 有白話的計分題數（NoPlainCount 的分母；推論題沒有白話，不算）
        public static int PlainScoredCount()
        {
            int n = 0;
            for (int i = 0; i <= MaxClueId; i++) if (Scored(i)) n++;
            return n;
        }

        public static int TotalTries()
        {
            int n = 0;
            foreach (int i in Ids()) if (Scored(i)) n += Tries(i);
            return n;
        }

        public static void Clear()
        {
            for (int i = 0; i <= Mathf.Max(InferId, ClearMax); i++)
            {
                PlayerPrefs.DeleteKey(TriesKey(i));
                PlayerPrefs.DeleteKey(SolvedKey(i));
                PlayerPrefs.DeleteKey(PlainKey(i));
            }
            PlayerPrefs.Save();
        }
    }
}
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// 畫質高／低（右上「畫質」鈕）。自動建立（不必掛在場景裡），跨場景重載保留；選擇存在 PlayerPrefs。
    /// 舊版只開關 SSAO，但 WebGL 用的 Mobile_Renderer 根本沒有 SSAO、場景裡也沒掛元件，按了沒反應（審查技術 #4）。
    /// 現在「低」是實際降級：renderScale ×0.8（下限 0.5）、關主光陰影（shadowDistance 0）、關 HDR、關 Bloom；
    /// 「高」＝目前的管線設定（啟動時記下的原值）。預設：觸控裝置低、桌機高。
    /// 裝置判斷與 RenderGovernor 共用 TouchInput.Enabled（審查 #18）：iPadOS Safari 回報為桌機，
    /// 第一次觸控後才知道是平板；玩家還沒自己選過畫質時，此刻自動改成低。
    /// Round8 自動降畫質（只降不升、每次開遊戲最多一次、不寫 PlayerPrefs）：玩家沒選過畫質、目前是高、
    /// 而且正在走動（不在讀卷軸省電、不在演出）時量幀率；進場 6 秒暖機後，連續 8 秒平均低於 24fps 才降為低。
    /// 手機預設就是低、上限 30fps，不受影響；主要救學校的老筆電／內顯桌機。編輯器不啟用（Editor 幀率不代表 WebGL）。
    public class QualityToggle : MonoBehaviour
    {
        public static QualityToggle I { get; private set; }
        const string Key = "liulaolao_quality_high";
        const float LowScaleFactor = 0.8f, MinScale = 0.5f;
        const float AutoWarmup = 6f, AutoWindow = 8f, AutoMinFps = 24f, AutoMaxFrame = 0.5f;

        public bool High { get; private set; }

        UniversalRenderPipelineAsset urp;
        float origScale, origShadow;
        int origMsaa;
        bool origHdr, captured, touchChecked, autoDone;
        // R30：桌機「高」比手機管線再往上一級（WebGL 一律用 Mobile_RPAsset）
        const float DesktopScale = 1f, DesktopShadow = 45f;
        const int DesktopMsaa = 4; // 不動 cascade 數：build 會依管線資產剝掉 cascade 變體
        float autoWarm, autoTime;
        int autoFrames;

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void Boot()
        {
            if (I) return;
            var go = new GameObject("QualityToggle");
            DontDestroyOnLoad(go);
            go.AddComponent<QualityToggle>();
        }

        void Awake()
        {
            if (I && I != this) { Destroy(this); return; }
            I = this;
            urp = GraphicsSettings.currentRenderPipeline as UniversalRenderPipelineAsset;
            if (urp)
            {
                origScale = urp.renderScale;
                origShadow = urp.shadowDistance;
                origHdr = urp.supportsHDR;
                origMsaa = urp.msaaSampleCount;
                captured = true;
            }
            int def = TouchInput.Enabled ? 0 : 1;
            High = PlayerPrefs.GetInt(Key, def) == 1;
            SceneManager.sceneLoaded += OnSceneLoaded;
        }

        void Start() => Apply(High);

        void Update()
        {
            AutoDowngrade();
            if (touchChecked || !TouchInput.Enabled) return;
            touchChecked = true;
            if (High && !PlayerPrefs.HasKey(Key)) Apply(false); // 不寫 PlayerPrefs：仍算「沒選過」；ScrollUI 會同步按鈕文字
        }

        void AutoDowngrade()
        {
            if (autoDone || Application.isEditor) return;
            if (!High || PlayerPrefs.HasKey(Key)) { autoDone = true; return; }
            float dt = Time.unscaledDeltaTime;
            var ui = ScrollUI.I;
            // 讀卷軸（場景暫停、限 30fps）、演出、切到別的分頁回來的長幀（> 0.5 秒）都不算；暖機期間也不算（著色器第一次編譯會卡）
            if (RenderGovernor.Reading || (ui && ui.Cinematic) || dt > AutoMaxFrame) { autoTime = 0; autoFrames = 0; return; }
            if (autoWarm < AutoWarmup) { autoWarm += dt; return; }
            autoTime += dt; autoFrames++;
            if (autoTime < AutoWindow) return;
            if (autoFrames / autoTime < AutoMinFps) { Apply(false); autoDone = true; } // ScrollUI 每幀同步畫質鈕文字
            autoTime = 0; autoFrames = 0;
        }

        void OnSceneLoaded(Scene s, LoadSceneMode m) => Apply(High); // 新場景的 Volume 也要套 Bloom 開關

        public void Toggle()
        {
            autoDone = true; // 玩家自己選過就不再自動調
            Apply(!High);
            PlayerPrefs.SetInt(Key, High ? 1 : 0);
            PlayerPrefs.Save();
        }

        void Apply(bool high)
        {
            High = high;
            if (urp && captured)
            {
                bool desktop = high && !TouchInput.Enabled;
                urp.renderScale = desktop ? DesktopScale : high ? origScale : Mathf.Max(MinScale, origScale * LowScaleFactor);
                urp.shadowDistance = desktop ? DesktopShadow : high ? origShadow : 0f;
                urp.msaaSampleCount = desktop ? DesktopMsaa : origMsaa;
                urp.supportsHDR = high && origHdr;
            }
            SetBloom(high);
        }

        static void SetBloom(bool on)
        {
            foreach (var v in FindObjectsByType<Volume>(FindObjectsSortMode.None))
            {
                var prof = v.HasInstantiatedProfile() ? v.profile : v.sharedProfile;
                if (prof && prof.TryGet<Bloom>(out var bloom)) bloom.active = on;
            }
        }

        void OnDestroy()
        {
            SceneManager.sceneLoaded -= OnSceneLoaded;
#if UNITY_EDITOR
            // 編輯器中別把管線資產／Volume Profile 留成低畫質
            if (urp && captured) { urp.renderScale = origScale; urp.shadowDistance = origShadow; urp.supportsHDR = origHdr; urp.msaaSampleCount = origMsaa; }
            SetBloom(true);
#endif
        }
    }
}
using UnityEngine;
using UnityEngine.Rendering.Universal;

namespace Liulaolao
{
    /// 省電：限幀＋讀卷軸時暫停 3D 場景。自動建立（不必掛在場景裡），跨場景重載保留。
    /// - 幀率上限：桌機 60、手機（含觸控過的平板）30；面板開著時桌機 30、手機 20。
    /// - ScrollUI 任何面板或小遊戲（LaughMatch／EggMinigame 全螢幕不透明）開著、且不是演出中：
    ///   主相機 cullingMask = 0、純色清除、關後製與陰影 → 只剩清畫面＋UI。關閉後原樣恢復。
    ///   （不直接 disable 相機：沒有相機時 Screen Space Overlay UI 在部分平台不保證重畫）
    public class RenderGovernor : MonoBehaviour
    {
        // 桌機 -1＝交給瀏覽器 requestAnimationFrame（WebGL 設定 targetFrameRate 可能改走 setTimeout，高更新率螢幕會抖）
        const int DesktopFps = -1, MobileFps = 30, DesktopReadingFps = 30, MobileReadingFps = 20;
        static readonly Color PausedBg = new Color(0.12f, 0.09f, 0.06f, 1f);

        Camera paused;
        int savedMask;
        CameraClearFlags savedFlags;
        Color savedBg;
        bool savedPost, savedShadows, hadData;
        int lastFps = -2;

        /// 目前是「讀卷軸省電」狀態（3D 場景暫停、限幀）。QualityToggle 量幀率時要排除這段。
        public static bool Reading { get; private set; }

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void Boot()
        {
            var go = new GameObject("RenderGovernor");
            DontDestroyOnLoad(go);
            go.AddComponent<RenderGovernor>();
        }

        void Awake() => QualitySettings.vSyncCount = 0; // 桌機上 vSync 會蓋掉 targetFrameRate

        void Update()
        {
            var ui = ScrollUI.I;
            // 夾蛋小遊戲要即時反應，不降幀也不暫停（判定窗約 0.23 秒，手機 20fps 只剩 4–5 幀）
            bool reading = ui && !ui.Cinematic && (ui.PanelOpen || ui.ExternalUI) && !EggMinigame.Running;
            Reading = reading;
            bool mobile = TouchInput.Enabled;
            int fps = reading ? (mobile ? MobileReadingFps : DesktopReadingFps) : (mobile ? MobileFps : DesktopFps);
            if (fps != lastFps) { Application.targetFrameRate = fps; lastFps = fps; }

            if (reading && !paused) Pause(Camera.main);
            else if (!reading && paused) Resume();
            else if (paused && paused != Camera.main) Resume(); // 場景重載或換相機
        }

        void Pause(Camera cam)
        {
            if (!cam) return;
            paused = cam;
            savedMask = cam.cullingMask;
            savedFlags = cam.clearFlags;
            savedBg = cam.backgroundColor;
            var data = cam.GetComponent<UniversalAdditionalCameraData>();
            hadData = data;
            if (data)
            {
                savedPost = data.renderPostProcessing;
                savedShadows = data.renderShadows;
                data.renderPostProcessing = false;
                data.renderShadows = false;
            }
            cam.cullingMask = 0;
            cam.clearFlags = CameraClearFlags.SolidColor;
            cam.backgroundColor = PausedBg;
        }

        void Resume()
        {
            var cam = paused;
            paused = null;
            if (!cam) return;
            cam.cullingMask = savedMask;
            cam.clearFlags = savedFlags;
            cam.backgroundColor = savedBg;
            if (hadData)
            {
                var data = cam.GetComponent<UniversalAdditionalCameraData>();
                if (data) { data.renderPostProcessing = savedPost; data.renderShadows = savedShadows; }
            }
        }
    }
}
using System.Collections.Generic;
using UnityEngine;

namespace Liulaolao
{
    /// Round10：戶外大量「靜態」擺件的距離剔除。掛在擺件根物件上（例如 _R10Outdoor），底下所有 MeshRenderer 都管。
    /// - 用 CullingGroup：每個 Renderer 一顆包圍球，距離量到球面，所以大物件（假山、亭子）自然比小盆栽晚消失；
    ///   只在跨越門檻時回呼，不必每幀掃清單。
    /// - 開關 Renderer.enabled，不碰 forceRenderingOff：ZoneVisibility 用 forceRenderingOff（室內／戶外分區），
    ///   最後「有畫」＝ enabled 且 !forceRenderingOff，兩支各管各的旗標，不會互相蓋掉。
    /// - 不能管 ProximitySwap 的物件（它也用 enabled 換外殼／灰盒）：開場自動排除，並記 warning。
    /// - 只適用不會移動的擺件（包圍球只在開場算一次）；NPC、演出道具不要放進來。
    /// - 畫質「低」時距離 × lowQualityFactor。
    public class DistanceCull : MonoBehaviour
    {
        [Tooltip("超過這個距離（公尺，量到包圍球表面）就不畫")]
        public float cullDistance = 40f;
        [Tooltip("畫質「低」時的距離倍率")]
        [Range(0.3f, 1f)] public float lowQualityFactor = 0.7f;
        [Tooltip("包圍球半徑小於這個值（公尺）的小物件，距離再乘 smallFactor（花盆、石子、燈籠先消失）")]
        public float smallRadius = 0.6f;
        [Range(0.3f, 1f)] public float smallFactor = 0.6f;

        readonly List<Renderer> renderers = new List<Renderer>();
        readonly List<Renderer> small = new List<Renderer>();
        CullingGroup group, smallGroup;
        BoundingSphere[] spheres, smallSpheres; // CullingGroup 不複製陣列，必須自己留著參考
        Camera cam;
        bool lastHigh = true;

        void OnEnable()
        {
            Collect();
            cam = Camera.main;
            if (!cam) { Debug.LogWarning("[DistanceCull] Camera.main not found; disabled."); enabled = false; return; }
            group = Make(renderers, out spheres);
            smallGroup = Make(small, out smallSpheres);
            lastHigh = !QualityToggle.I || QualityToggle.I.High;
            ApplyDistances();
            Debug.Log($"[DistanceCull] {name}: {renderers.Count} renderer(s), {small.Count} small.");
        }

        void Collect()
        {
            renderers.Clear(); small.Clear();
            var swapped = new HashSet<Renderer>();
            foreach (var ps in FindObjectsByType<ProximitySwap>(FindObjectsSortMode.None))
            {
                if (ps.tripo) foreach (var r in ps.tripo.GetComponentsInChildren<Renderer>(true)) swapped.Add(r);
                if (ps.greybox != null) foreach (var r in ps.greybox) if (r) swapped.Add(r);
            }
            int skipped = 0;
            foreach (var r in GetComponentsInChildren<MeshRenderer>(true))
            {
                if (swapped.Contains(r)) { skipped++; continue; }
                if (r.bounds.extents.magnitude < smallRadius) small.Add(r); else renderers.Add(r);
            }
            if (skipped > 0) Debug.LogWarning($"[DistanceCull] {name}: skipped {skipped} renderer(s) owned by ProximitySwap.");
        }

        CullingGroup Make(List<Renderer> list, out BoundingSphere[] spheres)
        {
            spheres = new BoundingSphere[list.Count];
            for (int i = 0; i < list.Count; i++)
            {
                var b = list[i].bounds;
                spheres[i] = new BoundingSphere(b.center, b.extents.magnitude);
            }
            var g = new CullingGroup { targetCamera = cam };
            g.SetBoundingSpheres(spheres);
            g.SetBoundingSphereCount(spheres.Length);
            g.SetDistanceReferencePoint(cam.transform);
            var target = list;
            g.onStateChanged = ev =>
            {
                // 只看距離帶（0＝門檻內、1＝門檻外）；視錐剔除照舊交給 Unity
                if (ev.currentDistance != ev.previousDistance && ev.index < target.Count && target[ev.index])
                    target[ev.index].enabled = ev.currentDistance == 0;
            };
            return g;
        }

        void ApplyDistances()
        {
            float d = cullDistance * (lastHigh ? 1f : lowQualityFactor);
            group?.SetBoundingDistances(new[] { d });
            smallGroup?.SetBoundingDistances(new[] { d * smallFactor });
        }

        void Update()
        {
            // 換相機（場景重載）就重建；畫質切換就改距離
            if (Camera.main != cam) { OnDisable(); OnEnable(); return; }
            bool high = !QualityToggle.I || QualityToggle.I.High;
            if (high != lastHigh) { lastHigh = high; ApplyDistances(); }
        }

        void OnDisable()
        {
            group?.Dispose(); group = null;
            smallGroup?.Dispose(); smallGroup = null;
            foreach (var r in renderers) if (r) r.enabled = true;
            foreach (var r in small) if (r) r.enabled = true;
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// Round8：大量重複的戶外擺件（粉牆、花街鋪地、盆菊、秋草…）改走 GPU Instancing。
    /// URP 開著 SRP Batcher 時，相容的 Renderer 一律走 SRP Batcher，同模型同材質也是一個物件一個 draw call；
    /// 給 Renderer 一個 MaterialPropertyBlock 會讓它退出 SRP Batcher，改由材質的 Enable GPU Instancing 合併成一批。
    /// 掛在擺件的根物件上（_R8Outdoor），底下所有 MeshRenderer 都套用；材質要勾 Enable GPU Instancing。
    public class InstancedGroup : MonoBehaviour
    {
        static readonly int Tag = Shader.PropertyToID("_InstancedGroup");

        void Awake()
        {
            var mpb = new MaterialPropertyBlock();
            mpb.SetFloat(Tag, 1f); // 空的 block 不算數，放一個 shader 沒用到的值
            foreach (var r in GetComponentsInChildren<MeshRenderer>(true)) r.SetPropertyBlock(mpb);
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// 找東西的提示：上下飄、面向鏡頭、光一閃一閃
    public class FindGlow : MonoBehaviour
    {
        Vector3 basePos; Light lt;
        void Start() { basePos = transform.position; lt = GetComponent<Light>(); }
        void LateUpdate()
        {
            float t = Time.time;
            transform.position = basePos + Vector3.up * Mathf.Sin(t * 3f) * 0.08f;
            if (Camera.main) transform.rotation = Camera.main.transform.rotation;
            if (lt) lt.intensity = 1.5f + Mathf.Sin(t * 4f) * 1f;
        }
    }
}
