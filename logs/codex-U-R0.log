// Tools/Liulaolao/Rebuild Font Subset
// 重新產生靜態字型「NotoSerifTC Static SDF」的字集：
//   clues.json 全部非 ASCII 字元 + Scripts/**/*.cs 字串常值（文案集中在 Strings.cs）中的非 ASCII 字元 + ASCII 可列印字元 + 常用全形標點。
// 作法（依 com.unity.ugui 2.0 內建 TMP 原始碼查證）：
//   暫時切成 Dynamic（編輯器會由 m_SourceFontFileGUID 找回 NotoSerifTC-Regular.otf）
//   → ClearFontAssetData(false) 保留 2048 圖集尺寸 → TryAddCharacters → 切回 Static → 存檔。
// 原地改寫同一個 .asset，GUID 不變，ScrollUI 等既有引用不受影響。
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using TMPro;
using UnityEditor;
using UnityEngine;

namespace Liulaolao.EditorTools
{
    public static class FontSubset
    {
        const string FontAssetPath = "Assets/_Project/Fonts/NotoSerifTC Static SDF.asset";
        const string CluesPath = "Assets/_Project/Data/clues.json";
        const string WonderPath = "Assets/_Project/Data/wonder_points.json"; // Round10 驚嘆點台詞
        const string EpiloguePath = "Assets/_Project/Data/epilogue.json"; // Round11 宴後加演（先收字，避免日後方框）
        // R17 任務層資料（quests.json 正式、quests_sample.json 假資料、find_targets.json 找物標籤）
        static readonly string[] QuestPaths = { "Assets/_Project/Data/quests.json", "Assets/_Project/Data/quests_sample.json", "Assets/_Project/Data/find_targets.json" };
        const string ScriptsDir = "Assets/_Project/Scripts";
        static readonly string[] SceneDirs = { "Assets/_Project/Scenes", "Assets/Scenes" };

        const string CommonPunctuation =
            "，。、；：？！「」『』（）《》〈〉【】〔〕—…·～　＋－＝％／＊＃＠＆" +
            "０１２３４５６７８９" +
            "○●◎◇◆□■△▲▽▼☆★→←↑↓✓✔✗✘";

        static readonly Regex StringLiteral = new Regex(
            "@\"(?:[^\"]|\"\")*\"|\\$?\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)'",
            RegexOptions.Compiled);
        static readonly Regex UnicodeEscape = new Regex(@"\\u([0-9a-fA-F]{4})", RegexOptions.Compiled);

        [MenuItem("Tools/Liulaolao/Rebuild Font Subset")]
        static void Rebuild()
        {
            var fontAsset = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(FontAssetPath);
            if (fontAsset == null) { Debug.LogError("[FontSubset] 找不到 " + FontAssetPath); return; }

            string chars = CollectCharacters(out int fromJson, out int fromCs);
            if (!EditorUtility.DisplayDialog("Rebuild Font Subset",
                    $"將以 {chars.Length} 個字元重建「{fontAsset.name}」\n" +
                    $"（clues.json {fromJson}、Scripts {fromCs}、ASCII/標點補充）\n原有字集會被清空。繼續？",
                    "重建", "取消"))
                return;
            DoRebuild(fontAsset, chars);
        }

        /// R17：不跳對話框的重建（給 UnityMCP execute_code 呼叫；選單版的 DisplayDialog 會卡住自動化）。回傳摘要。
        public static string RebuildNoDialog()
        {
            var fontAsset = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(FontAssetPath);
            if (fontAsset == null) return "找不到 " + FontAssetPath;
            string chars = CollectCharacters(out int fromJson, out int fromCs);
            string missing = DoRebuild(fontAsset, chars);
            return $"chars={chars.Length} json={fromJson} cs={fromCs} table={fontAsset.characterTable.Count} missing={missing}";
        }

        /// 檢查字型是否收了這些字（回傳缺的字）
        public static string MissingIn(string text)
        {
            var fontAsset = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(FontAssetPath);
            var sb = new StringBuilder();
            foreach (char c in text ?? "")
                if (c > 0x20 && !char.IsWhiteSpace(c) && !fontAsset.HasCharacter(c)) sb.Append(c);
            return sb.ToString();
        }

        static string DoRebuild(TMP_FontAsset fontAsset, string chars)
        {
            string missingOut = "";
            int before = fontAsset.characterTable.Count;
            var oldMode = fontAsset.atlasPopulationMode;
            try
            {
                fontAsset.atlasPopulationMode = AtlasPopulationMode.Dynamic;
                fontAsset.ClearFontAssetData(false);

                fontAsset.TryAddCharacters(chars, out missingOut);
                string missing = missingOut;

                fontAsset.atlasPopulationMode = AtlasPopulationMode.Static;
                EditorUtility.SetDirty(fontAsset);
                foreach (var tex in fontAsset.atlasTextures)
                    if (tex != null) EditorUtility.SetDirty(tex);
                AssetDatabase.SaveAssets();

                int atlasCount = fontAsset.atlasTextures.Count(t => t != null && t.width > 1);
                Debug.Log($"[FontSubset] 完成：字元 {before} → {fontAsset.characterTable.Count}，圖集 {atlasCount} 張 " +
                          $"({fontAsset.atlasWidth}x{fontAsset.atlasHeight})。");
                if (!string.IsNullOrEmpty(missing))
                    Debug.LogWarning($"[FontSubset] 來源字型缺字 {missing.Length} 個：{missing}");
                if (atlasCount > 1)
                    Debug.LogWarning("[FontSubset] 字集超過一張圖集，build 會多約 4MB；可考慮刪減或降低取樣點數。");
            }
            catch (System.Exception e)
            {
                fontAsset.atlasPopulationMode = oldMode;
                Debug.LogException(e);
            }
            return missingOut;
        }

        static string CollectCharacters(out int fromJson, out int fromCs)
        {
            var set = new SortedSet<char>();

            // ASCII 可列印字元
            for (char c = (char)0x20; c <= (char)0x7E; c++) set.Add(c);
            foreach (char c in CommonPunctuation) set.Add(c);

            // clues.json：整份檔案的非 ASCII 字元（含 \uXXXX 跳脫）
            var jsonSet = new HashSet<char>();
            if (File.Exists(CluesPath))
                AddNonAscii(DecodeEscapes(File.ReadAllText(CluesPath, Encoding.UTF8)), jsonSet);
            if (File.Exists(WonderPath))
                AddNonAscii(DecodeEscapes(File.ReadAllText(WonderPath, Encoding.UTF8)), jsonSet);
            if (File.Exists(EpiloguePath))
                AddNonAscii(DecodeEscapes(File.ReadAllText(EpiloguePath, Encoding.UTF8)), jsonSet);
            foreach (var qp in QuestPaths)
                if (File.Exists(qp)) AddNonAscii(DecodeEscapes(File.ReadAllText(qp, Encoding.UTF8)), jsonSet);
            // 場景內序列化字串（Interactable 的 prompt／toast 等，YAML 以 \uXXXX 跳脫）
            foreach (var dir in SceneDirs)
                if (Directory.Exists(dir))
                    foreach (var scene in Directory.GetFiles(dir, "*.unity", SearchOption.AllDirectories))
                        AddNonAscii(DecodeEscapes(File.ReadAllText(scene, Encoding.UTF8)), jsonSet);
            if (!File.Exists(CluesPath))
                Debug.LogWarning("[FontSubset] 找不到 " + CluesPath);

            // Scripts/*.cs：只取字串／字元常值（排除註解）
            var csSet = new HashSet<char>();
            foreach (var file in Directory.Exists(ScriptsDir) ? Directory.GetFiles(ScriptsDir, "*.cs", SearchOption.AllDirectories) : new string[0])
            {
                string src = File.ReadAllText(file, Encoding.UTF8);
                src = Regex.Replace(src, @"/\*.*?\*/", "", RegexOptions.Singleline);
                var sb = new StringBuilder();
                foreach (var line in src.Split('\n'))
                {
                    // 去掉行註解（避開字串內的 //：只在常值以外截斷）
                    sb.Append(StripLineComment(line)).Append('\n');
                }
                foreach (Match m in StringLiteral.Matches(sb.ToString()))
                    AddNonAscii(DecodeEscapes(m.Value), csSet);
            }

            fromJson = jsonSet.Count;
            fromCs = csSet.Count;
            set.UnionWith(jsonSet);
            set.UnionWith(csSet);
            set.RemoveWhere(c => char.IsControl(c) || char.IsSurrogate(c) || c == '﻿');
            return new string(set.ToArray());
        }

        static string StripLineComment(string line)
        {
            bool inStr = false, verbatim = false;
            for (int i = 0; i < line.Length; i++)
            {
                char c = line[i];
                if (inStr)
                {
                    if (!verbatim && c == '\\') { i++; continue; }
                    if (c == '"')
                    {
                        if (verbatim && i + 1 < line.Length && line[i + 1] == '"') { i++; continue; }
                        inStr = false;
                    }
                }
                else if (c == '"') { inStr = true; verbatim = i > 0 && line[i - 1] == '@'; }
                else if (c == '\'' && i + 2 < line.Length) { i += line[i + 1] == '\\' ? 3 : 2; }
                else if (c == '/' && i + 1 < line.Length && line[i + 1] == '/') return line.Substring(0, i);
            }
            return line;
        }

        static string DecodeEscapes(string s) =>
            UnicodeEscape.Replace(s, m => ((char)System.Convert.ToInt32(m.Groups[1].Value, 16)).ToString());

        static void AddNonAscii(string s, HashSet<char> target)
        {
            foreach (char c in s)
                if (c > 0x7E && !char.IsWhiteSpace(c) || c == '　') target.Add(c);
        }
    }
}
using System.Collections.Generic;
using System.IO;
using System.Linq;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.Rendering;

namespace Liulaolao
{
    /// R30 畫質升級第 3 步：HDRI 天空＋烘焙光照（lightmap、light probe、reflection probe）。
    /// 依 staging/R30/laneD/audit.md 第 7 節的建議值；static 名單在 scripts/r30_static_pis.txt（PrefabInstance fileID）。
    public static class R30Lighting
    {
        const string SkyHdr = "Assets/_Project/Art/Sky/kloofendal_48d_partly_cloudy_puresky_2k.hdr";
        const string SkyMat = "Assets/_Project/Art/Sky/M_Sky_Kloofendal.mat";
        const string LightingAsset = "Assets/_Project/Settings/R30_Lighting.lighting";
        const string RootName = "_R30Lighting";
        static readonly string[] VegWords = { "bamboo", "竹", "banana", "芭蕉", "lotus", "荷", "willow", "柳", "grass", "草", "tree", "樹" };

        public static string Setup()
        {
            var log = new List<string>();
            Sky(log);
            Statics(log);
            Lights(log);
            Probes(log);
            Settings(log);
            EditorSceneManager.MarkSceneDirty(EditorSceneManager.GetActiveScene());
            EditorSceneManager.SaveOpenScenes();
            return string.Join("\n", log);
        }

        public static string Bake() => Lightmapping.BakeAsync() ? "bake started" : "bake failed to start";

        static void Sky(List<string> log)
        {
            var ti = (TextureImporter)AssetImporter.GetAtPath(SkyHdr);
            ti.textureShape = TextureImporterShape.TextureCube;
            ti.maxTextureSize = 512; // 每面 512；1024 的 RGB9E5 cube 要 24MB 記憶體，手機吃不消
            ti.mipmapEnabled = true;
            // WebGL 明指 BC6H（2MB、保留 HDR）：RGB9E5 要 8MB，自動壓縮會變 DXT5 把天空亮部截掉；
            // 不支援 BPTC 的手機由 Unity 執行期解壓，與 lightmap 同一條路
            var webgl = ti.GetPlatformTextureSettings("WebGL");
            webgl.overridden = true; webgl.maxTextureSize = 512; webgl.format = TextureImporterFormat.BC6H;
            ti.SetPlatformTextureSettings(webgl);
            ti.SaveAndReimport();

            var mat = AssetDatabase.LoadAssetAtPath<Material>(SkyMat);
            if (mat == null) { mat = new Material(Shader.Find("Skybox/Cubemap")); AssetDatabase.CreateAsset(mat, SkyMat); }
            mat.SetTexture("_Tex", AssetDatabase.LoadAssetAtPath<Cubemap>(SkyHdr));
            mat.SetFloat("_Exposure", 1f);
            EditorUtility.SetDirty(mat);

            RenderSettings.skybox = mat;
            RenderSettings.ambientMode = AmbientMode.Skybox;
            RenderSettings.ambientIntensity = 0.85f; // 1.0 時草地偏白（s3 截圖）
            RenderSettings.defaultReflectionMode = DefaultReflectionMode.Skybox;
            RenderSettings.defaultReflectionResolution = 128;
            log.Add("sky: " + SkyMat);
        }

        static bool IsVeg(Transform t)
        {
            for (; t != null; t = t.parent)
                foreach (var w in VegWords) if (t.name.ToLowerInvariant().Contains(w)) return true;
            return false;
        }

        static void Statics(List<string> log)
        {
            var cat = new Dictionary<ulong, string>();
            foreach (var line in File.ReadAllLines("scripts/r30_static_pis.txt"))
            {
                var p = line.Split('\t');
                cat[unchecked((ulong)long.Parse(p[1]))] = p[0]; // fileID 可能是負數
            }

            int matched = 0, removed = 0, uv2 = 0;
            var fbx = new HashSet<string>();
            foreach (var go in Object.FindObjectsByType<GameObject>(FindObjectsInactive.Include, FindObjectsSortMode.None))
            {
                if (!PrefabUtility.IsAnyPrefabInstanceRoot(go)) continue;
                var handle = PrefabUtility.GetPrefabInstanceHandle(go);
                if (handle == null) continue;
                if (!cat.TryGetValue(GlobalObjectId.GetGlobalObjectIdSlow(handle).targetObjectId, out var c)) continue;
                matched++;
                float scale = c == "地面" ? 0.5f : c == "假山石" ? 1.2f : 1f;
                foreach (var r in go.GetComponentsInChildren<MeshRenderer>(true))
                {
                    var flags = GameObjectUtility.GetStaticEditorFlags(r.gameObject);
                    GameObjectUtility.SetStaticEditorFlags(r.gameObject, flags | StaticEditorFlags.ContributeGI | StaticEditorFlags.ReflectionProbeStatic);
                    r.receiveGI = ReceiveGI.Lightmaps;
                    var so = new SerializedObject(r);
                    so.FindProperty("m_ScaleInLightmap").floatValue = scale;
                    so.ApplyModifiedPropertiesWithoutUndo();
                }
            }

            // 已勾 ContributeGI 的植被拿掉，免得小葉片吃光 lightmap；改用 light probe
            foreach (var r in Object.FindObjectsByType<MeshRenderer>(FindObjectsInactive.Include, FindObjectsSortMode.None))
            {
                var flags = GameObjectUtility.GetStaticEditorFlags(r.gameObject);
                if ((flags & StaticEditorFlags.ContributeGI) == 0) continue;
                if (IsVeg(r.transform))
                {
                    GameObjectUtility.SetStaticEditorFlags(r.gameObject, flags & ~StaticEditorFlags.ContributeGI);
                    r.receiveGI = ReceiveGI.LightProbes;
                    removed++;
                    continue;
                }
                var mf = r.GetComponent<MeshFilter>();
                if (mf == null || mf.sharedMesh == null) continue;
                var path = AssetDatabase.GetAssetPath(mf.sharedMesh);
                if (path.EndsWith(".fbx", System.StringComparison.OrdinalIgnoreCase)) fbx.Add(path);
                else if (path.EndsWith(".asset") && mf.sharedMesh.uv2.Length == 0)
                {
                    Unwrapping.GenerateSecondaryUVSet(mf.sharedMesh);
                    EditorUtility.SetDirty(mf.sharedMesh);
                    uv2++;
                }
            }

            foreach (var path in fbx)
            {
                var mi = (ModelImporter)AssetImporter.GetAtPath(path);
                if (mi.generateSecondaryUV) continue;
                mi.generateSecondaryUV = true;
                mi.SaveAndReimport();
            }
            AssetDatabase.SaveAssets();
            log.Add($"static: matched {matched}/{cat.Count} instances, veg ContributeGI removed {removed}, fbx lightmapUV {fbx.Count}, .asset uv2 {uv2}");
        }

        static void Lights(List<string> log)
        {
            int baked = 0;
            foreach (var l in Object.FindObjectsByType<Light>(FindObjectsInactive.Include, FindObjectsSortMode.None))
            {
                if (l.type == LightType.Directional) { l.lightmapBakeType = LightmapBakeType.Mixed; continue; }
                if (l.GetComponents<MonoBehaviour>().Length > 0) continue; // 有腳本在動的燈（FindGlow 等）維持即時
                l.lightmapBakeType = LightmapBakeType.Baked;
                baked++;
            }
            log.Add($"lights: directional→Mixed, {baked} point/spot→Baked");
        }

        static void Probes(List<string> log)
        {
            var old = GameObject.Find(RootName);
            if (old != null) Object.DestroyImmediate(old);
            var root = new GameObject(RootName);

            // 反射探針：全園一顆底＋主要區域（audit 7.2）
            var refl = new (string n, Vector3 c, Vector3 s, int res)[]
            {
                ("RP_Global", new Vector3(-11, 6, -7), new Vector3(130, 40, 200), 128),
                ("RP_qiushuang", new Vector3(15.3f, 3, 59.6f), new Vector3(33, 10, 19), 128),
                ("RP_banquet", new Vector3(37.1f, 3, 70.1f), new Vector3(18, 10, 20), 128),
                ("RP_xiaoxiang", new Vector3(-50, 3, 41.6f), new Vector3(28, 10, 35), 128),
                ("RP_entrance", new Vector3(-2, 3, -87), new Vector3(36, 10, 26), 128),
                ("RP_qinfang", new Vector3(2.2f, 3, -26.8f), new Vector3(76, 12, 38), 128),
                ("RP_pond", new Vector3(31.3f, 3, 29.6f), new Vector3(12, 10, 10), 128),
            };
            foreach (var p in refl)
            {
                var go = new GameObject(p.n);
                go.transform.SetParent(root.transform);
                go.transform.position = p.c;
                var rp = go.AddComponent<ReflectionProbe>();
                rp.mode = ReflectionProbeMode.Baked;
                rp.size = p.s;
                rp.resolution = p.res;
                rp.boxProjection = p.n != "RP_Global";
                rp.importance = p.n == "RP_Global" ? 0 : 1;
                rp.hdr = true;
            }

            // Light probe：每 6m 一點，貼地 0.5m 與 2.2m 兩層；往下打不到東西就跳過
            var pts = new List<Vector3>();
            for (float x = -72; x <= 49; x += 6)
                for (float z = -105; z <= 90; z += 6)
                    if (Physics.Raycast(new Vector3(x, 40, z), Vector3.down, out var hit, 60))
                    {
                        pts.Add(hit.point + Vector3.up * 0.5f);
                        pts.Add(hit.point + Vector3.up * 2.2f);
                    }
            var lpg = new GameObject("LightProbes").AddComponent<LightProbeGroup>();
            lpg.transform.SetParent(root.transform);
            lpg.probePositions = pts.ToArray();
            log.Add($"probes: {refl.Length} reflection, {pts.Count} light probes");
        }

        static void Settings(List<string> log)
        {
            var s = AssetDatabase.LoadAssetAtPath<LightingSettings>(LightingAsset);
            if (s == null) { s = new LightingSettings(); AssetDatabase.CreateAsset(s, LightingAsset); }
            s.bakedGI = true;
            s.realtimeGI = false;
            s.mixedBakeMode = MixedLightingMode.IndirectOnly;
            s.lightmapper = LightingSettings.Lightmapper.ProgressiveGPU;
            s.lightmapResolution = 4;
            s.lightmapMaxSize = 1024;
            s.lightmapPadding = 2;
            s.directionalityMode = LightmapsMode.NonDirectional;
            s.lightmapCompression = LightmapCompression.NormalQuality;
            s.ao = true;
            s.aoMaxDistance = 1f;
            s.directSampleCount = 32;
            s.indirectSampleCount = 256;
            s.environmentSampleCount = 256;
            s.maxBounces = 2;
            EditorUtility.SetDirty(s);
            AssetDatabase.SaveAssets();
            Lightmapping.lightingSettings = s;
            log.Add("lighting settings: " + LightingAsset);
        }
    }
}
using System.IO;
using UnityEditor;
using UnityEngine;
using UnityEngine.Rendering.Universal;

namespace Liulaolao
{
    /// R30 畫質升級：固定機位截圖，做改前／改後對照（輸出 Captures/r30/<tag>_<shot>.png）
    public static class R30Capture
    {
        static readonly (string name, Vector3 pos, Vector3 look)[] Shots =
        {
            ("a_entrance", new Vector3(0, 2, -100), new Vector3(0, 3, -80)),
            ("b_pond", new Vector3(-15, 4, -45), new Vector3(5, 1, -15)),
            ("c_xiaoxiang", new Vector3(-40, 2.2f, 28), new Vector3(-50, 3, 41)),
            ("d_qiushuang", new Vector3(16, 2, 44), new Vector3(16, 2.5f, 55)),
            ("e_overview", new Vector3(40, 25, -70), new Vector3(-5, 0, 10)),
            ("f_banquet", new Vector3(30, 2, 58), new Vector3(36, 2, 69)),
        };

        public static string Run(string tag)
        {
            string dir = Path.GetFullPath(Path.Combine(Application.dataPath, "../Captures/r30"));
            Directory.CreateDirectory(dir);
            foreach (var ps in Object.FindObjectsByType<ParticleSystem>(FindObjectsSortMode.None)) ps.Simulate(10f, true, true);
            var go = new GameObject("_R30CaptureCam") { hideFlags = HideFlags.HideAndDontSave };
            var cam = go.AddComponent<Camera>();
            cam.fieldOfView = 55; cam.nearClipPlane = 0.1f; cam.farClipPlane = 1000;
            go.AddComponent<UniversalAdditionalCameraData>().renderPostProcessing = true;
            var rt = new RenderTexture(1280, 720, 24, RenderTextureFormat.ARGB32) { antiAliasing = 4 };
            var tex = new Texture2D(1280, 720, TextureFormat.RGB24, false);
            try
            {
                foreach (var s in Shots)
                {
                    go.transform.position = s.pos;
                    go.transform.LookAt(s.look);
                    cam.targetTexture = rt;
                    cam.Render();
                    RenderTexture.active = rt;
                    tex.ReadPixels(new Rect(0, 0, 1280, 720), 0, 0);
                    File.WriteAllBytes(Path.Combine(dir, $"{tag}_{s.name}.png"), tex.EncodeToPNG());
                }
            }
            finally
            {
                RenderTexture.active = null;
                cam.targetTexture = null;
                Object.DestroyImmediate(go);
                Object.DestroyImmediate(rt);
                Object.DestroyImmediate(tex);
            }
            return dir;
        }
    }
}

