using System;
using System.IO;
using UnityEditor;
using UnityEditor.Build.Reporting;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// WebGL 分包（仿 oz-journey ZoneBundles）：Main.unity 打成 LZMA scene bundle「main」，切成 ≤20 MiB 的
    /// StreamingAssets/scene/main.0、.1…＋parts.json；主包只放 Boot.unity（BootLoader 下載拼回後載入 Main）。
    /// EditorBuildSettings 不動：Editor 直接開 Main.unity 按 Play 照舊。
    /// 一鍵：-executeMethod Liulaolao.SceneBundles.BuildAll
    public static class SceneBundles
    {
        const string MainScenePath = "Assets/_Project/Scenes/Main.unity";
        const string BootScenePath = "Assets/_Project/Scenes/Boot.unity";
        const string OutDir = "Build/SceneBundles";      // 增量建置快取；SceneBundles.manifest 給程式碼裁剪用
        const string PlayerDir = "Build/WebGL";
        const string ServeDir = PlayerDir + "/StreamingAssets/" + BootLoader.Dir;
        const string DoneFlag = PlayerDir + "/.bundle-done"; // 全部成功才寫；外部用它判斷建置結束
        const long MaxFile = 25L * 1024 * 1024;          // Cloudflare Pages 單檔上限

        [MenuItem("Tools/Liulaolao/Build/Scene Bundle Only")]
        public static void BuildBundleOnlyMenu()
        {
            bool ok = BuildBundle() && (!Directory.Exists(PlayerDir) || CopyToPlayer());
            if (Application.isBatchMode) EditorApplication.Exit(ok ? 0 : 1);
        }

        /// 建 bundle → 建 WebGL（只含 Boot）→ bundle 切塊放進 Build/WebGL/StreamingAssets/scene → 寫 .bundle-done
        [MenuItem("Tools/Liulaolao/Build/WebGL + Scene Bundle")]
        public static void BuildAll()
        {
            if (File.Exists(DoneFlag)) File.Delete(DoneFlag);
            bool ok = EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo() && EnsureBootScene() && BuildBundle();
            if (ok)
            {
                // PlayerSettings（Brotli、檔名雜湊、模板、記憶體）沿用 ProjectSettings 現有 WebGL 設定
                var report = BuildPipeline.BuildPlayer(new BuildPlayerOptions
                {
                    scenes = new[] { BootScenePath },
                    locationPathName = PlayerDir,
                    target = BuildTarget.WebGL,
                    targetGroup = BuildTargetGroup.WebGL,
                    assetBundleManifestPath = $"{OutDir}/{Path.GetFileName(OutDir)}.manifest", // 只在 bundle 用到的型別／引擎模組不被裁掉
                });
                ok = report.summary.result == BuildResult.Succeeded;
                Debug.Log($"[SceneBundles] WebGL {report.summary.result}");
                if (ok) ok = CopyToPlayer(); // BuildPlayer 之後才複製，避免被 StreamingAssets 覆蓋
            }
            if (ok) File.WriteAllText(DoneFlag, DateTime.Now.ToString("o") + "\n");
            else Debug.LogError("[SceneBundles] 建置失敗，未寫 .bundle-done");
            if (Application.isBatchMode) EditorApplication.Exit(ok ? 0 : 1);
        }

        static bool BuildBundle()
        {
            // bundle 讀磁碟上的場景：Main 有未存修改時先問（batch mode 直接回 true）
            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return false;
            Directory.CreateDirectory(OutDir);
            // 預設 LZMA：檔案最小（CF 以存放大小算 25 MiB；octet-stream 不一定會再壓）
            var manifest = BuildPipeline.BuildAssetBundles(OutDir, new[]
            {
                new AssetBundleBuild { assetBundleName = BootLoader.BundleName, assetNames = new[] { MainScenePath } },
            }, BuildAssetBundleOptions.None, BuildTarget.WebGL);
            if (!manifest) { Debug.LogError("[SceneBundles] bundle 建置失敗"); return false; }
            long size = new FileInfo(Path.Combine(OutDir, BootLoader.BundleName)).Length;
            Debug.Log($"[SceneBundles] {BootLoader.BundleName} {size / 1048576f:F2} MiB");
            return true;
        }

        /// 切成 ≤20 MiB 的 main.0、.1…，寫 parts.json；任何一塊超過 25 MiB 就失敗
        static bool CopyToPlayer()
        {
            if (Directory.Exists(ServeDir)) Directory.Delete(ServeDir, true);
            Directory.CreateDirectory(ServeDir);
            var data = File.ReadAllBytes(Path.Combine(OutDir, BootLoader.BundleName));
            if (data.LongLength == 0 || data.LongLength > int.MaxValue) { Debug.LogError("[SceneBundles] bundle 大小無效"); return false; }
            int n = (int)((data.LongLength + BootLoader.PartSize - 1) / BootLoader.PartSize);
            for (int i = 0; i < n; i++)
            {
                int len = (int)Math.Min(BootLoader.PartSize, data.LongLength - (long)i * BootLoader.PartSize);
                if (len > MaxFile) { Debug.LogError($"[SceneBundles] {BootLoader.BundleName}.{i} 超過 25 MiB"); return false; }
                using (var fs = File.Create(Path.Combine(ServeDir, $"{BootLoader.BundleName}.{i}")))
                    fs.Write(data, i * BootLoader.PartSize, len);
            }
            var parts = new BootLoader.Parts { name = BootLoader.BundleName, parts = n, bytes = data.LongLength };
            File.WriteAllText(Path.Combine(ServeDir, BootLoader.IndexFile), JsonUtility.ToJson(parts, true));
            Debug.Log($"[SceneBundles] 已切 {n} 塊到 {ServeDir}");
            return true;
        }

        /// Boot.unity 不存在就建：黑底相機＋BootLoader（附加開啟後存檔關閉，不動目前場景）
        static bool EnsureBootScene()
        {
            if (File.Exists(BootScenePath)) return true;
            var active = SceneManager.GetActiveScene();
            bool additive = active.IsValid() && !string.IsNullOrEmpty(active.path); // 未命名場景不能附加開新場景（batch mode 常見）
            var boot = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, additive ? NewSceneMode.Additive : NewSceneMode.Single);
            SceneManager.SetActiveScene(boot); // 新物件建在 Boot，不弄髒 Main
            var cam = new GameObject("Camera").AddComponent<Camera>();
            cam.clearFlags = CameraClearFlags.SolidColor;
            cam.backgroundColor = new Color(0.12f, 0.09f, 0.07f);
            new GameObject("BootLoader", typeof(BootLoader));
            bool ok = EditorSceneManager.SaveScene(boot, BootScenePath);
            if (additive)
            {
                SceneManager.SetActiveScene(active);
                EditorSceneManager.CloseScene(boot, true);
            }
            if (!ok) Debug.LogError("[SceneBundles] Boot.unity 建立失敗");
            else AssetDatabase.ImportAsset(BootScenePath);
            return ok;
        }
    }
}
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// 畫質高／低（右上「畫質」鈕）。自動建立（不必掛在場景裡），跨場景重載保留；選擇存在 PlayerPrefs。
    /// 舊版只開關 SSAO，但 WebGL 用的 Mobile_Renderer 根本沒有 SSAO、場景裡也沒掛元件，按了沒反應（審查技術 #4）。
    /// 現在「低」是實際降級：renderScale ×0.8（下限 0.5）、關主光陰影（shadowDistance 0）、關 HDR、關 Bloom；
    /// 「高」＝目前的管線設定（啟動時記下的原值）。預設：觸控裝置低、桌機高。
    /// 裝置判斷與 RenderGovernor 共用 TouchInput.Enabled（審查 #18）：iPadOS Safari 回報為桌機，
    /// 第一次觸控後才知道是平板；玩家還沒自己選過畫質時，此刻自動改成低。
    /// Round8 自動降畫質（只降不升、每次開遊戲最多一次、不寫 PlayerPrefs）：玩家沒選過畫質、目前是高、
    /// 而且正在走動（不在讀卷軸省電、不在演出）時量幀率；進場 6 秒暖機後，連續 8 秒平均低於 24fps 才降為低。
    /// 手機預設就是低、上限 30fps，不受影響；主要救學校的老筆電／內顯桌機。編輯器不啟用（Editor 幀率不代表 WebGL）。
    public class QualityToggle : MonoBehaviour
    {
        public static QualityToggle I { get; private set; }
        const string Key = "liulaolao_quality_high";
        const float LowScaleFactor = 0.8f, MinScale = 0.5f;
        const float AutoWarmup = 6f, AutoWindow = 8f, AutoMinFps = 24f, AutoMaxFrame = 0.5f;

        public bool High { get; private set; }

        UniversalRenderPipelineAsset urp;
        float origScale, origShadow;
        int origMsaa;
        bool origHdr, captured, touchChecked, autoDone;
        // R30：桌機「高」比手機管線再往上一級（WebGL 一律用 Mobile_RPAsset）
        const float DesktopScale = 1f, DesktopShadow = 45f;
        const int DesktopMsaa = 4; // 不動 cascade 數：build 會依管線資產剝掉 cascade 變體
        float autoWarm, autoTime;
        int autoFrames;

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void Boot()
        {
            if (I) return;
            var go = new GameObject("QualityToggle");
            DontDestroyOnLoad(go);
            go.AddComponent<QualityToggle>();
        }

        void Awake()
        {
            if (I && I != this) { Destroy(this); return; }
            I = this;
            urp = GraphicsSettings.currentRenderPipeline as UniversalRenderPipelineAsset;
            if (urp)
            {
                origScale = urp.renderScale;
                origShadow = urp.shadowDistance;
                origHdr = urp.supportsHDR;
                origMsaa = urp.msaaSampleCount;
                captured = true;
            }
            int def = TouchInput.Enabled ? 0 : 1;
            High = PlayerPrefs.GetInt(Key, def) == 1;
            SceneManager.sceneLoaded += OnSceneLoaded;
        }

        void Start() => Apply(High);

        void Update()
        {
            AutoDowngrade();
            if (touchChecked || !TouchInput.Enabled) return;
            touchChecked = true;
            if (High && !PlayerPrefs.HasKey(Key)) Apply(false); // 不寫 PlayerPrefs：仍算「沒選過」；ScrollUI 會同步按鈕文字
        }

        void AutoDowngrade()
        {
            if (autoDone || Application.isEditor) return;
            if (!High || PlayerPrefs.HasKey(Key)) { autoDone = true; return; }
            float dt = Time.unscaledDeltaTime;
            var ui = ScrollUI.I;
            // 讀卷軸（場景暫停、限 30fps）、演出、切到別的分頁回來的長幀（> 0.5 秒）都不算；暖機期間也不算（著色器第一次編譯會卡）
            if (RenderGovernor.Reading || (ui && ui.Cinematic) || dt > AutoMaxFrame) { autoTime = 0; autoFrames = 0; return; }
            if (autoWarm < AutoWarmup) { autoWarm += dt; return; }
            autoTime += dt; autoFrames++;
            if (autoTime < AutoWindow) return;
            if (autoFrames / autoTime < AutoMinFps) { Apply(false); autoDone = true; } // ScrollUI 每幀同步畫質鈕文字
            autoTime = 0; autoFrames = 0;
        }

        void OnSceneLoaded(Scene s, LoadSceneMode m) => Apply(High); // 新場景的 Volume 也要套 Bloom 開關

        public void Toggle()
        {
            autoDone = true; // 玩家自己選過就不再自動調
            Apply(!High);
            PlayerPrefs.SetInt(Key, High ? 1 : 0);
            PlayerPrefs.Save();
        }

        void Apply(bool high)
        {
            High = high;
            if (urp && captured)
            {
                bool desktop = high && !TouchInput.Enabled;
                urp.renderScale = desktop ? DesktopScale : high ? origScale : Mathf.Max(MinScale, origScale * LowScaleFactor);
                urp.shadowDistance = desktop ? DesktopShadow : high ? origShadow : 0f;
                urp.msaaSampleCount = desktop ? DesktopMsaa : origMsaa;
                urp.supportsHDR = high && origHdr;
            }
            SetBloom(high);
        }

        static void SetBloom(bool on)
        {
            foreach (var v in FindObjectsByType<Volume>(FindObjectsSortMode.None))
            {
                var prof = v.HasInstantiatedProfile() ? v.profile : v.sharedProfile;
                if (prof && prof.TryGet<Bloom>(out var bloom)) bloom.active = on;
            }
        }

        void OnDestroy()
        {
            SceneManager.sceneLoaded -= OnSceneLoaded;
#if UNITY_EDITOR
            // 編輯器中別把管線資產／Volume Profile 留成低畫質
            if (urp && captured) { urp.renderScale = origScale; urp.shadowDistance = origShadow; urp.supportsHDR = origHdr; urp.msaaSampleCount = origMsaa; }
            SetBloom(true);
#endif
        }
    }
}
using UnityEngine;
using UnityEngine.EventSystems;

namespace Liulaolao
{
    /// 手機／平板觸控輸入：左下搖桿移動、拖曳畫面轉視角、右下互動鍵（等同 E）。
    public static class TouchInput
    {
        /// 手機平台、瀏覽器判斷為觸控平板（hotfix1：iPadOS 回報 Macintosh 但 maxTouchPoints > 1；Android 平板），
        /// 或桌機上實際摸過螢幕（保留原本「第一次觸控就切換」）
        public static bool Enabled => Application.isMobilePlatform || sawTouch || Tablet;
        static bool sawTouch;
        static int tablet = -1;
        static bool Tablet { get { if (tablet < 0) tablet = TabletJs() ? 1 : 0; return tablet == 1; } }
#if UNITY_WEBGL && !UNITY_EDITOR
        [System.Runtime.InteropServices.DllImport("__Internal")] static extern int LiulaolaoTouchTablet();
        static bool TabletJs() { try { return LiulaolaoTouchTablet() == 1; } catch { return false; } }
#else
        static bool TabletJs() => false;
#endif
        public static void Poll() { if (Input.touchCount > 0) sawTouch = true; }
        public static Vector2 Move;
        public static Vector2 Look;
        public static bool InteractHeld;
        static int downFrame = -10;
        static bool used = true;

        public static void Press() { downFrame = Time.frameCount; used = false; }

        /// 本幀或上一幀按下且尚未被取用
        public static bool ConsumeDown()
        {
            if (used || Time.frameCount - downFrame > 1) return false;
            used = true;
            return true;
        }

        public static Vector2 ConsumeLook() { var d = Look; Look = Vector2.zero; return d; }
    }

    /// 虛擬搖桿：拖曳範圍為自身半徑
    public class TouchStick : MonoBehaviour, IPointerDownHandler, IDragHandler, IPointerUpHandler
    {
        public RectTransform knob;
        RectTransform rt;

        void Awake() => rt = (RectTransform)transform;

        public void OnPointerDown(PointerEventData e) => OnDrag(e);

        public void OnDrag(PointerEventData e)
        {
            RectTransformUtility.ScreenPointToLocalPointInRectangle(rt, e.position, e.pressEventCamera, out var p);
            float r = rt.rect.width * 0.5f;
            var v = Vector2.ClampMagnitude(p / r, 1f);
            TouchInput.Move = v;
            knob.anchoredPosition = v * r;
        }

        public void OnPointerUp(PointerEventData e)
        {
            TouchInput.Move = Vector2.zero;
            knob.anchoredPosition = Vector2.zero;
        }

        void OnDisable() => OnPointerUp(null);
    }

    /// 拖曳空白畫面轉視角
    public class TouchLook : MonoBehaviour, IDragHandler
    {
        public void OnDrag(PointerEventData e) => TouchInput.Look += e.delta;
    }

    /// 互動鍵：按下觸發一次，按住可持續（磨墨用）
    public class TouchButton : MonoBehaviour, IPointerDownHandler, IPointerUpHandler
    {
        public void OnPointerDown(PointerEventData e) { TouchInput.InteractHeld = true; TouchInput.Press(); }
        public void OnPointerUp(PointerEventData e) => TouchInput.InteractHeld = false;
        void OnDisable() => TouchInput.InteractHeld = false;
    }
}

