#!/usr/bin/env bash
# 劉姥姥進大觀園 WebGL 部署：Netlify ＋ Cloudflare Pages ＋ itch.io。
# 絕不部署 Vercel（2026-08-24 起全域暫停）。
#
# 用法（在專案根目錄）：
#   scripts/deploy.sh <版本號，例如 0.1.0>
#   scripts/deploy.sh --dry-run <版本號>   # 只做唯讀檢查並印出每一步指令，不寫檔、不上傳
#
# 首次部署前：
#   - Cloudflare：npx wrangler pages project create liulaolao-garden --production-branch main
#   - Netlify：第一次用 --site-name 會自動建站；建好後把 Site ID 存成環境變數
#     NETLIFY_SITE_ID，之後改用 --site 指定，避免 .netlify/state.json 綁錯站。
#   - .cf-branch 內容必須是 main（deploy-gate hook 會檢查）。
#   - itch.io：~/bin/butler-dl/butler 已登入 hk6429，liulaolao-garden 已設為 HTML 公開頁。
# 部署完一定要跑 scripts/verify.sh 回讀比對 md5。
set -euo pipefail

SITE=liulaolao-garden
SKILL=~/.claude/skills/unity-webgl-edu-game/scripts
DRY=0
[ "${1:-}" = "--dry-run" ] && { DRY=1; shift; }
VERSION="${1:?請給版本號，例如 scripts/deploy.sh 0.1.0}"
# run：dry-run 時只印指令；正式模式印出後執行
run() { echo "+ $*"; [ "$DRY" = 1 ] || "$@"; }

cd "$(dirname "$0")/.."
[ -f Build/WebGL/index.html ] || { echo "找不到 Build/WebGL/index.html，請先在 Unity 打包 WebGL"; exit 1; }
CF_BRANCH=$(tr -d ' \n' < .cf-branch)
[ "$CF_BRANCH" = "main" ] || { echo ".cf-branch 不是 main"; exit 1; }
# nameFilesAsHashes：檔名每次打包都不同，index.html 必須引用 Build/ 裡實際存在的 loader 與 .unityweb
for f in Build/WebGL/Build/*.loader.js Build/WebGL/Build/*.unityweb; do
  [ -e "$f" ] || { echo "Build/WebGL/Build 缺 loader 或 .unityweb"; exit 1; }
  grep -q "$(basename "$f")" Build/WebGL/index.html || { echo "index.html 沒引用 $(basename "$f")，Build 可能不完整"; exit 1; }
done
# R30：Main 場景改成 StreamingAssets/scene/main.N＋parts.json（Tools/Liulaolao/Build/WebGL + Scene Bundle 產生）。
#      .bundle-done 在 BuildPlayer 與切塊全部成功後才寫，必須比 loader 新；只跑 BuildPlayer（manage_build）不算完整建置。
LOADER=$(ls Build/WebGL/Build/*.loader.js | head -1)
[ -f Build/WebGL/.bundle-done ] && [ Build/WebGL/.bundle-done -nt "$LOADER" ] \
  || { echo "缺 Build/WebGL/.bundle-done 或比 loader 舊：請用 Tools/Liulaolao/Build/WebGL + Scene Bundle 重建"; exit 1; }
python3 - Build/WebGL/StreamingAssets/scene <<'PY_SCENE'
import json, os, sys
d = sys.argv[1]
p = json.load(open(os.path.join(d, "parts.json")))
names = {f"{p['name']}.{i}" for i in range(p["parts"])}
size = sum(os.path.getsize(os.path.join(d, n)) for n in names)
extra = set(os.listdir(d)) - names - {"parts.json", ".DS_Store"}
if size != p["bytes"] or extra or p["parts"] < 1:
    sys.exit(f"scene 切塊不一致：parts 總和 {size}／parts.json {p['bytes']}，多餘檔案 {sorted(extra)}")
print(f"scene bundle OK：{p['parts']} 塊，{p['bytes']} bytes")
PY_SCENE
[ "$DRY" = 1 ] && echo "【dry-run】只印指令，不寫檔、不上傳。版本 v${VERSION}，CF branch=${CF_BRANCH}"

# 1. 同步到部署資料夾（--delete 會清掉上一版的舊雜湊檔）
run rsync -a --delete --exclude '.DS_Store' --exclude '.bundle-done' Build/WebGL/ Deploy/site/

# R21：只處理部署副本；資產逐檔自檢後再更新 data 雜湊與 index。
run python3 scripts/compact_webgl_data.py Deploy/site

# 2. 手機殼補丁（冪等，標記 mobile-patch）：只改 Deploy/site 的副本，不動 Build/
run python3 "$SKILL/patch_index.py" Deploy/site/index.html
run python3 scripts/patch_mobile_entry.py Deploy/site/index.html
run python3 scripts/patch_loading_recovery.py Deploy/site/index.html

# 2.5 單檔大小閘門：Cloudflare Pages 單檔上限 25 MiB（26214400 bytes），Round10 原留 1 MiB 邊際；R18 data 26,114,902 介於 24～25 MiB，閘門改為貼齊 CF 上限
#     dry-run 時 Deploy/site 尚未同步，改檢查 Build/WebGL
LIMIT=$((25 * 1024 * 1024))
SRC=Deploy/site; [ "$DRY" = 1 ] && SRC=Build/WebGL
big=$(find "$SRC" -type f -size +"$((LIMIT - 1))"c)
if [ -n "$big" ]; then
  echo "有檔案達到或超過 25 MiB，Cloudflare Pages 會拒收："
  for f in $big; do echo "  $(stat -f %z "$f") bytes  $f"; done
  echo "處理方式見 staging/Round10/size-strategy.md"; exit 1
fi
find "$SRC/Build" "$SRC/StreamingAssets/scene" -type f -exec stat -f '%z %N' {} + | sort -rn | awk '{printf "  %6.2f MiB  %s\n", $1/1048576, $2}'

# 3. 產生 _headers（.unityweb 送 Content-Encoding: br、正確 Content-Type、immutable 快取）
run python3 "$SKILL/make_headers.py" Deploy/site
run python3 scripts/prepare_wasm_delivery.py Deploy/site

# 4. Netlify：有 NETLIFY_SITE_ID 一律 --site 指定（不靠 .netlify/state.json）；
#    沒設時只允許「首次建站」：state.json 已存在代表站早建好了，拒跑以免綁錯站
if [ -n "${NETLIFY_SITE_ID:-}" ]; then
  run netlify deploy --dir Deploy/site --prod --site "$NETLIFY_SITE_ID" --message "v$VERSION"
else
  [ -f .netlify/state.json ] && { echo "已有 .netlify/state.json 但沒設 NETLIFY_SITE_ID：請先 export NETLIFY_SITE_ID=<Site ID>"; exit 1; }
  echo "（未設 NETLIFY_SITE_ID：視為首次建站，用 --site-name）"
  run netlify deploy --dir Deploy/site --prod --site-name "$SITE" --message "v$VERSION"
fi

# 5. Cloudflare Pages（--branch 取自 .cf-branch＝main；沒帶只會出 Preview）
run npx wrangler pages deploy Deploy/site --project-name "$SITE" --branch "$CF_BRANCH" --commit-dirty=true

# 6. itch.io：使用者已授權，沿用已公開的 html5 頁面與同一份縮包／手機補丁。
run rsync -a --delete --exclude .DS_Store --exclude _headers Deploy/site/ Deploy/itch/
run "$HOME/bin/butler-dl/butler" push Deploy/itch hk6429/liulaolao-garden:html5 --userversion="$VERSION" --if-changed

if [ "$DRY" = 1 ]; then echo "【dry-run】結束，未執行任何寫入或上傳。"; else echo "部署指令跑完。接著執行：scripts/verify.sh"; fi
#!/usr/bin/env bash
# 部署後回讀驗證：線上檔案 md5 必須等於 Deploy/site 本機檔。只做唯讀 curl，不改任何檔案。
#
# 用法（在專案根目錄）：
#   scripts/verify.sh [網址 ...]
# 不給網址時預設驗兩站：https://liulaolao-garden.netlify.app  https://liulaolao-garden.pages.dev
# Cloudflare 專案名被佔用時網域會帶後綴（例如 liulaolao-garden-abc.pages.dev），請自行列出兩個網址。
#
# 比對來源預設是 Deploy/site；部署預演時可用環境變數指定別的資料夾：
#   SITE_DIR=/path/to/site scripts/verify.sh http://127.0.0.1:8799
#
# 規則（見 unity-webgl-edu-game SKILL 第 9 節）：
#   *.unityweb  → Accept-Encoding: br 取原始位元組比 md5（不帶 br 時 CDN 會解壓，md5 必然不同）
#   *.loader.js → Accept-Encoding: identity 比 md5（帶 br 會拿到 CDN 即時壓縮版）
#   StreamingAssets/scene/*（main.N、parts.json）→ Accept-Encoding: identity 比 md5
#   index.html  → 平台會注入內容，不比 md5；改 grep Build 檔名與 mobile-patch 標記
#
# 本機模式（網址是 localhost／127.0.0.1）：python3 -m http.server 不讀 _headers、也不送
# Content-Encoding: br，所以只能驗「位元組一致、檔案 200、index 內容正確」；wasm 標頭檢查標為 SKIP。
set -uo pipefail

cd "$(dirname "$0")/.."
SITE_DIR="${SITE_DIR:-Deploy/site}"
[ -d "$SITE_DIR/Build" ] || { echo "找不到 $SITE_DIR/Build，請先跑 scripts/deploy.sh（或用 SITE_DIR 指定）"; exit 1; }
[ $# -gt 0 ] || set -- https://liulaolao-garden.netlify.app https://liulaolao-garden.pages.dev

fail=0
TMP=$(mktemp)
HDR=$(mktemp)
trap '/bin/rm -f "$TMP" "$HDR"' EXIT
CURL=(curl -s --max-time 120)

check_base() {
  local base="${1%/}" is_local=0
  case "$base" in http://localhost*|http://127.0.0.1*) is_local=1 ;; esac
  echo "== $base$([ $is_local = 1 ] && echo '（本機模式：不驗 br 標頭）')"

  local f name enc want got code
  for f in "$SITE_DIR"/Build/*; do
    name=$(basename "$f")
    case "$name" in
      *.unityweb)  enc="br" ;;
      *.loader.js) enc="identity" ;;
      *) continue ;;
    esac
    want=$(md5 -q "$f")
    code=$("${CURL[@]}" -D "$HDR" -o "$TMP" -w '%{http_code}' -H "Accept-Encoding: $enc" "$base/Build/$name")
    got=$(md5 -q "$TMP")
    if [ "$code" = "200" ] && [ "$want" = "$got" ]; then
      echo "  OK    $name ($enc)"
      if [ "$is_local" = 0 ] && [[ "$name" = *.wasm.unityweb ]]; then
        if grep -qi '^content-type: application/wasm' "$HDR" && grep -qi '^content-encoding: br' "$HDR"; then
          echo "  OK    wasm GET 標頭 br＋application/wasm"
        else
          echo "  FAIL  wasm GET 標頭不正確"; fail=1
        fi
      fi
    else
      echo "  FAIL  $name ($enc) http=$code 本機=$want 線上=$got"; fail=1
    fi
  done

  # R30：Main 場景切塊（main.N 無副檔名＋parts.json）。Netlify 會即時再壓 br，一律 identity 取原始位元組比 md5。
  local n=0
  for f in "$SITE_DIR"/StreamingAssets/scene/*; do
    [ -f "$f" ] || continue
    name=$(basename "$f"); n=$((n + 1))
    want=$(md5 -q "$f")
    code=$("${CURL[@]}" -o "$TMP" -w '%{http_code}' -H 'Accept-Encoding: identity' "$base/StreamingAssets/scene/$name")
    got=$(md5 -q "$TMP")
    if [ "$code" = "200" ] && [ "$want" = "$got" ]; then
      echo "  OK    scene/$name (identity)"
    else
      echo "  FAIL  scene/$name (identity) http=$code 本機=$want 線上=$got"; fail=1
    fi
  done
  [ "$n" -ge 2 ] || { echo "  FAIL  $SITE_DIR/StreamingAssets/scene 缺 parts.json 或切塊"; fail=1; }

  local html
  html=$("${CURL[@]}" -H 'Accept-Encoding: identity' -H 'Cache-Control: no-cache' "$base/")
  if grep -q 'mobile-patch' <<<"$html"; then
    echo "  OK    index.html 含 mobile-patch"
  else
    echo "  FAIL  index.html 缺 mobile-patch 標記"; fail=1
  fi
  for f in "$SITE_DIR"/Build/*; do
    name=$(basename "$f")
    # 只檢查 index.html 本來就引用的檔名（loader 與三個 .unityweb）
    grep -q "$name" "$SITE_DIR/index.html" || continue
    if grep -q "$name" <<<"$html"; then
      echo "  OK    index.html 引用 $name"
    else
      echo "  FAIL  index.html 沒有引用 $name（可能還是舊版或 CDN 未更新）"; fail=1
    fi
  done

  if [ $is_local = 1 ]; then
    echo "  SKIP  wasm 標頭（本機 http.server 不送 Content-Encoding: br，請在線上驗）"
    return
  fi
  local hdr
  hdr=$("${CURL[@]}" -I -H 'Accept-Encoding: br' "$base/Build/$(cd "$SITE_DIR/Build" && ls *.wasm.unityweb | head -1)")
  if grep -qi '^content-encoding: br' <<<"$hdr" && grep -qi '^content-type: application/wasm' <<<"$hdr"; then
    echo "  OK    wasm 標頭 br＋application/wasm"
  else
    echo "  FAIL  wasm 標頭不對（_headers 沒生效？）"; fail=1
  fi
}

for u in "$@"; do check_base "$u"; done

if [ "$fail" = 0 ]; then
  echo "全部通過。最後一步：用瀏覽器實開，看到操作說明卡才算數；手機修正請用真機確認。"
else
  echo "有項目失敗，不能說部署完成。"; exit 1
fi
