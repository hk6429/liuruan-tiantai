from pathlib import Path
import re
root=Path.cwd()
# Rename both file paths and content while preserving GUIDs.
for p in sorted((root/'Assets').rglob('*'),key=lambda p:len(p.parts),reverse=True):
    if 'Liulaolao' in p.name: p.rename(p.with_name(p.name.replace('Liulaolao','Liuruan')))
for base in ['Assets','scripts','ProjectSettings']:
    for p in (root/base).rglob('*'):
        if not p.is_file(): continue
        try: s=p.read_text()
        except UnicodeDecodeError: continue
        s=s.replace('Liulaolao','Liuruan').replace('liulaolao-garden','liuruan-tiantai').replace('liulaolao','liuruan')
        p.write_text(s)
def edit(rel,fn):
    p=root/rel;s=p.read_text();p.write_text(fn(s))
def cut(s,start,end):
    assert start in s and end in s,(start,end)
    a=s.index(start);b=s.index(end,a);return s[:a]+s[b:]
def sub(s,a,b):
    assert a in s,a
    return s.replace(a,b)
