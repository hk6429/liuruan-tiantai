using UnityEngine;

namespace Liulaolao
{
    /// 作答紀錄（PlayerPrefs）：每題答對前的作答次數、是否已答對、答對前是否看過白話。
    /// 題號 = 線索 id；結局推論題 = 固定 InferId（100，不與線索 id 撞號）。首答正確 = 已答對且只答了 1 次。
    /// 小遊戲不計分，見 ClueManager.IsScored。
    public static class QuizStats
    {
        /// 推論題固定題號；線索 id 必須小於它（check.py 另驗）
        public const int InferId = 100;
        /// 線索題號上限（不含推論題），依 ClueManager 實際最大 id
        static int MaxClueId => ClueManager.I != null && ClueManager.I.Clues.Count > 0 ? ClueManager.I.Clues[ClueManager.I.Clues.Count - 1].id : ClueManager.EndingId;
        static System.Collections.Generic.IEnumerable<int> Ids()
        {
            for (int i = 0; i <= MaxClueId; i++) yield return i;
            yield return InferId;
        }
        const int ClearMax = 64; // 重新開始時一律清到這裡，不依賴 ClueManager 是否在場

        static string TriesKey(int id) => $"liulaolao_q{id}_tries";
        static string SolvedKey(int id) => $"liulaolao_q{id}_solved";
        static string PlainKey(int id) => $"liulaolao_q{id}_plain";

        public static bool Solved(int id) => PlayerPrefs.GetInt(SolvedKey(id), 0) == 1;
        public static int Tries(int id) => PlayerPrefs.GetInt(TriesKey(id), 0);
        public static bool SawPlain(int id) => PlayerPrefs.GetInt(PlainKey(id), 0) == 1;
        public static bool FirstTryCorrect(int id) => Solved(id) && Tries(id) == 1;

        static bool Scored(int id) => ClueManager.I == null || ClueManager.I.IsScored(id);

        /// 只記「第一次答對之前」的作答，重看已答對的卷軸不改成績。
        public static void Record(int id, bool correct)
        {
            if (Solved(id)) return;
            PlayerPrefs.SetInt(TriesKey(id), Tries(id) + 1);
            if (correct) PlayerPrefs.SetInt(SolvedKey(id), 1);
            PlayerPrefs.Save();
        }

        public static void MarkPlain(int id)
        {
            if (Solved(id) || SawPlain(id)) return;
            PlayerPrefs.SetInt(PlainKey(id), 1);
            PlayerPrefs.Save();
        }

        public static int ScoredCount()
        {
            int n = 0;
            foreach (int i in Ids()) if (Scored(i)) n++;
            return n;
        }

        public static int FirstTryCount()
        {
            int n = 0;
            foreach (int i in Ids()) if (Scored(i) && FirstTryCorrect(i)) n++;
            return n;
        }

        /// 有白話的計分題中，沒看白話就答對的題數
        public static int NoPlainCount()
        {
            int n = 0;
            for (int i = 0; i <= MaxClueId; i++) if (Scored(i) && Solved(i) && !SawPlain(i)) n++;
            return n;
        }

        /// 有白話的計分題數（NoPlainCount 的分母；推論題沒有白話，不算）
        public static int PlainScoredCount()
        {
            int n = 0;
            for (int i = 0; i <= MaxClueId; i++) if (Scored(i)) n++;
            return n;
        }

        public static int TotalTries()
        {
            int n = 0;
            foreach (int i in Ids()) if (Scored(i)) n += Tries(i);
            return n;
        }

        public static void Clear()
        {
            for (int i = 0; i <= Mathf.Max(InferId, ClearMax); i++)
            {
                PlayerPrefs.DeleteKey(TriesKey(i));
                PlayerPrefs.DeleteKey(SolvedKey(i));
                PlayerPrefs.DeleteKey(PlainKey(i));
            }
            PlayerPrefs.Save();
        }
    }
}
using UnityEngine;
using UnityEngine.Rendering.Universal;

namespace Liulaolao
{
    /// 省電：限幀＋讀卷軸時暫停 3D 場景。自動建立（不必掛在場景裡），跨場景重載保留。
    /// - 幀率上限：桌機 60、手機（含觸控過的平板）30；面板開著時桌機 30、手機 20。
    /// - ScrollUI 任何面板或小遊戲（LaughMatch／EggMinigame 全螢幕不透明）開著、且不是演出中：
    ///   主相機 cullingMask = 0、純色清除、關後製與陰影 → 只剩清畫面＋UI。關閉後原樣恢復。
    ///   （不直接 disable 相機：沒有相機時 Screen Space Overlay UI 在部分平台不保證重畫）
    public class RenderGovernor : MonoBehaviour
    {
        // 桌機 -1＝交給瀏覽器 requestAnimationFrame（WebGL 設定 targetFrameRate 可能改走 setTimeout，高更新率螢幕會抖）
        const int DesktopFps = -1, MobileFps = 30, DesktopReadingFps = 30, MobileReadingFps = 20;
        static readonly Color PausedBg = new Color(0.12f, 0.09f, 0.06f, 1f);

        Camera paused;
        int savedMask;
        CameraClearFlags savedFlags;
        Color savedBg;
        bool savedPost, savedShadows, hadData;
        int lastFps = -2;

        /// 目前是「讀卷軸省電」狀態（3D 場景暫停、限幀）。QualityToggle 量幀率時要排除這段。
        public static bool Reading { get; private set; }

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void Boot()
        {
            var go = new GameObject("RenderGovernor");
            DontDestroyOnLoad(go);
            go.AddComponent<RenderGovernor>();
        }

        void Awake() => QualitySettings.vSyncCount = 0; // 桌機上 vSync 會蓋掉 targetFrameRate

        void Update()
        {
            var ui = ScrollUI.I;
            // 夾蛋小遊戲要即時反應，不降幀也不暫停（判定窗約 0.23 秒，手機 20fps 只剩 4–5 幀）
            bool reading = ui && !ui.Cinematic && (ui.PanelOpen || ui.ExternalUI) && !EggMinigame.Running;
            Reading = reading;
            bool mobile = TouchInput.Enabled;
            int fps = reading ? (mobile ? MobileReadingFps : DesktopReadingFps) : (mobile ? MobileFps : DesktopFps);
            if (fps != lastFps) { Application.targetFrameRate = fps; lastFps = fps; }

            if (reading && !paused) Pause(Camera.main);
            else if (!reading && paused) Resume();
            else if (paused && paused != Camera.main) Resume(); // 場景重載或換相機
        }

        void Pause(Camera cam)
        {
            if (!cam) return;
            paused = cam;
            savedMask = cam.cullingMask;
            savedFlags = cam.clearFlags;
            savedBg = cam.backgroundColor;
            var data = cam.GetComponent<UniversalAdditionalCameraData>();
            hadData = data;
            if (data)
            {
                savedPost = data.renderPostProcessing;
                savedShadows = data.renderShadows;
                data.renderPostProcessing = false;
                data.renderShadows = false;
            }
            cam.cullingMask = 0;
            cam.clearFlags = CameraClearFlags.SolidColor;
            cam.backgroundColor = PausedBg;
        }

        void Resume()
        {
            var cam = paused;
            paused = null;
            if (!cam) return;
            cam.cullingMask = savedMask;
            cam.clearFlags = savedFlags;
            cam.backgroundColor = savedBg;
            if (hadData)
            {
                var data = cam.GetComponent<UniversalAdditionalCameraData>();
                if (data) { data.renderPostProcessing = savedPost; data.renderShadows = savedShadows; }
            }
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// 線索互動點上方的浮空卷軸：上下飄、慢慢轉、亮度呼吸。未收集才顯示；
    /// 鎖住的線索（宴席、結局）顯示為灰色。用 Unlit 材質，不加光源、不加碰撞體。
    public class ClueMarker : MonoBehaviour
    {
        static readonly Color Paper = new Color(0.94f, 0.88f, 0.72f);
        static readonly Color Wood = new Color(0.31f, 0.17f, 0.07f);
        static readonly Color[] PartColors = { Paper, Wood, Wood };
        static readonly Color Grey = new Color(0.45f, 0.45f, 0.45f);
        static readonly int BaseColor = Shader.PropertyToID("_BaseColor");

        int clueId;
        Transform target;
        float height;
        Transform visual;
        Renderer[] rends;
        MaterialPropertyBlock mpb;
        bool shown = true;

        public int ClueId => clueId;

        public static ClueMarker Create(Interactable target, Material mat)
        {
            // 放在物件頂端再往上一點
            float top = target.transform.position.y + 1.2f;
            foreach (var r in target.GetComponentsInChildren<Renderer>())
                top = Mathf.Max(top, r.bounds.max.y + 0.7f);

            var go = new GameObject("ClueMarker_" + target.clueId);
            var m = go.AddComponent<ClueMarker>();
            m.clueId = target.clueId;
            m.target = target.transform; // 不設父物件，免得吃到模型的縮放
            m.height = top - target.transform.position.y;
            m.Build(mat);
            return m;
        }

        void Build(Material mat)
        {
            visual = new GameObject("Visual").transform;
            visual.SetParent(transform, false);
            // 軸頭比紙卷粗，旋轉到側面仍保留卷軸輪廓。
            rends = new[]
            {
                Part(PrimitiveType.Cylinder, Vector3.zero, new Vector3(0.22f, 0.3f, 0.22f), mat),
                Part(PrimitiveType.Cylinder, new Vector3(-0.33f, 0, 0), new Vector3(0.32f, 0.045f, 0.32f), mat),
                Part(PrimitiveType.Cylinder, new Vector3(0.33f, 0, 0), new Vector3(0.32f, 0.045f, 0.32f), mat)
            };
            mpb = new MaterialPropertyBlock();
        }

        Renderer Part(PrimitiveType type, Vector3 pos, Vector3 scale, Material mat)
        {
            var p = GameObject.CreatePrimitive(type);
            Destroy(p.GetComponent<Collider>());
            p.transform.SetParent(visual, false);
            p.transform.localPosition = pos;
            p.transform.localRotation = Quaternion.Euler(0, 0, 90);
            p.transform.localScale = scale;
            var r = p.GetComponent<Renderer>();
            r.sharedMaterial = mat;
            r.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
            r.receiveShadows = false;
            return r;
        }

        void Update()
        {
            var cm = ClueManager.I;
            bool show = cm && !cm.IsCollected(clueId) && !(ScrollUI.I && ScrollUI.I.Cinematic) && !QuestRunner.Active;
            if (show != shown)
            {
                shown = show;
                visual.gameObject.SetActive(show);
            }
            if (!show || !target) return;

            bool locked = cm.IsLocked(clueId);
            float t = Time.time + clueId;
            transform.position = target.position + Vector3.up * (height + (locked ? 0f : Mathf.Sin(t * 2f) * 0.15f));
            visual.localRotation = Quaternion.Euler(0, t * 45f, 0);

            // 離鏡頭越遠放大一點，遠處也看得到
            var cam = Camera.main;
            float s = cam ? Mathf.Clamp(Vector3.Distance(cam.transform.position, transform.position) * 0.06f, 1f, 3f) : 1f;
            visual.localScale = Vector3.one * s;

            float brightness = 0.94f + 0.04f * Mathf.Sin(t * 3f);
            for (int i = 0; i < rends.Length; i++)
            {
                Color c = locked ? Grey : PartColors[i] * brightness;
                c.a = 1f;
                mpb.SetColor(BaseColor, c);
                rends[i].SetPropertyBlock(mpb);
            }
        }
    }
}
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.Events;

namespace Liulaolao
{
    /// 靠近顯示提示，按 E 觸發。clueId >= 0 時開啟該線索；toast 不為空時顯示一句提示。
    public class Interactable : MonoBehaviour
    {
        public static readonly List<Interactable> All = new List<Interactable>();

        public string prompt = Txt.DefaultPrompt;
        public float radius = 2.5f;
        public int clueId = -1;
        [TextArea] public string toast;
        public UnityEvent onInteract = new UnityEvent(); // r12：執行期 AddComponent 時不會自動建立，沒初始值會 NRE

        /// Round14：已收集的線索點顯示「E 再讀」（自訂提示字不動）
        public string CurrentPrompt => clueId >= 0 && prompt == Txt.DefaultPrompt && ClueManager.I && ClueManager.I.IsCollected(clueId) ? Txt.RereadPrompt : prompt;

        void OnEnable() => All.Add(this);
        void OnDisable() => All.Remove(this);

        public void Interact()
        {
            if (!string.IsNullOrEmpty(toast)) ScrollUI.I.Toast(toast);
            if (clueId >= 0) ClueManager.I.TriggerClue(clueId);
            onInteract.Invoke();
        }

        public static Interactable Nearest(Vector3 pos)
        {
            Interactable best = null;
            float bestDist = float.MaxValue;
            foreach (var it in All)
            {
                if (it.clueId >= 0 && QuestRunner.Active) continue; // R17 任務模式：經典卷軸點不互動
                Vector3 off = it.transform.position - pos;
                off.y = 0; // 只算水平距離
                float d = off.magnitude;
                if (d <= it.radius && d < bestDist) { best = it; bestDist = d; }
            }
            return best;
        }
    }
}
using System.Collections;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;
using UnityEngine;
using UnityEngine.Networking;

namespace Liulaolao
{
    /// 朗讀（Round14）：優先播 StreamingAssets/voice/ 的大乃老師克隆聲音預錄檔，對照表沒有的字串才退回瀏覽器 Web Speech
    /// （Assets/Plugins/WebGL/LiulaolaoSpeech.jslib）。對照表 key＝正規化文字（去 rich text 標籤、去所有空白），
    /// 規則與 staging/Round14/tools/inventory.py 的 norm() 相同；改了台詞文字就查不到 → 自動走 Web Speech 備援。
    /// 呼叫端 API 不變：Supported／Init／Speak／Stop／HideLoading。
    public static class SpeechBridge
    {
        const string VoiceDir = "voice";
        const string ManifestFile = "manifest.json";
        const int ClipCacheMax = 12;
        const float ManifestWait = 4f;   // Speak 早於對照表載完時最多等幾秒，逾時改用 Web Speech

        [System.Serializable] class Entry { public string k; public string f; }
        [System.Serializable] class Manifest { public string ext = "mp3"; public Entry[] items; }

        static Dictionary<string, string> map;   // 正規化文字 → 檔名（不含副檔名）
        static string ext = "mp3";
        static bool manifestLoading, manifestFailed;
        static int serial;                        // 每次 Speak/Stop 遞增；下載回來時序號不符就丟棄
        static Runner runner;
        static readonly Dictionary<string, AudioClip> clips = new Dictionary<string, AudioClip>();
        static readonly LinkedList<string> clipOrder = new LinkedList<string>();

#if UNITY_WEBGL && !UNITY_EDITOR
        [DllImport("__Internal")] static extern int LiulaolaoSpeechSupported();
        [DllImport("__Internal")] static extern void LiulaolaoSpeechInit();
        [DllImport("__Internal")] static extern void LiulaolaoSpeak(string text, float rate);
        [DllImport("__Internal")] static extern void LiulaolaoSpeechStop();
        [DllImport("__Internal")] static extern void LiulaolaoHideLoading();

        static bool WebSpeech => LiulaolaoSpeechSupported() == 1;
        static void WebInit() { if (WebSpeech) LiulaolaoSpeechInit(); }
        static void WebSpeak(string text) { if (WebSpeech) LiulaolaoSpeak(text, 0.8f); }
        static void WebStop() { if (WebSpeech) LiulaolaoSpeechStop(); }
        public static void HideLoading() => LiulaolaoHideLoading();
        static bool VoiceAvailable => true;   // WebGL 一律可播 AudioClip；對照表讀不到時每句都走 Web Speech
#else
        static bool WebSpeech => false;
        static void WebInit() { }
        static void WebSpeak(string text) { }
        static void WebStop() { }
        public static void HideLoading() { }
        // 編輯器／其他平台：StreamingAssets/voice/manifest.json 存在才啟用（方便在 Play 模式試聽）
        static bool? voiceFile;
        static bool VoiceAvailable
        {
            get
            {
                if (voiceFile == null)
                    voiceFile = System.IO.File.Exists(System.IO.Path.Combine(Application.streamingAssetsPath, VoiceDir, ManifestFile));
                return voiceFile.Value;
            }
        }
#endif

        /// 能朗讀：有預錄聲音或瀏覽器支援 Web Speech（朗讀鈕、M 鍵是否出現看這個）
        public static bool Supported => VoiceAvailable || WebSpeech;

        public static void Init()
        {
            WebInit();
            if (VoiceAvailable) LoadManifest();
        }

        public static void Speak(string text)
        {
            if (string.IsNullOrEmpty(text)) return;
            Stop();
            int my = serial;
            if (!VoiceAvailable) { WebSpeak(text); return; }
            LoadManifest();
            EnsureRunner().StartCoroutine(PlayVoice(text, my));
        }

        public static void Stop()
        {
            serial++;
            if (runner && runner.source) runner.source.Stop();
            QuestVoice.StopOwn(); // R18：連任務預錄音一起停，避免疊音
            WebStop();
        }

        /// 正規化：去掉 &lt;...&gt; 標籤與所有空白（必須與 inventory.py 的 norm() 一致）
        public static string Normalize(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            var sb = new StringBuilder(s.Length);
            for (int i = 0; i < s.Length; i++)
            {
                char c = s[i];
                if (c == '<')
                {
                    int close = s.IndexOf('>', i + 1);
                    if (close >= 0) { i = close; continue; }
                }
                if (!char.IsWhiteSpace(c)) sb.Append(c);
            }
            return sb.ToString();
        }

        // ---------- 內部 ----------

        class Runner : MonoBehaviour { public AudioSource source; }

        static Runner EnsureRunner()
        {
            if (runner) return runner;
            var go = new GameObject("SpeechVoice");
            go.hideFlags = HideFlags.HideInHierarchy;
            Object.DontDestroyOnLoad(go);
            runner = go.AddComponent<Runner>();
            var src = go.AddComponent<AudioSource>();
            src.playOnAwake = false;
            src.loop = false;
            src.spatialBlend = 0f;   // 2D；音量照 AudioListener.volume（AudioManager 靜音＝0）
            src.volume = 1f;
            runner.source = src;
            return runner;
        }

        static string Url(string file)
        {
            string p = Application.streamingAssetsPath + "/" + VoiceDir + "/" + file;
            return p.Contains("://") ? p : "file://" + p;
        }

        static void LoadManifest()
        {
            if (map != null || manifestLoading || manifestFailed) return;
            manifestLoading = true;
            EnsureRunner().StartCoroutine(FetchManifest());
        }

        static IEnumerator FetchManifest()
        {
            using (var req = UnityWebRequest.Get(Url(ManifestFile)))
            {
                yield return req.SendWebRequest();
                manifestLoading = false;
                if (req.result != UnityWebRequest.Result.Success)
                {
                    manifestFailed = true;
                    Debug.LogWarning("[SpeechBridge] voice manifest 讀取失敗，改用 Web Speech：" + req.error);
                    yield break;
                }
                Manifest m = null;
                try { m = JsonUtility.FromJson<Manifest>(req.downloadHandler.text); }
                catch (System.Exception e) { Debug.LogWarning("[SpeechBridge] voice manifest 解析失敗：" + e.Message); }
                if (m == null || m.items == null) { manifestFailed = true; yield break; }
                var d = new Dictionary<string, string>(m.items.Length);
                foreach (var it in m.items) if (it != null && !string.IsNullOrEmpty(it.k)) d[it.k] = it.f;
                if (!string.IsNullOrEmpty(m.ext)) ext = m.ext;
                map = d;
            }
        }

        static IEnumerator PlayVoice(string text, int my)
        {
            for (float t = 0f; map == null && !manifestFailed && t < ManifestWait; t += Time.unscaledDeltaTime) yield return null;
            if (my != serial) yield break;
            string file;
            if (map == null || !map.TryGetValue(Normalize(text), out file)) { WebSpeak(text); yield break; }

            AudioClip clip;
            if (!clips.TryGetValue(file, out clip) || !clip)
            {
                clip = null;
                using (var req = UnityWebRequestMultimedia.GetAudioClip(Url(file + "." + ext), ext == "ogg" ? AudioType.OGGVORBIS : AudioType.MPEG))
                {
                    var dh = (DownloadHandlerAudioClip)req.downloadHandler;
                    dh.compressed = true;   // CompressedInMemory：iOS 靜音模式下 DecompressOnLoad 的聲音會聽不到（Unity Web 音訊手冊）
                    dh.streamAudio = false; // 瀏覽器不支援串流解碼
                    yield return req.SendWebRequest();
                    if (req.result == UnityWebRequest.Result.Success) clip = DownloadHandlerAudioClip.GetContent(req);
                    else Debug.LogWarning("[SpeechBridge] 音檔讀取失敗 " + file + "：" + req.error);
                }
                if (!clip) { if (my == serial) WebSpeak(text); yield break; }
                Remember(file, clip);
            }
            else
            {
                clipOrder.Remove(file);
                clipOrder.AddLast(file);
            }
            if (my != serial) yield break;   // 下載期間玩家已跳下一句／關掉
            var src = EnsureRunner().source;
            src.Stop();
            src.clip = clip;
            src.Play();
        }

        static void Remember(string file, AudioClip clip)
        {
            clips[file] = clip;
            clipOrder.Remove(file);
            clipOrder.AddLast(file);
            while (clipOrder.Count > ClipCacheMax)
            {
                string old = clipOrder.First.Value;
                clipOrder.RemoveFirst();
                if (clips.TryGetValue(old, out var c))
                {
                    clips.Remove(old);
                    if (c && !(runner && runner.source && runner.source.clip == c)) Object.Destroy(c);
                }
            }
        }
    }
