using UnityEngine;

namespace Liulaolao
{
    /// 第三人稱控制：WASD／方向鍵移動、按住滑鼠右鍵轉視角、E 互動。相機為簡單跟隨相機。
    [RequireComponent(typeof(CharacterController))]
    public class PlayerController : MonoBehaviour
    {
        public float moveSpeed = 4f;
        public float turnSpeed = 720f;
        public float gravity = -20f;

        public Transform cam;
        public float camDistance = 6f;
        public float camHeight = 1.5f;
        public float mouseSensitivity = 3f;
        public LayerMask camCollision = ~0;

        public Animator animator; // 參數 Speed (float)

        /// 演出時由 CluePerformance 指定的固定鏡頭；null 時恢復跟隨
        public static Transform CamShot;

        CharacterController cc;
        float yaw, pitch = 20f, vy;
        float interactHintAfter;
        static readonly int SpeedHash = Animator.StringToHash("Speed");

        void Awake()
        {
            cc = GetComponent<CharacterController>();
            if (cam == null && Camera.main != null) cam = Camera.main.transform;
            yaw = transform.eulerAngles.y;
            RestoreFoliage();
            foliage = null; // 關掉 Domain Reload 時靜態清單會殘留上一局
        }

        public void FaceDirection(Vector3 direction)
        {
            direction.y = 0;
            if (direction.sqrMagnitude < 0.01f) return;
            transform.rotation = Quaternion.LookRotation(direction);
            yaw = transform.eulerAngles.y;
        }

        void Update()
        {
            // hotfix1：HTML 輸入框開著時不吃鍵盤（WASD、E 是在打字）
            bool busy = (ScrollUI.I != null && ScrollUI.I.IsBusy) || QuestWeb.TextOpen;
            Vector3 move = Vector3.zero;

            if (!busy)
            {
                if (Input.GetMouseButton(1))
                {
                    yaw += Input.GetAxis("Mouse X") * mouseSensitivity;
                    pitch = Mathf.Clamp(pitch - Input.GetAxis("Mouse Y") * mouseSensitivity, -10f, 60f);
                }
                Vector2 look = TouchInput.ConsumeLook() * 0.15f;
                yaw += look.x;
                pitch = Mathf.Clamp(pitch - look.y, -10f, 60f);
                Vector3 input = new Vector3(Input.GetAxisRaw("Horizontal"), 0, Input.GetAxisRaw("Vertical"));
                input += new Vector3(TouchInput.Move.x, 0, TouchInput.Move.y);
                move = Quaternion.Euler(0, yaw, 0) * Vector3.ClampMagnitude(input, 1f);

                var near = Interactable.Nearest(transform.position);
                ScrollUI.I?.SetPrompt(near ? near.CurrentPrompt : null);
                bool interactPressed = Input.GetKeyDown(KeyCode.E) | TouchInput.ConsumeDown();
                if (interactPressed)
                {
                    if (near) near.Interact();
                    else if (Time.unscaledTime >= interactHintAfter)
                    {
                        interactHintAfter = Time.unscaledTime + 2.5f;
                        ScrollUI.I?.Toast(Txt.InteractTooFar);
                    }
                }
            }
            else TouchInput.ConsumeLook();

            if (move.sqrMagnitude > 0.01f)
                transform.rotation = Quaternion.RotateTowards(transform.rotation, Quaternion.LookRotation(move), turnSpeed * Time.deltaTime);

            vy = cc.isGrounded ? -1f : vy + gravity * Time.deltaTime;
            Vector3 before = transform.position;
            MoveDisplacement(cc, (move * moveSpeed + Vector3.up * vy) * Time.deltaTime);
            GroundFeet();

            // 讀實際水平速度（撞牆就停步；鍵盤、觸控搖桿都走 move → cc.Move，一樣有效）
            if (animator)
            {
                var v = (transform.position - before) / Mathf.Max(Time.deltaTime, 0.0001f); v.y = 0f;
                animator.SetFloat(SpeedHash, v.magnitude, 0.08f, Time.deltaTime);
            }
        }

        public static CollisionFlags MoveDisplacement(CharacterController controller, Vector3 delta)
        {
            // 每次不跨過單級踏面，低幀率也能逐階抬腳；限制落下時的迴圈成本。
            int count = Mathf.Clamp(Mathf.CeilToInt(delta.magnitude / 0.12f), 1, 32);
            var flags = CollisionFlags.None;
            for (int i = 0; i < count; i++) flags |= controller.Move(delta / count);
            return flags;
        }

        // hotfix1：腳貼地。膠囊圓底踩在台階邊緣時，模型腳底會陷進上一階（最多一階高）或浮在下一階；
        // 改用腳尖、腳中、腳跟三條射線量到的最高走路面當腳底，模型只上下微調（±0.1～0.3m），碰撞體不動。
        Transform foot; float footBase, footOff;
        void GroundFeet()
        {
            if (!foot)
            {
                if (!animator || !animator.transform.parent) return;
                foot = animator.transform.parent; footBase = foot.localPosition.y;
            }
            float bottom = transform.position.y + cc.center.y - cc.height * 0.5f;
            float best = float.NegativeInfinity;
            var fw = transform.forward;
            for (int i = -1; i <= 1; i++)
            {
                var p = transform.position + fw * (0.14f * i);
                if (Physics.Raycast(new Vector3(p.x, bottom + 0.4f, p.z), Vector3.down, out var h, 0.65f, CamOcclusion.WalkMask & ~(1 << 2), QueryTriggerInteraction.Ignore)
                    && h.normal.y > 0.6f && h.point.y > best) best = h.point.y;
            }
            float want = cc.isGrounded && best > float.NegativeInfinity ? Mathf.Clamp(best - bottom, -0.1f, 0.3f) : 0f;
            footOff = Mathf.MoveTowards(footOff, want, 1.5f * Time.deltaTime);
            var lp = foot.localPosition;
            float s = foot.parent ? foot.parent.lossyScale.y : 1f;
            lp.y = footBase + footOff / (s > 0.001f ? s : 1f);
            foot.localPosition = lp;
        }

        void LateUpdate()
        {
            if (!cam) return;
            if (CamShot) { cam.SetPositionAndRotation(CamShot.position, CamShot.rotation); RestoreFoliage(); HideSelf(false); return; }
            Vector3 pivot = transform.position + Vector3.up * camHeight;
            // 低矮屋簷下（亭子內抬高視角）鏡頭會被樑擋到貼著後腦：暫時把俯角放低，挑退得最遠的角度（不改玩家設定的 pitch）
            Quaternion rot = Quaternion.Euler(pitch, yaw, 0);
            float want = CamClearDistance(pivot, rot * Vector3.back, camDistance, transform);
            if (want < 1.2f)
                for (float p = pitch - 10f; p >= -10f; p -= 10f)
                {
                    var r2 = Quaternion.Euler(p, yaw, 0);
                    float w2 = CamClearDistance(pivot, r2 * Vector3.back, camDistance, transform);
                    if (w2 > want + 0.5f) { rot = r2; want = w2; }
                    if (want >= 2f) break;
                }
            // 撞到就立刻拉近；離開障礙時慢慢退回，不會一抽一抽
            camDist = want < camDist ? want : Mathf.MoveTowards(camDist, want, 4f * Time.deltaTime);
            cam.SetPositionAndRotation(pivot + rot * Vector3.back * camDist, rot);
            UpdateFoliage(cam.position, transform.position);
            // 背貼牆時鏡頭只剩 0.35～0.8 m，後腦會佔掉半個畫面：人物改成只投影子（不動模型本身）
            HideSelf(camDist < 0.8f);
        }

        Renderer[] selfRenderers;
        UnityEngine.Rendering.ShadowCastingMode[] selfModes;
        bool selfHidden;
        void HideSelf(bool hide)
        {
            if (hide == selfHidden) return;
            selfHidden = hide;
            if (selfRenderers == null)
            {
                selfRenderers = GetComponentsInChildren<Renderer>(true);
                selfModes = new UnityEngine.Rendering.ShadowCastingMode[selfRenderers.Length];
                for (int i = 0; i < selfRenderers.Length; i++) selfModes[i] = selfRenderers[i].shadowCastingMode;
            }
            for (int i = 0; i < selfRenderers.Length; i++)
                if (selfRenderers[i]) selfRenderers[i].shadowCastingMode = hide ? UnityEngine.Rendering.ShadowCastingMode.ShadowsOnly : selfModes[i];
        }

        float camDist = 5f;
        const float CamRadius = 0.22f, CamMin = 0.35f;

        /// R17-U：鏡頭可退多遠。SphereCastAll 取最近的非玩家碰撞（含 CamOcclusion 鏡頭層），
        /// 再檢查鏡頭點本身有沒有埋在物件裡（SphereCast 起點就重疊時會漏掉），有就一路往前拉近。
        public static float CamClearDistance(Vector3 pivot, Vector3 dir, float maxDist, Transform self)
        {
            float best = maxDist;
            foreach (var h in Physics.SphereCastAll(pivot, CamRadius, dir, maxDist, ~0, QueryTriggerInteraction.Ignore))
            {
                if (h.distance <= 0f || IsSelf(h.collider, self)) continue;
                if (h.distance < best) best = h.distance;
            }
            best = Mathf.Max(CamMin, best - 0.05f);
            for (int i = 0; i < 12 && best > CamMin; i++)
            {
                if (!Blocked(pivot + dir * best, self)) break;
                best = Mathf.Max(CamMin, best - 0.4f);
            }
            return best;
        }

        static readonly Collider[] overlap = new Collider[8];
        static bool Blocked(Vector3 p, Transform self)
        {
            int n = Physics.OverlapSphereNonAlloc(p, CamRadius * 0.8f, overlap, ~0, QueryTriggerInteraction.Ignore);
            for (int i = 0; i < n; i++) if (!IsSelf(overlap[i], self)) return true;
            return false;
        }

        static bool IsSelf(Collider c, Transform self) =>
            (self && c.transform.IsChildOf(self)) || c.GetComponentInParent<PlayerController>() || c is CharacterController;

        // 樹冠沒有碰撞體：沿用暫時只投影，兼看鏡頭所在處與鏡頭到角色的視線。
        static readonly string[] FoliageKeys = { "maple", "willow", "pine", "wutong", "bamboo", "banana", "tree" };
        static System.Collections.Generic.List<Renderer> foliage;
        static readonly System.Collections.Generic.Dictionary<Renderer, UnityEngine.Rendering.ShadowCastingMode> hidden = new System.Collections.Generic.Dictionary<Renderer, UnityEngine.Rendering.ShadowCastingMode>();
        static readonly System.Collections.Generic.List<Renderer> toShow = new System.Collections.Generic.List<Renderer>();

        void OnDisable() { RestoreFoliage(); HideSelf(false); }

        static void RestoreFoliage()
        {
            foreach (var item in hidden) if (item.Key) item.Key.shadowCastingMode = item.Value;
            hidden.Clear();
        }

        static void UpdateFoliage(Vector3 camPos, Vector3 feet)
        {
            if (foliage == null)
            {
                foliage = new System.Collections.Generic.List<Renderer>();
                foreach (var r in FindObjectsByType<MeshRenderer>(FindObjectsSortMode.None))
                {
                    if (r.bounds.size.y < 1f) continue;
                    bool tree = false;
                    for (var t = r.transform; t && !tree; t = t.parent)
                    {
                        string n = t.name.ToLowerInvariant();
                        foreach (var k in FoliageKeys) if (n.Contains(k)) { tree = true; break; }
                    }
                    if (tree) foliage.Add(r);
                }
            }
            toShow.Clear();
            foreach (var item in hidden)
                if (!item.Key || !ObscuresPlayer(item.Key.bounds, camPos, feet)) toShow.Add(item.Key);
            foreach (var r in toShow)
            {
                var mode = hidden[r]; hidden.Remove(r);
                if (r) r.shadowCastingMode = mode;
            }
            foreach (var r in foliage)
                if (r && r.enabled && !hidden.ContainsKey(r) && ObscuresPlayer(r.bounds, camPos, feet)
                    && r.shadowCastingMode != UnityEngine.Rendering.ShadowCastingMode.ShadowsOnly)
                {
                    hidden.Add(r, r.shadowCastingMode);
                    r.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.ShadowsOnly;
                }
        }

        static bool ObscuresPlayer(Bounds b, Vector3 camera, Vector3 feet)
        {
            // shortcut: 用樹的包圍盒保護角色輪廓；若鬆散樹冠隱藏過多，再改成網格判定。
            return CamOcclusion.BlocksView(b, camera, feet + Vector3.up * 0.3f)
                || CamOcclusion.BlocksView(b, camera, feet + Vector3.up * 1f)
                || CamOcclusion.BlocksView(b, camera, feet + Vector3.up * 1.7f);
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// R17-U：鏡頭專用碰撞層。亭子、迴廊、廳堂等建築模型本身沒有碰撞體（走路靠另外擺的隱形牆），
    /// 跟隨鏡頭與演出鏡頭的 SphereCast 打不到它們，於是鏡頭會卡進屋頂、坐凳裡。
    /// 編輯器用 CamOcclusionBaker.Bake() 在場景 _CamOcclusion 底下複製一份 MeshCollider（放第 8 層），
    /// 執行期讓第 8 層不和任何層發生物理碰撞：只給射線查詢用，不擋人、不擋 CharacterController。
    public static class CamOcclusion
    {
        public const int Layer = 8;
        public const string LayerName = "CamOcclude";
        /// 地面探測、站位檢查要排除鏡頭層（不然會站到迴廊屋頂上）
        public const int WalkMask = ~(1 << Layer);

        /// 樹沒有鏡頭碰撞體時，用鏡頭到角色的線段判斷；不把角色後方的樹算成遮擋。
        public static bool BlocksView(Bounds bounds, Vector3 camera, Vector3 target)
        {
            bounds.Expand(0.3f);
            if (bounds.Contains(camera)) return true;
            Vector3 to = target - camera;
            float length = to.magnitude;
            float distance;
            return length > 0.01f && bounds.IntersectRay(new Ray(camera, to / length), out distance)
                && distance < length - 0.1f;
        }

        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
        static void Init()
        {
            for (int i = 0; i < 32; i++) Physics.IgnoreLayerCollision(Layer, i, true);
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// 人物動作驅動（第六輪 Mixamo）：掛在帶 Animator 的人物模型上。依 docs/anim-cues.md：
    /// - DialogueBox 播到「speaker」開頭的說話者台詞時 Talk=true，結束 false（劉姥姥、鳳姐、鴛鴦、賈母都一樣）。
    /// - 群像笑（LaughMatch）期間：laughOnMatch → Laugh（只有宴席賈母，坐著笑）；
    ///   talkOnMatch → Talk（宴席鳳姐、鴛鴦「撐著，還只管讓劉姥姥」：忍笑勸菜，不笑）；結束後再維持 matchLinger 秒。
    /// - 演出腳本可呼叫 LaughFor(宿主, 秒數) 讓某位 NPC 笑一陣（入口插花、青苔滑倒時的賈母）。
    [RequireComponent(typeof(Animator))]
    public class CharacterAnimDriver : MonoBehaviour
    {
        public string speaker;
        public bool laughOnMatch;
        public bool talkOnMatch;
        public float matchLinger = 6f;

        static readonly int TalkHash = Animator.StringToHash("Talk");
        static readonly int LaughHash = Animator.StringToHash("Laugh");

        Animator anim;
        bool speaking, matchOn;
        float matchUntil = -1f, laughUntil = -1f;

        void Awake() => anim = GetComponent<Animator>();

        void Start()
        {
            // 同一份 idle 的 NPC 錯開相位，免得整園子同步擺手
            // （速度 0 的定格狀態不錯開：賈母坐姿待機是 sitting_laughing 停在固定一格）
            if (anim && anim.runtimeAnimatorController && anim.isActiveAndEnabled && anim.GetCurrentAnimatorStateInfo(0).speed > 0f)
                anim.Play(0, 0, Random.value);
        }

        void OnEnable()
        {
            DialogueBox.SpeakerChanged += OnSpeaker;
            LaughMatch.ActiveChanged += OnMatch;
            // 物件被藏起又打開時 Animator 參數會重設，補回目前狀態
            speaking = Matches(DialogueBox.CurrentSpeaker);
            if (LaughMatch.IsActive) OnMatch(true);
            Apply();
        }

        void OnDisable()
        {
            DialogueBox.SpeakerChanged -= OnSpeaker;
            LaughMatch.ActiveChanged -= OnMatch;
        }

        /// 讓 host（或其子物件）上的人物笑 seconds 秒
        public static void LaughFor(Transform host, float seconds)
        {
            if (!host) return;
            var d = host.GetComponentInChildren<CharacterAnimDriver>();
            if (!d) return;
            d.laughUntil = Mathf.Max(d.laughUntil, Time.unscaledTime + seconds);
            d.Apply();
        }

        bool Matches(string who) =>
            !string.IsNullOrEmpty(speaker) && !string.IsNullOrEmpty(who) && who.StartsWith(speaker, System.StringComparison.Ordinal);

        void OnSpeaker(string who) { speaking = Matches(who); Apply(); }

        void OnMatch(bool on)
        {
            if (!laughOnMatch && !talkOnMatch) return;
            if (on) { matchOn = true; matchUntil = float.MaxValue; }
            else matchUntil = Time.unscaledTime + matchLinger;
            Apply();
        }

        void Update()
        {
            float now = Time.unscaledTime;
            if (matchOn && now >= matchUntil) { matchOn = false; Apply(); }
            if (laughUntil > 0f && now >= laughUntil) { laughUntil = -1f; Apply(); }
        }

        void Apply()
        {
            bool laugh = laughUntil > Time.unscaledTime || (matchOn && laughOnMatch);
            bool talk = speaking || (matchOn && talkOnMatch);
            SetBool(LaughHash, laugh);
            SetBool(TalkHash, talk && !laugh);
        }

        void SetBool(int hash, bool v)
        {
            if (!anim || !anim.runtimeAnimatorController || !anim.isActiveAndEnabled) return;
            foreach (var p in anim.parameters)
                if (p.nameHash == hash && p.type == AnimatorControllerParameterType.Bool) { anim.SetBool(hash, v); return; }
        }
    }
}
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.Events;

namespace Liulaolao
{
    /// 靠近顯示提示，按 E 觸發。clueId >= 0 時開啟該線索；toast 不為空時顯示一句提示。
    public class Interactable : MonoBehaviour
    {
        public static readonly List<Interactable> All = new List<Interactable>();

        public string prompt = Txt.DefaultPrompt;
        public float radius = 2.5f;
        public int clueId = -1;
        [TextArea] public string toast;
        public UnityEvent onInteract = new UnityEvent(); // r12：執行期 AddComponent 時不會自動建立，沒初始值會 NRE

        /// Round14：已收集的線索點顯示「E 再讀」（自訂提示字不動）
        public string CurrentPrompt => clueId >= 0 && prompt == Txt.DefaultPrompt && ClueManager.I && ClueManager.I.IsCollected(clueId) ? Txt.RereadPrompt : prompt;

        void OnEnable() => All.Add(this);
        void OnDisable() => All.Remove(this);

        public void Interact()
        {
            if (!string.IsNullOrEmpty(toast)) ScrollUI.I.Toast(toast);
            if (clueId >= 0) ClueManager.I.TriggerClue(clueId);
            onInteract.Invoke();
        }

        public static Interactable Nearest(Vector3 pos)
        {
            Interactable best = null;
            float bestDist = float.MaxValue;
            foreach (var it in All)
            {
                if (it.clueId >= 0 && QuestRunner.Active) continue; // R17 任務模式：經典卷軸點不互動
                Vector3 off = it.transform.position - pos;
                off.y = 0; // 只算水平距離
                float d = off.magnitude;
                if (d <= it.radius && d < bestDist) { best = it; bestDist = d; }
            }
            return best;
        }
    }
}
using System;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// 笑場配對的一組：人物 ↔ 笑法描述
    [Serializable]
    public class MatchPair
    {
        public string who;
        public string laugh;
        public string trait;  // 選填：身分個性
        public string why;    // 選填：配對成功後顯示的說明
        [System.NonSerialized] public string icon; // R17-U 任務層：笑法卡左側小圖示（QuestArt 檔名）
    }

    /// clues.json 的一筆。沿用前作全部欄位，另加 type / zone / pairs / minigame。
    /// JsonUtility 缺欄位時給預設值（字串 null、陣列 null），一律用下面的唯讀屬性判斷。
    [Serializable]
    public class ClueData
    {
        public int id;
        public string title;
        public string original;
        public string plain;
        public string question;
        public string[] options;
        public int answer;
        public string feedback;
        public string[] wrongHints;

        public string type;       // "quiz"（預設）| "match" | "minigame"
        public string zone;       // entrance | qinfang | xiaoxiang | qiushuang | banquet
        public MatchPair[] pairs; // type == "match"
        public string minigame;   // type == "minigame"，例："egg"
        public bool isEnding;     // 選填：結局卷軸（沒有任何一筆標記時，退回「最大 id＝結局」）
        public int[] requires;    // 選填：這些線索收齊前鎖住（標記灰色、靠近時提示「先去看看〇〇」）

        public const string TypeQuiz = "quiz", TypeMatch = "match", TypeMinigame = "minigame";
        public const string ZoneBanquet = "banquet";

        public string Type => string.IsNullOrEmpty(type) ? TypeQuiz : type;
        public bool IsMatch => Type == TypeMatch;
        public bool IsMinigame => Type == TypeMinigame;
        public bool IsBanquet => zone == ZoneBanquet;
        /// 有完整選擇題（match / minigame 之後可再接一題）
        public bool HasQuiz => !string.IsNullOrEmpty(question) && options != null && options.Length > 0
                               && answer >= 0 && answer < options.Length;

        /// 拿掉選擇題的淺複本：交給 EggMinigame 時用（小遊戲內建題不回傳對錯，改由 ScrollUI 出題計分）
        public ClueData WithoutQuiz()
        {
            var c = (ClueData)MemberwiseClone();
            c.question = null;
            c.options = null;
            return c;
        }
    }

    /// 頂層 "evidenceCards" 的一張：結局推論題前顯示（只顯示已收集線索的卡）
    [Serializable]
    public class EvidenceCard
    {
        public int clueId;
        public string label;
        public string quote;
    }

    /// 頂層 "reflection"：不計分的反思題
    [Serializable]
    public class Reflection
    {
        public string question;
        public string[] prompts;
    }

    [Serializable]
    class ClueList
    {
        public ClueData[] clues;
        public ClueData infer;      // 選填：結局後的推論題；沒填就不出（結局線索本身可當推論題）
        public string endingText;   // 選填：作者／人物揭曉文字；沒填用 Txt.EndingReveal
        public EvidenceCard[] evidenceCards; // 選填
        public Reflection reflection;        // 選填
    }

    /// 線索資料（clues.json）＋進度（PlayerPrefs）。
    /// id 最大的一筆是結局（集齊其他全部才開）；zone == banquet 的線索要等園中線索集齊才開（宴席門）；
    /// 有 requires 的線索要等列出的線索都收齊才開。
    public class ClueManager : MonoBehaviour
    {
        const string SaveKey = "liulaolao_collected";

        public static ClueManager I { get; private set; }
        /// 結局線索 id（資料中最大 id）；QuizStats 以它推算推論題 id
        public static int EndingId { get; private set; }
        public static bool IsEnding(int id) => id == EndingId;

        [SerializeField] TextAsset clueJson;
        [SerializeField] ScrollUI ui;
        [SerializeField] Material markerMat; // 線索標記用（URP Unlit）
        public Material MarkerMat => markerMat; // R17 任務關卡標記共用

        ClueData[] clues = new ClueData[0];
        ClueData inferData;
        string endingText;
        EvidenceCard[] evidenceCards = new EvidenceCard[0];
        Reflection reflection;
        readonly HashSet<int> collected = new HashSet<int>();
        // id → 線索。ClueMarker 每幀呼叫 IsLocked → Find；舊版 Array.Find 帶捕獲 lambda，每次呼叫都配置記憶體（審查 #17）
        readonly Dictionary<int, ClueData> byId = new Dictionary<int, ClueData>();

        public IReadOnlyList<ClueData> Clues => clues;
        public bool IsCollected(int id) => collected.Contains(id);
        public bool FirstScrollPending => clues.Length > 0 && !collected.Contains(clues[0].id);
        public ClueData Find(int id) => byId.TryGetValue(id, out var c) ? c : null;
        public ClueData InferData => inferData;
        public string EndingText => string.IsNullOrEmpty(endingText) ? Txt.EndingReveal : endingText;
        /// 反思題（沒填 question 時為 null）
        public Reflection ReflectionData => reflection;

        /// 已收集線索的證據卡（依 clueId 排序）
        public List<EvidenceCard> CollectedEvidence()
        {
            var list = new List<EvidenceCard>();
            foreach (var e in evidenceCards)
                if (e != null && collected.Contains(e.clueId) && (!string.IsNullOrEmpty(e.label) || !string.IsNullOrEmpty(e.quote)))
                    list.Add(e);
            list.Sort((a, b) => a.clueId.CompareTo(b.clueId));
            return list;
        }

        // 以下計數每幀被 HUD／ClueMarker 呼叫：用迴圈，不用捕獲 this 的 lambda 或方法群組（每次都會配置委派）
        /// 結局以外的線索數（HUD「線索冊 x／N」）
        public int ScrollCount { get { int n = 0; foreach (var c in clues) if (c.id != EndingId) n++; return n; } }
        public int ScrollsCollected { get { int n = 0; foreach (var c in clues) if (c.id != EndingId && collected.Contains(c.id)) n++; return n; } }
        /// 園中（非宴席、非結局）線索
        public int GardenCount { get { int n = 0; foreach (var c in clues) if (IsGarden(c)) n++; return n; } }
        public int GardenCollected { get { int n = 0; foreach (var c in clues) if (IsGarden(c) && collected.Contains(c.id)) n++; return n; } }
        public bool BanquetUnlocked => GardenCollected == GardenCount;
        public bool EndingUnlocked => ScrollsCollected == ScrollCount;

        bool IsGarden(ClueData c) => c.id != EndingId && !c.IsBanquet;

        /// ClueMarker 每幀呼叫：只回布林、不產生字串
        public bool IsLocked(int id)
        {
            if (id == EndingId) return !EndingUnlocked;
            var c = Find(id);
            return c != null && ((c.IsBanquet && !BanquetUnlocked) || MissingRequirement(c) != null);
        }

        /// requires 裡第一張還沒收集的線索；都收齊回傳 null。
        /// 會造成永久鎖死的條件一律略過（check.py 也會擋，這裡是 C# 端防呆，審查 #16）：
        /// 自己、不存在的 id、結局 id、園中線索 requires 宴席線索（宴席要等園中全收齊才開，互等）。
        public ClueData MissingRequirement(ClueData c)
        {
            if (c == null || c.requires == null) return null;
            foreach (int r in c.requires)
            {
                if (r == c.id || r == EndingId || collected.Contains(r)) continue;
                var rc = Find(r);
                if (rc == null || (IsGarden(c) && rc.IsBanquet)) continue;
                return rc;
            }
            return null;
        }

        /// 鎖住時的提示；沒鎖回傳 null
        string LockedMessage(int id)
        {
            if (id == EndingId) return EndingUnlocked ? null : Txt.EndingLocked(ScrollsCollected, ScrollCount);
            var c = Find(id);
            if (c == null) return null;
            if (c.IsBanquet && !BanquetUnlocked) return Txt.BanquetLocked(GardenCollected, GardenCount);
            var miss = MissingRequirement(c);
            return miss != null ? Txt.RequiresLocked(miss.title) : null;
        }

        /// 算進成績的題目：一般選擇題、配對關（以配對後選擇題首答計）、
        /// 有選擇題的小遊戲（小遊戲後由 ScrollUI 出題）、推論題（有 infer 區塊時）。
        public bool IsScored(int id)
        {
            if (id == QuizStats.InferId) return inferData != null;
            var c = Find(id);
            return c != null && (c.HasQuiz || c.IsMatch);
        }

        /// 線索冊／卷軸標題用的標籤：卷一、卷二……／宴席／結局
        public string LabelOf(ClueData c)
        {
            if (c.id == EndingId) return Txt.EndingTag;
            if (c.IsBanquet) return Txt.BanquetTag;
            int n = 0;
            foreach (var x in clues) if (IsGarden(x) && x.id < c.id) n++;
            return Txt.RollPrefix + (n < Txt.Numerals.Length ? Txt.Numerals[n].ToString() : (n + 1).ToString());
        }


        void Awake()
        {
            I = this;
            if (clueJson == null) Debug.LogError("[ClueManager] 沒有指定 clues.json");
            else
            {
                var list = JsonUtility.FromJson<ClueList>(clueJson.text);
                if (list != null)
                {
                    clues = list.clues ?? new ClueData[0];
                    inferData = list.infer != null && !string.IsNullOrEmpty(list.infer.question) ? list.infer : null;
                    endingText = list.endingText;
                    if (list.evidenceCards != null) evidenceCards = list.evidenceCards;
                    reflection = list.reflection != null && !string.IsNullOrEmpty(list.reflection.question) ? list.reflection : null;
                }
            }
            SceneScript.Load(clueJson); // 劇情演出台詞（clues.json 的 "scenes"；缺了用內建 fallback）
            Array.Sort(clues, (a, b) => a.id.CompareTo(b.id));
            byId.Clear();
            foreach (var c in clues) if (c != null && !byId.ContainsKey(c.id)) byId[c.id] = c;
            var flagged = Array.Find(clues, c => c.isEnding);
            EndingId = flagged != null ? flagged.id : clues.Length > 0 ? clues[clues.Length - 1].id : 0;
            foreach (var s in PlayerPrefs.GetString(SaveKey, "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                if (int.TryParse(s, out int v)) collected.Add(v);
        }

        void Start()
        {
            foreach (var it in Interactable.All)
                if (it.clueId >= 0) ClueMarker.Create(it, markerMat);
            GardenPerformances.Register(CluePerformance.I); // 園中卷一～四的精緻演出（取代佔位版）
            // 不自動跳題：先讓玩家自由走動，用一句話指出第一步
            if (collected.Count == 0 && !ScrollUI.DeferHelp) Invoke(nameof(StartOpening), 1f);
        }

        void StartOpening() { if (ui) ui.Toast(NextStop.Line(true) ?? Txt.Opening); }
        /// R17：選經典模式後才放開場提示
        public void ShowOpening() { if (collected.Count == 0) Invoke(nameof(StartOpening), 0.5f); }

        public void TriggerClue(int id)
        {
            var locked = LockedMessage(id);
            if (locked != null) { ui.Toast(locked); return; }
            var clue = Find(id);
            if (clue == null) { Debug.LogWarning($"[ClueManager] clues.json 沒有 id={id}"); return; }
            // 宴席卷軸：先播宴席前演出（鴛鴦悄悄話）才開放
            if (clue.IsBanquet && id != EndingId && !IsCollected(id) && BanquetIntro.InterceptBanquetClue()) return;
            if (IsCollected(id))
                ui.ShowClue(clue, () => { }, true); // 已收集：直接重讀，不重播演出
            else if (id == EndingId)
            {
                // 結局：證據卡 → 推論題 → scenes.ending 揭曉 → infer → 反思 → 成績卡（成績卡出現前才收進線索冊）
                Action run = () => ui.StartEnding(clue, () => Collect(id));
                if (CluePerformance.I && CluePerformance.I.Has(clue)) CluePerformance.I.Play(clue, run);
                else run();
            }
            else if (CluePerformance.I && CluePerformance.I.Has(clue))
                CluePerformance.I.Play(clue, () => ui.ShowClue(clue, () => Collect(id)));
            else
                ui.ShowClue(clue, () => Collect(id));
        }

        void Collect(int id)
        {
            bool wasBanquetOpen = BanquetUnlocked;
            if (!collected.Add(id)) return;
            PlayerPrefs.SetString(SaveKey, string.Join(",", collected));
            PlayerPrefs.Save();
            if (id == EndingId) return; // 結局流程由 ScrollUI.StartEnding 接手
            string msg = EndingUnlocked ? Txt.EndingReady : !wasBanquetOpen && BanquetUnlocked ? Txt.BanquetOpen : null;
            // hotfix1：收完一卷就說下一站在哪、往哪走（卷軸面板關掉後鏡頭回到姥姥身後才算方向）
            if (clues.Length > 0 && id == clues[0].id) msg = Txt.FirstScrollComplete;
            StartCoroutine(NextStopToast(msg));
        }

        System.Collections.IEnumerator NextStopToast(string msg)
        {
            yield return null;
            for (float t = 0; t < 30f && ScrollUI.I && ScrollUI.I.IsBusy; t += Time.unscaledDeltaTime) yield return null;
            string next = NextStop.Line(true);
            string text = msg == null ? next : next == null ? msg : msg + "\n" + next;
            if (string.IsNullOrEmpty(text)) yield break;
            ui.Toast(text);
            if (next != null && SpeechBridge.Supported && !(AudioManager.I && AudioManager.I.Muted) && !(ui && ui.IsBusy)) SpeechBridge.Speak(next);
        }

        public void ResetProgress()
        {
            PlayerPrefs.DeleteKey(SaveKey);
            QuizStats.Clear();
            PerfUtil.ClearSaves();
            PlayerPrefs.DeleteKey(ScrollUI.HelpSeenKey); // 共用電腦：下一位學生重新開始也看得到操作說明
            PlayerPrefs.Save();
            SceneManager.LoadScene(SceneManager.GetActiveScene().name);
        }
    }
}
using UnityEngine;

namespace Liulaolao
{
    /// 線索互動點上方的浮空卷軸：上下飄、慢慢轉、亮度呼吸。未收集才顯示；
    /// 鎖住的線索（宴席、結局）顯示為灰色。用 Unlit 材質，不加光源、不加碰撞體。
    public class ClueMarker : MonoBehaviour
    {
        static readonly Color Paper = new Color(0.94f, 0.88f, 0.72f);
        static readonly Color Wood = new Color(0.31f, 0.17f, 0.07f);
        static readonly Color[] PartColors = { Paper, Wood, Wood };
        static readonly Color Grey = new Color(0.45f, 0.45f, 0.45f);
        static readonly int BaseColor = Shader.PropertyToID("_BaseColor");

        int clueId;
        Transform target;
        float height;
        Transform visual;
        Renderer[] rends;
        MaterialPropertyBlock mpb;
        bool shown = true;

        public int ClueId => clueId;

        public static ClueMarker Create(Interactable target, Material mat)
        {
            // 放在物件頂端再往上一點
            float top = target.transform.position.y + 1.2f;
            foreach (var r in target.GetComponentsInChildren<Renderer>())
                top = Mathf.Max(top, r.bounds.max.y + 0.7f);

            var go = new GameObject("ClueMarker_" + target.clueId);
            var m = go.AddComponent<ClueMarker>();
            m.clueId = target.clueId;
            m.target = target.transform; // 不設父物件，免得吃到模型的縮放
            m.height = top - target.transform.position.y;
            m.Build(mat);
            return m;
        }

        void Build(Material mat)
        {
            visual = new GameObject("Visual").transform;
            visual.SetParent(transform, false);
            // 軸頭比紙卷粗，旋轉到側面仍保留卷軸輪廓。
            rends = new[]
            {
                Part(PrimitiveType.Cylinder, Vector3.zero, new Vector3(0.22f, 0.3f, 0.22f), mat),
                Part(PrimitiveType.Cylinder, new Vector3(-0.33f, 0, 0), new Vector3(0.32f, 0.045f, 0.32f), mat),
                Part(PrimitiveType.Cylinder, new Vector3(0.33f, 0, 0), new Vector3(0.32f, 0.045f, 0.32f), mat)
            };
            mpb = new MaterialPropertyBlock();
        }

        Renderer Part(PrimitiveType type, Vector3 pos, Vector3 scale, Material mat)
        {
            var p = GameObject.CreatePrimitive(type);
            Destroy(p.GetComponent<Collider>());
            p.transform.SetParent(visual, false);
            p.transform.localPosition = pos;
            p.transform.localRotation = Quaternion.Euler(0, 0, 90);
            p.transform.localScale = scale;
            var r = p.GetComponent<Renderer>();
            r.sharedMaterial = mat;
            r.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
            r.receiveShadows = false;
            return r;
        }

        void Update()
        {
            var cm = ClueManager.I;
            bool show = cm && !cm.IsCollected(clueId) && !(ScrollUI.I && ScrollUI.I.Cinematic) && !QuestRunner.Active;
            if (show != shown)
            {
                shown = show;
                visual.gameObject.SetActive(show);
            }
            if (!show || !target) return;

            bool locked = cm.IsLocked(clueId);
            float t = Time.time + clueId;
            transform.position = target.position + Vector3.up * (height + (locked ? 0f : Mathf.Sin(t * 2f) * 0.15f));
            visual.localRotation = Quaternion.Euler(0, t * 45f, 0);

            // 離鏡頭越遠放大一點，遠處也看得到
            var cam = Camera.main;
            float s = cam ? Mathf.Clamp(Vector3.Distance(cam.transform.position, transform.position) * 0.06f, 1f, 3f) : 1f;
            visual.localScale = Vector3.one * s;

            float brightness = 0.94f + 0.04f * Mathf.Sin(t * 3f);
            for (int i = 0; i < rends.Length; i++)
            {
                Color c = locked ? Grey : PartColors[i] * brightness;
                c.a = 1f;
                mpb.SetColor(BaseColor, c);
                rends[i].SetPropertyBlock(mpb);
            }
        }
    }
}

