using System;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// 笑場配對的一組：人物 ↔ 笑法描述
    [Serializable]
    public class MatchPair
    {
        public string who;
        public string laugh;
        public string trait;  // 選填：身分個性
        public string why;    // 選填：配對成功後顯示的說明
        [System.NonSerialized] public string icon; // R17-U 任務層：笑法卡左側小圖示（QuestArt 檔名）
    }

    /// clues.json 的一筆。沿用前作全部欄位，另加 type / zone / pairs / minigame。
    /// JsonUtility 缺欄位時給預設值（字串 null、陣列 null），一律用下面的唯讀屬性判斷。
    [Serializable]
    public class ClueData
    {
        public int id;
        public string title;
        public string original;
        public string plain;
        public string question;
        public string[] options;
        public int answer;
        public string feedback;
        public string[] wrongHints;

        public string type;       // "quiz"（預設）| "match" | "minigame"
        public string zone;       // entrance | qinfang | xiaoxiang | qiushuang | banquet
        public MatchPair[] pairs; // type == "match"
        public string minigame;   // type == "minigame"，例："egg"
        public bool isEnding;     // 選填：結局卷軸（沒有任何一筆標記時，退回「最大 id＝結局」）
        public int[] requires;    // 選填：這些線索收齊前鎖住（標記灰色、靠近時提示「先去看看〇〇」）

        public const string TypeQuiz = "quiz", TypeMatch = "match", TypeMinigame = "minigame";
        public const string ZoneBanquet = "banquet";

        public string Type => string.IsNullOrEmpty(type) ? TypeQuiz : type;
        public bool IsMatch => Type == TypeMatch;
        public bool IsMinigame => Type == TypeMinigame;
        public bool IsBanquet => zone == ZoneBanquet;
        /// 有完整選擇題（match / minigame 之後可再接一題）
        public bool HasQuiz => !string.IsNullOrEmpty(question) && options != null && options.Length > 0
                               && answer >= 0 && answer < options.Length;

        /// 拿掉選擇題的淺複本：交給 EggMinigame 時用（小遊戲內建題不回傳對錯，改由 ScrollUI 出題計分）
        public ClueData WithoutQuiz()
        {
            var c = (ClueData)MemberwiseClone();
            c.question = null;
            c.options = null;
            return c;
        }
    }

    /// 頂層 "evidenceCards" 的一張：結局推論題前顯示（只顯示已收集線索的卡）
    [Serializable]
    public class EvidenceCard
    {
        public int clueId;
        public string label;
        public string quote;
    }

    /// 頂層 "reflection"：不計分的反思題
    [Serializable]
    public class Reflection
    {
        public string question;
        public string[] prompts;
    }

    [Serializable]
    class ClueList
    {
        public ClueData[] clues;
        public ClueData infer;      // 選填：結局後的推論題；沒填就不出（結局線索本身可當推論題）
        public string endingText;   // 選填：作者／人物揭曉文字；沒填用 Txt.EndingReveal
        public EvidenceCard[] evidenceCards; // 選填
        public Reflection reflection;        // 選填
    }

    /// 線索資料（clues.json）＋進度（PlayerPrefs）。
    /// id 最大的一筆是結局（集齊其他全部才開）；zone == banquet 的線索要等園中線索集齊才開（宴席門）；
    /// 有 requires 的線索要等列出的線索都收齊才開。
    public class ClueManager : MonoBehaviour
    {
        const string SaveKey = "liulaolao_collected";

        public static ClueManager I { get; private set; }
        /// 結局線索 id（資料中最大 id）；QuizStats 以它推算推論題 id
        public static int EndingId { get; private set; }
        public static bool IsEnding(int id) => id == EndingId;

        [SerializeField] TextAsset clueJson;
        [SerializeField] ScrollUI ui;
        [SerializeField] Material markerMat; // 線索標記用（URP Unlit）
        public Material MarkerMat => markerMat; // R17 任務關卡標記共用

        ClueData[] clues = new ClueData[0];
        ClueData inferData;
        string endingText;
        EvidenceCard[] evidenceCards = new EvidenceCard[0];
        Reflection reflection;
        readonly HashSet<int> collected = new HashSet<int>();
        // id → 線索。ClueMarker 每幀呼叫 IsLocked → Find；舊版 Array.Find 帶捕獲 lambda，每次呼叫都配置記憶體（審查 #17）
        readonly Dictionary<int, ClueData> byId = new Dictionary<int, ClueData>();

        public IReadOnlyList<ClueData> Clues => clues;
        public bool IsCollected(int id) => collected.Contains(id);
        public bool FirstScrollPending => clues.Length > 0 && !collected.Contains(clues[0].id);
        public ClueData Find(int id) => byId.TryGetValue(id, out var c) ? c : null;
        public ClueData InferData => inferData;
        public string EndingText => string.IsNullOrEmpty(endingText) ? Txt.EndingReveal : endingText;
        /// 反思題（沒填 question 時為 null）
        public Reflection ReflectionData => reflection;

        /// 已收集線索的證據卡（依 clueId 排序）
        public List<EvidenceCard> CollectedEvidence()
        {
            var list = new List<EvidenceCard>();
            foreach (var e in evidenceCards)
                if (e != null && collected.Contains(e.clueId) && (!string.IsNullOrEmpty(e.label) || !string.IsNullOrEmpty(e.quote)))
                    list.Add(e);
            list.Sort((a, b) => a.clueId.CompareTo(b.clueId));
            return list;
        }

        // 以下計數每幀被 HUD／ClueMarker 呼叫：用迴圈，不用捕獲 this 的 lambda 或方法群組（每次都會配置委派）
        /// 結局以外的線索數（HUD「線索冊 x／N」）
        public int ScrollCount { get { int n = 0; foreach (var c in clues) if (c.id != EndingId) n++; return n; } }
        public int ScrollsCollected { get { int n = 0; foreach (var c in clues) if (c.id != EndingId && collected.Contains(c.id)) n++; return n; } }
        /// 園中（非宴席、非結局）線索
        public int GardenCount { get { int n = 0; foreach (var c in clues) if (IsGarden(c)) n++; return n; } }
        public int GardenCollected { get { int n = 0; foreach (var c in clues) if (IsGarden(c) && collected.Contains(c.id)) n++; return n; } }
        public bool BanquetUnlocked => GardenCollected == GardenCount;
        public bool EndingUnlocked => ScrollsCollected == ScrollCount;

        bool IsGarden(ClueData c) => c.id != EndingId && !c.IsBanquet;

        /// ClueMarker 每幀呼叫：只回布林、不產生字串
        public bool IsLocked(int id)
        {
            if (id == EndingId) return !EndingUnlocked;
            var c = Find(id);
            return c != null && ((c.IsBanquet && !BanquetUnlocked) || MissingRequirement(c) != null);
        }

        /// requires 裡第一張還沒收集的線索；都收齊回傳 null。
        /// 會造成永久鎖死的條件一律略過（check.py 也會擋，這裡是 C# 端防呆，審查 #16）：
        /// 自己、不存在的 id、結局 id、園中線索 requires 宴席線索（宴席要等園中全收齊才開，互等）。
        public ClueData MissingRequirement(ClueData c)
        {
            if (c == null || c.requires == null) return null;
            foreach (int r in c.requires)
            {
                if (r == c.id || r == EndingId || collected.Contains(r)) continue;
                var rc = Find(r);
                if (rc == null || (IsGarden(c) && rc.IsBanquet)) continue;
                return rc;
            }
            return null;
        }

        /// 鎖住時的提示；沒鎖回傳 null
        string LockedMessage(int id)
        {
            if (id == EndingId) return EndingUnlocked ? null : Txt.EndingLocked(ScrollsCollected, ScrollCount);
            var c = Find(id);
            if (c == null) return null;
            if (c.IsBanquet && !BanquetUnlocked) return Txt.BanquetLocked(GardenCollected, GardenCount);
            var miss = MissingRequirement(c);
            return miss != null ? Txt.RequiresLocked(miss.title) : null;
        }

        /// 算進成績的題目：一般選擇題、配對關（以配對後選擇題首答計）、
        /// 有選擇題的小遊戲（小遊戲後由 ScrollUI 出題）、推論題（有 infer 區塊時）。
        public bool IsScored(int id)
        {
            if (id == QuizStats.InferId) return inferData != null;
            var c = Find(id);
            return c != null && (c.HasQuiz || c.IsMatch);
        }

        /// 線索冊／卷軸標題用的標籤：卷一、卷二……／宴席／結局
        public string LabelOf(ClueData c)
        {
            if (c.id == EndingId) return Txt.EndingTag;
            if (c.IsBanquet) return Txt.BanquetTag;
            int n = 0;
            foreach (var x in clues) if (IsGarden(x) && x.id < c.id) n++;
            return Txt.RollPrefix + (n < Txt.Numerals.Length ? Txt.Numerals[n].ToString() : (n + 1).ToString());
        }


        void Awake()
        {
            I = this;
            if (clueJson == null) Debug.LogError("[ClueManager] 沒有指定 clues.json");
            else
            {
                var list = JsonUtility.FromJson<ClueList>(clueJson.text);
                if (list != null)
                {
                    clues = list.clues ?? new ClueData[0];
                    inferData = list.infer != null && !string.IsNullOrEmpty(list.infer.question) ? list.infer : null;
                    endingText = list.endingText;
                    if (list.evidenceCards != null) evidenceCards = list.evidenceCards;
                    reflection = list.reflection != null && !string.IsNullOrEmpty(list.reflection.question) ? list.reflection : null;
                }
            }
            SceneScript.Load(clueJson); // 劇情演出台詞（clues.json 的 "scenes"；缺了用內建 fallback）
            Array.Sort(clues, (a, b) => a.id.CompareTo(b.id));
            byId.Clear();
            foreach (var c in clues) if (c != null && !byId.ContainsKey(c.id)) byId[c.id] = c;
            var flagged = Array.Find(clues, c => c.isEnding);
            EndingId = flagged != null ? flagged.id : clues.Length > 0 ? clues[clues.Length - 1].id : 0;
            foreach (var s in PlayerPrefs.GetString(SaveKey, "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                if (int.TryParse(s, out int v)) collected.Add(v);
        }

        void Start()
        {
            foreach (var it in Interactable.All)
                if (it.clueId >= 0) ClueMarker.Create(it, markerMat);
            GardenPerformances.Register(CluePerformance.I); // 園中卷一～四的精緻演出（取代佔位版）
            // 不自動跳題：先讓玩家自由走動，用一句話指出第一步
            if (collected.Count == 0 && !ScrollUI.DeferHelp) Invoke(nameof(StartOpening), 1f);
        }

        void StartOpening() { if (ui) ui.Toast(NextStop.Line(true) ?? Txt.Opening); }
        /// R17：選經典模式後才放開場提示
        public void ShowOpening() { if (collected.Count == 0) Invoke(nameof(StartOpening), 0.5f); }

        public void TriggerClue(int id)
        {
            var locked = LockedMessage(id);
            if (locked != null) { ui.Toast(locked); return; }
            var clue = Find(id);
            if (clue == null) { Debug.LogWarning($"[ClueManager] clues.json 沒有 id={id}"); return; }
            // 宴席卷軸：先播宴席前演出（鴛鴦悄悄話）才開放
            if (clue.IsBanquet && id != EndingId && !IsCollected(id) && BanquetIntro.InterceptBanquetClue()) return;
            if (IsCollected(id))
                ui.ShowClue(clue, () => { }, true); // 已收集：直接重讀，不重播演出
            else if (id == EndingId)
            {
                // 結局：證據卡 → 推論題 → scenes.ending 揭曉 → infer → 反思 → 成績卡（成績卡出現前才收進線索冊）
                Action run = () => ui.StartEnding(clue, () => Collect(id));
                if (CluePerformance.I && CluePerformance.I.Has(clue)) CluePerformance.I.Play(clue, run);
                else run();
            }
            else if (CluePerformance.I && CluePerformance.I.Has(clue))
                CluePerformance.I.Play(clue, () => ui.ShowClue(clue, () => Collect(id)));
            else
                ui.ShowClue(clue, () => Collect(id));
        }

        void Collect(int id)
        {
            bool wasBanquetOpen = BanquetUnlocked;
            if (!collected.Add(id)) return;
            PlayerPrefs.SetString(SaveKey, string.Join(",", collected));
            PlayerPrefs.Save();
            if (id == EndingId) return; // 結局流程由 ScrollUI.StartEnding 接手
            string msg = EndingUnlocked ? Txt.EndingReady : !wasBanquetOpen && BanquetUnlocked ? Txt.BanquetOpen : null;
            // hotfix1：收完一卷就說下一站在哪、往哪走（卷軸面板關掉後鏡頭回到姥姥身後才算方向）
            if (clues.Length > 0 && id == clues[0].id) msg = Txt.FirstScrollComplete;
            StartCoroutine(NextStopToast(msg));
        }

        System.Collections.IEnumerator NextStopToast(string msg)
        {
            yield return null;
            for (float t = 0; t < 30f && ScrollUI.I && ScrollUI.I.IsBusy; t += Time.unscaledDeltaTime) yield return null;
            string next = NextStop.Line(true);
            string text = msg == null ? next : next == null ? msg : msg + "\n" + next;
            if (string.IsNullOrEmpty(text)) yield break;
            ui.Toast(text);
            if (next != null && SpeechBridge.Supported && !(AudioManager.I && AudioManager.I.Muted) && !(ui && ui.IsBusy)) SpeechBridge.Speak(next);
        }

        public void ResetProgress()
        {
            PlayerPrefs.DeleteKey(SaveKey);
            QuizStats.Clear();
            PerfUtil.ClearSaves();
            PlayerPrefs.DeleteKey(ScrollUI.HelpSeenKey); // 共用電腦：下一位學生重新開始也看得到操作說明
            PlayerPrefs.Save();
            SceneManager.LoadScene(SceneManager.GetActiveScene().name);
        }
    }
}
using System;
using System.Collections;
using System.Text;
using UnityEngine;
using UnityEngine.Networking;
using UnityEngine.SceneManagement;

namespace Liulaolao
{
    /// Boot 場景唯一的元件。WebGL 版 Main 場景不在主包：從 StreamingAssets/scene/ 依 parts.json 依序下載各塊、
    /// 拼回完整 bundle 再 LoadFromMemoryAsync，最後載入 Main（Editor/SceneBundles.cs 產生這些檔）。
    /// Editor 直接 LoadScene("Main")（Main 仍在 Build Settings）。畫面文字只用英文／數字，避免 TMP 中文缺字。
    public class BootLoader : MonoBehaviour
    {
        public const string MainScene = "Main", BundleName = "main", Dir = "scene", IndexFile = "parts.json";
        public const int PartSize = 20 * 1024 * 1024; // 每塊 20 MiB，低於 Cloudflare Pages 單檔 25 MiB

        /// parts.json：{ "name": "main", "parts": 2, "bytes": 31457280 }
        [Serializable] public class Parts { public string name; public int parts; public long bytes; }

#pragma warning disable CS0169, CS0649 // 下面三個欄位只在 WebGL 分支寫入；Editor 編譯時別洗警告
        static AssetBundle bundle; // 刻意不卸載：「重新開始」用 LoadScene("Main") 重載時還要用
        long doneBytes, totalBytes;
#pragma warning restore CS0169, CS0649

        string status = "Loading...";
        bool failed;
        UnityWebRequest current;
        GUIStyle label, button;

        void Start() => StartCoroutine(Run());

        IEnumerator Run()
        {
            failed = false;
            status = "Loading...";
#if UNITY_WEBGL && !UNITY_EDITOR
            if (!bundle)
            {
                string dir = $"{Application.streamingAssetsPath}/{Dir}/", v = $"?v={Application.buildGUID}"; // ?v= 讓新版不吃到 CDN 舊檔
                byte[] json = null;
                yield return Download(dir + IndexFile + v, d => json = d);
                if (json == null) { Fail("Network error (E1). Please check your connection and retry."); yield break; }
                Parts p = null;
                try { p = JsonUtility.FromJson<Parts>(Encoding.UTF8.GetString(json)); }
                catch (Exception e) { Debug.LogError($"[Boot] parts.json parse failed (got index.html?): {e.Message}"); }
                if (p == null || p.name != BundleName || p.bytes <= 0 || p.bytes > int.MaxValue
                    || p.parts != (p.bytes + PartSize - 1) / PartSize)
                { Fail("Data error (E2). Please reload the page."); yield break; }

                var all = new byte[p.bytes];
                totalBytes = p.bytes;
                doneBytes = 0;
                for (int i = 0; i < p.parts; i++)
                {
                    byte[] part = null;
                    yield return Download($"{dir}{p.name}.{i}{v}", d => part = d);
                    if (part == null) { Fail($"Network error (E3, part {i + 1}/{p.parts}). Please retry."); yield break; }
                    if (doneBytes + part.Length > all.Length) { Fail($"Data error (E4, part {i + 1}). Please reload the page."); yield break; }
                    Buffer.BlockCopy(part, 0, all, (int)doneBytes, part.Length);
                    doneBytes += part.Length;
                }
                if (doneBytes != all.Length) { Fail($"Data error (E4, {doneBytes}/{all.Length}). Please reload the page."); yield break; }

                status = "Unpacking...";
                var load = AssetBundle.LoadFromMemoryAsync(all);
                all = null; // 引擎已有自己的副本，放掉讓 GC 回收
                yield return load;
                bundle = load.assetBundle;
                if (!bundle) { Fail("Load error (E5). Please reload the page."); yield break; }
            }
#endif
            status = "Starting...";
            var op = SceneManager.LoadSceneAsync(MainScene);
            if (op == null) { Fail("Load error (E6). Please reload the page."); yield break; } // Editor：Main 不在 Build Settings
            yield return op;
        }

        void Fail(string message)
        {
            Debug.LogError("[Boot] " + message);
            status = message;
            failed = true;
            current = null;
        }

        /// 網路不穩重試 3 次；全失敗不呼叫 done（呼叫端以 null 判斷）
        IEnumerator Download(string url, Action<byte[]> done)
        {
            for (int tries = 1; tries <= 3; tries++)
                using (var req = UnityWebRequest.Get(url))
                {
                    current = req;
                    yield return req.SendWebRequest();
                    current = null;
                    if (req.result == UnityWebRequest.Result.Success) { done(req.downloadHandler.data); yield break; }
                    Debug.LogWarning($"[Boot] download failed (try {tries}) {url}: {req.error}");
                    if (tries < 3) yield return new WaitForSecondsRealtime(tries);
                }
        }

        void OnGUI()
        {
            int size = Mathf.Max(16, Screen.height / 28);
            if (label == null)
            {
                label = new GUIStyle(GUI.skin.label) { alignment = TextAnchor.MiddleCenter, wordWrap = true };
                label.normal.textColor = new Color(0.96f, 0.9f, 0.78f);
                button = new GUIStyle(GUI.skin.button);
            }
            label.fontSize = button.fontSize = size;

            string text = status;
            if (!failed && totalBytes > 0 && status == "Loading...")
            {
                long got = doneBytes + (current != null ? (long)current.downloadedBytes : 0);
                text = $"Loading {Mathf.Clamp(100f * got / totalBytes, 0f, 100f):0}%  ({got / 1048576f:0.0} / {totalBytes / 1048576f:0.0} MB)";
            }
            float w = Mathf.Min(Screen.width - 32, size * 30);
            GUI.Label(new Rect((Screen.width - w) / 2, Screen.height / 2 - size * 2, w, size * 3), text, label);
            if (failed && GUI.Button(new Rect((Screen.width - size * 6) / 2, Screen.height / 2 + size * 1.5f, size * 6, size * 2), "Retry", button))
                StartCoroutine(Run());
        }
    }
}

