                r.sharedMaterial = mats[1]; r.SetPropertyBlock(props);
            }
            else if (n == "VillageSquare")
            {
                var props = new MaterialPropertyBlock(); props.SetVector("_BaseMap_ST", new Vector4(r.bounds.size.x / 6, r.bounds.size.z / 6, 0, 0));
                r.sharedMaterial = mats[4]; r.SetPropertyBlock(props);
            }
            else if (n.StartsWith("Cliff_") || n == "R1PeachLanding") r.sharedMaterial = mats[2];
        }
    }
    static void Foliage()
    {
        var entries = JsonUtility.FromJson<AtlasList>("{\"entries\":" + File.ReadAllText(Art + "foliage/atlas_layout.json") + "}").entries;
        var mat = Material("foliage", "Universal Render Pipeline/Lit"); mat.SetTexture("_BaseMap", Texture("foliage/foliage_atlas.png"));
        mat.SetFloat("_AlphaClip", 1); mat.EnableKeyword("_ALPHATEST_ON"); mat.SetFloat("_Cutoff", 0.4f);
        mat.SetFloat("_Cull", 0); mat.SetFloat("_Smoothness", 0); mat.renderQueue = 2450; mat.enableInstancing = true;
        EditorUtility.SetDirty(mat);
        var meshes = new Mesh[6];
        for (int i = 0; i < 6; i++)
        {
            var uv = entries[i].uv_bottom_left;
            if (uv.Length != 4 || uv[0] < 0 || uv[1] < 0 || uv[0] + uv[2] > 1 || uv[1] + uv[3] > 1) throw new InvalidDataException("圖集 UV 無效。");
            string path = Mats + "foliage_" + entries[i].name + ".asset";
            var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path); bool exists = mesh;
            if (!mesh) mesh = new Mesh(); else mesh.Clear();
            mesh.vertices = new[] { new Vector3(-0.5f,0,0),new Vector3(0.5f,0,0),new Vector3(-0.5f,1,0),new Vector3(0.5f,1,0),new Vector3(0,0,-0.5f),new Vector3(0,0,0.5f),new Vector3(0,1,-0.5f),new Vector3(0,1,0.5f) };
            mesh.uv = Enumerable.Range(0, 8).Select(j => new Vector2(uv[0] + (j % 2) * uv[2], uv[1] + (j % 4 / 2) * uv[3])).ToArray();
            mesh.triangles = new[] { 0,2,1,1,2,3,4,6,5,5,6,7 }; mesh.RecalculateNormals(); mesh.RecalculateBounds();
            if (!exists) AssetDatabase.CreateAsset(mesh, path); else EditorUtility.SetDirty(mesh); meshes[i] = mesh;
        }
        for (int zone = 0; zone < 2; zone++)
        {
            string name = zone == 0 ? "R2ForestFoliage" : "R2GorgeFoliage";
            var old = GameObject.Find(name); if (old) UnityEngine.Object.DestroyImmediate(old);
            var root = new GameObject(name); root.AddComponent<InstancedGroup>(); var random = new System.Random(271 + zone);
            for (int i = 0; i < (zone == 0 ? 240 : 160); i++)
            {
                float z = zone == 0 ? -104 + (float)random.NextDouble() * 68 : -28 + (float)random.NextDouble() * 85;
                float center = zone == 0 ? 8 * Mathf.Sin((z + 110) * 0.065f) : 0;
                float x = center + (i % 2 == 0 ? -1 : 1) * (zone == 0 ? 4 + (float)random.NextDouble() * 14 : 5 + (float)random.NextDouble() * 8);
                int kind = random.Next(5); var go = new GameObject("Card_" + i, typeof(MeshFilter), typeof(MeshRenderer));
                go.transform.SetParent(root.transform); float y = Terrain.activeTerrain.SampleHeight(new Vector3(x, 0, z)) + Terrain.activeTerrain.transform.position.y;
                go.transform.position = new Vector3(x, y, z); go.transform.rotation = Quaternion.Euler(0, (float)random.NextDouble() * 360, 0);
                go.transform.localScale = Vector3.one * (kind == 4 ? 2.5f : 0.6f + (float)random.NextDouble() * 0.7f);
                go.GetComponent<MeshFilter>().sharedMesh = meshes[kind]; var r = go.GetComponent<MeshRenderer>(); r.sharedMaterial = mat;
                r.shadowCastingMode = ShadowCastingMode.Off; go.isStatic = false;
            }
        }
    }
    static void Vine(Transform plane)
    {
        var root = GameObject.Find("R2Vines"); if (root) UnityEngine.Object.DestroyImmediate(root);
        root = new GameObject("R2Vines"); root.AddComponent<InstancedGroup>();
        var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(Mats + "foliage_hanging_vine.asset");
        for (int i = 0; i < 6; i++)
        {
            var go = new GameObject("Vine_" + i, typeof(MeshFilter), typeof(MeshRenderer)); go.transform.SetParent(root.transform);
            go.transform.position = plane.position + Vector3.up * i * 3; go.transform.rotation = plane.rotation;
            go.transform.localScale = new Vector3(1.8f, 3, 1.8f); go.GetComponent<MeshFilter>().sharedMesh = mesh;
            go.GetComponent<MeshRenderer>().sharedMaterial = AssetDatabase.LoadAssetAtPath<Material>(Mats + "foliage.mat");
        }
    }
    static Transform Node(string name, Vector3 position) { var go = GameObject.Find(name) ?? new GameObject(name); go.transform.position = position; return go.transform; }
    static T Add<T>(GameObject go) where T : Component { var c = go.GetComponent<T>(); return c ? c : go.AddComponent<T>(); }
    static void Ref(UnityEngine.Object target, string name, UnityEngine.Object value) { var s = new SerializedObject(target); s.FindProperty(name).objectReferenceValue = value; s.ApplyModifiedPropertiesWithoutUndo(); }
    static void Number(UnityEngine.Object target, string name, float value) { var s = new SerializedObject(target); s.FindProperty(name).floatValue = value; s.ApplyModifiedPropertiesWithoutUndo(); }
    static Texture2D Texture(string name) { return AssetDatabase.LoadAssetAtPath<Texture2D>(Art + name) ?? throw new FileNotFoundException(Art + name); }
    static Sprite Sprite(string name) { return AssetDatabase.LoadAssetAtPath<Sprite>(Art + "ui/" + name + ".png") ?? throw new FileNotFoundException(name); }
    static Material Material(string name, string shader)
    {
        string path = Mats + name + ".mat"; var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
        var s = Shader.Find(shader); if (!s) throw new InvalidOperationException("找不到 shader " + shader);
        if (!mat) { mat = new Material(s); AssetDatabase.CreateAsset(mat, path); } else mat.shader = s;
        return mat;
    }
}
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Liuruan;
using UnityEditor;
using UnityEditor.Animations;
using UnityEngine;

public static class R2bSetup
{
    const string Art = "Assets/_Project/Art/";
    static void Copy(string source, string dest)
    {
        if (!File.Exists(source)) throw new FileNotFoundException(source);
        Directory.CreateDirectory(Path.GetDirectoryName(dest));
        if (!File.Exists(dest) || !File.ReadAllBytes(source).SequenceEqual(File.ReadAllBytes(dest))) File.Copy(source, dest, true);
        AssetDatabase.ImportAsset(dest, ImportAssetOptions.ForceSynchronousImport);
    }
    static Material Skin(string source, string folder, string key)
    {
        string texture = folder + "/" + key + "_albedo.png";
        Copy(source, texture);
        var importer = (TextureImporter)AssetImporter.GetAtPath(texture);
        importer.textureType = TextureImporterType.Default; importer.textureShape = TextureImporterShape.Texture2D;
        importer.maxTextureSize = 1024; importer.textureCompression = TextureImporterCompression.Compressed;
        importer.SaveAndReimport();
        string path = folder + "/" + key + ".mat";
        var mat = AssetDatabase.LoadAssetAtPath<Material>(path);
        if (!mat) { mat = new Material(Shader.Find("Universal Render Pipeline/Lit")); AssetDatabase.CreateAsset(mat, path); }
        mat.SetTexture("_BaseMap", AssetDatabase.LoadAssetAtPath<Texture2D>(texture));
        mat.SetColor("_BaseColor", Color.white); mat.SetFloat("_Smoothness", .12f); EditorUtility.SetDirty(mat);
        return mat;
    }
    public static void Character(GameObject root, string key)
    {
        string folder = Art + "Characters/" + key;
        var clips = new Dictionary<string, AnimationClip>();
        Avatar avatar = null;
        foreach (string action in key == "liuchen" ? new[] { "idle", "walk", "run", "climb", "pickup", "pickfruit" } : new[] { "idle", "walk", "run", "climb" })
        {
            string path = folder + "/" + key + "@" + action + ".fbx";
            Copy("staging/models/mixamo/" + key + "/" + key + "@" + action + ".fbx", path);
            var importer = (ModelImporter)AssetImporter.GetAtPath(path);
            importer.materialImportMode = ModelImporterMaterialImportMode.None;
            importer.animationType = ModelImporterAnimationType.Human;
            importer.avatarSetup = action == "idle" ? ModelImporterAvatarSetup.CreateFromThisModel : ModelImporterAvatarSetup.CopyFromOther;
            importer.sourceAvatar = action == "idle" ? null : avatar;
            importer.importAnimation = true; importer.importCameras = false; importer.importLights = false;
            importer.SaveAndReimport();
            var settings = importer.defaultClipAnimations;
            if (settings.Length == 0) throw new InvalidDataException(path + " 缺少動畫。");
            foreach (var clip in settings)
            {
                clip.name = action;
                clip.loopTime = action == "idle" || action == "walk" || action == "run" || action == "climb";
                clip.lockRootRotation = true;
                // Climb translation is extracted and discarded by applyRootMotion=false; ClimbZone owns world movement.
                clip.lockRootHeightY = action != "climb"; clip.lockRootPositionXZ = action != "climb";
                if (action == "climb") { clip.keepOriginalPositionY = true; clip.keepOriginalPositionXZ = true; }
            }
            importer.clipAnimations = settings; importer.SaveAndReimport();
            if (action == "idle")
            {
                avatar = AssetDatabase.LoadAllAssetsAtPath(path).OfType<Avatar>().FirstOrDefault();
                if (!avatar || !avatar.isValid || !avatar.isHuman) throw new InvalidDataException(key + " Humanoid Avatar 無效。");
            }
            clips[action] = AssetDatabase.LoadAllAssetsAtPath(path).OfType<AnimationClip>().First(c => !c.name.StartsWith("__preview__"));
        }
        var mat = Skin("staging/models/game/" + key + "_albedo.png", folder, key);
        string controllerPath = folder + "/" + key + ".controller";
        var controller = AssetDatabase.LoadAssetAtPath<AnimatorController>(controllerPath);
        if (!controller) controller = AnimatorController.CreateAnimatorControllerAtPath(controllerPath);
        // Rebuild only this generated controller, preserving its GUID and scene references.
        foreach (var layer in controller.layers) foreach (var child in layer.stateMachine.states) layer.stateMachine.RemoveState(child.state);
        foreach (var tree in AssetDatabase.LoadAllAssetsAtPath(controllerPath).OfType<BlendTree>()) UnityEngine.Object.DestroyImmediate(tree, true);
        controller.parameters = new AnimatorControllerParameter[0];
        controller.AddParameter("Speed", AnimatorControllerParameterType.Float); controller.AddParameter("Climbing", AnimatorControllerParameterType.Bool);
        var machine = controller.layers[0].stateMachine;
        var locomotion = machine.AddState("Locomotion"); machine.defaultState = locomotion;
        var blend = new BlendTree { name = "Speed", blendParameter = "Speed", useAutomaticThresholds = false };
        AssetDatabase.AddObjectToAsset(blend, controller); blend.AddChild(clips["idle"], 0); blend.AddChild(clips["walk"], 1.5f); blend.AddChild(clips["run"], 4);
        locomotion.motion = blend;
        var climb = machine.AddState("Climb"); climb.motion = clips["climb"];
        var enter = locomotion.AddTransition(climb); enter.hasExitTime = false; enter.duration = .12f; enter.AddCondition(AnimatorConditionMode.If, 0, "Climbing");
        var exit = climb.AddTransition(locomotion); exit.hasExitTime = false; exit.duration = .12f; exit.AddCondition(AnimatorConditionMode.IfNot, 0, "Climbing");
        foreach (string action in key == "liuchen" ? new[] { "Pickup", "PickFruit" } : new string[0])
        {
            controller.AddParameter(action, AnimatorControllerParameterType.Trigger);
            var state = machine.AddState(action); state.motion = clips[action.ToLowerInvariant()];
            var transition = locomotion.AddTransition(state); transition.hasExitTime = false; transition.duration = .08f;
            transition.AddCondition(AnimatorConditionMode.IfNot, 0, "Climbing"); transition.AddCondition(AnimatorConditionMode.If, 0, action);
            var back = state.AddTransition(locomotion); back.hasExitTime = true; back.exitTime = .95f; back.duration = .12f;
        }
        if (blend.children.Length != 3 || blend.children[0].threshold != 0 || blend.children[1].threshold != 1.5f || blend.children[2].threshold != 4)
            throw new InvalidDataException(key + " Speed 混合樹閾值錯誤。");
        EditorUtility.SetDirty(controller);
        var old = root.transform.Find("R2Visual"); if (old) UnityEngine.Object.DestroyImmediate(old.gameObject);
        foreach (var renderer in root.GetComponentsInChildren<Renderer>(true)) renderer.enabled = false;
        var pivot = new GameObject("R2Visual"); pivot.transform.SetParent(root.transform, false);
        var visual = (GameObject)PrefabUtility.InstantiatePrefab(AssetDatabase.LoadAssetAtPath<GameObject>(folder + "/" + key + "@idle.fbx"));
        visual.transform.SetParent(pivot.transform, false);
        Fit(pivot.transform, 1.6f);
        foreach (var renderer in pivot.GetComponentsInChildren<Renderer>()) renderer.sharedMaterials = Enumerable.Repeat(mat, renderer.sharedMaterials.Length).ToArray();
        var animator = visual.GetComponent<Animator>() ?? visual.AddComponent<Animator>();
        animator.avatar = avatar; animator.runtimeAnimatorController = controller; animator.applyRootMotion = false;
        if (root.TryGetComponent<PlayerController>(out var player)) player.animator = animator;
        if (root.TryGetComponent<CompanionFollow>(out var companion)) companion.animator = animator;
        foreach (var bob in root.GetComponentsInChildren<R2CharacterMotion>(true)) UnityEngine.Object.DestroyImmediate(bob);
        foreach (var bob in root.GetComponentsInChildren<CharacterBob>(true)) UnityEngine.Object.DestroyImmediate(bob);
    }
    static Bounds Bounds(Transform root)
    {
        var renderers = root.GetComponentsInChildren<Renderer>();
        if (renderers.Length == 0) throw new InvalidDataException(root.name + " 無 Renderer。");
        var bounds = renderers[0].bounds; foreach (var renderer in renderers) bounds.Encapsulate(renderer.bounds); return bounds;
    }
    static void Fit(Transform root, float height)
    {
        root.localScale = new Vector3(1 / root.parent.lossyScale.x, 1 / root.parent.lossyScale.y, 1 / root.parent.lossyScale.z);
        var bounds = Bounds(root); if (bounds.size.y <= .0001f) throw new InvalidDataException(root.name + " 高度無效。");
        root.localScale *= height / bounds.size.y; bounds = Bounds(root);
        root.position += new Vector3(root.parent.position.x - bounds.center.x, root.parent.position.y - bounds.min.y, root.parent.position.z - bounds.center.z);
        bounds = Bounds(root);
        if (Mathf.Abs(bounds.size.y - height) > .01f || Mathf.Abs(bounds.min.y - root.parent.position.y) > .01f) throw new InvalidDataException(root.name + " 尺寸校準失敗。");
    }
    static void Set(UnityEngine.Object obj, string field, UnityEngine.Object value)
    { var so = new SerializedObject(obj); so.FindProperty(field).objectReferenceValue = value; so.ApplyModifiedPropertiesWithoutUndo(); }
    static void Renderers(SeasonSwap seasons, string field, Renderer[] renderers)
    {
        var so = new SerializedObject(seasons); var array = so.FindProperty(field); array.arraySize = renderers.Length;
        for (int i = 0; i < renderers.Length; i++) array.GetArrayElementAtIndex(i).objectReferenceValue = renderers[i];
        so.ApplyModifiedPropertiesWithoutUndo();
    }
    public static void World(GameFlow flow, Material sky)
    {
        var village = GameObject.Find("Village");
        var home = UnityEngine.Object.FindObjectsByType<Transform>(FindObjectsInactive.Include, FindObjectsSortMode.None).FirstOrDefault(t => t.name == "R2HomeVillage");
        if (!home) home = new GameObject("R2HomeVillage").transform;
        home.gameObject.SetActive(true);
        foreach (string name in new[] { "HomeVillage_West", "HomeVillage_East", "VillageGate_Left", "VillageGate_Right", "VillageGate_Top" })
        {
            var obj = GameObject.Find(name); if (obj) obj.transform.SetParent(home, true);
        }
        for (int i = 0; i < 2; i++)
        {
            string name = "HomeHouse_" + i;
            if (!home.Find(name))
            {
                var house = UnityEngine.Object.Instantiate(village.transform.Find("House_" + i).gameObject, home);
                house.name = name; house.transform.position = new Vector3(i % 2 == 0 ? -18 : 18, 0, -91 + (i / 2) * 14);
            }
        }
        var report = new System.Text.StringBuilder("# R2b 道具安裝\n\n");
        foreach (string key in new[] { "house_tongwa", "pavilion_luozhang", "peach_tree", "chu_tree", "drift_items", "home_house", "vine_cliff", "village_board" })
        {
            string source = "staging/models/props/" + key;
            if (!File.Exists(source + ".fbx") || !File.Exists(source + "_albedo.png")) { report.AppendLine("- SKIP " + key + "：缺少 FBX 或 albedo PNG。"); continue; }
            string folder = Art + "Props/" + key, path = folder + "/" + key + ".fbx";
            Copy(source + ".fbx", path);
            var importer = (ModelImporter)AssetImporter.GetAtPath(path); importer.materialImportMode = ModelImporterMaterialImportMode.None; importer.importAnimation = false; importer.SaveAndReimport();
            var mat = Skin(source + "_albedo.png", folder, key);
            var targets = new List<Transform>();
            if (key == "house_tongwa") for (int i = 0; i < 4; i++) targets.Add(village.transform.Find("House_" + i));
            if (key == "home_house")
            {
                for (int i = 0; i < 2; i++) targets.Add(home.Find("HomeHouse_" + i));
                foreach (string name in new[] { "HomeVillage_West", "HomeVillage_East" }) if (home.Find(name)) targets.Add(home.Find(name));
            }
            if (key == "chu_tree") for (int i = 1; i <= 5; i++) targets.Add(GameObject.Find("ActPoints/Act1_Bark_" + i).transform);
            if (key == "drift_items") for (int i = 1; i <= 3; i++) targets.Add(GameObject.Find("ActPoints/Act3_Drift_" + i).transform);
            if (key == "village_board") targets.Add(GameObject.Find("ActPoints/Act4_Board").transform);
            if (key == "vine_cliff") targets.Add(GameObject.Find("ActPoints/Act2_ClimbBase").transform);
            if (key == "peach_tree")
            {
                targets.Add(GameObject.Find("ActPoints/Act2_PeachTree").transform);
                for (int i = 0; i < 3; i++) targets.Add(Node("R2Peach_" + i, new Vector3(-20 + i * 3, 18, -26 + i * 2), GameObject.Find("Gorge").transform));
            }
            if (key == "pavilion_luozhang") targets.Add(Node("R2Pavilion", new Vector3(0, 0, 90), village.transform));
            float height = key == "peach_tree" ? 4 : key == "village_board" ? 2.2f : key == "drift_items" ? .35f : key == "vine_cliff" ? new SerializedObject(flow.climb).FindProperty("height").floatValue : 5;
            foreach (var target in targets)
            {
                var old = target.Find("R2Prop"); if (old) UnityEngine.Object.DestroyImmediate(old.gameObject);
                foreach (var r in target.GetComponentsInChildren<Renderer>(true)) if (r.name != "R1Marker") r.enabled = false;
                var visual = (GameObject)PrefabUtility.InstantiatePrefab(AssetDatabase.LoadAssetAtPath<GameObject>(path));
                visual.name = "R2Prop"; visual.transform.SetParent(target, false); Fit(visual.transform, height);
                foreach (var r in visual.GetComponentsInChildren<Renderer>()) r.sharedMaterials = Enumerable.Repeat(mat, r.sharedMaterials.Length).ToArray();
                // Visual-only imports retain the existing gameplay colliders and interaction roots.
                foreach (var collider in visual.GetComponentsInChildren<Collider>()) UnityEngine.Object.DestroyImmediate(collider);
            }
            if (key == "house_tongwa") for (int i = 4; i < 6; i++) foreach (var r in village.transform.Find("House_" + i).GetComponentsInChildren<Renderer>(true)) r.enabled = false;
            if (key == "village_board") foreach (var r in GameObject.Find("VillageBoard").GetComponentsInChildren<Renderer>()) r.enabled = false;
            if (key == "peach_tree") foreach (var r in GameObject.Find("PeachTree").GetComponentsInChildren<Renderer>()) r.enabled = false;
            report.AppendLine("- PASS " + key + "：" + targets.Count + " 個外觀，height=" + height + "m。");
        }
        File.WriteAllText("logs/U-R2-props.md", report.ToString());
        var seasons = flow.GetComponent<SeasonSwap>() ?? flow.gameObject.AddComponent<SeasonSwap>(); flow.seasons = seasons;
        Set(seasons, "immortalVillageRoot", village); Set(seasons, "homeVillageRoot", home.gameObject); Set(seasons, "skyReturn", sky); Set(seasons, "sun", RenderSettings.sun);
        Renderers(seasons, "canopyRenderers", GameObject.Find("Gorge").GetComponentsInChildren<Renderer>().Where(r => r.name.Contains("Canopy") || r.GetComponentsInParent<Transform>().Any(t => t.name.StartsWith("R2Peach_"))).Concat(GameObject.Find("ActPoints/Act2_PeachTree").GetComponentsInChildren<Renderer>()).ToArray());
        Renderers(seasons, "groundRenderers", village.GetComponentsInChildren<Renderer>().Where(r => r.name == "VillageSquare").ToArray());
        var epilogue = flow.GetComponent<EpilogueDirector>() ?? flow.gameObject.AddComponent<EpilogueDirector>(); flow.epilogue = epilogue;
        Set(epilogue, "cluesJson", AssetDatabase.LoadAssetAtPath<TextAsset>("Assets/_Project/Data/clues.json"));
        Set(epilogue, "compareJson", AssetDatabase.LoadAssetAtPath<TextAsset>("Assets/_Project/Data/compare.json"));
        home.gameObject.SetActive(false); village.SetActive(true);
    }
    static Transform Node(string name, Vector3 position, Transform parent)
    { var t = parent.Find(name); if (!t) { t = new GameObject(name).transform; t.SetParent(parent, false); } t.position = position; return t; }
}
using System;
using System.IO;
using System.Text;
using Liuruan;
using TMPro;
using UnityEditor;
using UnityEditor.TestTools.TestRunner.Api;
using UnityEngine;
using UnityEngine.UI;

[InitializeOnLoad]
public static class R2Validation
{
    const string Phase = "Liuruan.R2.Phase";
    const string SaveKey = "liuruan_r1_progress";
    static TestRunnerApi runner;
    static double started, next;
    static int step;
    static double actionAt;
    static Vector3 driftStart;
    static bool chasing, climbing;
    static readonly string[] Route = { "Act1_Bark_1", "Act1_Bark_2", "Act1_Bark_3", "Act1_Bark_4", "Act1_Bark_5", "Act2_ClimbBase", "Act2_PeachTree", "Act3_Drift_1", "Act3_Drift_2", "Act3_Drift_3", "Act3_Wade", "Act4_Women", "Act4_House", "Act4_Board", "ReturnHome", "Act5_Return" };
    static R2Validation()
    {
        EditorApplication.update += Tick;
        EditorApplication.playModeStateChanged += state =>
        {
            File.AppendAllText("logs/U-R2-playstate.md", DateTime.Now.ToString("HH:mm:ss.fff") + " " + state + " phase=" + SessionState.GetString(Phase, "") + " step=" + SessionState.GetInt("Liuruan.R2.Step", -1) + (state == PlayModeStateChange.ExitingPlayMode ? "\n" + Environment.StackTrace : "") + "\n");
            if (state != PlayModeStateChange.EnteredEditMode || SessionState.GetString(Phase, "") != "play") return;
            RestorePrefs();
            SessionState.SetString(Phase, "failed");
            File.AppendAllText("logs/U-R2-failure.md", "Play 驗證提前停止，已還原測試前進度。\n");
        };
        Application.logMessageReceived += (message, stack, type) =>
        {
            string phase = SessionState.GetString(Phase, "");
            if (phase != "" && phase != "done" && phase != "failed" && (type == LogType.Error || type == LogType.Exception || type == LogType.Assert))
                SessionState.SetInt("Liuruan.R2.Errors", SessionState.GetInt("Liuruan.R2.Errors", 0) + 1);
        };
    }
    [MenuItem("Tools/Liuruan/R2/Validate All")]
    public static void Begin()
    {
        // 清除舊輪次的流程，避免安裝期間 domain reload 接續殘留作業。
        RestorePrefs();
        SessionState.SetString("Liuruan.R1.Phase", "");
        SessionState.SetString(Phase, "");
        SessionState.SetInt("Liuruan.R2.Step", 0);
        SessionState.SetFloat("Liuruan.R2.PlayAt", 0);
        started = next = actionAt = 0; chasing = climbing = false;
        if (EditorApplication.isPlaying) throw new InvalidOperationException("請先離開 Play 模式。");
        SessionState.SetString("Liuruan.R2.CaptureAfter", DateTime.UtcNow.Ticks.ToString());
        Directory.CreateDirectory("Captures/r2");
        SessionState.SetInt("Liuruan.R2.Errors", 0);
        SessionState.SetString(Phase, "install");
        try { R2Setup.Install(); Require(SessionState.GetInt("Liuruan.R2.Errors", 0) == 0, "安裝期間出現 console error"); }
        catch (Exception e) { Fail(e.ToString()); return; }
        started = 0; next = 0;
        SessionState.SetInt("Liuruan.R2.Errors", 0);
        SessionState.SetString(Phase, "tests");
        runner = ScriptableObject.CreateInstance<TestRunnerApi>();
        runner.RegisterCallbacks(new Results());
        runner.Execute(new ExecutionSettings(new Filter { testMode = TestMode.EditMode, assemblyNames = new[] { "Liuruan.EditModeTests" } }));
    }
    sealed class Results : ICallbacks
    {
        public void RunStarted(ITestAdaptor t) { }
        public void TestStarted(ITestAdaptor t) { }
        public void TestFinished(ITestResultAdaptor r) { }
        public void RunFinished(ITestResultAdaptor r)
        {
            var text = new StringBuilder("# EditMode Test Runner\n\n");
            text.AppendLine("Passed=" + r.PassCount + " Failed=" + r.FailCount + " Skipped=" + r.SkipCount + " Duration=" + r.Duration);
            Append(r, text);
            File.WriteAllText("logs/U-R2-tests.md", text.ToString());
            if (r.FailCount != 0 || r.PassCount == 0 || r.SkipCount != 0) { Fail("EditMode 測試未全數通過。"); return; }
            BackupPrefs();
            PlayerPrefs.DeleteKey(SaveKey);
            SessionState.SetString(Phase, "play");
            SessionState.SetInt("Liuruan.R2.Step", 0);
            File.WriteAllText("logs/U-R2-play.md", "# Play 五幕驗證\n\n");
            // Test Runner 還要還原場景，不能在回呼裡直接進 Play；交給 Tick 延後進入。
            SessionState.SetString(Phase, "startplay");
            SessionState.SetFloat("Liuruan.R2.PlayAt", (float)EditorApplication.timeSinceStartup + 3f);
        }
        static void Append(ITestResultAdaptor r, StringBuilder s)
        {
            if (!r.HasChildren) s.AppendLine("- " + r.FullName + "：" + r.ResultState + " " + r.Message);
            else foreach (var child in r.Children) Append(child, s);
        }
    }
    static void BackupPrefs()
    {
        SessionState.SetBool("Liuruan.R2.PrefsBackedUp", true);
        SessionState.SetString("Liuruan.R2.OldSave", PlayerPrefs.GetString(SaveKey, ""));
        for (int id = 0; id <= 100; id++) foreach (string field in new[] { "tries", "solved", "plain" })
        {
            string key = "liuruan_q" + id + "_" + field;
            SessionState.SetInt(key, PlayerPrefs.GetInt(key, -1)); PlayerPrefs.DeleteKey(key);
        }
    }
    static void RestorePrefs()
    {
        if (!SessionState.GetBool("Liuruan.R2.PrefsBackedUp", false)) return;
        string old = SessionState.GetString("Liuruan.R2.OldSave", "");
        if (old.Length == 0) PlayerPrefs.DeleteKey(SaveKey); else PlayerPrefs.SetString(SaveKey, old);
        for (int id = 0; id <= 100; id++) foreach (string field in new[] { "tries", "solved", "plain" })
        {
            string key = "liuruan_q" + id + "_" + field;
            int value = SessionState.GetInt(key, -1);
            if (value < 0) PlayerPrefs.DeleteKey(key); else PlayerPrefs.SetInt(key, value);
        }
        PlayerPrefs.Save();
        SessionState.SetBool("Liuruan.R2.PrefsBackedUp", false);
    }
    static void Tick()
    {
        string phase = SessionState.GetString(Phase, "");
        if (EditorApplication.isCompiling || EditorApplication.isUpdating) return;
        try
        {
            if (phase == "startplay" && !EditorApplication.isPlayingOrWillChangePlaymode)
            {
                if (EditorApplication.timeSinceStartup < SessionState.GetFloat("Liuruan.R2.PlayAt", 0)) return;
                SessionState.SetInt("Liuruan.R2.Errors", 0);
                SessionState.SetString(Phase, "play");
                EditorApplication.isPlaying = true;
                return;
            }
            if (phase == "play" && EditorApplication.isPlaying)
            {
                EditorApplication.QueuePlayerLoopUpdate();
                if (EditorApplication.timeSinceStartup < next) return;
                next = EditorApplication.timeSinceStartup + 0.15;
                if (started == 0) { started = EditorApplication.timeSinceStartup; step = SessionState.GetInt("Liuruan.R2.Step", 0); }
                if (EditorApplication.timeSinceStartup - started > 300) throw new TimeoutException("Play 五幕驗證超過 300 秒。");
                var flow = UnityEngine.Object.FindFirstObjectByType<GameFlow>();
                if (!flow || !flow.GetComponentInChildren<Canvas>()) return;
                ScrollUI.I.charInterval = 0.001f;
                if (flow.Reading) { AdvanceCard(flow); return; }
                if (step == Route.Length)
                {
                    Require(flow.Act == 5 && flow.State.ended, "結局面板未完成");
                    Require(flow.State.bark == 31 && flow.State.drift == 7 && flow.State.inferred, "收集或推論進度錯誤");
                    Require(flow.driftCollection.Count == 3, "漂流物未共用收集器");
                    Require(flow.State.villageStep == 3, "仙村順序錯誤");
                    Require(SessionState.GetInt("Liuruan.R2.Errors", 0) == 0, "Play 期間出現 console error");
                    Require(flow.seasons.IsHome && GameObject.Find("R2HomeVillage") && !GameObject.Find("Village"), "歸鄉房屋切換失敗");
                    Require(flow.epilogue.Model != null && flow.epilogue.Model.Score.DriftCount == 3 && flow.epilogue.Model.Score.BarkCount == 5, "結局資料模型／成績錯誤");
                    Require(GameObject.Find("JourneySystems/JourneyHUD/JourneyEnding"), "結局面板未顯示");
                    VerifyEnding(flow);
                    File.AppendAllText("logs/U-R2-play.md", "\nPASS：五幕實際互動、五棵穀皮、三件漂流物、閱讀卡作答、求歸、結局；捕捉到的 console error=0。\n");
                    SessionState.SetString(Phase, "capture"); EditorApplication.isPlaying = false; return;
                }
                if (flow.Act >= 2) Require(flow.minimap.FogMask.GetPixel(31, 31).a == 0, "第二幕起仍有迷霧");
                string key = Route[step];
                if (key == "Act2_ClimbBase" && climbing)
                {
                    if (!flow.State.climbed)
                    {
                        Require(flow.Player.animator.GetBool("Climbing"), "攀藤未設定 Climbing 動畫");
                        Require(flow.climb.IsLocked, "攀藤未到頂就失去鎖定");
                        flow.climb.SetMoveInput(Vector2.up);
                        return;
                    }
                    Require(flow.Player.enabled && flow.Player.GetComponent<CharacterController>().enabled, "攀藤後沒有還原控制");
                    Require(flow.Player.transform.position.y > 17.8f, "未真正攀至崖頂");
                    Require(!flow.Player.animator.GetBool("Climbing"), "攀藤結束未還原動畫");
                    flow.climb.SetMoveInput(Vector2.zero); climbing = false;
                    File.AppendAllText("logs/U-R2-play.md", "- PASS：ClimbZone 經 Attaching/Climbing/TopOut 到平台，控制已還原。\n");
                    step++; SessionState.SetInt("Liuruan.R2.Step", step); return;
                }
                if (key.StartsWith("Act3_Drift_"))
                {
                    var item = GameObject.Find("ActPoints/" + key);
                    Require(item, key + " 提前消失");
                    var pickup = item.GetComponent<DriftPickup>();
                    if (!chasing)
                    {
                        flow.MovePlayer(item.transform.position + new Vector3(-6, 0, 0));
                        chasing = true; actionAt = EditorApplication.timeSinceStartup; driftStart = item.transform.position; return;
                    }
                    if (EditorApplication.timeSinceStartup - actionAt < 1) return;
                    Require((item.transform.position - driftStart).magnitude > 0.02f, "漂流物沒有移動");
                    if (!pickup.CanInteract)
                    {
                        var cc = flow.Player.GetComponent<CharacterController>();
                        Vector3 offset = item.transform.position - flow.Player.transform.position; offset.y = 0;
                        PlayerController.MoveDisplacement(cc, Vector3.ClampMagnitude(offset, 0.7f));
                        return;
                    }
                    Require(Interactable.Nearest(flow.Player.transform.position) == item.GetComponent<Interactable>(), "移動漂流物不是最近互動點");
                    item.GetComponent<Interactable>().Interact();
                    Require(!item.activeSelf, "漂流物撿起後沒有隱藏");
                    Require(flow.driftCollection.Count == step - 6, "共用漂流收集計數錯誤");
                    if (step < 9) Require(!flow.Reading && !flow.State.inferred, "未集滿三件就觸發推論");
                    File.AppendAllText("logs/U-R2-play.md", "- PASS：追上移動漂流物並互動 " + key + "\n");
                    chasing = false; step++; SessionState.SetInt("Liuruan.R2.Step", step); return;
                }
                if (step == 0)
                {
                    Require(Mathf.Approximately(flow.Hunger.Value, 3), "開場飢餓值不是三格");
                    Require(flow.Companion.Call() && flow.Companion.CooldownRatio > 0.99f && !flow.Companion.Call(), "呼喚冷卻錯誤");
                    Require(flow.minimap && flow.minimap.Output && flow.minimap.FogMask, "小地圖未初始化");
                    Require(flow.minimap.FogMask.GetPixel(31, 31).a > 0.9f, "第一幕沒有迷霧");
                    foreach (var animator in new[] { flow.Player.animator, flow.Companion.animator })
                    { Require(animator && animator.avatar.isValid && animator.avatar.isHuman && !animator.applyRootMotion, "Humanoid／Root Motion 設定錯誤"); }
                    ScreenCapture.CaptureScreenshot("Captures/r2/r2_hud.png");
                }
                if (key == "ReturnHome")
                {
                    if (flow.SeasonPlaying) { Require(!flow.CanReturn, "半年演出尚未結束就能求歸"); return; }
                    Require(flow.State.halfYearComplete && flow.CanReturn, "求歸尚未解鎖");
                    var button = GameObject.Find("JourneySystems/JourneyHUD/ReturnHome").GetComponent<Button>();
                    button.onClick.Invoke();
                }
                else
                {
                    var it = GameObject.Find("ActPoints/" + key).GetComponent<Interactable>();
                    Require(it.enabled, key + " 尚未解鎖");
                    flow.MovePlayer(it.transform.position + Vector3.right);
                    if (key == "Act2_ClimbBase" && !flow.climb.CanInteract) return;
                    Require(Interactable.Nearest(flow.Player.transform.position) == it, key + " 並非最近互動點");
                    int act = flow.Act;
                    it.Interact();
                    if (key == "Act2_ClimbBase")
                    {
                        Require(flow.climb.IsLocked && !flow.State.climbed, "攀援仍使用瞬移流程");
                        climbing = true; flow.climb.SetMoveInput(Vector2.up); return;
                    }
                    File.AppendAllText("logs/U-R2-play.md", "- Act" + act + " 實際 Interactable.Interact：" + key + "\n");
                    if (key == "Act2_PeachTree") Require(Mathf.Approximately(flow.Hunger.Value, 5), "摘桃沒有補滿飢餓值");
                }
                step++; SessionState.SetInt("Liuruan.R2.Step", step);
            }
            else if (phase == "capture" && !EditorApplication.isPlayingOrWillChangePlaymode)
            {
                RestorePrefs();
                string capture = R30Capture.Run("r2");
                Require(Directory.GetFiles(capture, "r2_*.png").Length == 8, "截圖未達六機位＋HUD＋人物近景共八張");
                foreach (string file in Directory.GetFiles(capture, "r2_*.png"))
                {
                    var info = new FileInfo(file);
                    Require(info.Length > 1024 && info.LastWriteTimeUtc.Ticks >= long.Parse(SessionState.GetString("Liuruan.R2.CaptureAfter", "0")), "截圖無效或屬於舊輪：" + file);
                }
                File.WriteAllText("logs/U-R2-captures.md", "# 六機位\n\n" + string.Join("\n", Directory.GetFiles(capture, "r2_*.png")));
                SessionState.SetString(Phase, "build");
            }
            else if (phase == "build" && !EditorApplication.isPlayingOrWillChangePlaymode)
            {
                SessionState.SetString(Phase, "building");
                EditorUserBuildSettings.development = false;
                // 沿用已存在且經確認的選單，不另外啟動 Unity。
                if (!EditorApplication.ExecuteMenuItem("Tools/Liuruan/Build/WebGL + Scene Bundle")) throw new InvalidOperationException("找不到建置選單。");
                Require(File.Exists("Build/WebGL/.bundle-done") && File.GetLastWriteTimeUtc("Build/WebGL/.bundle-done").Ticks >= long.Parse(SessionState.GetString("Liuruan.R2.CaptureAfter", "0")), "建置沒有本輪成功旗標");
                Require(PlayerSettings.WebGL.compressionFormat == WebGLCompressionFormat.Brotli, "專案壓縮不是 Brotli");
                Require(Directory.GetFiles("Build/WebGL/Build", "*.unityweb").Length > 0, "deploy.sh 需要 *.unityweb，請檢查現有 decompression fallback 設定");
                var dataFiles = Directory.GetFiles("Build/WebGL/Build", "*.data*", SearchOption.TopDirectoryOnly);
                Require(dataFiles.Length > 0, "找不到 WebGL data 檔");
                var text = new StringBuilder("# R2b WebGL Release\n\ndevelopment=false\nCompression=" + PlayerSettings.WebGL.compressionFormat + "\nDecompressionFallback=" + PlayerSettings.WebGL.decompressionFallback + "\n");
                var wasmFiles = Directory.GetFiles("Build/WebGL/Build", "*.wasm*");
                Require(wasmFiles.Length > 0, "找不到 wasm 檔");
                foreach (string file in wasmFiles) text.AppendLine(file + "：" + new FileInfo(file).Length + " bytes");
                foreach (string file in dataFiles)
                {
                    long bytes = new FileInfo(file).Length;
                    text.AppendLine(file + "：" + bytes + " bytes");
                    File.WriteAllText("logs/U-R2-build.md", text.ToString());
                    Require(bytes > 0 && bytes < 26214400, "data 超過限制或為空");
                }
                Require(SessionState.GetInt("Liuruan.R2.Errors", 0) == 0, "R2 流程出現 console error");
                text.AppendLine("PASS：.bundle-done=" + File.ReadAllText("Build/WebGL/.bundle-done"));
                File.WriteAllText("logs/U-R2-build.md", text.ToString());
                SessionState.SetString(Phase, "done");
            }
        }
        catch (Exception e) { Fail(e.ToString()); }
    }
    static void VerifyEnding(GameFlow flow)
    {
        var model = flow.epilogue.Model;
        var panel = GameObject.Find("JourneySystems/JourneyHUD/JourneyEnding").transform;
        var text = panel.Find("Label").GetComponent<TMP_Text>();
        var nextPage = panel.Find("EndingNext").GetComponent<Button>();
        foreach (string paragraph in model.Paragraphs)
        {
            Require(text.text.Contains(paragraph), "結局全文頁遺漏原文");
            nextPage.onClick.Invoke();
        }
        Require(text.text == model.Question.Prompt, "結局推論題未顯示");
        for (int i = 0; i < 3; i++)
        {
            var option = panel.Find("EndingOption" + i).GetComponent<Button>();
            Require(option.gameObject.activeInHierarchy && option.GetComponentInChildren<TMP_Text>().text == model.Question.Options[i], "結局選項錯誤");
        }
        panel.Find("EndingOption" + model.Question.AnswerIndex).GetComponent<Button>().onClick.Invoke();
        Require(QuizStats.FirstTryCorrect(QuizStats.InferId) && text.text.Contains(model.Question.Explanation), "結局作答／解析未接線");
        nextPage.onClick.Invoke();
        foreach (var row in model.Comparison)
        {
            Require(text.text.Contains(row.Aspect) && text.text.Contains(row.Liuruan) && text.text.Contains(row.Taohua), "比較表頁遺漏內容");
            nextPage.onClick.Invoke();
        }
        Require(text.text.Contains("成績卡") && text.text.Contains("6／6"), "成績卡未顯示全六題首答結果");
        File.AppendAllText("logs/U-R2-play.md", "- PASS：全文各段、三選一作答／解析、比較表各列與成績卡，均經實際面板按鈕巡覽。\n");
    }
    static void AdvanceCard(GameFlow flow)
    {
        if (ScrollUI.I.Typing) return;
        var card = flow.CurrentCard;
        var buttons = ScrollUI.I.GetComponentsInChildren<Button>();
        foreach (var b in buttons)
            if (b.name == "Next" && b.interactable && b.transform.parent.name == "ReadPager") { b.onClick.Invoke(); return; }
        foreach (var b in buttons)
            if (b.name == "CloseBtn" && b.interactable && b.transform.parent.name == "ScrollPanel") { b.onClick.Invoke(); return; }
        if (card == null || !card.HasQuiz) return;
        foreach (var b in buttons)
        {
            var label = b.GetComponentInChildren<TMP_Text>();
            if (b.interactable && label && label.text.EndsWith(". " + card.options[card.answer], StringComparison.Ordinal))
            { b.onClick.Invoke(); return; }
        }
    }
    static void Require(bool condition, string message) { if (!condition) throw new InvalidOperationException(message); }
    static void Fail(string error)
    {
        SessionState.SetString(Phase, "failed");
        File.AppendAllText("logs/U-R2-failure.md", error + "\n");
        RestorePrefs();
        if (EditorApplication.isPlaying) EditorApplication.isPlaying = false;
        Debug.LogError("[R2Validation] " + error);
    }
}
using System;
using System.IO;
using UnityEditor;
using UnityEngine;

// Editor 腳本備援入口；只接受本輪固定作業，不開啟另一個 Unity。
[InitializeOnLoad]
public static class R1Bridge
{
    const string Request = "Assets/_Project/Editor/R1Command.txt";
    static string last;
    static R1Bridge() { EditorApplication.update += Tick; }
    static void Tick()
    {
        if (EditorApplication.isCompiling || EditorApplication.isUpdating || !File.Exists(Request)) return;
        string command = File.ReadAllText(Request).Trim();
        if (command.Length == 0) { last = null; return; }
        if (command == last) return; if (EditorApplication.isPlaying) { EditorApplication.isPlaying = false; return; }
        last = command;
        string round = command.StartsWith("r2") ? "R2" : "R1";
        try
        {
            File.WriteAllText("logs/U-" + round + "-bridge.md", DateTime.Now.ToString("o") + " " + command + " ready " + Application.dataPath);
            File.WriteAllText(Request, "");
            if (command.StartsWith("refresh")) AssetDatabase.Refresh();
            if (command.StartsWith("r2")) R2Validation.Begin();
            else if (command.StartsWith("all")) R1Validation.Begin();
        }
        catch (Exception e) { File.AppendAllText("logs/U-" + round + "-failure.md", e + "\n"); Debug.LogException(e); }
    }
}
using System;
using System.IO;
using System.Linq;
using Liuruan;
using TMPro;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;
using UnityEngine.SceneManagement;
using Object = UnityEngine.Object;

/// <summary>R0 灰盒；由 batchmode -executeMethod LiuruanGreybox.Build 建立。</summary>
public static class LiuruanGreybox
{
    const string Scenes = "Assets/_Project/Scenes";
    const string Materials = "Assets/_Project/Materials/Greybox";
    static Material ground, path, trunk, leaves, rock, water, wall, roof;

    [MenuItem("Tools/Liuruan/Build/Greybox")]
    public static void Build()
    {
        if (!Application.isBatchMode && !EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return;
        Directory.CreateDirectory(Scenes);
        Directory.CreateDirectory(Materials);
        AssetDatabase.Refresh();
        ground = Mat("Ground", new Color(0.39f, 0.49f, 0.23f));
        path = Mat("Path", new Color(0.65f, 0.52f, 0.32f));
        trunk = Mat("Trunk", new Color(0.34f, 0.22f, 0.12f));
        leaves = Mat("Leaves", new Color(0.25f, 0.47f, 0.18f));
        rock = Mat("Rock", new Color(0.40f, 0.42f, 0.38f));
        water = Mat("Stream", new Color(0.15f, 0.49f, 0.68f));
        wall = Mat("Wall", new Color(0.77f, 0.68f, 0.49f));
        roof = Mat("Roof", new Color(0.27f, 0.43f, 0.36f));

        var boot = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);
        var bootCamera = new GameObject("Camera").AddComponent<Camera>();
        bootCamera.clearFlags = CameraClearFlags.SolidColor;
        bootCamera.backgroundColor = new Color(0.12f, 0.09f, 0.07f);
        new GameObject("BootLoader", typeof(BootLoader));
        Save(boot, Scenes + "/Boot.unity");

        var main = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);
        TerrainGround();
        var forest = Empty("Forest", new Vector3(0, 0, -76));
        var gorge = Empty("Gorge", Vector3.zero);
        var village = Empty("Village", new Vector3(0, 0, 84));
        var markers = Empty("ActPoints", Vector3.zero);

        Vector3 previous = ForestPath(-110);
        for (int z = -106; z <= -34; z += 4)
        {
            var next = ForestPath(z);
            var segment = Primitive("ForestPath", PrimitiveType.Cube, (previous + next) * 0.5f + Vector3.up * 0.025f,
                new Vector3(4.5f, 0.05f, Vector3.Distance(previous, next) + 0.15f), path, forest);
            segment.transform.rotation = Quaternion.LookRotation(next - previous);
            previous = next;
        }
        for (int i = 0; i < 24; i++)
        {
            float z = -102 + i * 2.8f;
            var p = ForestPath(z);
            Tree("ForestTree_" + i, p + Vector3.right * (i % 2 == 0 ? -7 - i % 3 : 7 + i % 3), forest);
        }
        House("HomeVillage_West", new Vector3(-14, 0, -109), forest);
        House("HomeVillage_East", new Vector3(14, 0, -109), forest);
        Primitive("VillageGate_Left", PrimitiveType.Cube, new Vector3(-4, 2, -108), new Vector3(0.6f, 4, 0.6f), trunk, forest);
        Primitive("VillageGate_Right", PrimitiveType.Cube, new Vector3(4, 2, -108), new Vector3(0.6f, 4, 0.6f), trunk, forest);
        Primitive("VillageGate_Top", PrimitiveType.Cube, new Vector3(0, 4, -108), new Vector3(9, 0.5f, 0.6f), trunk, forest);

        for (int i = 0; i < 6; i++)
        {
            float z = -25 + i * 14;
            Primitive("Cliff_West_" + i, PrimitiveType.Cube, new Vector3(-22, 9 + i % 2, z), new Vector3(14, 18 + 2 * (i % 2), 13), rock, gorge);
            Primitive("Cliff_East_" + i, PrimitiveType.Cube, new Vector3(22, 11 - i % 2, z), new Vector3(14, 22 - 2 * (i % 2), 13), rock, gorge);
        }
        var stream = Primitive("Stream_NorthToSouth", PrimitiveType.Plane, new Vector3(0, 0.08f, 13), new Vector3(0.8f, 1, 9.4f), water, gorge);
        Object.DestroyImmediate(stream.GetComponent<Collider>());
        // shortcut: 靜態箭頭標示北往南水流；R1 接入漂流物時再加水面動畫。
        for (int i = 0; i < 7; i++)
        {
            float z = -25 + i * 13;
            for (int side = -1; side <= 1; side += 2)
            {
                var arrow = Primitive("Flow_South_" + i + "_" + side, PrimitiveType.Cube,
                    new Vector3(side * 0.5f, 0.10f, z), new Vector3(0.12f, 0.02f, 1.4f), wall, gorge);
                arrow.transform.rotation = Quaternion.Euler(0, side * 45, 0);
                Object.DestroyImmediate(arrow.GetComponent<Collider>());
            }
        }
        Tree("PeachTree", new Vector3(-18, 18, -24), gorge);
        Primitive("Gorge_WestPath", PrimitiveType.Cube, new Vector3(-9, 0.03f, 12), new Vector3(4.5f, 0.06f, 94), path, gorge);
        Primitive("VillagePath", PrimitiveType.Cube, new Vector3(-4.5f, 0.03f, 63), new Vector3(13.5f, 0.06f, 7), path, village);
        Primitive("VillageSquare", PrimitiveType.Cube, new Vector3(0, 0.03f, 87), new Vector3(28, 0.06f, 38), path, village);
        for (int i = 0; i < 6; i++) House("House_" + i, new Vector3(i % 2 == 0 ? -18 : 18, 0, 75 + (i / 2) * 15), village);
        Primitive("VillageBoard", PrimitiveType.Cube, new Vector3(-8, 1.5f, 85), new Vector3(3, 2, 0.25f), trunk, village);

        Marker("Act1_Start", new Vector3(0, 0, -108), markers);
        for (int i = 0; i < 5; i++) Marker("Act1_Bark_" + (i + 1), ForestPath(-94 + i * 12) + Vector3.right * (i % 2 == 0 ? -5 : 5), markers);
        Marker("Act2_ClimbBase", new Vector3(-13, 0, -31), markers);
        Marker("Act2_PeachTree", new Vector3(-18, 18, -24), markers);
        for (int i = 0; i < 3; i++) Marker("Act3_Drift_" + (i + 1), new Vector3(-2, 0.12f, -13 + i * 18), markers);
        Marker("Act3_Wade", new Vector3(-3, 0.12f, 48), markers);
        Marker("Act4_Women", new Vector3(0, 0, 65), markers);
        Marker("Act4_House", new Vector3(-18, 0, 75), markers);
        Marker("Act4_Board", new Vector3(-8, 0, 83), markers);
        Marker("Act5_Return", new Vector3(0, 0, -108), markers);

        var camera = new GameObject("Main Camera", typeof(Camera), typeof(AudioListener));
        camera.tag = "MainCamera";
        var cam = camera.GetComponent<Camera>();
        cam.fieldOfView = 55;
        cam.nearClipPlane = 0.1f;
        cam.farClipPlane = 350;
        cam.backgroundColor = new Color(0.65f, 0.78f, 0.82f);
        cam.clearFlags = CameraClearFlags.SolidColor;
        camera.AddComponent<UniversalAdditionalCameraData>().renderPostProcessing = true;
        var player = new GameObject("Player");
        player.transform.position = new Vector3(0, 0.1f, -105);
        var controller = player.AddComponent<CharacterController>();
        controller.height = 1.8f; controller.radius = 0.3f; controller.center = new Vector3(0, 0.9f, 0);
        controller.stepOffset = 0.3f;
        Primitive("劉晨", PrimitiveType.Capsule, new Vector3(0, 1, -105), new Vector3(0.65f, 0.9f, 0.65f), Mat("Player", new Color(0.66f, 0.33f, 0.19f)), player.transform, false);
        var pc = player.AddComponent<PlayerController>();
        pc.cam = camera.transform; pc.camDistance = 3.6f; pc.camHeight = 1.2f;
        camera.transform.SetPositionAndRotation(player.transform.position + new Vector3(0, 2.43f, -3.38f), Quaternion.Euler(20, 0, 0));
        Primitive("Companion", PrimitiveType.Capsule, new Vector3(1.7f, 0.9f, -106), new Vector3(0.65f, 0.9f, 0.65f), Mat("Companion", new Color(0.26f, 0.41f, 0.59f)), null);
        var sun = new GameObject("Warm Sun").AddComponent<Light>();
        sun.type = LightType.Directional; sun.transform.rotation = Quaternion.Euler(35, -35, 0);
        sun.color = new Color(1, 0.87f, 0.67f); sun.intensity = 1.4f; sun.shadows = LightShadows.Soft;
        RenderSettings.sun = sun;
        RenderSettings.ambientMode = AmbientMode.Flat;
        RenderSettings.ambientLight = new Color(0.58f, 0.65f, 0.69f);
        var volume = new GameObject("Global Volume").AddComponent<Volume>();
        volume.isGlobal = true;
        volume.sharedProfile = AssetDatabase.LoadAssetAtPath<VolumeProfile>("Assets/_Project/Settings/MainVolumeProfile.asset");
        new GameObject("AudioManager", typeof(AudioManager));
        var ui = new GameObject("ScrollUI").AddComponent<ScrollUI>();
        var so = new SerializedObject(ui);
        so.FindProperty("font").objectReferenceValue = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>("Assets/_Project/Fonts/NotoSerifTC Static SDF.asset");
        so.ApplyModifiedPropertiesWithoutUndo();
        // R0 不掛 ClueManager：題庫由 C 線交付後再綁定，避免空資料啟動錯誤。
        Validate(main);
        Save(main, Scenes + "/Main.unity");
        EditorBuildSettings.scenes = new[] { new EditorBuildSettingsScene(Scenes + "/Boot.unity", true), new EditorBuildSettingsScene(Scenes + "/Main.unity", true) };
        Debug.Log(Liuruan.EditorTools.FontSubset.RebuildNoDialog());
        AssetDatabase.SaveAssets();
        Debug.Log("[LiuruanGreybox] 已建立 Boot/Main、240×240 地形、三區與 16 個五幕定位點。");
    }

    static void TerrainGround()
    {
        const string assetPath = Scenes + "/GreyboxTerrain.asset";
        var data = AssetDatabase.LoadAssetAtPath<TerrainData>(assetPath);
        if (!data) { data = new TerrainData(); AssetDatabase.CreateAsset(data, assetPath); }
        data.heightmapResolution = 129;
        data.size = new Vector3(240, 30, 240);
        var heights = new float[129, 129];
        for (int z = 0; z < 129; z++)
            for (int x = 0; x < 129; x++)
            {
                float wx = x * 240f / 128 - 120, wz = z * 240f / 128 - 120;
                float hill = Mathf.SmoothStep(0, 1, Mathf.InverseLerp(35, 100, Mathf.Abs(wx))) * 8 * (0.7f + 0.3f * Mathf.Sin(wz * 0.08f));
                float bed = Mathf.Abs(wx) < 3 && wz > -34 && wz < 60 ? -0.4f : 0;
                heights[z, x] = (2 + hill + bed) / 30;
            }
        data.SetHeights(0, 0, heights);
        const string layerPath = Scenes + "/GreyboxGround.terrainlayer";
        var layer = AssetDatabase.LoadAssetAtPath<TerrainLayer>(layerPath);
        if (!layer) { layer = new TerrainLayer(); AssetDatabase.CreateAsset(layer, layerPath); }
        const string texturePath = Scenes + "/GreyboxGround.asset";
        var texture = AssetDatabase.LoadAssetAtPath<Texture2D>(texturePath);
        if (!texture) { texture = new Texture2D(1, 1); AssetDatabase.CreateAsset(texture, texturePath); }
        texture.SetPixel(0, 0, ground.color); texture.Apply();
        layer.diffuseTexture = texture; layer.tileSize = new Vector2(8, 8);
        data.terrainLayers = new[] { layer };
        data.alphamapResolution = 32;
        var splat = new float[32, 32, 1];
        for (int z = 0; z < 32; z++)
            for (int x = 0; x < 32; x++) splat[z, x, 0] = 1;
        data.SetAlphamaps(0, 0, splat);
        EditorUtility.SetDirty(texture); EditorUtility.SetDirty(layer);
        EditorUtility.SetDirty(data);
        var terrain = Terrain.CreateTerrainGameObject(data);
        terrain.name = "Terrain_240x240"; terrain.transform.position = new Vector3(-120, -2, -120);
        terrain.GetComponent<Terrain>().materialTemplate = Mat("Terrain", ground.color, "Universal Render Pipeline/Terrain/Lit");
    }

    static Material Mat(string name, Color color, string shaderName = "Universal Render Pipeline/Lit")
    {
        string assetPath = Materials + "/" + name + ".mat";
        var material = AssetDatabase.LoadAssetAtPath<Material>(assetPath);
        var shader = Shader.Find(shaderName);
        if (!shader) throw new InvalidOperationException("找不到 Shader：" + shaderName);
        if (!material) { material = new Material(shader); AssetDatabase.CreateAsset(material, assetPath); }
        material.shader = shader;
        if (material.HasProperty("_BaseColor")) material.SetColor("_BaseColor", color);
        material.enableInstancing = true;
        EditorUtility.SetDirty(material);
        return material;
    }

    static Transform Empty(string name, Vector3 position, Transform parent = null)
    {
        var t = new GameObject(name).transform; t.SetParent(parent); t.position = position; return t;
    }
    static void Marker(string name, Vector3 position, Transform parent) => Empty(name, position, parent);
    static Vector3 ForestPath(float z) => new Vector3(8 * Mathf.Sin((z + 110) * 0.065f), 0, z);
    static GameObject Primitive(string name, PrimitiveType type, Vector3 pos, Vector3 scale, Material material, Transform parent, bool collider = true)
    {
        var go = GameObject.CreatePrimitive(type); go.name = name; go.transform.SetParent(parent);
        go.transform.position = pos; go.transform.localScale = scale;
        go.GetComponent<Renderer>().sharedMaterial = material;
        if (!collider) Object.DestroyImmediate(go.GetComponent<Collider>());
        return go;
    }
    static void Tree(string name, Vector3 pos, Transform parent)
    {
        var t = Empty(name, pos, parent);
        Primitive("Trunk", PrimitiveType.Cylinder, pos + Vector3.up * 2, new Vector3(0.6f, 2, 0.6f), trunk, t);
        Primitive("Canopy", PrimitiveType.Sphere, pos + Vector3.up * 4.8f, new Vector3(4, 4, 4), leaves, t, false);
    }
    static void House(string name, Vector3 pos, Transform parent)
    {
        var t = Empty(name, pos, parent);
        Primitive("Walls", PrimitiveType.Cube, pos + Vector3.up * 2, new Vector3(7, 4, 7), wall, t);
        const string meshPath = Scenes + "/GreyboxRoof.asset";
        var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(meshPath);
        if (!mesh)
        {
            mesh = new Mesh { name = "WedgeRoof" };
            mesh.vertices = new[] { new Vector3(-4, 0, -4), new Vector3(4, 0, -4), new Vector3(0, 2, -4), new Vector3(-4, 0, 4), new Vector3(4, 0, 4), new Vector3(0, 2, 4) };
            mesh.triangles = new[] { 0, 2, 1, 3, 4, 5, 0, 3, 5, 0, 5, 2, 1, 2, 5, 1, 5, 4, 0, 1, 4, 0, 4, 3 };
            mesh.RecalculateNormals(); mesh.RecalculateBounds(); AssetDatabase.CreateAsset(mesh, meshPath);
        }
        var top = new GameObject("WedgeRoof", typeof(MeshFilter), typeof(MeshRenderer));
        top.transform.SetParent(t); top.transform.position = pos + Vector3.up * 4;
        top.GetComponent<MeshFilter>().sharedMesh = mesh; top.GetComponent<MeshRenderer>().sharedMaterial = roof;
    }
    static void Save(Scene scene, string path)
    {
        if (!EditorSceneManager.SaveScene(scene, path)) throw new IOException("場景儲存失敗：" + path);
    }
    static void Validate(Scene scene)
    {
        var objects = scene.GetRootGameObjects().SelectMany(g => g.GetComponentsInChildren<Transform>(true)).ToArray();
        foreach (string zone in new[] { "Forest", "Gorge", "Village" })
            if (objects.Count(t => t.name == zone) != 1) throw new InvalidOperationException("區域數量錯誤：" + zone);
        if (objects.Count(t => t.name.StartsWith("Act", StringComparison.Ordinal) && t.name != "ActPoints") != 16)
            throw new InvalidOperationException("五幕定位點必須有 16 個");
        if (objects.Single(t => t.name == "Act1_Start").position != objects.Single(t => t.name == "Act5_Return").position)
            throw new InvalidOperationException("歸鄉必須回到原村口");
        if (objects.Single(t => t.name == "Player").GetComponent<PlayerController>() == null || Camera.main == null)
            throw new InvalidOperationException("玩家或攝影機缺漏");
    }
}

