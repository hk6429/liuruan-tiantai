            if (!layers[i]) { layers[i] = new TerrainLayer(); AssetDatabase.CreateAsset(layers[i], path); }
            layers[i].diffuseTexture = Texture("ground/" + names[i] + ".png"); layers[i].normalMapTexture = Texture("ground/" + names[i] + "_n.png");
