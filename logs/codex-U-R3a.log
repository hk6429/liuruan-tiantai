            float wx = x * 240f / 255 - 120, wz = z * 240f / 255 - 120;
            int type = Mathf.Abs(wx) > 30 ? 2 : wz > 65 && Mathf.Abs(wx) < 30 ? 4 : wz > -34 && wz < 60 && Mathf.Abs(wx) < 4 ? 3 : 0;
            weights[z, x, type] = 1;
        }
