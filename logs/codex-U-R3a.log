        {
            string n = r.name;
            if (n.Contains("Path"))
            {
                var props = new MaterialPropertyBlock();
                props.SetVector("_BaseMap_ST", new Vector4(Mathf.Max(1, r.bounds.size.x / 4), Mathf.Max(1, r.bounds.size.z / 4), 0, 0));
                r.sharedMaterial = mats[1]; r.SetPropertyBlock(props);
