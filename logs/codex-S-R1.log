            Check.Throws(() => c.SetAct(0)); Check.Throws(() => c.SetAct(6));
            Check.Throws(() => c.Reveal(0, 0, -1)); Check.Throws(() => c.Reveal(0, 0, 32));
            Check.Throws(() => c.MaskAlpha(-1, 0)); Check.Throws(() => c.MaskAlpha(0, 32));
