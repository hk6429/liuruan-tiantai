using System;

namespace Liuruan
{
    public readonly struct WorldPosition
    {
        public readonly float X, Y, Z;
        public WorldPosition(float x, float y, float z)
        {
            HungerCore.RequireFinite(x, nameof(x));
            HungerCore.RequireFinite(y, nameof(y));
            HungerCore.RequireFinite(z, nameof(z));
            X = x; Y = y; Z = z;
        }
        public static double Distance(WorldPosition a, WorldPosition b)
        {
            double x = (double)a.X - b.X, y = (double)a.Y - b.Y, z = (double)a.Z - b.Z;
            return Math.Sqrt(x * x + y * y + z * z);
        }
    }

    public enum CompanionState { Follow, Idle, Catchup, Teleport }

    public sealed class CompanionCore
    {
        public const float CallCooldownSeconds = 8f;
        public CompanionState State { get; private set; } = CompanionState.Idle;
        public WorldPosition Destination { get; private set; }
        public float CooldownRatio => (float)(cooldown / CallCooldownSeconds);
        private double cooldown;
        private double stuckSeconds;
        private WorldPosition progressAnchor;
        private bool trackingProgress;
        private bool called;

        public bool Call()
        {
            if (cooldown > 0) return false;
            cooldown = CallCooldownSeconds;
            called = true;
            return true;
        }

        public CompanionState Tick(float deltaSeconds, WorldPosition player,
            WorldPosition companion, WorldPosition playerForward)
        {
            HungerCore.RequireFinite(deltaSeconds, nameof(deltaSeconds));
            if (deltaSeconds < 0) throw new ArgumentOutOfRangeException(nameof(deltaSeconds));
            cooldown = Math.Max(0, cooldown - deltaSeconds);
            double distance = WorldPosition.Distance(player, companion);
            Destination = player;
            if (distance < 2.5)
            {
                State = CompanionState.Idle;
                called = false;
                ResetProgress();
                return State;
            }

            if (!trackingProgress || WorldPosition.Distance(progressAnchor, companion) >= 0.05)
            {
                progressAnchor = companion;
                stuckSeconds = 0;
                trackingProgress = true;
            }
            else stuckSeconds += deltaSeconds;

            if (distance > 30 || stuckSeconds >= 3)
            {
                // 只取水平朝向，避免玩家上下坡時把夥伴放進地底。
                double length = Math.Sqrt((double)playerForward.X * playerForward.X +
                    (double)playerForward.Z * playerForward.Z);
                float x = length > 0 ? (float)(playerForward.X / length) : 0f;
                float z = length > 0 ? (float)(playerForward.Z / length) : 1f;
                Destination = new WorldPosition(player.X - 2 * x, player.Y, player.Z - 2 * z);
                State = CompanionState.Teleport;
                called = false;
                ResetProgress();
            }
            else State = distance > 12 || called ? CompanionState.Catchup : CompanionState.Follow;
            return State;
        }

        private void ResetProgress()
        {
            trackingProgress = false;
            stuckSeconds = 0;
        }
    }
}
using UnityEngine;
using UnityEngine.AI;

namespace Liuruan
{
    public sealed class CompanionFollow : MonoBehaviour
    {
        [SerializeField] private Transform player;
        [SerializeField, Min(0f)] private float followSpeed = 3f;
        [SerializeField, Min(1f)] private float catchupMultiplier = 1.6f;
        private NavMeshAgent agent;
        private readonly CompanionCore core = new CompanionCore();
        private Vector3 previousPosition;
        public float Speed { get; private set; }
        public float CooldownRatio => core.CooldownRatio;
        public CompanionState State => core.State;
        public bool Call() => core.Call();
        private bool AgentReady => agent != null && agent.enabled && agent.isOnNavMesh;
        private void Awake() => agent = GetComponent<NavMeshAgent>();
        private void OnEnable() { previousPosition = transform.position; Speed = 0f; }

        private void Update()
        {
            float dt = Time.deltaTime;
            Speed = dt > 0f ? Vector3.Distance(transform.position, previousPosition) / dt : 0f;
            previousPosition = transform.position;
            if (player == null)
            {
                if (AgentReady) agent.ResetPath();
                Speed = 0f;
                return;
            }
            CompanionState state = core.Tick(dt, ToCore(player.position),
                ToCore(transform.position), ToCore(player.forward));
            Vector3 target = ToUnity(core.Destination);
            if (state == CompanionState.Teleport)
            {
                // shortcut: 僅搜尋目標附近 2m 的 NavMesh；複雜多層地形由 U 線提供安全落點。
                bool ready = AgentReady;
                if (NavMesh.SamplePosition(target, out NavMeshHit hit, 2f, NavMesh.AllAreas))
                    target = hit.position;
                if (ready) agent.ResetPath();
                if (!ready || !agent.Warp(target)) transform.position = target;
                previousPosition = transform.position;
                Speed = 0f;
                return;
            }
            float speed = state == CompanionState.Catchup ? followSpeed * catchupMultiplier : followSpeed;
            if (AgentReady)
            {
                agent.stoppingDistance = 2.4f;
                agent.speed = speed;
                agent.isStopped = state == CompanionState.Idle;
                if (state != CompanionState.Idle) agent.SetDestination(target);
            }
            else if (state != CompanionState.Idle)
            {
                float remaining = Mathf.Max(0f, Vector3.Distance(transform.position, target) - 2.4f);
                transform.position = Vector3.MoveTowards(transform.position, target, Mathf.Min(speed * dt, remaining));
            }
        }

        private void OnDisable()
        {
            if (AgentReady) agent.ResetPath();
            Speed = 0f;
        }
        private static WorldPosition ToCore(Vector3 p) => new WorldPosition(p.x, p.y, p.z);
        private static Vector3 ToUnity(WorldPosition p) => new Vector3(p.X, p.Y, p.Z);
    }
}
using System;

namespace Liuruan
{
    public sealed class HungerCore
    {
        public const float Capacity = 5f;
        public float Value { get; private set; }
        public float IntervalSeconds { get; }
        public bool IsPaused { get; private set; }
        public float SpeedMultiplier => Value <= 0f ? 0.6f : 1f;
        public event Action<float> OnChanged;
        public event Action OnStarving;
        private double elapsed;

        public HungerCore(float initialValue = 3f, float intervalSeconds = 24f)
        {
            RequireFinite(initialValue, nameof(initialValue));
            RequireFinite(intervalSeconds, nameof(intervalSeconds));
            if (intervalSeconds <= 0f) throw new ArgumentOutOfRangeException(nameof(intervalSeconds));
            Value = Math.Max(0f, Math.Min(Capacity, initialValue));
            IntervalSeconds = intervalSeconds;
        }

        public void Pause() => IsPaused = true;
        public void Resume() => IsPaused = false;

        public void Tick(float deltaSeconds)
        {
            RequireFinite(deltaSeconds, nameof(deltaSeconds));
            if (deltaSeconds < 0f) throw new ArgumentOutOfRangeException(nameof(deltaSeconds));
            if (IsPaused || Value <= 0f) return;
            elapsed += deltaSeconds;
            double steps = Math.Floor(elapsed / IntervalSeconds);
            if (steps < 1) return;
            elapsed %= IntervalSeconds;
            SetValue((float)Math.Max(0d, Value - steps * 0.5d));
        }

        public void Eat(float amount)
        {
            RequireFinite(amount, nameof(amount));
            if (amount < 0f) throw new ArgumentOutOfRangeException(nameof(amount));
            SetValue(Math.Min(Capacity, Value + amount));
        }

        public void FillAll() => SetValue(Capacity);

        private void SetValue(float next)
        {
            if (next == Value) return;
            bool starving = Value > 0f && next <= 0f;
            bool recovering = Value <= 0f && next > 0f;
            Value = next;
            if (starving || recovering) elapsed = 0;
            OnChanged?.Invoke(Value);
            if (starving) OnStarving?.Invoke();
        }

        internal static void RequireFinite(float value, string name)
        {
            if (float.IsNaN(value) || float.IsInfinity(value))
                throw new ArgumentOutOfRangeException(name);
        }
    }
}
using System;
using UnityEngine;
using UnityEngine.Events;

namespace Liuruan
{
    public sealed class HungerSystem : MonoBehaviour
    {
        [SerializeField, Range(0f, 5f)] private float initialValue = 3f;
        [SerializeField, Min(0.01f)] private float intervalSeconds = 24f;
        [SerializeField] private UnityEvent<float> onChanged = new UnityEvent<float>();
        [SerializeField] private UnityEvent onStarving = new UnityEvent();
        [SerializeField] private UnityEvent<string> onToast = new UnityEvent<string>();
        public event Action<float> OnChanged;
        public event Action OnStarving;
        public event Action<string> OnToast;
        private HungerCore core;
        private HungerCore Core
        {
            get
            {
                if (core == null)
                {
                    core = new HungerCore(initialValue, intervalSeconds);
                    core.OnChanged += value => { onChanged.Invoke(value); OnChanged?.Invoke(value); };
                    core.OnStarving += HandleStarving;
                }
                return core;
            }
        }
        public float Value => Core.Value;
        public float SpeedMultiplier => Core.SpeedMultiplier;
        private void Awake() { _ = Core; }
        private void Update() => Core.Tick(Time.deltaTime);
        public void Pause() => Core.Pause();
        public void Resume() => Core.Resume();
        public void Eat(float amount) => Core.Eat(amount);
        public void FillAll() => Core.FillAll();
        private void HandleStarving()
        {
            onStarving.Invoke();
            OnStarving?.Invoke();
            const string message = "肚子餓了，去找些食物吧。";
            onToast.Invoke(message);
            OnToast?.Invoke(message);
        }
    }
}
#!/bin/sh
set -eu
pwd
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v dotnet >/dev/null 2>&1; then
    echo "ERROR: 此 runner 需要 .NET SDK；本次交件使用本機 dotnet，未宣稱支援其他編譯器。" >&2
    exit 1
fi
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/liuruan-core.XXXXXX")
trap '/bin/rm -r "$work_dir"' EXIT HUP INT TERM
export DOTNET_CLI_HOME="$work_dir/cli"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
export DOTNET_NOLOGO=1
sdk_version=$(dotnet --version)
sdk_major=${sdk_version%%.*}
case "$sdk_major" in
    ''|*[!0-9]*) echo "ERROR: 無法辨識 SDK: $sdk_version" >&2; exit 1 ;;
esac
if [ "$sdk_major" -lt 8 ]; then
    echo "ERROR: 需要 .NET SDK 8 以上（C# 限定為 9）。" >&2
    exit 1
fi
cp "$scripts_dir/Runtime/HungerCore.cs" "$scripts_dir/Runtime/CompanionCore.cs"     "$scripts_dir/Tests/EditMode/CoreTests.cs" "$scripts_dir/Tests/Console/Runner.cs" "$work_dir/"
cat > "$work_dir/NuGet.Config" <<'XML'
<configuration><packageSources><clear /></packageSources></configuration>
XML
cat > "$work_dir/CoreTests.csproj" <<XML
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$sdk_major.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
XML
printf 'Compiler: .NET SDK %s; C# 9.0; no NuGet packages; shared EditMode test methods\n' "$sdk_version"
dotnet run --project "$work_dir/CoreTests.csproj" --configuration Release --no-launch-profile --disable-build-servers
// 此檔只供 console；不要複製進 Unity。
using System;
using System.Linq;
using System.Reflection;

namespace NUnit.Framework
{
    [AttributeUsage(AttributeTargets.Method)]
    public sealed class TestAttribute : Attribute { }
    [AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
    public sealed class TestCaseAttribute : Attribute
    {
        public object[] Arguments { get; }
        public TestCaseAttribute(params object[] arguments) { Arguments = arguments; }
    }
}

internal static class Runner
{
    private static int Main()
    {
        int passed = 0, failed = 0;
        foreach (Type type in new[] { typeof(Liuruan.Tests.HungerCoreTests), typeof(Liuruan.Tests.CompanionCoreTests) })
        foreach (MethodInfo method in type.GetMethods().OrderBy(m => m.Name))
        {
            var cases = method.GetCustomAttributes<NUnit.Framework.TestCaseAttribute>().ToArray();
            bool simple = method.IsDefined(typeof(NUnit.Framework.TestAttribute), false);
            if (!simple && cases.Length == 0) continue;
            var arguments = cases.Length > 0 ? cases.Select(c => c.Arguments) : new[] { new object[0] };
            foreach (object[] args in arguments)
            {
                string name = type.Name + "." + method.Name + "(" + string.Join(",", args) + ")";
                try
                {
                    method.Invoke(Activator.CreateInstance(type), args);
                    Console.WriteLine("PASS " + name); passed++;
                }
                catch (Exception e)
                {
                    Console.WriteLine("FAIL " + name + ": " + (e.InnerException ?? e)); failed++;
                }
            }
        }
        Console.WriteLine($"RESULT: {passed} passed, {failed} failed");
        return failed == 0 && passed > 0 ? 0 : 1;
    }
}
using System;
using NUnit.Framework;

namespace Liuruan.Tests
{
    internal static class Check
    {
        public static void Equal<T>(T expected, T actual)
        {
            if (!Equals(expected, actual)) throw new Exception($"Expected {expected}, got {actual}");
        }
        public static void Near(double expected, double actual)
        {
            if (double.IsNaN(actual) || Math.Abs(expected - actual) > 0.00001)
                throw new Exception($"Expected {expected}, got {actual}");
        }
        public static void Throws(Action action)
        {
            try { action(); }
            catch (ArgumentOutOfRangeException) { return; }
            throw new Exception("Expected ArgumentOutOfRangeException");
        }
    }

    public sealed class HungerCoreTests
    {
        [Test] public void StartsWithThreeAndNormalSpeed()
        {
            var c = new HungerCore();
            Check.Near(3, c.Value); Check.Near(24, c.IntervalSeconds);
            Check.Near(1, c.SpeedMultiplier); Check.Equal(false, c.IsPaused);
        }
        [TestCase(-1f, 0f)] [TestCase(0f, 0f)] [TestCase(5f, 5f)] [TestCase(6f, 5f)]
        public void ClampsInitialValue(float initial, float expected)
        { Check.Near(expected, new HungerCore(initial).Value); }
        [Test] public void DropsAtExactIntervalAndPreservesRemainder()
        {
            var c = new HungerCore();
            c.Tick(23); Check.Near(3, c.Value);
            c.Tick(1); Check.Near(2.5, c.Value);
            c.Tick(49); Check.Near(1.5, c.Value);
            c.Tick(23); Check.Near(1, c.Value);
        }
        [Test] public void SupportsCustomInterval()
        { var c = new HungerCore(3, 2); c.Tick(2); Check.Near(2.5, c.Value); }
        [Test] public void PauseResumeIsIdempotentAndKeepsRemainder()
        {
            var c = new HungerCore(); c.Tick(12); c.Pause(); c.Pause(); c.Tick(1000);
            Check.Equal(true, c.IsPaused); Check.Near(3, c.Value);
            c.Resume(); c.Resume(); c.Tick(12); Check.Near(2.5, c.Value);
        }
        [Test] public void StarvesOncePerCrossingAndRecoversWithoutDying()
        {
            var c = new HungerCore(); int count = 0; c.OnStarving += () => count++;
            c.Tick(144); Check.Near(0, c.Value); Check.Near(0.6, c.SpeedMultiplier);
            c.Tick(10000); c.Eat(0); Check.Equal(1, count);
            c.Eat(0.25f); Check.Near(1, c.SpeedMultiplier);
            c.Tick(24); Check.Near(0, c.Value); Check.Equal(2, count);
            c.FillAll(); Check.Near(5, c.Value); Check.Near(1, c.SpeedMultiplier);
        }
        [Test] public void EatClampFillAndChangeEvents()
        {
            var c = new HungerCore(); int events = 0; float observed = 0;
            c.OnChanged += v => { events++; observed = v; };
            c.Eat(0); Check.Equal(0, events);
            c.Eat(0.25f); Check.Near(3.25, observed);
            c.Eat(float.MaxValue); Check.Near(5, c.Value);
            c.FillAll(); Check.Equal(2, events);
            c.Tick(24); Check.Near(4.5, observed); Check.Equal(3, events);
            c.FillAll(); Check.Near(5, observed); Check.Equal(4, events);
        }
        [Test] public void FoodWorksWhilePausedAndDoesNotResetActiveClock()
        {
            var c = new HungerCore(); c.Tick(12); c.Pause(); c.Eat(1); c.FillAll();
            Check.Near(5, c.Value); c.Resume(); c.Tick(12); Check.Near(4.5, c.Value);
        }
        [Test] public void LargeTickClampsAndRecoveryGetsFreshInterval()
        {
            var c = new HungerCore(); c.Tick(float.MaxValue); Check.Near(0, c.Value);
            c.FillAll(); c.Tick(23); Check.Near(5, c.Value); c.Tick(1); Check.Near(4.5, c.Value);
        }
        [Test] public void ZeroTickDoesNothing()
        { var c = new HungerCore(); c.Tick(0); Check.Near(3, c.Value); }
        [Test] public void RejectsInvalidInputs()
        {
            foreach (float v in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity })
            {
                Check.Throws(() => new HungerCore(v)); Check.Throws(() => new HungerCore(3, v));
                var c = new HungerCore(); Check.Throws(() => c.Tick(v)); Check.Throws(() => c.Eat(v));
            }
            Check.Throws(() => new HungerCore(3, 0)); Check.Throws(() => new HungerCore(3, -1));
            Check.Throws(() => new HungerCore().Tick(-1)); Check.Throws(() => new HungerCore().Eat(-1));
        }
    }

    public sealed class CompanionCoreTests
    {
        private static WorldPosition P(float x, float y = 0, float z = 0) => new WorldPosition(x, y, z);
        private static CompanionState Step(CompanionCore c, float dt, float distance)
            => c.Tick(dt, P(0), P(distance), P(0, 0, 1));

        [TestCase(0f, CompanionState.Idle)] [TestCase(2.499f, CompanionState.Idle)]
        [TestCase(2.5f, CompanionState.Follow)] [TestCase(12f, CompanionState.Follow)]
        [TestCase(12.001f, CompanionState.Catchup)] [TestCase(30f, CompanionState.Catchup)]
        [TestCase(30.001f, CompanionState.Teleport)]
        public void DistanceBoundaries(float distance, CompanionState expected)
        { Check.Equal(expected, Step(new CompanionCore(), 0, distance)); }
        [TestCase(0)] [TestCase(1)] [TestCase(2)] [TestCase(3)]
        public void AllSixteenDistanceDrivenTransitions(int sourceIndex)
        {
            float[] distances = { 1, 3, 20, 31 };
            CompanionState[] states = { CompanionState.Idle, CompanionState.Follow,
                CompanionState.Catchup, CompanionState.Teleport };
            for (int target = 0; target < distances.Length; target++)
            {
                var c = new CompanionCore();
                Check.Equal(states[sourceIndex], Step(c, 0, distances[sourceIndex]));
                Check.Equal(states[target], Step(c, 0, distances[target]));
            }
        }
        [Test] public void MovesThroughEveryStateAndBack()
        {
            var c = new CompanionCore(); Check.Equal(CompanionState.Idle, c.State);
            Check.Equal(CompanionState.Follow, Step(c, 0, 3));
            Check.Equal(CompanionState.Catchup, Step(c, 0, 13));
            Check.Equal(CompanionState.Follow, Step(c, 0, 12));
            Check.Equal(CompanionState.Idle, Step(c, 0, 2));
            Check.Equal(CompanionState.Teleport, Step(c, 0, 31));
            Check.Equal(CompanionState.Idle, Step(c, 0, 2));
        }
        [Test] public void TeleportIsTwoMetresBehindNormalizedHorizontalForward()
        {
            var c = new CompanionCore(); c.Tick(0, P(10, 4, 10), P(100), P(3, 7, 4));
            Check.Near(8.8, c.Destination.X); Check.Near(4, c.Destination.Y); Check.Near(8.4, c.Destination.Z);
        }
        [Test] public void ZeroForwardUsesWorldBack()
        {
            var c = new CompanionCore(); c.Tick(0, P(10, 4, 10), P(100), P(0));
            Check.Near(10, c.Destination.X); Check.Near(4, c.Destination.Y); Check.Near(8, c.Destination.Z);
        }
        [Test] public void UsesThreeDimensionalDistance()
        {
            var c = new CompanionCore();
            Check.Equal(CompanionState.Catchup, c.Tick(0, P(0), P(0, 13), P(0)));
        }
        [Test] public void StuckAtExactlyThreeSecondsTeleportsThenResets()
        {
            var c = new CompanionCore(); Step(c, 0, 5);
            Check.Equal(CompanionState.Follow, Step(c, 2.999f, 5));
            Check.Equal(CompanionState.Teleport, Step(c, 0.002f, 5));
            Check.Equal(CompanionState.Follow, Step(c, 0, 5));
        }
        [Test] public void ExactStuckBoundary()
        {
            var c = new CompanionCore(); Step(c, 0, 5);
            Check.Equal(CompanionState.Teleport, Step(c, 3, 5));
        }
        [Test] public void ProgressAndIdleResetStuckTimer()
        {
            var c = new CompanionCore(); Step(c, 0, 5); Step(c, 2, 5);
            Check.Equal(CompanionState.Follow, Step(c, 2, 5.1f));
            Step(c, 2, 5.1f); Step(c, 100, 1);
            Check.Equal(CompanionState.Follow, Step(c, 0, 5.1f));
        }
        [Test] public void SlowProgressAccumulatesAgainstAnchor()
        {
            var c = new CompanionCore(); Step(c, 0, 5);
            Step(c, 1, 5.02f); Step(c, 1, 5.04f);
            Check.Equal(CompanionState.Follow, Step(c, 1, 5.06f));
        }
        [Test] public void FiveCentimetresResetsStuckTimer()
        {
            var c = new CompanionCore(); Step(c, 0, 5); Step(c, 2, 5);
            Check.Equal(CompanionState.Follow, Step(c, 1, 5.05f));
            Check.Equal(CompanionState.Follow, Step(c, 2.99f, 5.05f));
        }
        [Test] public void CatchupCanAlsoGetStuck()
        {
            var c = new CompanionCore(); Step(c, 0, 20);
            Check.Equal(CompanionState.Teleport, Step(c, 3, 20));
        }
        [Test] public void IdleNeverCountsAsStuck()
        { var c = new CompanionCore(); Step(c, 0, 1); Check.Equal(CompanionState.Idle, Step(c, 100, 1)); }
        [Test] public void CallCooldownAndExactReadyBoundary()
        {
            var c = new CompanionCore(); Check.Near(0, c.CooldownRatio);
            Check.Equal(true, c.Call()); Check.Near(1, c.CooldownRatio);
            Check.Equal(false, c.Call()); Step(c, 4, 1); Check.Near(0.5, c.CooldownRatio);
            Check.Equal(false, c.Call()); Check.Near(0.5, c.CooldownRatio);
            Step(c, 4, 1); Check.Near(0, c.CooldownRatio); Check.Equal(true, c.Call());
            Step(c, 100, 1); Check.Near(0, c.CooldownRatio);
        }
        [Test] public void CallAcceleratesUntilReunion()
        {
            var c = new CompanionCore(); c.Call();
            Check.Equal(CompanionState.Catchup, Step(c, 0, 3));
            Check.Equal(CompanionState.Catchup, Step(c, 8, 4));
            Check.Equal(CompanionState.Idle, Step(c, 0, 2));
            Check.Equal(CompanionState.Follow, Step(c, 0, 3));
            Check.Near(0, c.Destination.X);
        }
        [Test] public void TeleportClearsCallButPreservesCooldown()
        {
            var c = new CompanionCore(); c.Call(); Step(c, 1, 31);
            Check.Near(0.875, c.CooldownRatio);
            Check.Equal(CompanionState.Follow, Step(c, 0, 3));
        }
        [Test] public void RejectsInvalidTimeAndCoordinates()
        {
            var c = new CompanionCore(); Check.Throws(() => Step(c, -1, 3));
            foreach (float v in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity })
            {
                Check.Throws(() => Step(c, v, 3)); Check.Throws(() => P(v));
                Check.Throws(() => P(0, v)); Check.Throws(() => P(0, 0, v));
            }
        }
    }
}
