using System;
using System.IO;
using Liuruan;
using TMPro;
using Unity.AI.Navigation;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.AI;

public static class R1Setup
{
    [MenuItem("Tools/Liuruan/R1/Install")]
    public static void Install()
    {
        if (EditorApplication.isPlaying) throw new InvalidOperationException("請先離開 Play 模式。");
        var scene = EditorSceneManager.OpenScene("Assets/_Project/Scenes/Main.unity");
        var player = GameObject.Find("Player");
        Add<HungerSystem>(player);
        var companion = GameObject.Find("Companion");
        var collider = companion.GetComponent<Collider>();
        if (collider) UnityEngine.Object.DestroyImmediate(collider);
        var agent = Add<NavMeshAgent>(companion);
        agent.radius = 0.3f; agent.height = 1.8f; agent.baseOffset = 0.9f;
        var follow = Add<CompanionFollow>(companion);
        Set(follow, "player", player.transform);
        var deck = GameObject.Find("R1PeachLanding");
        if (!deck)
        {
            deck = GameObject.CreatePrimitive(PrimitiveType.Cube); deck.name = "R1PeachLanding";
            deck.transform.position = new Vector3(-17, 17.8f, -24); deck.transform.localScale = new Vector3(8, 0.4f, 8);
            deck.GetComponent<Renderer>().sharedMaterial = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/Rock.mat");
        }
        foreach (Transform t in GameObject.Find("ActPoints").transform)
        {
            if (t.name == "Act1_Start") continue;
            var it = Add<Interactable>(t.gameObject);
            it.radius = 3.5f;
            if (t.name.StartsWith("Act1_")) it.prompt = "剝皮";
            else if (t.name == "Act2_ClimbBase") it.prompt = "攀援";
            else if (t.name == "Act2_PeachTree") it.prompt = "摘桃";
            else if (t.name.StartsWith("Act3_Drift_")) it.prompt = "撿起";
            else if (t.name == "Act3_Wade") it.prompt = "涉水";
            else if (t.name == "Act4_Board") it.prompt = "閱讀原文";
            else if (t.name == "Act5_Return") it.prompt = "返回村口";
            else it.prompt = "查看";
            if (!t.Find("R1Marker"))
            {
                var marker = GameObject.CreatePrimitive(PrimitiveType.Sphere); marker.name = "R1Marker";
                UnityEngine.Object.DestroyImmediate(marker.GetComponent<Collider>());
                marker.transform.SetParent(t, false); marker.transform.localPosition = Vector3.up * 1.3f; marker.transform.localScale = Vector3.one * 0.55f;
                marker.GetComponent<Renderer>().sharedMaterial = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/Player.mat");
            }
        }
        var cold = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/ReturnCold.mat");
        if (!cold)
        {
            cold = new Material(AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/Wall.mat"));
            cold.SetColor("_BaseColor", new Color(0.32f, 0.37f, 0.42f));
            AssetDatabase.CreateAsset(cold, "Assets/_Project/Materials/Greybox/ReturnCold.mat");
        }
        var systems = GameObject.Find("JourneySystems");
        if (!systems) systems = new GameObject("JourneySystems");
        var flow = Add<GameFlow>(systems); BindData(flow); Set(flow, "returnMaterial", cold);
        var hud = Add<HudUI>(systems);
        hud.font = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>("Assets/_Project/Fonts/NotoSerifTC Static SDF.asset");
        var surface = Add<NavMeshSurface>(GameObject.Find("Terrain_240x240"));
        surface.collectObjects = CollectObjects.All;
        surface.useGeometry = NavMeshCollectGeometry.PhysicsColliders;
        surface.BuildNavMesh();
        var mesh = NavMesh.CalculateTriangulation();
        if (mesh.vertices.Length == 0) throw new InvalidOperationException("NavMesh 烘焙結果為空。");
        PlayerSettings.runInBackground = true;
        EditorUtility.SetDirty(hud);
        EditorSceneManager.MarkSceneDirty(scene);
        if (!EditorSceneManager.SaveScene(scene)) throw new IOException("Main 場景儲存失敗。");
        Debug.Log(Liuruan.EditorTools.FontSubset.RebuildNoDialog());
        AssetDatabase.SaveAssets();
        File.WriteAllText("logs/U-R1-install.md", "# R1 安裝結果\n\nMain 已儲存；互動點 15 個；NavMesh vertices=" + mesh.vertices.Length + "。\n題庫：" + (AssetDatabase.LoadAssetAtPath<TextAsset>("Assets/_Project/Data/clues.json") ? "已綁定" : "使用占位鍵") + "\n");
    }
    public static void BindData(GameFlow flow)
    {
        Set(flow, "clueJson", AssetDatabase.LoadAssetAtPath<TextAsset>("Assets/_Project/Data/clues.json"));
    }
    static T Add<T>(GameObject go) where T : Component { var c = go.GetComponent<T>(); return c ? c : go.AddComponent<T>(); }
    static void Set(UnityEngine.Object target, string key, UnityEngine.Object value)
    {
        var so = new SerializedObject(target); so.FindProperty(key).objectReferenceValue = value; so.ApplyModifiedPropertiesWithoutUndo();
    }
}
using System.IO;
using UnityEditor;
using UnityEngine;
using UnityEngine.Rendering.Universal;

namespace Liuruan
{
    /// R30 畫質升級：固定機位截圖，做改前／改後對照（輸出 Captures/r30/<tag>_<shot>.png）
    public static class R30Capture
    {
        static readonly (string name, Vector3 pos, Vector3 look)[] Shots =
        {
            ("a_start", new Vector3(0, 2.4f, -112), new Vector3(0, 1.2f, -104)),
            ("b_forest", new Vector3(2, 2.4f, -86), new Vector3(8, 1.2f, -72)),
            ("c_gorge", new Vector3(-9, 2.4f, -31), new Vector3(-4, 1, 12)),
            ("d_peach", new Vector3(-7, 5, -40), new Vector3(-18, 20, -24)),
            ("e_village", new Vector3(0, 2.4f, 65), new Vector3(0, 2, 85)),
            ("f_overview", new Vector3(70, 100, -100), new Vector3(0, 0, 5)),
        };

        public static string Run(string tag)
        {
            string dir = Path.GetFullPath(Path.Combine(Application.dataPath, tag == "r1" ? "../Captures/r1" : "../Captures/r30"));
            Directory.CreateDirectory(dir);
            foreach (var ps in Object.FindObjectsByType<ParticleSystem>(FindObjectsSortMode.None)) ps.Simulate(10f, true, true);
            var go = new GameObject("_R30CaptureCam") { hideFlags = HideFlags.HideAndDontSave };
            var cam = go.AddComponent<Camera>();
            cam.fieldOfView = 55; cam.nearClipPlane = 0.1f; cam.farClipPlane = 1000;
            go.AddComponent<UniversalAdditionalCameraData>().renderPostProcessing = true;
            var rt = new RenderTexture(1280, 720, 24, RenderTextureFormat.ARGB32) { antiAliasing = 4 };
            var tex = new Texture2D(1280, 720, TextureFormat.RGB24, false);
            try
            {
                foreach (var s in Shots)
                {
                    go.transform.position = s.pos;
                    go.transform.LookAt(s.look);
                    cam.targetTexture = rt;
                    cam.Render();
                    RenderTexture.active = rt;
                    tex.ReadPixels(new Rect(0, 0, 1280, 720), 0, 0);
                    File.WriteAllBytes(Path.Combine(dir, $"{tag}_{s.name}.png"), tex.EncodeToPNG());
                }
            }
            finally
            {
                RenderTexture.active = null;
                cam.targetTexture = null;
                Object.DestroyImmediate(go);
                Object.DestroyImmediate(rt);
                Object.DestroyImmediate(tex);
            }
            return dir;
        }
    }
}
using System.Collections.Generic;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;

namespace Liuruan
{
    /// R30 畫質升級第 5 步：植被換 Liuruan/FoliageWind（風動＋葉背透光）。
    /// 植被和建築共用 M_r10_2side / M_r10_matte 調色盤材質，所以另建風動版本、只換在植被 renderer 上。
    /// Instancing 已由 _R8/_R10/_R12/_R14Outdoor 根物件上的 InstancedGroup 處理。
    public static class R30Foliage
    {
        const string Dir = "Assets/_Project/Materials/R30/";

        // 類別, 權重高度(m), 主擺動(m), 細顫(m), 透光, 網格名
        static readonly (string cls, float height, float strength, float flutter, float transl, string[] meshes)[] Classes =
        {
            ("grass", 0.5f, 0.06f, 0.01f, 0.6f, new[] { "gc_maidong", "gc_shudai", "gc_shudai_drift", "grass_patch_mix", "gc_changpu", "flower_jiguan", "flower_fengxian", "juhua_bed" }),
            ("shrub", 1.5f, 0.05f, 0.008f, 0.5f, new[] { "dujuan_low", "dujuan_mound", "huangyang_trio", "huangyang_ball", "shrub_belt", "mufurong", "bamboo_belt", "bamboo_small" }),
            ("tree", 8f, 0.15f, 0.01f, 0.3f, new[] { "pine_r12", "pine_r12_lod1", "wutong_slim", "wutong_slim_lod1", "guihua", "guihua_lod1" }),
        };

        public static string Run()
        {
            var shader = Shader.Find("Liuruan/FoliageWind");
            var src2 = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Blender/r10r11/M_r10_2side.mat");
            var srcM = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Blender/r10r11/M_r10_matte.mat");
            if (!shader || !src2 || !srcM) return "foliage wind: 尚無風動 shader／調色盤材質，未修改場景";
            System.IO.Directory.CreateDirectory(Dir);
            AssetDatabase.Refresh();

            var swap = new Dictionary<string, (Material two, Material matte)>();
            foreach (var c in Classes)
            {
                var pair = (Make(shader, src2, c, true), Make(shader, srcM, c, false));
                foreach (var m in c.meshes) swap[m] = pair;
            }

            int n = 0;
            foreach (var r in Object.FindObjectsByType<MeshRenderer>(FindObjectsInactive.Include, FindObjectsSortMode.None))
            {
                var mf = r.GetComponent<MeshFilter>();
                if (mf == null || mf.sharedMesh == null || !swap.TryGetValue(mf.sharedMesh.name, out var pair)) continue;
                var mats = r.sharedMaterials;
                bool hit = false;
                for (int i = 0; i < mats.Length; i++)
                {
                    if (mats[i] == src2) { mats[i] = pair.two; hit = true; }
                    else if (mats[i] == srcM) { mats[i] = pair.matte; hit = true; }
                }
                if (!hit) continue;
                r.sharedMaterials = mats;
                n++;
            }
            AssetDatabase.SaveAssets();
            EditorSceneManager.MarkSceneDirty(EditorSceneManager.GetActiveScene());
            EditorSceneManager.SaveOpenScenes();
            return $"foliage wind: {n} renderers";
        }

        static Material Make(Shader shader, Material src, (string cls, float height, float strength, float flutter, float transl, string[] meshes) c, bool twoSided)
        {
            var path = Dir + $"M_r10_{c.cls}_{(twoSided ? "2side" : "matte")}_wind.mat";
            var m = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (m == null) { m = new Material(shader); AssetDatabase.CreateAsset(m, path); }
            m.shader = shader;
            m.SetTexture("_BaseMap", src.GetTexture("_BaseMap"));
            m.SetColor("_BaseColor", src.GetColor("_BaseColor"));
            m.SetFloat("_Cutoff", 0.1f); // 調色盤不透明，只為共用 alpha clip 路徑
            m.SetFloat("_Cull", twoSided ? 0f : 2f);
            m.SetFloat("_WrapDiffuse", 0.4f);
            m.SetFloat("_SpecularStrength", 0.05f);
            m.SetFloat("_Smoothness", 0.3f);
            m.SetColor("_TranslucencyColor", new Color(0.6f, 0.8f, 0.25f));
            m.SetFloat("_Translucency", c.transl);
            m.SetFloat("_WindHeight", c.height);
            m.SetVector("_WindDir", new Vector4(1, 0, 0.3f, 0));
            m.SetFloat("_WindStrength", c.strength);
            m.SetFloat("_WindSpeed", c.cls == "grass" ? 1.8f : 1.0f);
            m.SetFloat("_WindWaveScale", c.cls == "grass" ? 0.3f : 0.15f);
            m.SetFloat("_FlutterStrength", c.flutter);
            m.enableInstancing = true;
            EditorUtility.SetDirty(m);
            return m;
        }
    }
}

