            go.transform.position = plane.position + Vector3.up * i * 3; go.transform.rotation = plane.rotation;
            go.transform.localScale = new Vector3(1.8f, 3, 1.8f); go.GetComponent<MeshFilter>().sharedMesh = mesh;
