using System;
using UnityEngine;

namespace Liuruan
{
    [RequireComponent(typeof(Camera))]
    public sealed class MinimapCam : MonoBehaviour
    {
        [SerializeField] private Transform player;
        [SerializeField] private Transform companion;
        [SerializeField] private Transform target;
        [SerializeField] private Vector2 worldMin = new Vector2(-128, -128);
        [SerializeField] private Vector2 worldSize = new Vector2(256, 256);
        [SerializeField, Range(0, 31)] private int revealRadiusCells = 2;
        [SerializeField, Min(1)] private float viewHalfSize = 24;
        [SerializeField, Min(1)] private float cameraHeight = 100;
        [SerializeField, Min(64)] private float hudSize = 192;
        [SerializeField] private LayerMask mapLayers = ~0;
        public RenderTexture Output { get; private set; }
        public Texture2D FogMask { get; private set; }
        public event Action<bool> OnFogChanged;
        private MinimapFogCore core;
        private Camera mapCamera;
        private Texture2D arrow, dot;
        private readonly Color32[] maskPixels = new Color32[32 * 32];

        private void Awake()
        {
            core = new MinimapFogCore(worldMin.x, worldMin.y, worldSize.x, worldSize.y);
            mapCamera = GetComponent<Camera>();
            mapCamera.orthographic = true; mapCamera.orthographicSize = viewHalfSize;
            mapCamera.cullingMask = mapLayers; mapCamera.aspect = 1;
            mapCamera.nearClipPlane = 0.1f; mapCamera.farClipPlane = cameraHeight * 2;
            Output = new RenderTexture(256, 256, 16) { name = "LiuruanMinimap" };
            Output.Create(); mapCamera.targetTexture = Output;
            FogMask = new Texture2D(32, 32, TextureFormat.RGBA32, false)
                { name = "LiuruanFog", filterMode = FilterMode.Point, wrapMode = TextureWrapMode.Clamp };
            arrow = MakeIcon(true); dot = MakeIcon(false); UpdateMask();
        }
        public void SetAct(int act)
        {
            if (core == null) throw new InvalidOperationException("請在 MinimapCam.Awake 後設定幕次。");
            bool before = core.FogEnabled; core.SetAct(act); UpdateMask();
            if (before != core.FogEnabled) OnFogChanged?.Invoke(core.FogEnabled);
        }
        public void SetTarget(Transform currentTarget) => target = currentTarget;
        private void LateUpdate()
        {
            if (!player) return;
            transform.SetPositionAndRotation(player.position + Vector3.up * cameraHeight, Quaternion.Euler(90, 0, 0));
            if (core.FogEnabled && core.Reveal(player.position.x, player.position.z, revealRadiusCells)) UpdateMask();
        }
        private void UpdateMask()
        {
            for (int row = 0; row < 32; row++)
            for (int col = 0; col < 32; col++) maskPixels[row * 32 + col] = new Color32(0, 0, 0, core.MaskAlpha(col, row));
            FogMask.SetPixels32(maskPixels); FogMask.Apply(false, false);
        }
        private void OnGUI()
        {
            if (!player || !Output || Event.current.type != EventType.Repaint) return;
            Color oldColor = GUI.color; Matrix4x4 oldMatrix = GUI.matrix; GUI.color = Color.white;
            var rect = new Rect(Screen.width - hudSize - 16, Screen.height - hudSize - 16, hudSize, hudSize);
            GUI.BeginGroup(rect);
            GUI.DrawTexture(new Rect(0, 0, hudSize, hudSize), Output);
            if (core.FogEnabled)
            {
                float scale = hudSize / (viewHalfSize * 2);
                var bounds = new Rect((worldMin.x - player.position.x + viewHalfSize) * scale,
                    (player.position.z + viewHalfSize - worldMin.y - worldSize.y) * scale,
                    worldSize.x * scale, worldSize.y * scale);
                GUI.DrawTexture(bounds, FogMask);
                GUI.color = Color.black;
                Fill(0, 0, hudSize, Mathf.Clamp(bounds.yMin, 0, hudSize));
                Fill(0, Mathf.Clamp(bounds.yMax, 0, hudSize), hudSize, hudSize - Mathf.Clamp(bounds.yMax, 0, hudSize));
                Fill(0, 0, Mathf.Clamp(bounds.xMin, 0, hudSize), hudSize);
                Fill(Mathf.Clamp(bounds.xMax, 0, hudSize), 0, hudSize - Mathf.Clamp(bounds.xMax, 0, hudSize), hudSize);
            }
            DrawIcon(companion, Color.cyan, dot, false);
            DrawIcon(target, Color.yellow, dot, false);
            DrawIcon(player, Color.white, arrow, true);
            GUI.EndGroup(); GUI.matrix = oldMatrix; GUI.color = oldColor;
        }
        private void Fill(float x, float y, float w, float h)
        { if (w > 0 && h > 0) GUI.DrawTexture(new Rect(x, y, w, h), Texture2D.whiteTexture); }
        private void DrawIcon(Transform subject, Color color, Texture2D texture, bool rotate)
        {
            if (!subject) return;
            float scale = hudSize / (viewHalfSize * 2);
            Vector2 p = new Vector2(hudSize / 2 + (subject.position.x - player.position.x) * scale,
                hudSize / 2 - (subject.position.z - player.position.z) * scale);
            if (p.x < 0 || p.y < 0 || p.x > hudSize || p.y > hudSize) return;
            Matrix4x4 before = GUI.matrix;
            GUI.color = color;
            if (rotate) GUIUtility.RotateAroundPivot(subject.eulerAngles.y, p);
            GUI.DrawTexture(new Rect(p.x - 6, p.y - 6, 12, 12), texture);
            GUI.matrix = before;
        }
        private static Texture2D MakeIcon(bool triangle)
        {
            var texture = new Texture2D(16, 16, TextureFormat.RGBA32, false);
            var pixels = new Color32[256];
            for (int y = 0; y < 16; y++)
            for (int x = 0; x < 16; x++)
            {
                bool visible = triangle ? Math.Abs(x - 7.5f) <= (15 - y) * 0.5f
                    : (x - 7.5f) * (x - 7.5f) + (y - 7.5f) * (y - 7.5f) <= 49;
                pixels[y * 16 + x] = new Color32(255, 255, 255, (byte)(visible ? 255 : 0));
            }
            texture.SetPixels32(pixels); texture.Apply(); return texture;
        }
        private void OnDestroy()
        {
            if (mapCamera && mapCamera.targetTexture == Output) mapCamera.targetTexture = null;
            if (Output) { Output.Release(); Destroy(Output); }
            if (FogMask) Destroy(FogMask);
            if (arrow) Destroy(arrow);
            if (dot) Destroy(dot);
        }
    }
}
using System;
using System.Collections.Generic;
using UnityEngine;

namespace Liuruan
{
    [RequireComponent(typeof(BoxCollider))]
    public sealed class ClimbZone : MonoBehaviour
    {
        [SerializeField] private Transform player;
        [SerializeField] private Behaviour playerMovement;
        [SerializeField] private HungerSystem hunger;
        [SerializeField] private Transform planeOrigin;
        [SerializeField] private Transform topLanding;
        [SerializeField, Min(0.01f)] private float width = 3;
        [SerializeField, Min(0.01f)] private float height = 6;
        public event Action<ClimbState> OnStateChanged;
        public event Action<bool> OnMovementLockChanged;
        public event Action<bool> OnPromptChanged;
        public event Action OnTopOut;
        public ClimbState State => core != null ? core.State : ClimbState.Grounded;
        public bool IsLocked => core != null && core.IsLocked;
        public bool CanInteract => isActiveAndEnabled && playerMovement && playerMovement.enabled && inside.Count > 0 && State == ClimbState.Grounded;
        private readonly HashSet<Collider> inside = new HashSet<Collider>();
        private ClimbCore core;
        private CharacterController controller;
        private bool movementWasEnabled, controllerWasEnabled, ownsMovement, prompt;
        private Vector2 moveInput;

        private void Awake()
        {
            GetComponent<BoxCollider>().isTrigger = true;
            if (!player || !playerMovement || !planeOrigin || !topLanding || playerMovement == this)
            { Debug.LogError("ClimbZone 需要玩家、一般移動元件、藤蔓平面原點與頂端落點。", this); enabled = false; return; }
            controller = player.GetComponent<CharacterController>();
            core = new ClimbCore(width, height);
            core.OnStateChanged += state => OnStateChanged?.Invoke(state);
        }
        public bool TryInteract()
        {
            if (core == null || !CanInteract) return false;
            Vector3 offset = player.position - planeOrigin.position;
            movementWasEnabled = playerMovement.enabled;
            controllerWasEnabled = controller && controller.enabled;
            ownsMovement = true;
            playerMovement.enabled = false;
            if (controller) controller.enabled = false;
            OnMovementLockChanged?.Invoke(true);
            core.Attach(Vector3.Dot(offset, planeOrigin.right), Vector3.Dot(offset, Vector3.up));
            ApplyPlanePosition(); SetPrompt(false); return true;
        }
        public void SetMoveInput(Vector2 input) => moveInput = Vector2.ClampMagnitude(input, 1);
        public void Release()
        {
            if (core == null || !ownsMovement) return;
            core.Release(); RestoreMovement(); core.Finish();
        }
        private void Update()
        {
            SetPrompt(CanInteract);
            if (!ownsMovement) return;
            bool wasTopOut = State == ClimbState.TopOut;
            Vector2 input = moveInput + new Vector2(Input.GetAxisRaw("Horizontal"), Input.GetAxisRaw("Vertical"));
            core.Tick(Time.deltaTime, input.x, input.y, hunger ? hunger.Value : 5);
            if (!wasTopOut) ApplyPlanePosition();
            if (State == ClimbState.TopOut)
            {
                player.position = Vector3.MoveTowards(player.position, topLanding.position, ClimbCore.Speed * Time.deltaTime);
                if ((player.position - topLanding.position).sqrMagnitude <= 0.000001f)
                { RestoreMovement(); core.Finish(); OnTopOut?.Invoke(); }
            }
            else if (State == ClimbState.Release) { RestoreMovement(); core.Finish(); }
        }
        private void ApplyPlanePosition()
        {
            // 平面保持垂直，planeOrigin 只能繞世界 Y 旋轉。
            player.position = planeOrigin.position + planeOrigin.right * core.X + Vector3.up * core.Y;
            player.rotation = Quaternion.LookRotation(-planeOrigin.forward, Vector3.up);
        }
        private void RestoreMovement()
        {
            if (!ownsMovement) return;
            ownsMovement = false; moveInput = Vector2.zero;
            if (controller) controller.enabled = controllerWasEnabled;
            if (playerMovement) playerMovement.enabled = movementWasEnabled;
            OnMovementLockChanged?.Invoke(false);
        }
        private bool IsPlayer(Collider other) => player && (other.transform == player || other.transform.IsChildOf(player));
        private void OnTriggerEnter(Collider other) { if (IsPlayer(other)) { inside.Add(other); SetPrompt(CanInteract); } }
        private void OnTriggerExit(Collider other) { if (inside.Remove(other)) SetPrompt(CanInteract); }
        private void SetPrompt(bool show)
        { if (prompt != show) { prompt = show; OnPromptChanged?.Invoke(show); } }
        private void OnDisable() { Release(); inside.Clear(); SetPrompt(false); }
    }
}
using UnityEngine;

namespace Liuruan
{
    /// Round8：大量重複的戶外擺件（粉牆、花街鋪地、盆菊、秋草…）改走 GPU Instancing。
    /// URP 開著 SRP Batcher 時，相容的 Renderer 一律走 SRP Batcher，同模型同材質也是一個物件一個 draw call；
    /// 給 Renderer 一個 MaterialPropertyBlock 會讓它退出 SRP Batcher，改由材質的 Enable GPU Instancing 合併成一批。
    /// 掛在擺件的根物件上（_R8Outdoor），底下所有 MeshRenderer 都套用；材質要勾 Enable GPU Instancing。
    public class InstancedGroup : MonoBehaviour
    {
        static readonly int Tag = Shader.PropertyToID("_InstancedGroup");

        void Awake()
        {
            var mpb = new MaterialPropertyBlock();
            mpb.SetFloat(Tag, 1f); // 空的 block 不算數，放一個 shader 沒用到的值
            foreach (var r in GetComponentsInChildren<MeshRenderer>(true)) r.SetPropertyBlock(mpb);
        }
    }
}
using System.Collections.Generic;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;

namespace Liuruan
{
    /// R30 畫質升級第 5 步：植被換 Liuruan/FoliageWind（風動＋葉背透光）。
    /// 植被和建築共用 M_r10_2side / M_r10_matte 調色盤材質，所以另建風動版本、只換在植被 renderer 上。
    /// Instancing 已由 _R8/_R10/_R12/_R14Outdoor 根物件上的 InstancedGroup 處理。
    public static class R30Foliage
    {
        const string Dir = "Assets/_Project/Materials/R30/";

        // 類別, 權重高度(m), 主擺動(m), 細顫(m), 透光, 網格名
        static readonly (string cls, float height, float strength, float flutter, float transl, string[] meshes)[] Classes =
        {
            ("grass", 0.5f, 0.06f, 0.01f, 0.6f, new[] { "gc_maidong", "gc_shudai", "gc_shudai_drift", "grass_patch_mix", "gc_changpu", "flower_jiguan", "flower_fengxian", "juhua_bed" }),
            ("shrub", 1.5f, 0.05f, 0.008f, 0.5f, new[] { "dujuan_low", "dujuan_mound", "huangyang_trio", "huangyang_ball", "shrub_belt", "mufurong", "bamboo_belt", "bamboo_small" }),
            ("tree", 8f, 0.15f, 0.01f, 0.3f, new[] { "pine_r12", "pine_r12_lod1", "wutong_slim", "wutong_slim_lod1", "guihua", "guihua_lod1" }),
        };

        public static string Run()
        {
            var shader = Shader.Find("Liuruan/FoliageWind");
            var src2 = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Blender/r10r11/M_r10_2side.mat");
            var srcM = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Blender/r10r11/M_r10_matte.mat");
            if (!shader || !src2 || !srcM) return "foliage wind: 尚無風動 shader／調色盤材質，未修改場景";
            System.IO.Directory.CreateDirectory(Dir);
            AssetDatabase.Refresh();

            var swap = new Dictionary<string, (Material two, Material matte)>();
            foreach (var c in Classes)
            {
                var pair = (Make(shader, src2, c, true), Make(shader, srcM, c, false));
                foreach (var m in c.meshes) swap[m] = pair;
            }

            int n = 0;
            foreach (var r in Object.FindObjectsByType<MeshRenderer>(FindObjectsInactive.Include, FindObjectsSortMode.None))
            {
                var mf = r.GetComponent<MeshFilter>();
                if (mf == null || mf.sharedMesh == null || !swap.TryGetValue(mf.sharedMesh.name, out var pair)) continue;
                var mats = r.sharedMaterials;
                bool hit = false;
                for (int i = 0; i < mats.Length; i++)
                {
                    if (mats[i] == src2) { mats[i] = pair.two; hit = true; }
                    else if (mats[i] == srcM) { mats[i] = pair.matte; hit = true; }
                }
                if (!hit) continue;
                r.sharedMaterials = mats;
                n++;
            }
            AssetDatabase.SaveAssets();
            EditorSceneManager.MarkSceneDirty(EditorSceneManager.GetActiveScene());
            EditorSceneManager.SaveOpenScenes();
            return $"foliage wind: {n} renderers";
        }

        static Material Make(Shader shader, Material src, (string cls, float height, float strength, float flutter, float transl, string[] meshes) c, bool twoSided)
        {
            var path = Dir + $"M_r10_{c.cls}_{(twoSided ? "2side" : "matte")}_wind.mat";
            var m = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (m == null) { m = new Material(shader); AssetDatabase.CreateAsset(m, path); }
            m.shader = shader;
            m.SetTexture("_BaseMap", src.GetTexture("_BaseMap"));
            m.SetColor("_BaseColor", src.GetColor("_BaseColor"));
            m.SetFloat("_Cutoff", 0.1f); // 調色盤不透明，只為共用 alpha clip 路徑
            m.SetFloat("_Cull", twoSided ? 0f : 2f);
            m.SetFloat("_WrapDiffuse", 0.4f);
            m.SetFloat("_SpecularStrength", 0.05f);
            m.SetFloat("_Smoothness", 0.3f);
            m.SetColor("_TranslucencyColor", new Color(0.6f, 0.8f, 0.25f));
            m.SetFloat("_Translucency", c.transl);
            m.SetFloat("_WindHeight", c.height);
            m.SetVector("_WindDir", new Vector4(1, 0, 0.3f, 0));
            m.SetFloat("_WindStrength", c.strength);
            m.SetFloat("_WindSpeed", c.cls == "grass" ? 1.8f : 1.0f);
            m.SetFloat("_WindWaveScale", c.cls == "grass" ? 0.3f : 0.15f);
            m.SetFloat("_FlutterStrength", c.flutter);
            m.enableInstancing = true;
            EditorUtility.SetDirty(m);
            return m;
        }
    }
}
using System;
using System.IO;
using UnityEditor;
using UnityEditor.Build.Reporting;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace Liuruan
{
    /// WebGL 分包（仿 oz-journey ZoneBundles）：Main.unity 打成 LZMA scene bundle「main」，切成 ≤20 MiB 的
    /// StreamingAssets/scene/main.0、.1…＋parts.json；主包只放 Boot.unity（BootLoader 下載拼回後載入 Main）。
    /// EditorBuildSettings 不動：Editor 直接開 Main.unity 按 Play 照舊。
    /// 一鍵：-executeMethod Liuruan.SceneBundles.BuildAll
    public static class SceneBundles
    {
        const string MainScenePath = "Assets/_Project/Scenes/Main.unity";
        const string BootScenePath = "Assets/_Project/Scenes/Boot.unity";
        const string OutDir = "Build/SceneBundles";      // 增量建置快取；SceneBundles.manifest 給程式碼裁剪用
        const string PlayerDir = "Build/WebGL";
        const string ServeDir = PlayerDir + "/StreamingAssets/" + BootLoader.Dir;
        const string DoneFlag = PlayerDir + "/.bundle-done"; // 全部成功才寫；外部用它判斷建置結束
        const long MaxFile = 25L * 1024 * 1024;          // Cloudflare Pages 單檔上限

        [MenuItem("Tools/Liuruan/Build/Scene Bundle Only")]
        public static void BuildBundleOnlyMenu()
        {
            bool ok = BuildBundle() && (!Directory.Exists(PlayerDir) || CopyToPlayer());
            if (Application.isBatchMode) EditorApplication.Exit(ok ? 0 : 1);
        }

        /// 建 bundle → 建 WebGL（只含 Boot）→ bundle 切塊放進 Build/WebGL/StreamingAssets/scene → 寫 .bundle-done
        [MenuItem("Tools/Liuruan/Build/WebGL + Scene Bundle")]
        public static void BuildAll()
        {
            if (File.Exists(DoneFlag)) File.Delete(DoneFlag);
            bool ok = EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo() && EnsureBootScene() && BuildBundle();
            if (ok)
            {
                // PlayerSettings（Brotli、檔名雜湊、模板、記憶體）沿用 ProjectSettings 現有 WebGL 設定
                var report = BuildPipeline.BuildPlayer(new BuildPlayerOptions
                {
                    scenes = new[] { BootScenePath },
                    locationPathName = PlayerDir,
                    target = BuildTarget.WebGL,
                    targetGroup = BuildTargetGroup.WebGL,
                    options = EditorUserBuildSettings.development ? BuildOptions.Development : BuildOptions.None,
                    assetBundleManifestPath = $"{OutDir}/{Path.GetFileName(OutDir)}.manifest", // 只在 bundle 用到的型別／引擎模組不被裁掉
                });
                ok = report.summary.result == BuildResult.Succeeded;
                Debug.Log($"[SceneBundles] WebGL {report.summary.result}");
                if (ok) ok = CopyToPlayer(); // BuildPlayer 之後才複製，避免被 StreamingAssets 覆蓋
            }
            if (ok) File.WriteAllText(DoneFlag, DateTime.Now.ToString("o") + "\n");
            else Debug.LogError("[SceneBundles] 建置失敗，未寫 .bundle-done");
            if (Application.isBatchMode) EditorApplication.Exit(ok ? 0 : 1);
        }

        static bool BuildBundle()
        {
            // bundle 讀磁碟上的場景：Main 有未存修改時先問（batch mode 直接回 true）
            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return false;
            Directory.CreateDirectory(OutDir);
            // 預設 LZMA：檔案最小（CF 以存放大小算 25 MiB；octet-stream 不一定會再壓）
            var manifest = BuildPipeline.BuildAssetBundles(OutDir, new[]
            {
                new AssetBundleBuild { assetBundleName = BootLoader.BundleName, assetNames = new[] { MainScenePath } },
            }, BuildAssetBundleOptions.None, BuildTarget.WebGL);
            if (!manifest) { Debug.LogError("[SceneBundles] bundle 建置失敗"); return false; }
            long size = new FileInfo(Path.Combine(OutDir, BootLoader.BundleName)).Length;
            Debug.Log($"[SceneBundles] {BootLoader.BundleName} {size / 1048576f:F2} MiB");
            return true;
        }

        /// 切成 ≤20 MiB 的 main.0、.1…，寫 parts.json；任何一塊超過 25 MiB 就失敗
        static bool CopyToPlayer()
        {
            if (Directory.Exists(ServeDir)) Directory.Delete(ServeDir, true);
            Directory.CreateDirectory(ServeDir);
            var data = File.ReadAllBytes(Path.Combine(OutDir, BootLoader.BundleName));
            if (data.LongLength == 0 || data.LongLength > int.MaxValue) { Debug.LogError("[SceneBundles] bundle 大小無效"); return false; }
            int n = (int)((data.LongLength + BootLoader.PartSize - 1) / BootLoader.PartSize);
            for (int i = 0; i < n; i++)
            {
                int len = (int)Math.Min(BootLoader.PartSize, data.LongLength - (long)i * BootLoader.PartSize);
                if (len > MaxFile) { Debug.LogError($"[SceneBundles] {BootLoader.BundleName}.{i} 超過 25 MiB"); return false; }
                using (var fs = File.Create(Path.Combine(ServeDir, $"{BootLoader.BundleName}.{i}")))
                    fs.Write(data, i * BootLoader.PartSize, len);
            }
            var parts = new BootLoader.Parts { name = BootLoader.BundleName, parts = n, bytes = data.LongLength };
            File.WriteAllText(Path.Combine(ServeDir, BootLoader.IndexFile), JsonUtility.ToJson(parts, true));
            Debug.Log($"[SceneBundles] 已切 {n} 塊到 {ServeDir}");
            return true;
        }

        /// Boot.unity 不存在就建：黑底相機＋BootLoader（附加開啟後存檔關閉，不動目前場景）
        static bool EnsureBootScene()
        {
            if (File.Exists(BootScenePath)) return true;
            var active = SceneManager.GetActiveScene();
            bool additive = active.IsValid() && !string.IsNullOrEmpty(active.path); // 未命名場景不能附加開新場景（batch mode 常見）
            var boot = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, additive ? NewSceneMode.Additive : NewSceneMode.Single);
            SceneManager.SetActiveScene(boot); // 新物件建在 Boot，不弄髒 Main
            var cam = new GameObject("Camera").AddComponent<Camera>();
            cam.clearFlags = CameraClearFlags.SolidColor;
            cam.backgroundColor = new Color(0.12f, 0.09f, 0.07f);
            new GameObject("BootLoader", typeof(BootLoader));
            bool ok = EditorSceneManager.SaveScene(boot, BootScenePath);
            if (additive)
            {
                SceneManager.SetActiveScene(active);
                EditorSceneManager.CloseScene(boot, true);
            }
            if (!ok) Debug.LogError("[SceneBundles] Boot.unity 建立失敗");
            else AssetDatabase.ImportAsset(BootScenePath);
            return ok;
        }
    }
}

