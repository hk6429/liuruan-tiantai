using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;

namespace Liuruan
{
    [Serializable] public sealed class SentenceDocument { public ReadingParagraph[] paragraphs = null; }
    [Serializable] public sealed class ReadingParagraph { public int p = 0; public ReadingSentence[] sentences = null; }
    [Serializable] public sealed class ReadingSentence { public string orig = null, plain = null; public string[] terms = null; }
    [Serializable] public sealed class GlossaryDocument { public GlossaryCard[] terms = null; }
    [Serializable] public sealed class GlossaryCard { public string term = null, reading = null, meaning = null; }
    public enum ReadingMode { Original, OriginalAndPlain }
    public sealed class ReadingCore
    {
        readonly Dictionary<int, ReadingParagraph> paragraphs = new Dictionary<int, ReadingParagraph>();
        readonly Dictionary<string, GlossaryCard> terms = new Dictionary<string, GlossaryCard>();
        public ReadOnlyCollection<string> MissingTerms { get; }
        public ReadingMode Mode { get; private set; }
        public event Action<ReadingMode> OnModeChanged;
        public ReadingCore(SentenceDocument sentences, GlossaryDocument glossary)
        {
            foreach (var card in R3Data.Required(glossary?.terms, "glossary.terms"))
            {
                R3Data.Text(card.term, "term"); R3Data.Text(card.meaning, "meaning");
                if (terms.ContainsKey(card.term)) throw new ArgumentException("詞卡重複：" + card.term);
                terms.Add(card.term, card);
            }
            var missing = new SortedSet<string>(StringComparer.Ordinal);
            foreach (var paragraph in R3Data.Required(sentences?.paragraphs, "sentences.paragraphs"))
            {
                if (paragraph.p < 1 || paragraphs.ContainsKey(paragraph.p)) throw new ArgumentException("段落編號無效或重複。");
                foreach (var sentence in R3Data.Required(paragraph.sentences, "paragraph.sentences"))
                {
                    R3Data.Text(sentence.orig, "sentence.orig"); R3Data.Text(sentence.plain, "sentence.plain");
                    if (sentence.terms == null) throw new ArgumentException("sentence.terms 不可缺少，可用空陣列。");
                    foreach (string term in sentence.terms)
                    { R3Data.Text(term, "sentence.term"); if (!terms.ContainsKey(term)) missing.Add(term); }
                }
                paragraphs.Add(paragraph.p, paragraph);
            }
            MissingTerms = Array.AsReadOnly(new List<string>(missing).ToArray());
        }
        public ReadingParagraph GetParagraph(int p) => paragraphs.TryGetValue(p, out var value) ? value : null;
        public GlossaryCard FindTerm(string term) => term != null && terms.TryGetValue(term, out var value) ? value : null;
        public void SetMode(ReadingMode mode)
        {
            if (mode != ReadingMode.Original && mode != ReadingMode.OriginalAndPlain) throw new ArgumentOutOfRangeException(nameof(mode));
            if (mode == Mode) return;
            Mode = mode; OnModeChanged?.Invoke(mode);
        }
        public string Display(ReadingSentence sentence)
        {
            if (sentence == null) throw new ArgumentNullException(nameof(sentence));
            return Mode == ReadingMode.Original ? sentence.orig : sentence.orig + "\n" + sentence.plain;
        }
    }
}
using System;
using System.Collections.Generic;

namespace Liuruan
{
    [Serializable] public sealed class DialogueDocument { public DialogueAct[] acts = null; }
    [Serializable] public sealed class DialogueAct { public int act = 0; public DialogueScene[] scenes = null; }
    [Serializable] public sealed class DialogueScene
    { public string id = null, trigger = null; public DialogueLine[] lines = null; }
    [Serializable] public sealed class DialogueLine { public string speaker = null, text = null, type = null; public string source = null, label = null, orig = null; }
    public sealed class DialogueCore
    {
        readonly Dictionary<string, DialogueScene> scenes = new Dictionary<string, DialogueScene>();
        readonly List<DialogueScene> ordered = new List<DialogueScene>();
        readonly HashSet<string> played = new HashSet<string>();
        DialogueScene current;
        int line;
        public bool IsActive => current != null;
        public DialogueLine CurrentLine => current == null ? null : current.lines[line];
        public string SceneId => current?.id;
        public event Action<string> OnSceneEnd;
        public event Action<DialogueLine> OnLineChanged;
        public DialogueCore(DialogueDocument data)
        {
            var acts = new HashSet<int>();
            foreach (var act in R3Data.Required(data?.acts, "dialogue.acts"))
            {
                R3Data.Act(act.act); R3Data.Unique(acts, act.act, "dialogue.act");
                foreach (var scene in R3Data.Required(act.scenes, "dialogue.scenes"))
                {
                    R3Data.Text(scene.id, "scene.id"); R3Data.Text(scene.trigger, "scene.trigger");
                    foreach (var entry in R3Data.Required(scene.lines, "scene.lines"))
                    {
                        R3Data.Text(entry.speaker, "line.speaker"); R3Data.Text(entry.text, "line.text");
                        if (entry.type != "original" && entry.type != "plain") throw new ArgumentException("line.type 必須為 original 或 plain。");
                        if (entry.type == "plain" && new System.Globalization.StringInfo(entry.text).LengthInTextElements > 20)
                            throw new ArgumentException("白話台詞不可超過 20 字。");
                    }
                    if (scenes.ContainsKey(scene.id)) throw new ArgumentException("scene.id 重複。");
                    scenes.Add(scene.id, scene); ordered.Add(scene);
                }
            }
        }
        public bool Start(string sceneId, bool replay = false)
        {
            if (IsActive || sceneId == null || !scenes.TryGetValue(sceneId, out var scene) || (!replay && played.Contains(sceneId))) return false;
            current = scene; line = 0; played.Add(sceneId);
            OnLineChanged?.Invoke(CurrentLine); return true;
        }
        public bool TryTrigger(string trigger)
        {
            foreach (var scene in ordered) if (scene.trigger == trigger && Start(scene.id)) return true;
            return false;
        }
        public bool Next()
        {
            if (!IsActive) return false;
            if (line + 1 < current.lines.Length)
            { line++; OnLineChanged?.Invoke(CurrentLine); return true; }
            string id = current.id; current = null; line = 0;
            OnSceneEnd?.Invoke(id); return true;
        }
    }
}

