        public string ReadingMarkup(ClueData card)
        {
            int[] ps = card.act == 4 ? new[] { 4, 5, 6 } : new[] { card.act == 5 ? 7 : card.act };
            var sb = new StringBuilder();
            foreach (int p in ps)
            {
                var paragraph = reading.GetParagraph(p);
                if (paragraph == null) continue;
                for (int i = 0; i < paragraph.sentences.Length; i++)
                {
                    var sentence = paragraph.sentences[i]; string key = p + ":" + i;
                    // 詞連結獨立於句連結，避免 TMP 不支援巢狀 link。
                    string original = sentence.orig;
                    foreach (string term in sentence.terms) original = original.Replace(term, "<link='"\\\"t:\" + term + \"\\\"><u>\" + term + \"</u></link>\");
                    sb.Append(original).Append(\" <link=\\\"s:\" + key + \"\\\"><color=#256C70>〔白話〕</color></link>\");
                    if (expanded.Contains(key)) sb.Append(\"\\n<color=#256C70>\").Append(sentence.plain).Append(\"</color>\");
                    sb.Append('\\n');
                }
            }
            return sb.ToString();
        }
