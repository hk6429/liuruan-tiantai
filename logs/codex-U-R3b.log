        File.AppendAllText("logs/U-R3-play.md", "\nPASS：每點碰撞步行可達、y=-20 掉落救回、漂流物靠近暫停、結局重載及按鈕重開回第一幕；console error=0。\n");
        SessionState.SetString(Phase, "capture"); EditorApplication.isPlaying = false;
    }
