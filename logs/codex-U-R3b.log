  "clues": [
    {
      "id": 7,
      "act": 3,
      "title": "去：一詞多義",
      "original": "此處去人徑不遠。",
      "plain": "這裡離人行小路不遠。",
      "question": "此句的「去」是哪個意思？",
      "options": [
        "距離",
        "離開",
        "前往"
      ],
      "answer": 0,
      "feedback": "「不遠」說明距離，去在此是距離。",
      "wrongHints": [
        "看看後面的「不遠」。",
        "這裡在說位置，不是在說動作。"
      ]
    },
    {
      "id": 8,
      "act": 4,
      "title": "呼姓：熟悉與陌生",
      "original": "晨、肇既不識之，二女便呼其姓，如似有舊",
      "plain": "兩人不認識女子，女子卻叫出姓。",
      "question": "二女呼姓主要帶出什麼感受？",
      "options": [
        "證明雙方早已認識",
        "女子似知來客，增添奇異感",
        "兩人入山前已約好見面"
      ],
      "answer": 1,
      "feedback": "兩人不識女子，女子卻似熟識，形成奇異感。",
      "wrongHints": [
        "注意「既不識之」。",
        "像有舊交，不代表真有舊交。"
      ]
    },
    {
      "id": 9,
      "act": 4,
      "title": "忻怖：交織的情緒",
      "original": "酒酣作樂，劉、阮忻怖交並。",
      "plain": "兩人又高興又害怕。",
      "question": "哪個推論最能解釋「忻怖交並」？",
      "options": [
