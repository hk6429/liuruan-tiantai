            var sBtn = Btn(root, "ScoreBtn", new Vector2(0.54f, 0.93f), new Vector2(0.62f, 0.99f), Txt.ScoreBtn);
            T(sBtn, 0.43f, 0.86f, 0.53f, 0.99f);
            sBtn.onClick.AddListener(() =>
