using UnityEngine;
using UnityEngine.EventSystems;

namespace Liuruan
{
    /// 手機／平板觸控輸入：左下搖桿移動、拖曳畫面轉視角、右下互動鍵（等同 E）。
    public static class TouchInput
    {
        /// 手機平台、瀏覽器判斷為觸控平板（hotfix1：iPadOS 回報 Macintosh 但 maxTouchPoints > 1；Android 平板），
        /// 或桌機上實際摸過螢幕（保留原本「第一次觸控就切換」）
        public static bool Enabled => Application.isMobilePlatform || sawTouch || Tablet;
        static bool sawTouch;
        static int tablet = -1;
        static bool Tablet { get { if (tablet < 0) tablet = TabletJs() ? 1 : 0; return tablet == 1; } }
#if UNITY_WEBGL && !UNITY_EDITOR
        [System.Runtime.InteropServices.DllImport("__Internal")] static extern int LiuruanTouchTablet();
        static bool TabletJs() { try { return LiuruanTouchTablet() == 1; } catch { return false; } }
#else
        static bool TabletJs() => false;
#endif
        public static void Poll() { if (Input.touchCount > 0) sawTouch = true; }
        public static Vector2 Move;
        public static Vector2 Look;
        public static bool InteractHeld;
        static int downFrame = -10;
        static bool used = true;

        public static void Press() { downFrame = Time.frameCount; used = false; }

        /// 本幀或上一幀按下且尚未被取用
        public static bool ConsumeDown()
        {
            if (used || Time.frameCount - downFrame > 1) return false;
            used = true;
            return true;
        }

        public static Vector2 ConsumeLook() { var d = Look; Look = Vector2.zero; return d; }
    }

    /// 虛擬搖桿：拖曳範圍為自身半徑
    public class TouchStick : MonoBehaviour, IPointerDownHandler, IDragHandler, IPointerUpHandler
    {
        public RectTransform knob;
        RectTransform rt;

        void Awake() => rt = (RectTransform)transform;

        public void OnPointerDown(PointerEventData e) => OnDrag(e);

        public void OnDrag(PointerEventData e)
        {
            RectTransformUtility.ScreenPointToLocalPointInRectangle(rt, e.position, e.pressEventCamera, out var p);
            float r = rt.rect.width * 0.5f;
            var v = Vector2.ClampMagnitude(p / r, 1f);
            TouchInput.Move = v;
            knob.anchoredPosition = v * r;
        }

        public void OnPointerUp(PointerEventData e)
        {
            TouchInput.Move = Vector2.zero;
            knob.anchoredPosition = Vector2.zero;
        }

        void OnDisable() => OnPointerUp(null);
    }

    /// 拖曳空白畫面轉視角
    public class TouchLook : MonoBehaviour, IDragHandler
    {
        public void OnDrag(PointerEventData e) => TouchInput.Look += e.delta;
    }

    /// 互動鍵：按下觸發一次，按住可持續（磨墨用）
    public class TouchButton : MonoBehaviour, IPointerDownHandler, IPointerUpHandler
    {
        public void OnPointerDown(PointerEventData e) { TouchInput.InteractHeld = true; TouchInput.Press(); }
        public void OnPointerUp(PointerEventData e) => TouchInput.InteractHeld = false;
        void OnDisable() => TouchInput.InteractHeld = false;
    }
}
using System;
using UnityEngine;
using UnityEngine.Events;

namespace Liuruan
{
    public sealed class HungerSystem : MonoBehaviour
    {
        [SerializeField, Range(0f, 5f)] private float initialValue = 3f;
        [SerializeField, Min(0.01f)] private float intervalSeconds = 24f;
        [SerializeField] private UnityEvent<float> onChanged = new UnityEvent<float>();
        [SerializeField] private UnityEvent onStarving = new UnityEvent();
        [SerializeField] private UnityEvent<string> onToast = new UnityEvent<string>();
        public event Action<float> OnChanged;
        public event Action OnStarving;
        public event Action<string> OnToast;
        private HungerCore core;
        private HungerCore Core
        {
            get
            {
                if (core == null)
                {
                    core = new HungerCore(initialValue, intervalSeconds);
                    core.OnChanged += value => { onChanged.Invoke(value); OnChanged?.Invoke(value); };
                    core.OnStarving += HandleStarving;
                }
                return core;
            }
        }
        public float Value => Core.Value;
        public float SpeedMultiplier => Core.SpeedMultiplier;
        private void Awake() { _ = Core; }
        private void Update() => Core.Tick(Time.deltaTime);
        public void Pause() => Core.Pause();
        public void Resume() => Core.Resume();
        public void Eat(float amount) => Core.Eat(amount);
        public void FillAll() => Core.FillAll();
        private void HandleStarving()
        {
            onStarving.Invoke();
            OnStarving?.Invoke();
            const string message = "肚子餓了，去找些食物吧。";
            onToast.Invoke(message);
            OnToast?.Invoke(message);
        }
    }
}
using UnityEngine;
using UnityEngine.AI;

namespace Liuruan
{
    public sealed class CompanionFollow : MonoBehaviour
    {
        [SerializeField] private Transform player;
        [SerializeField, Min(0f)] private float followSpeed = 3f;
        [SerializeField, Min(1f)] private float catchupMultiplier = 1.6f;
        private NavMeshAgent agent;
        private readonly CompanionCore core = new CompanionCore();
        private Vector3 previousPosition;
        public float Speed { get; private set; }
        public float CooldownRatio => core.CooldownRatio;
        public CompanionState State => core.State;
        public bool Call() => core.Call();
        private bool AgentReady => agent != null && agent.enabled && agent.isOnNavMesh;
        private void Awake() => agent = GetComponent<NavMeshAgent>();
        private void OnEnable() { previousPosition = transform.position; Speed = 0f; }

        private void Update()
        {
            float dt = Time.deltaTime;
            Speed = dt > 0f ? Vector3.Distance(transform.position, previousPosition) / dt : 0f;
            previousPosition = transform.position;
            if (player == null)
            {
                if (AgentReady) agent.ResetPath();
                Speed = 0f;
                return;
            }
            CompanionState state = core.Tick(dt, ToCore(player.position),
                ToCore(transform.position), ToCore(player.forward));
            Vector3 target = ToUnity(core.Destination);
            if (state == CompanionState.Teleport)
            {
                // shortcut: 僅搜尋目標附近 2m 的 NavMesh；複雜多層地形由 U 線提供安全落點。
                bool ready = AgentReady;
                if (NavMesh.SamplePosition(target, out NavMeshHit hit, 2f, NavMesh.AllAreas))
                    target = hit.position;
                if (ready) agent.ResetPath();
                if (!ready || !agent.Warp(target)) transform.position = target;
                previousPosition = transform.position;
                Speed = 0f;
                return;
            }
            float speed = state == CompanionState.Catchup ? followSpeed * catchupMultiplier : followSpeed;
            if (AgentReady)
            {
                agent.stoppingDistance = 2.4f;
                agent.speed = speed;
                agent.isStopped = state == CompanionState.Idle;
                if (state != CompanionState.Idle) agent.SetDestination(target);
            }
            else if (state != CompanionState.Idle)
            {
                float remaining = Mathf.Max(0f, Vector3.Distance(transform.position, target) - 2.4f);
                transform.position = Vector3.MoveTowards(transform.position, target, Mathf.Min(speed * dt, remaining));
            }
        }

        private void OnDisable()
        {
            if (AgentReady) agent.ResetPath();
            Speed = 0f;
        }
        private static WorldPosition ToCore(Vector3 p) => new WorldPosition(p.x, p.y, p.z);
        private static Vector3 ToUnity(WorldPosition p) => new Vector3(p.X, p.Y, p.Z);
    }
}
