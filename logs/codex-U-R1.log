diff --git a/Assets/_Project/Editor/R1Bridge.cs b/Assets/_Project/Editor/R1Bridge.cs
new file mode 100644
index 0000000000000000000000000000000000000000..efa893f8fa78073f5f760d8ec75c7074e40eb3cf
--- /dev/null
+++ b/Assets/_Project/Editor/R1Bridge.cs
@@ -0,0 +1,26 @@
+using System;
+using System.IO;
+using UnityEditor;
+using UnityEngine;
+
+// Editor 腳本備援入口；只接受本輪固定作業，不開啟另一個 Unity。
+[InitializeOnLoad]
+public static class R1Bridge
+{
+    const string Request = "Assets/_Project/Editor/R1Command.txt";
+    static string last;
+    static R1Bridge() { EditorApplication.update += Tick; }
+    static void Tick()
+    {
+        if (EditorApplication.isCompiling || EditorApplication.isUpdating || !File.Exists(Request)) return;
+        string command = File.ReadAllText(Request).Trim();
+        if (command == last || command.Length == 0) return;
+        last = command;
+        try
+        {
+            if (command.StartsWith("refresh")) AssetDatabase.Refresh();
+            File.WriteAllText("logs/U-R1-bridge.md", DateTime.Now.ToString("o") + " " + command + " ready " + Application.dataPath);
+        }
+        catch (Exception e) { Debug.LogException(e); }
+    }
+}
diff --git a/Assets/_Project/Editor/R1Setup.cs b/Assets/_Project/Editor/R1Setup.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c057f0ffc87ae8181a0957a81cbdc9e1e80daf8c
--- /dev/null
+++ b/Assets/_Project/Editor/R1Setup.cs
@@ -0,0 +1,90 @@
+using System;
+using System.IO;
+using Liuruan;
+using TMPro;
+using Unity.AI.Navigation;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.AI;
+
+public static class R1Setup
+{
+    [MenuItem("Tools/Liuruan/R1/Install")]
+    public static void Install()
+    {
+        if (EditorApplication.isPlaying) throw new InvalidOperationException("請先離開 Play 模式。");
+        var scene = EditorSceneManager.OpenScene("Assets/_Project/Scenes/Main.unity");
+        var player = GameObject.Find("Player");
+        Add<HungerSystem>(player);
+        var companion = GameObject.Find("Companion");
+        var collider = companion.GetComponent<Collider>();
+        if (collider) UnityEngine.Object.DestroyImmediate(collider);
+        var agent = Add<NavMeshAgent>(companion);
+        agent.radius = 0.3f; agent.height = 1.8f; agent.baseOffset = 0.9f;
+        var follow = Add<CompanionFollow>(companion);
+        Set(follow, "player", player.transform);
+        var deck = GameObject.Find("R1PeachLanding");
+        if (!deck)
+        {
+            deck = GameObject.CreatePrimitive(PrimitiveType.Cube); deck.name = "R1PeachLanding";
+            deck.transform.position = new Vector3(-17, 17.8f, -24); deck.transform.localScale = new Vector3(8, 0.4f, 8);
+            deck.GetComponent<Renderer>().sharedMaterial = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/Rock.mat");
+        }
+        foreach (Transform t in GameObject.Find("ActPoints").transform)
+        {
+            if (t.name == "Act1_Start") continue;
+            var it = Add<Interactable>(t.gameObject);
+            it.radius = 3.5f;
+            if (t.name.StartsWith("Act1_")) it.prompt = "剝皮";
+            else if (t.name == "Act2_ClimbBase") it.prompt = "攀援";
+            else if (t.name == "Act2_PeachTree") it.prompt = "摘桃";
+            else if (t.name.StartsWith("Act3_Drift_")) it.prompt = "撿起";
+            else if (t.name == "Act3_Wade") it.prompt = "涉水";
+            else if (t.name == "Act4_Board") it.prompt = "閱讀原文";
+            else if (t.name == "Act5_Return") it.prompt = "返回村口";
+            else it.prompt = "查看";
+            if (!t.Find("R1Marker"))
+            {
+                var marker = GameObject.CreatePrimitive(PrimitiveType.Sphere); marker.name = "R1Marker";
+                UnityEngine.Object.DestroyImmediate(marker.GetComponent<Collider>());
+                marker.transform.SetParent(t, false); marker.transform.localPosition = Vector3.up * 1.3f; marker.transform.localScale = Vector3.one * 0.55f;
+                marker.GetComponent<Renderer>().sharedMaterial = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/Player.mat");
+            }
+        }
+        var cold = AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/ReturnCold.mat");
+        if (!cold)
+        {
+            cold = new Material(AssetDatabase.LoadAssetAtPath<Material>("Assets/_Project/Materials/Greybox/Wall.mat"));
+            cold.SetColor("_BaseColor", new Color(0.32f, 0.37f, 0.42f));
+            AssetDatabase.CreateAsset(cold, "Assets/_Project/Materials/Greybox/ReturnCold.mat");
+        }
+        var systems = GameObject.Find("JourneySystems");
+        if (!systems) systems = new GameObject("JourneySystems");
+        var flow = Add<GameFlow>(systems); BindData(flow); Set(flow, "returnMaterial", cold);
+        var hud = Add<HudUI>(systems);
+        hud.font = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>("Assets/_Project/Fonts/NotoSerifTC Static SDF.asset");
+        var surface = Add<NavMeshSurface>(GameObject.Find("Terrain_240x240"));
+        surface.collectObjects = CollectObjects.All;
+        surface.useGeometry = NavMeshCollectGeometry.PhysicsColliders;
+        surface.BuildNavMesh();
+        var mesh = NavMesh.CalculateTriangulation();
+        if (mesh.vertices.Length == 0) throw new InvalidOperationException("NavMesh 烘焙結果為空。");
+        PlayerSettings.runInBackground = true;
+        EditorUtility.SetDirty(hud);
+        EditorSceneManager.MarkSceneDirty(scene);
+        if (!EditorSceneManager.SaveScene(scene)) throw new IOException("Main 場景儲存失敗。");
+        Debug.Log(Liuruan.EditorTools.FontSubset.RebuildNoDialog());
+        AssetDatabase.SaveAssets();
+        File.WriteAllText("logs/U-R1-install.md", "# R1 安裝結果\n\nMain 已儲存；互動點 15 個；NavMesh vertices=" + mesh.vertices.Length + "。\n題庫：" + (AssetDatabase.LoadAssetAtPath<TextAsset>("Assets/_Project/Data/clues.json") ? "已綁定" : "使用占位鍵") + "\n");
+    }
+    public static void BindData(GameFlow flow)
+    {
+        Set(flow, "clueJson", AssetDatabase.LoadAssetAtPath<TextAsset>("Assets/_Project/Data/clues.json"));
+    }
+    static T Add<T>(GameObject go) where T : Component { var c = go.GetComponent<T>(); return c ? c : go.AddComponent<T>(); }
+    static void Set(UnityEngine.Object target, string key, UnityEngine.Object value)
+    {
+        var so = new SerializedObject(target); so.FindProperty(key).objectReferenceValue = value; so.ApplyModifiedPropertiesWithoutUndo();
+    }
+}
diff --git a/Assets/_Project/Editor/R1Validation.cs b/Assets/_Project/Editor/R1Validation.cs
new file mode 100644
index 0000000000000000000000000000000000000000..7d5cca18b93689f7940f93d6fec3bb768f392992
--- /dev/null
+++ b/Assets/_Project/Editor/R1Validation.cs
@@ -0,0 +1,169 @@
+using System;
+using System.IO;
+using System.Text;
+using Liuruan;
+using TMPro;
+using UnityEditor;
+using UnityEditor.TestTools.TestRunner.Api;
+using UnityEngine;
+using UnityEngine.UI;
+
+[InitializeOnLoad]
+public static class R1Validation
+{
+    const string Phase = "Liuruan.R1.Phase";
+    const string SaveKey = "liuruan_r1_progress";
+    static TestRunnerApi runner;
+    static double started, next;
+    static int step;
+    static readonly string[] Route = { "Act1_Bark_1", "Act1_Bark_2", "Act1_Bark_3", "Act1_Bark_4", "Act1_Bark_5", "Act2_ClimbBase", "Act2_PeachTree", "Act3_Drift_1", "Act3_Drift_2", "Act3_Drift_3", "Act3_Wade", "Act4_Women", "Act4_House", "Act4_Board", "ReturnHome", "Act5_Return" };
+    static R1Validation() { EditorApplication.update += Tick; }
+    [MenuItem("Tools/Liuruan/R1/Validate All")]
+    public static void Begin()
+    {
+        if (EditorApplication.isPlaying) throw new InvalidOperationException("請先離開 Play 模式。");
+        R1Setup.Install();
+        SessionState.SetString(Phase, "tests");
+        runner = ScriptableObject.CreateInstance<TestRunnerApi>();
+        runner.RegisterCallbacks(new Results());
+        runner.Execute(new ExecutionSettings(new Filter { testMode = TestMode.EditMode, assemblyNames = new[] { "Liuruan.EditModeTests" } }));
+    }
+    sealed class Results : ICallbacks
+    {
+        public void RunStarted(ITestAdaptor t) { }
+        public void TestStarted(ITestAdaptor t) { }
+        public void TestFinished(ITestResultAdaptor r) { }
+        public void RunFinished(ITestResultAdaptor r)
+        {
+            var text = new StringBuilder("# EditMode Test Runner\n\n");
+            text.AppendLine("Passed=" + r.PassCount + " Failed=" + r.FailCount + " Skipped=" + r.SkipCount + " Duration=" + r.Duration);
+            Append(r, text);
+            File.WriteAllText("logs/U-R1-tests.md", text.ToString());
+            if (r.FailCount != 0 || r.PassCount == 0 || r.SkipCount != 0) { Fail("EditMode 測試未全數通過。"); return; }
+            BackupPrefs();
+            PlayerPrefs.DeleteKey(SaveKey);
+            SessionState.SetString(Phase, "play");
+            SessionState.SetInt("Liuruan.R1.Step", 0);
+            File.WriteAllText("logs/U-R1-play.md", "# Play 五幕驗證\n\n");
+            EditorApplication.isPlaying = true;
+        }
+        static void Append(ITestResultAdaptor r, StringBuilder s)
+        {
+            if (!r.HasChildren) s.AppendLine("- " + r.FullName + "：" + r.ResultState + " " + r.Message);
+            else foreach (var child in r.Children) Append(child, s);
+        }
+    }
+    static void BackupPrefs()
+    {
+        SessionState.SetString("Liuruan.R1.OldSave", PlayerPrefs.GetString(SaveKey, ""));
+        for (int id = 0; id <= 100; id++) foreach (string field in new[] { "tries", "solved", "plain" })
+        {
+            string key = "liuruan_q" + id + "_" + field;
+            SessionState.SetInt(key, PlayerPrefs.GetInt(key, -1)); PlayerPrefs.DeleteKey(key);
+        }
+    }
+    static void RestorePrefs()
+    {
+        string old = SessionState.GetString("Liuruan.R1.OldSave", "");
+        if (old.Length == 0) PlayerPrefs.DeleteKey(SaveKey); else PlayerPrefs.SetString(SaveKey, old);
+        for (int id = 0; id <= 100; id++) foreach (string field in new[] { "tries", "solved", "plain" })
+        {
+            string key = "liuruan_q" + id + "_" + field;
+            int value = SessionState.GetInt(key, -1);
+            if (value < 0) PlayerPrefs.DeleteKey(key); else PlayerPrefs.SetInt(key, value);
+        }
+        PlayerPrefs.Save();
+    }
+    static void Tick()
+    {
+        string phase = SessionState.GetString(Phase, "");
+        if (EditorApplication.isCompiling || EditorApplication.isUpdating) return;
+        try
+        {
+            if (phase == "play" && EditorApplication.isPlaying)
+            {
+                EditorApplication.QueuePlayerLoopUpdate();
+                if (EditorApplication.timeSinceStartup < next) return;
+                next = EditorApplication.timeSinceStartup + 0.15;
+                var flow = UnityEngine.Object.FindFirstObjectByType<GameFlow>();
+                if (!flow || !flow.GetComponentInChildren<Canvas>()) return;
+                if (started == 0) { started = EditorApplication.timeSinceStartup; step = SessionState.GetInt("Liuruan.R1.Step", 0); }
+                if (EditorApplication.timeSinceStartup - started > 180) throw new TimeoutException("Play 五幕驗證超過 180 秒。");
+                ScrollUI.I.charInterval = 0.001f;
+                if (flow.Reading) { AdvanceCard(flow); return; }
+                if (step == Route.Length)
+                {
+                    Require(flow.Act == 5 && flow.State.ended, "結局面板未完成");
+                    Require(flow.State.bark == 31 && flow.State.drift == 7 && flow.State.inferred, "收集或推論進度錯誤");
+                    Require(flow.State.villageStep == 3, "仙村順序錯誤");
+                    Require(GameObject.Find("Village/House_0") && !GameObject.Find("Village/House_1"), "歸鄉房屋切換失敗");
+                    Require(GameObject.Find("JourneySystems/JourneyHUD/JourneyEnding"), "結局面板未顯示");
+                    File.AppendAllText("logs/U-R1-play.md", "\nPASS：五幕實際互動、五棵穀皮、三件漂流物、閱讀卡作答、求歸、結局。\n");
+                    SessionState.SetString(Phase, "capture"); EditorApplication.isPlaying = false; return;
+                }
+                string key = Route[step];
+                if (key == "ReturnHome")
+                {
+                    Require(flow.CanReturn, "求歸尚未解鎖");
+                    var button = GameObject.Find("JourneySystems/JourneyHUD/ReturnHome").GetComponent<Button>();
+                    button.onClick.Invoke();
+                }
+                else
+                {
+                    var it = GameObject.Find("ActPoints/" + key).GetComponent<Interactable>();
+                    Require(it.enabled, key + " 尚未解鎖");
+                    flow.MovePlayer(it.transform.position + Vector3.right);
+                    Require(Interactable.Nearest(flow.Player.transform.position) == it, key + " 並非最近互動點");
+                    int act = flow.Act;
+                    it.Interact();
+                    File.AppendAllText("logs/U-R1-play.md", "- Act" + act + " 實際 Interactable.Interact：" + key + "\n");
+                    if (key == "Act2_PeachTree") Require(Mathf.Approximately(flow.Hunger.Value, 5), "摘桃沒有補滿飢餓值");
+                }
+                step++; SessionState.SetInt("Liuruan.R1.Step", step);
+            }
+            else if (phase == "capture" && !EditorApplication.isPlayingOrWillChangePlaymode)
+            {
+                RestorePrefs();
+                string capture = R30Capture.Run("r1");
+                File.WriteAllText("logs/U-R1-captures.md", "# 六機位\n\n" + string.Join("\n", Directory.GetFiles(capture, "r1_*.png")));
+                SessionState.SetString(Phase, "build");
+            }
+            else if (phase == "build" && !EditorApplication.isPlayingOrWillChangePlaymode)
+            {
+                SessionState.SetString(Phase, "building");
+                EditorUserBuildSettings.development = true;
+                // 沿用已存在且經確認的選單，不另外啟動 Unity。
+                if (!EditorApplication.ExecuteMenuItem("Tools/Liuruan/Build/WebGL + Scene Bundle")) throw new InvalidOperationException("找不到建置選單。");
+                Require(File.Exists("Build/WebGL/.bundle-done"), "建置沒有成功旗標");
+                SessionState.SetString(Phase, "done");
+                File.WriteAllText("logs/U-R1-build.md", "# WebGL Development\n\n" + File.ReadAllText("Build/WebGL/.bundle-done"));
+            }
+        }
+        catch (Exception e) { Fail(e.ToString()); }
+    }
+    static void AdvanceCard(GameFlow flow)
+    {
+        if (ScrollUI.I.Typing) return;
+        var card = flow.CurrentCard;
+        var buttons = ScrollUI.I.GetComponentsInChildren<Button>();
+        foreach (var b in buttons)
+            if (b.name == "Next" && b.interactable && b.transform.parent.name == "ReadPager") { b.onClick.Invoke(); return; }
+        foreach (var b in buttons)
+            if (b.name == "CloseBtn" && b.interactable && b.transform.parent.name == "Scroll") { b.onClick.Invoke(); return; }
+        if (card == null || !card.HasQuiz) return;
+        foreach (var b in buttons)
+        {
+            var label = b.GetComponentInChildren<TMP_Text>();
+            if (b.interactable && label && label.text.EndsWith(". " + card.options[card.answer], StringComparison.Ordinal))
+            { b.onClick.Invoke(); return; }
+        }
+    }
+    static void Require(bool condition, string message) { if (!condition) throw new InvalidOperationException(message); }
+    static void Fail(string error)
+    {
+        SessionState.SetString(Phase, "failed");
+        File.AppendAllText("logs/U-R1-failure.md", error + "\n");
+        if (EditorApplication.isPlaying) { RestorePrefs(); EditorApplication.isPlaying = false; }
+        Debug.LogError("[R1Validation] " + error);
+    }
+}
