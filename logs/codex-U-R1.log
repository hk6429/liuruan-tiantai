new file mode 100644
index 0000000000000000000000000000000000000000..4aa62b5db8a97973dbfdd4067d4b56adb3f49e54
--- /dev/null
+++ b/Assets/_Project/Editor/R1Serve.py
@@ -0,0 +1,31 @@
+"""在專案根目錄執行：python3 Assets/_Project/Editor/R1Serve.py。"""
+from functools import partial
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+
+class Handler(SimpleHTTPRequestHandler):
+    def guess_type(self, path):
+        for suffix in (".unityweb", ".br"):
+            if path.endswith(suffix):
+                path = path[:-len(suffix)]
+                break
+        if path.endswith(".wasm"):
+            return "application/wasm"
+        if path.endswith(".js"):
+            return "application/javascript"
+        return super().guess_type(path)
+
+    def end_headers(self):
+        if self.path.split("?", 1)[0].endswith((".unityweb", ".br")):
+            self.send_header("Content-Encoding", "br")
+        self.send_header("Cache-Control", "no-store")
+        super().end_headers()
+
+
+if __name__ == "__main__":
+    root = Path(__file__).resolve().parents[3] / "Build/WebGL"
+    if not (root / ".bundle-done").is_file():
+        raise SystemExit("尚無成功的 WebGL 建置：找不到 Build/WebGL/.bundle-done")
+    print("http://127.0.0.1:8765", flush=True)
+    ThreadingHTTPServer(("127.0.0.1", 8765), partial(Handler, directory=str(root))).serve_forever()
diff --git a/Assets/_Project/Editor/R1ServeTests.py b/Assets/_Project/Editor/R1ServeTests.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e4351db1300aa5ee3212580216ed6d7fabbf12f
--- /dev/null
+++ b/Assets/_Project/Editor/R1ServeTests.py
@@ -0,0 +1,31 @@
+"""不開網路連接埠，檢查本機伺服器的回應標頭。"""
+import io
+import runpy
+import unittest
+from pathlib import Path
+
+Handler = runpy.run_path(str(Path(__file__).with_name("R1Serve.py")))["Handler"]
+
+
+class ServerTests(unittest.TestCase):
+    def test_brotli_and_mime_headers(self):
+        for name, mime in (("game.wasm.unityweb", "application/wasm"),
+                           ("game.framework.js.unityweb", "application/javascript"),
+                           ("game.data.unityweb", "application/octet-stream"),
+                           ("game.wasm.br", "application/wasm"),
+                           ("index.html", "text/html")):
+            with self.subTest(name=name):
+                handler = Handler.__new__(Handler)
+                handler.path = "/" + name + "?v=1"
+                handler.request_version = "HTTP/1.1"
+                handler._headers_buffer = []
+                handler.wfile = io.BytesIO()
+                self.assertEqual(handler.guess_type(name), mime)
+                handler.end_headers()
+                headers = handler.wfile.getvalue().decode()
+                self.assertEqual("Content-Encoding: br" in headers, name != "index.html")
+                self.assertIn("Cache-Control: no-store", headers)
+
+
+if __name__ == "__main__":
+    unittest.main()
