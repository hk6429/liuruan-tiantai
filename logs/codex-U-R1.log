diff --git a/Assets/_Project/Scripts/ScrollUI.cs b/Assets/_Project/Scripts/ScrollUI.cs
index fcbf3dff8026ac892d8d14198b2df49c0d6d3a53..d3797346ae847000da3aa39f38f0e555945058cc
--- a/Assets/_Project/Scripts/ScrollUI.cs
