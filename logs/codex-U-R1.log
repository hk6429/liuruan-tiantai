@@ -0,0 +1,28 @@
+using System;
+using System.IO;
+using UnityEditor;
+using UnityEngine;
+
+// Editor 腳本備援入口；只接受本輪固定作業，不開啟另一個 Unity。
+[InitializeOnLoad]
+public static class R1Bridge
+{
+    const string Request = "Assets/_Project/Editor/R1Command.txt";
+    static string last;
+    static R1Bridge() { EditorApplication.update += Tick; }
+    static void Tick()
+    {
+        if (EditorApplication.isCompiling || EditorApplication.isUpdating || !File.Exists(Request)) return;
+        string command = File.ReadAllText(Request).Trim();
+        if (command == last || command.Length == 0) return;
+        last = command;
+        try
+        {
+            File.WriteAllText("logs/U-R1-bridge.md", DateTime.Now.ToString("o") + " " + command + " ready " + Application.dataPath);
+            File.WriteAllText(Request, "");
+            if (command.StartsWith("refresh")) AssetDatabase.Refresh();
+            if (command.StartsWith("all")) R1Validation.Begin();
+        }
+        catch (Exception e) { File.AppendAllText("logs/U-R1-failure.md", e + "\n"); Debug.LogException(e); }
+    }
+}
diff --git a/Assets/_Project/Editor/R1Serve.py b/Assets/_Project/Editor/R1Serve.py
new file mode 100644
index 0000000000000000000000000000000000000000..4aa62b5db8a97973dbfdd4067d4b56adb3f49e54
--- /dev/null
+++ b/Assets/_Project/Editor/R1Serve.py
@@ -0,0 +1,31 @@
+"""在專案根目錄執行：python3 Assets/_Project/Editor/R1Serve.py。"""
+from functools import partial
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+
+class Handler(SimpleHTTPRequestHandler):
+    def guess_type(self, path):
+        for suffix in (".unityweb", ".br"):
+            if path.endswith(suffix):
+                path = path[:-len(suffix)]
+                break
+        if path.endswith(".wasm"):
+            return "application/wasm"
+        if path.endswith(".js"):
+            return "application/javascript"
+        return super().guess_type(path)
+
+    def end_headers(self):
+        if self.path.split("?", 1)[0].endswith((".unityweb", ".br")):
+            self.send_header("Content-Encoding", "br")
+        self.send_header("Cache-Control", "no-store")
+        super().end_headers()
+
+
+if __name__ == "__main__":
+    root = Path(__file__).resolve().parents[3] / "Build/WebGL"
+    if not (root / ".bundle-done").is_file():
+        raise SystemExit("尚無成功的 WebGL 建置：找不到 Build/WebGL/.bundle-done")
+    print("http://127.0.0.1:8765", flush=True)
+    ThreadingHTTPServer(("127.0.0.1", 8765), partial(Handler, directory=str(root))).serve_forever()
diff --git a/Assets/_Project/Editor/R1Setup.cs b/Assets/_Project/Editor/R1Setup.cs
