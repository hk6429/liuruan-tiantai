          "terms": [
            "剡縣",
            "穀皮"
          ]
        },
        {
          "orig": "迷不得返，",
          "plain": "迷路，無法返回。",
          "terms": [
            "迷不得返"
          ]
        },
        {
          "orig": "經十餘日，",
