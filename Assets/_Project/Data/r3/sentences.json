          "terms": [
            "絕岩邃澗"
          ]
        },
        {
          "orig": "了無登路。",
          "plain": "完全沒有上山的路。",
          "terms": [
            "了無"
          ]
        },
        {
          "orig": "攀葛乃得至，",
