            "忻喜"
          ]
        },
        {
          "orig": "問：「",
          "plain": "問道。",
          "terms": []
        },
        {
          "orig": "來何晚耶？」",
          "plain": "怎麼來得這麼晚？",
          "terms": []
        },
        {
          "orig": "因要還家。",
          "plain": "於是邀他們回家。",
          "terms": [
            "要"
          ]
        }
      ]
    },
    {
